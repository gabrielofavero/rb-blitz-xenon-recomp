# Local retail game dump. Never commit game binaries or content.
/game/*
!/game/README.md

# Extracted game assets (scripts/extract_assets.ps1). Retail content: never commit.
# One tree per platform, both written by the same script: the 360 dump under
# assets/game/360, the PlayStation 3 dump under assets/game/ps3. The whole
# directory is retail content, so nothing under it is ever committed.
/assets/game/

# Build products and CMake-local state.
/out/
/build/
/cmake-build-*/
/compile_commands.json
/CMakeUserPresets.json

# clangd index cache (LLVM/Clang language server). Rebuilt locally on demand.
/.cache/

# Installer: everything it generates (embedded config, the payload snapshot it
# ships, the helper build tree and the produced setup executable).
/installer/out/
/installer/generated/

# Controller Settings: the settings schema compiled from controller-settings/config/settings.toml.
/controller-settings/out/

# Side wizard image made by installer/tools/make_art.ps1. The artwork is not ours
# to license, so only the repository's own art is committed: assets/icon/ holds the
# app's own blitz.ico / blitz.png and the black-and-white alt pair.
/assets/installer/wizard-*.bmp

# ReXGlue translation output is reproducible from the manifest and pinned SDK.
# Keep only the small SDK integration file emitted by `rexglue init`.
/generated/*
!/generated/rexglue.cmake

# Local diagnostics and captures.
/logs/
/captures/
*.log
*.dmp
*.etl
*.trace
*.pix3

# Disposable scratch for the harnesses and asset probes (`out/_swap/*/run.ps1` builds an
# empty DLC root here; scripts/hmx_milo.py dumps decompressed milo chunks here). A dumped
# chunk is retail content byte for byte, so nothing in this directory is ever committed.
/_scratch/

# Local-only runtime configuration.
/config/user.toml

# Python bytecode from the asset tooling (scripts/hmx_*.py).
__pycache__/

# .NET build output of the local asset tools (tools/milotex). The MiloEditor
# checkout it compiles against lives under the gitignored out/_tools/, so the
# binaries are machine-specific: milotex itself is rebuilt locally on demand,
# see tools/milotex/README.md.
/tools/milotex/bin/
/tools/milotex/obj/

# Editor and platform state.
/.vs/
/.vscode/
.DS_Store
Thumbs.db
