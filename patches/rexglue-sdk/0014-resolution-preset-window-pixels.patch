     if (rex::graphics::video_mode_util::TryGetResolutionPresetFromCVar(preset_width,
                                                                        preset_height)) {
-      return uint32_t(std::clamp(preset_height, 1, 8192));
+      return PixelsToWindowLogical(preset_height);
     }
