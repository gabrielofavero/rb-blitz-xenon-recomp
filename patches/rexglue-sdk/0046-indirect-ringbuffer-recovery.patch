# Indirect ringbuffer recovery for a library-loading stall observed in rb_blitz_443.log.
diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -216,7 +216,7 @@
 
   uint32_t ExecutePrimaryBuffer(uint32_t start_index, uint32_t end_index);
   virtual void OnPrimaryBufferEnd() {}
-  void ExecuteIndirectBuffer(uint32_t ptr, uint32_t length);
+  bool ExecuteIndirectBuffer(uint32_t ptr, uint32_t length);
   bool ExecutePacket(memory::RingBuffer* reader);
   bool ExecutePacketType0(memory::RingBuffer* reader, uint32_t packet);
   bool ExecutePacketType1(memory::RingBuffer* reader, uint32_t packet);
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -707,15 +707,16 @@
           packet_start, reader.read_count(), incomplete_packet_retries_,
           kMaxIncompletePacketRetries);
       reader.set_read_offset(packet_start);
-      return read_index;
+      return packet_start / sizeof(uint32_t);
     }
 
     // Still incomplete after every retry, or malformed outright: resynchronise.
-    // Stepping over the failed packet's header and continuing keeps the rest of
-    // the frame - in particular its swap packet - running instead of stopping
-    // the picture for good. Bounded, so a permanently garbage ring cannot spin
-    // here for ever.
-    reader.set_read_offset(packet_start + uint32_t(sizeof(uint32_t)));
+    // A failed indirect call already consumed its two argument words. Resume
+    // after those words, not inside them as if they were packet headers. For a
+    // direct length-check failure, only the header was consumed. Bounded, so a
+    // permanently garbage ring cannot spin here for ever.
+    reader.set_read_offset(std::max(packet_start + uint32_t(sizeof(uint32_t)),
+                                    reader.read_offset()));
     incomplete_packet_retries_ = 0;
     if (++resync_bad_packets_ > kMaxResyncPerBoot) {
       REXGPU_ERROR("**** PRIMARY RINGBUFFER: packet at {:08X} still failing after {} resync(s); "
@@ -733,20 +734,25 @@
   return write_index;
 }
 
-void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
+bool CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
   SCOPE_profile_cpu_f("gpu");
 
   // Execute commands!
   memory::RingBuffer reader(memory_->TranslatePhysical(ptr), count * sizeof(uint32_t));
   reader.set_write_offset(count * sizeof(uint32_t));
   do {
+    const uint32_t packet_start = reader.read_offset();
     if (!ExecutePacket(&reader)) {
-      // Return up a level if we encounter a bad packet.
-      REXGPU_ERROR("**** INDIRECT RINGBUFFER: Failed to execute packet.");
-      assert_always();
-      break;
+      // The parent packet must also fail. Otherwise the primary ring advances
+      // past this indirect call and loses its chance to retry an incompletely
+      // published list or resynchronise before the frame's swap packet.
+      REXGPU_ERROR("**** INDIRECT RINGBUFFER: Failed to execute packet at {:08X} "
+                   "(ptr {:08X}, {} dword(s)).",
+                   packet_start, ptr, count);
+      return false;
     }
   } while (reader.read_count());
+  return true;
 }
 
 void CommandProcessor::ExecutePacket(uint32_t ptr, uint32_t count) {
@@ -1099,8 +1105,7 @@
   uint32_t list_length = reader->ReadAndSwap<uint32_t>();
   assert_zero(list_length & ~0xFFFFF);
   list_length &= 0xFFFFF;
-  ExecuteIndirectBuffer(GpuToCpu(list_ptr), list_length);
-  return true;
+  return ExecuteIndirectBuffer(GpuToCpu(list_ptr), list_length);
 }
 
