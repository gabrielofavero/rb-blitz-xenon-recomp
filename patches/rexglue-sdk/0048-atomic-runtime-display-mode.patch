+
+Uint32 DisplayTrialTimerCallback(void* userdata, SDL_TimerID, Uint32) {
+  auto* timeout = static_cast<DisplayTrialTimeout*>(userdata);
+  SDL_Event event{};
+  event.type = timeout->event_type;
+  event.user.windowID = timeout->window_id;
+  event.user.code = int32_t(timeout->generation);
+  if (!SDL_PushEvent(&event)) {
+    REXLOG_ERROR("Display trial rollback event could not be queued: {}", SDL_GetError());
+  }
+  delete timeout;
+  return 0;
 }
 
