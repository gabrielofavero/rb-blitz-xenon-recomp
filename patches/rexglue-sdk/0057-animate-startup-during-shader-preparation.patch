+    auto resume_guest = [this, main_thread, graphics_system, has_shader_storage,
+                         async_preparation, title_id]() mutable {
+      OnPostLaunchModule(main_thread.get());
+      main_thread->Resume();
+
+      if (has_shader_storage && async_preparation) {
+        REXLOG_INFO("Preparing shader storage for title {:08X} beside the guest...", title_id);
+        if (!graphics_system->BeginShaderStoragePreparation(runtime_->cache_root(), title_id, 0)) {
+          REXLOG_WARN("Shader storage preparation could not start (a generation is already active)");
+        }
+      }
+
+      module_thread_ = std::thread([this, main_thread = std::move(main_thread)]() mutable {
+        main_thread->Wait(0, 0, 0, nullptr);
