+        if (!shutting_down_.load(std::memory_order_acquire)) {
+          app_context().CallInUIThreadDeferred([this, resume_guest]() mutable {
+            if (!shutting_down_.load(std::memory_order_acquire)) resume_guest();
+          });
+        }
+      });
+      return;
+    }
     if (has_shader_storage && !async_preparation) {
