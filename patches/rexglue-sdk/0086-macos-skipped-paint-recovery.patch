diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -347,6 +347,13 @@
   // them too.
   void PaintFromUIThread(bool force_paint = false);
 
+  // Consume a queued paint that the platform skipped while its drawable was
+  // unavailable. Otherwise future guest frames coalesce into a request whose
+  // window event has already been removed, leaving the last image frozen.
+  void OnPaintSkippedFromUIThread() {
+    ui_thread_paint_requested_.store(false, std::memory_order_relaxed);
+  }
+
   // UI paint is serialized with Window::SetDisplayMode on the UI thread.
   // A frame submitted by the guest output thread before the switch cannot advance this counter.
   uint64_t successful_ui_present_sequence() const {
diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -472,7 +472,9 @@
     }
     // Try to recover from the connection becoming outdated in the previous
     // paint.
-    if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+    if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated ||
+        (force_paint && surface_paint_connection_state_ ==
+                            SurfacePaintConnectionState::kUnconnectedRetryAtStateChange)) {
       UpdateSurfacePaintConnectionFromUIThread(nullptr, false);
     }
     // If still paintable or recovered successfully, paint.
@@ -1403,7 +1405,7 @@
           surface_paint_connection_has_implicit_vsync_ = is_vsync_implicit;
           surface_width_in_paint_connection_ = surface_width;
           surface_height_in_paint_connection_ = surface_height;
-          if (!is_reconnect) {
+          if (!is_reconnect && repaint_needed_out) {
             *repaint_needed_out = true;
           }
           break;
diff --git a/src/ui/window.cpp b/src/ui/window.cpp
--- a/src/ui/window.cpp
+++ b/src/ui/window.cpp
@@ -618,6 +618,9 @@
     // be outdated, so reconnect on the repeated gain as well.
     if (new_has_focus && presenter_surface_) {
       presenter_->OnSurfaceResizeFromUIThread(force_reconnect);
+#if REX_PLATFORM_MAC
+      RequestPaint();
+#endif
     }
     return;
   }
@@ -626,6 +629,11 @@
     // Capture/task switching can change the presentation path without resizing
     // the HWND. Reconnect even when the surface dimensions stayed the same.
     presenter_->OnSurfaceResizeFromUIThread(force_reconnect);
+#if REX_PLATFORM_MAC
+    // A skipped occluded paint may have been the last queued UI event. Repaint
+    // on focus even when retaining the same-size Metal swapchain.
+    RequestPaint();
+#endif
   }
   UISetupEvent e(this);
   if (has_focus_) {
diff --git a/src/ui/window_sdl.cpp b/src/ui/window_sdl.cpp
--- a/src/ui/window_sdl.cpp
+++ b/src/ui/window_sdl.cpp
@@ -615,6 +615,7 @@
   // is dispatched. Don't block Cocoa in nextDrawable ahead of that event.
   if (SDL_GetWindowFlags(sdl_window_) &
       (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED | SDL_WINDOW_OCCLUDED)) {
+    if (presenter()) presenter()->OnPaintSkippedFromUIThread();
     return;
   }
 #endif
