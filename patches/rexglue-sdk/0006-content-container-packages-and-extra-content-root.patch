+
+const ExtraContentItem* ContentManager::FindExtraContentItem(uint32_t title_id,
+                                                             XContentType content_type,
+                                                             const std::string_view file_name) const {
+  for (const auto& item : extra_content_library_) {
+    if (item.title_id == title_id && item.content_type == content_type &&
+        item.file_name == file_name) {
+      return &item;
+    }
+  }
+  return nullptr;
+}
+
+bool ContentManager::IsExtraContent(const std::filesystem::path& package_path) const {
+  for (const auto& item : extra_content_library_) {
+    if (item.host_path == package_path) {
+      return true;
+    }
+  }
+  if (!extra_content_root_.empty()) {
+    // Element-wise, so the root being a prefix of the path is a match while a sibling
+    // directory whose name shares that prefix is not. The spelling is the one the
+    // root was built from, which is what ResolveExtraPackageRoot() joins.
+    const auto root = extra_content_root_.lexically_normal();
+    const auto path = package_path.lexically_normal();
+    return std::mismatch(root.begin(), root.end(), path.begin(), path.end()).first == root.end();
+  }
+  return false;
+}
+
+std::filesystem::path ContentManager::ResolvePackagePath(uint64_t xuid,
+                                                         const XCONTENT_AGGREGATE_DATA& data) {
+  auto package_path = ResolvePrimaryPackagePath(xuid, data);
+  if (std::filesystem::exists(package_path)) {
+    return package_path;
+  }
+
+  // Read-only fallbacks, so a package that only exists in a registered extra source
+  // opens (and reports as existing) exactly like an installed one.
+  if (!extra_content_root_.empty()) {
+    auto extra_path = ResolveExtraPackageRoot(data.content_type, data.title_id) /
+                      rex::to_path(data.file_name());
+    if (std::filesystem::exists(extra_path)) {
+      return extra_path;
+    }
+  }
+
+  // A library item has no directory to resolve against: its identity is the header's
+  // own title id and content type, so it is looked up by what the enumerator handed
+  // the guest rather than by a path the extra root could build.
+  uint32_t title_id = uint32_t(data.title_id);
+  if (title_id == kCurrentlyRunningTitleId) {
+    title_id = kernel_state_->title_id();
+  }
+  if (const ExtraContentItem* item =
+          FindExtraContentItem(title_id, data.content_type, data.file_name())) {
+    return item->host_path;
+  }
+
+  return package_path;
+}
