+void ContentManager::AppendContentFromDirectory(const std::filesystem::path& package_root,
+                                                uint32_t device_id, uint64_t xuid,
+                                                XContentType content_type, uint32_t title_id,
+                                                bool read_headers,
+                                                std::vector<XCONTENT_AGGREGATE_DATA>* result) const {
+  auto file_infos = rex::filesystem::ListFiles(package_root);
+  for (const auto& file_info : file_infos) {
+    if (file_info.type != rex::filesystem::FileInfo::Type::kDirectory &&
+        !IsContentPackageFile(file_info.path / file_info.name)) {
+      // Directories only, plus the STFS containers a dumped content directory
+      // holds. Anything else (a readme, a stray save) is not content.
+      continue;
+    }
+
+    XCONTENT_AGGREGATE_DATA content_data;
+    if (read_headers && XSUCCEEDED(ReadContentHeaderFile(rex::path_to_utf8(file_info.name), xuid,
+                                                         title_id, content_type, content_data))) {
+      result->emplace_back(std::move(content_data));
+      continue;
+    }
+
+    content_data.device_id = device_id;
+    content_data.content_type = content_type;
+    content_data.set_display_name(rex::path_to_utf16(file_info.name));
+    content_data.set_file_name(rex::path_to_utf8(file_info.name));
+    content_data.title_id = title_id;
+    content_data.xuid = xuid;
+    result->emplace_back(std::move(content_data));
+  }
+}
