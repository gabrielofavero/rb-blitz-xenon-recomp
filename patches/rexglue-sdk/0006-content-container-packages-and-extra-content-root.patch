+std::filesystem::path ContentManager::ResolvePackagePath(uint64_t xuid,
+                                                         const XCONTENT_AGGREGATE_DATA& data) {
+  auto package_path = ResolvePrimaryPackagePath(xuid, data);
+  if (std::filesystem::exists(package_path) || extra_content_root_.empty()) {
+    return package_path;
+  }
+
+  // Read-only fallback, so a package that only exists in the extra root opens (and
+  // reports as existing) exactly like an installed one.
+  auto extra_path = ResolveExtraPackageRoot(data.content_type, data.title_id) /
+                    rex::to_path(data.file_name());
+  return std::filesystem::exists(extra_path) ? extra_path : package_path;
+}
