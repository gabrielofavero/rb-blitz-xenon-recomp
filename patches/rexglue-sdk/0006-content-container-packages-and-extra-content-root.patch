 static int content_device_id_ = 0;
 
+// A content item is either an extracted directory - the form InstallContent() and
+// CreateContent() write - or the STFS container itself. A real console keeps the
+// packages, it does not extract them, so a dumped content directory (a downloaded
+// DLC folder) holds containers and has to be mounted as such.
+bool IsContentPackageFile(const std::filesystem::path& path) {
+  return rex::filesystem::StfsContainerDevice::ReadPackageHeader(path) != nullptr;
+}
+
+// The bits InstallContent() copies into a .header file, read straight from the
+// package for a container that has none.
+uint32_t ComputeLicenseMask(const rex::filesystem::StfsHeader& header) {
+  uint32_t license_mask = 0;
+  for (size_t i = 0; i < countof(header.header.licenses); i++) {
+    if (header.header.licenses[i].license_flags) {
+      license_mask |= header.header.licenses[i].license_bits;
+    }
+  }
+  return license_mask;
+}
