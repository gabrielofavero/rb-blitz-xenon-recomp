+void SDLWindowedAppContext::PumpStartupPaint() {
+  assert_true(IsInUIThread());
+  if (startup_paint_pumping_ || HasQuitFromUIThread()) {
+    return;
+  }
+
+  startup_paint_pumping_ = true;
+  // SDL_PumpEvents dispatches the host window messages, but does not dispatch
+  // the custom paint events that WindowSDL queued. Do not drain the full event
+  // queue here: its wakeups may execute callbacks that expect startup to have
+  // finished, and input or display events may call into partly built services.
+  SDL_PumpEvents();
+  SDL_Event paint_event{};
+  if (SDL_PeepEvents(&paint_event, 1, SDL_GETEVENT, paint_event_type_, paint_event_type_) == 1) {
+    if (WindowSDL* window = GetWindow(paint_event.user.windowID)) {
+      window->HandlePaintEvent();
+    }
+  }
+  startup_paint_pumping_ = false;
 }
 
