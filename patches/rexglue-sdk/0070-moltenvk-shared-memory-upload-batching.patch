+void DeferredCommandBuffer::BeginSharedMemoryPass(const void* arguments) {
+  shared_pass_offset_ = reinterpret_cast<const uint8_t*>(arguments) -
+                        reinterpret_cast<const uint8_t*>(command_stream_.data());
+  shared_upload_hazards_.BeginPass();
+}
+
+bool DeferredCommandBuffer::CanHoistSharedMemoryUpload(uint32_t start, uint32_t length) const {
+  return shared_pass_offset_ != SIZE_MAX && shared_upload_hazards_.CanUpload(start, length);
+}
+
+void DeferredCommandBuffer::HoistSharedMemoryUpload(VkBuffer source, VkBuffer destination,
+                                                    uint32_t count, const VkBufferCopy* regions) {
+  assert_true(shared_pass_offset_ != SIZE_MAX);
+  auto& batch = shared_pass_uploads_[shared_pass_offset_];
+  if (batch.empty() || batch.back().source != source || batch.back().destination != destination) {
+    batch.push_back({source, destination, {}});
+  }
+  auto& copies = batch.back().regions;
+  copies.insert(copies.end(), regions, regions + count);
+  for (uint32_t i = 0; i < count; ++i) {
+    shared_upload_hazards_.Uploaded(uint32_t(regions[i].dstOffset), uint32_t(regions[i].size));
+  }
+}
+
+void DeferredCommandBuffer::ExecuteHoistedUploads(VkCommandBuffer command_buffer, size_t offset) {
+  const auto it = shared_pass_uploads_.find(offset);
+  if (it == shared_pass_uploads_.end()) return;
+  // Previous passes finish using shared memory before the transfer batch. All
+  // destinations in this batch are disjoint, and no draw in this pass writes
+  // shared memory. Make every transfer visible before starting the pass.
+  const auto& dfn = command_processor_.GetVulkanDevice()->functions();
+  VkBufferMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  barrier.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.buffer = it->second.front().destination;
+  barrier.size = VK_WHOLE_SIZE;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+  for (const auto& copy : it->second)
+    dfn.vkCmdCopyBuffer(command_buffer, copy.source, copy.destination,
+                        uint32_t(copy.regions.size()), copy.regions.data());
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 1, &barrier, 0, nullptr);
 }
 
