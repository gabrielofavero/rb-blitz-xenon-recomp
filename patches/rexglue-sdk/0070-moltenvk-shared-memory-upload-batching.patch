diff --git a/include/rex/graphics/vulkan/shared_memory_upload_hazards.h b/include/rex/graphics/vulkan/shared_memory_upload_hazards.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/shared_memory_upload_hazards.h
@@ -0,0 +1,97 @@
+// Copyright 2026. Released under the BSD license - see LICENSE in the root.
+#pragma once
+
+#include <bitset>
+#include <cstdint>
+
+namespace rex::graphics::vulkan {
+
+// Uploads may move before a recorded render pass only if earlier draws cannot
+// observe the new bytes. Track conservative 4 KiB pages within guest physical
+// memory, independent of the host's page size. Repeated writes stay ordered too.
+class SharedMemoryUploadHazards {
+ public:
+  static constexpr uint32_t kBufferSize = 512 * 1024 * 1024;
+  static constexpr uint32_t kPageSize = 4096;
+
+  void BeginPass() {
+    initialized_ = false;
+    has_draws_ = false;
+    tracked_draw_ = false;
+    read_only_ = false;
+  }
+
+  void PrepareDraw(bool read_only) {
+    if (!has_draws_ && read_only) {
+      if (!initialized_) {
+        reads_.reset();
+        writes_.reset();
+        initialized_ = true;
+      }
+      read_only_ = true;
+    } else if (!read_only) {
+      read_only_ = false;
+    }
+    tracked_draw_ = true;
+  }
+
+  void FinishDraw() {
+    if (!tracked_draw_)
+      read_only_ = false;
+    has_draws_ = true;
+    tracked_draw_ = false;
+  }
+
+  // An untracked helper command prevents later draws from enabling batching.
+  void Disable() {
+    read_only_ = false;
+    has_draws_ = true;
+  }
+
+  void Read(uint32_t start, uint32_t length) {
+    if (!length)
+      return;
+    if (!Valid(start, length)) {
+      Disable();
+      return;
+    }
+    Mark(reads_, start, length);
+  }
+
+  bool CanUpload(uint32_t start, uint32_t length) const {
+    if (!read_only_ || !Valid(start, length))
+      return false;
+    const uint32_t end = (start + length - 1) / kPageSize;
+    for (uint32_t page = start / kPageSize; page <= end; ++page) {
+      if (reads_[page] || writes_[page])
+        return false;
+    }
+    return true;
+  }
+
+  void Uploaded(uint32_t start, uint32_t length) {
+    if (!Valid(start, length)) {
+      Disable();
+      return;
+    }
+    Mark(writes_, start, length);
+  }
+
+ private:
+  using Pages = std::bitset<kBufferSize / kPageSize>;
+  static bool Valid(uint32_t start, uint32_t length) {
+    return length && uint64_t(start) + length <= kBufferSize;
+  }
+  static void Mark(Pages& pages, uint32_t start, uint32_t length) {
+    const uint32_t end = (start + length - 1) / kPageSize;
+    for (uint32_t page = start / kPageSize; page <= end; ++page)
+      pages.set(page);
+  }
+  Pages reads_, writes_;
+  bool initialized_ = false;
+  bool has_draws_ = false;
+  bool tracked_draw_ = false;
+  bool read_only_ = false;
+};
+
+}  // namespace rex::graphics::vulkan
