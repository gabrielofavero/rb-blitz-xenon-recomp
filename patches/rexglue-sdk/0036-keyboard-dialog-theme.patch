     if (ImGui::BeginPopupModal(title_.c_str(), nullptr, ImGuiWindowFlags_AlwaysAutoResize)) {
       if (description_.size()) {
         ImGui::TextWrapped("%s", description_.c_str());
@@ -407,6 +413,89 @@ class KeyboardInputDialog : public XamDialog {
   }
 
  private:
+  void DrawThemed(ImGuiIO& io, bool first_draw) {
+    const auto& theme = imgui_drawer()->style().keyboard;
+    // DisplaySize is already in DPI-independent units. Scale with the game,
+    // including short and ultrawide windows, and keep a margin at either edge.
+    const float scale = std::clamp(std::min(io.DisplaySize.y / 720.0f,
+                                          io.DisplaySize.x / 960.0f), 0.5f, 1.75f);
+    const float width = std::min(640.0f * scale, io.DisplaySize.x - 32.0f * scale);
+    ImGui::PushFont(theme.font, 22.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(32.0f * scale, 28.0f * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(14.0f * scale, 18.0f * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(16.0f * scale, 12.0f * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 4.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 1.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameBorderSize, 1.0f);
+    ImGui::PushStyleColor(ImGuiCol_PopupBg, theme.background);
+    ImGui::PushStyleColor(ImGuiCol_Border, theme.border);
+    ImGui::PushStyleColor(ImGuiCol_Text, theme.text);
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, theme.input);
+    ImGui::PushStyleColor(ImGuiCol_FrameBgHovered, theme.secondary);
+    ImGui::PushStyleColor(ImGuiCol_FrameBgActive, theme.input);
+    ImGui::PushStyleColor(ImGuiCol_Button, theme.accent);
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, theme.accent_hovered);
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive, theme.accent_active);
+    ImGui::PushStyleColor(ImGuiCol_TextSelectedBg, theme.accent_active);
+    ImGui::PushStyleColor(ImGuiCol_NavCursor, theme.accent_hovered);
+    ImGui::PushStyleColor(ImGuiCol_ModalWindowDimBg, theme.dim);
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f),
+                            ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(ImVec2(width, 0.0f));
+    const ImGuiWindowFlags flags = ImGuiWindowFlags_AlwaysAutoResize |
+                                   ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoMove |
+                                   ImGuiWindowFlags_NoSavedSettings;
+    if (ImGui::BeginPopupModal(title_.c_str(), nullptr, flags)) {
+      const ImVec2 pos = ImGui::GetWindowPos();
+      // The accent belongs to this modal's draw list and is clipped with it.
+      ImGui::GetWindowDrawList()->AddRectFilled(
+          ImVec2(pos.x + 8.0f * scale, pos.y),
+          ImVec2(pos.x + width - 8.0f * scale, pos.y + 4.0f * scale),
+          ImGui::GetColorU32(theme.accent));
+      ImGui::PushFont(theme.heading_font ? theme.heading_font : theme.font, 32.0f * scale);
+      ImGui::PushTextWrapPos(0.0f);
+      ImGui::TextUnformatted(title_.c_str());
+      ImGui::PopTextWrapPos();
+      ImGui::PopFont();
+      if (!description_.empty()) {
+        ImGui::PushStyleColor(ImGuiCol_Text, theme.muted_text);
+        ImGui::TextWrapped("%s", description_.c_str());
+        ImGui::PopStyleColor();
+      }
+      if (first_draw) {
+        ImGui::SetKeyboardFocusHere();
+      }
+      ImGui::SetNextItemWidth(-1.0f);
+      bool confirmed = ImGui::InputText("##body", text_buffer_.data(), text_buffer_.size(),
+                                        ImGuiInputTextFlags_EnterReturnsTrue);
+      const bool escaped = ImGui::IsKeyPressed(ImGuiKey_Escape, false);
+      const float button_width = (ImGui::GetContentRegionAvail().x - 14.0f * scale) * 0.5f;
+      confirmed |= ImGui::Button("Done", ImVec2(button_width, 48.0f * scale));
+      ImGui::SameLine();
+      ImGui::PushStyleColor(ImGuiCol_Button, theme.secondary);
+      const bool cancelled = ImGui::Button("Cancel", ImVec2(button_width, 48.0f * scale));
+      ImGui::PopStyleColor();
+      ImGui::PushFont(theme.font, 16.0f * scale);
+      ImGui::PushStyleColor(ImGuiCol_Text, theme.muted_text);
+      ImGui::TextUnformatted("Enter to confirm    /    Esc to cancel");
+      ImGui::PopStyleColor();
+      ImGui::PopFont();
+      if (confirmed || cancelled || escaped) {
+        cancelled_ = cancelled || escaped;
+        text_ = cancelled_ ? "" : text_buffer_.data();
+        ImGui::CloseCurrentPopup();
+        Close();
+      }
+      ImGui::EndPopup();
+    } else {
+      Close();
+    }
+    ImGui::PopStyleColor(12);
+    ImGui::PopStyleVar(7);
+    ImGui::PopFont();
+  }
+
   bool has_opened_ = false;
   std::string title_;
   std::string description_;
