diff --git a/include/rex/ui/style.h b/include/rex/ui/style.h
index fd80f0bf..9b65a33d 100644
--- a/include/rex/ui/style.h
+++ b/include/rex/ui/style.h
@@ -74,12 +74,31 @@ struct SettingsStyle {
   ImVec4 lifecycle_unknown{1.00f, 1.00f, 1.00f, 1.00f};
 };
 
+// Opt-in presentation for the existing XAM keyboard modal. Fonts belong to the
+// drawer's atlas and must be registered in OnConfigureFonts before enabling it.
+struct KeyboardInputStyle {
+  bool enabled = false;
+  ImFont* font = nullptr;
+  ImFont* heading_font = nullptr;
+  ImVec4 background{0.10f, 0.10f, 0.12f, 1.00f};
+  ImVec4 border{0.40f, 0.40f, 0.45f, 1.00f};
+  ImVec4 text{1.00f, 1.00f, 1.00f, 1.00f};
+  ImVec4 muted_text{0.75f, 0.75f, 0.80f, 1.00f};
+  ImVec4 input{0.05f, 0.05f, 0.07f, 1.00f};
+  ImVec4 accent{0.35f, 0.50f, 0.80f, 1.00f};
+  ImVec4 accent_hovered{0.45f, 0.60f, 0.90f, 1.00f};
+  ImVec4 accent_active{0.25f, 0.40f, 0.70f, 1.00f};
+  ImVec4 secondary{0.20f, 0.20f, 0.25f, 1.00f};
+  ImVec4 dim{0.02f, 0.02f, 0.04f, 0.55f};
+};
+
 struct Style {
   AchievementsStyle achievements;
   ToastStyle toast;
   ConsoleStyle console;
   DebugOverlayStyle debug;
   SettingsStyle settings;
+  KeyboardInputStyle keyboard;
 };
 
 }  // namespace rex::ui
