diff --git a/include/rex/graphics/d3d12/fence_sync.h b/include/rex/graphics/d3d12/fence_sync.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/d3d12/fence_sync.h
@@ -0,0 +1,34 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <winerror.h>
+
+namespace rex::graphics::d3d12 {
+
+// HRESULT success is nonnegative, and S_OK is zero. Never combine HRESULTs
+// with boolean && inside SUCCEEDED: that can skip arming the event yet wait.
+template <typename Arm, typename Wait>
+HRESULT ArmAndWaitForFence(Arm&& arm, Wait&& wait) {
+  const HRESULT armed = std::forward<Arm>(arm)();
+  return FAILED(armed) ? armed : std::forward<Wait>(wait)();
+}
+
+template <typename Signal, typename Arm, typename Wait>
+HRESULT SignalAndWaitForFence(Signal&& signal, Arm&& arm, Wait&& wait) {
+  const HRESULT signaled = std::forward<Signal>(signal)();
+  return FAILED(signaled) ? signaled : ArmAndWaitForFence(
+      std::forward<Arm>(arm), std::forward<Wait>(wait));
+}
+
+// Allocation/mapping proves neither that data was written nor GPU completion.
+// UINT64_MAX is D3D12's device-removal sentinel, not a completed submission.
+inline bool ReadbackCopyReady(uint64_t written_submission, uint64_t completed_submission,
+                              uint32_t written_size, uint32_t required_size) {
+  return written_submission != 0 && completed_submission != UINT64_MAX &&
+      written_submission <= completed_submission && required_size != 0 &&
+      required_size <= written_size;
+}
+
+}  // namespace rex::graphics::d3d12
