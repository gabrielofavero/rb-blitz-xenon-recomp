+void D3D12CommandProcessor::ReleaseReadbackSlot(ReadbackBuffer& readback, uint32_t index) {
+  if (readback.buffers[index]) {
+    if (readback.mapped_data[index]) readback.buffers[index]->Unmap(0, nullptr);
+    if (readback.submission_written[index] > submission_completed_) {
+      resources_for_deletion_.emplace_back(readback.submission_written[index], readback.buffers[index]);
+    } else {
+      readback.buffers[index]->Release();
+    }
+  }
+  readback.buffers[index] = nullptr;
+  readback.mapped_data[index] = nullptr;
+  readback.sizes[index] = 0;
+  readback.submission_written[index] = 0;
+  readback.written_size[index] = 0;
+}
