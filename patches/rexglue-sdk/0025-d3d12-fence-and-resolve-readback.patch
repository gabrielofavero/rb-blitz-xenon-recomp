+HRESULT D3D12CommandProcessor::WaitForFenceEvent(
+    ID3D12Fence* fence, uint64_t value, const char* scope) {
+  const ULONGLONG begin = GetTickCount64();
+  ULONGLONG next_report_ms = 1000;
+  while (true) {
+    // A timed poll also detects device removal and stale/shared event signals;
+    // a failed/removed device must not leave the command processor in INFINITE.
+    const DWORD waited = WaitForSingleObject(fence_completion_event_, 100);
+    if (waited == WAIT_FAILED) return HRESULT_FROM_WIN32(GetLastError());
+    const HRESULT removed = GetD3D12Provider().GetDevice()->GetDeviceRemovedReason();
+    if (FAILED(removed)) return removed;
+    const uint64_t completed = fence->GetCompletedValue();
+    if (completed == UINT64_MAX) return DXGI_ERROR_DEVICE_REMOVED;
+    if (completed >= value) return S_OK;
+    const ULONGLONG elapsed = GetTickCount64() - begin;
+    if (elapsed >= next_report_ms) {
+      REXGPU_WARN("D3D12 fence wait: scope={} target={} completed={} elapsed_ms={}",
+                  scope, value, completed, elapsed);
+      next_report_ms = elapsed + 5000;
+    }
+  }
+}
+
+void D3D12CommandProcessor::HandleFenceFailure(HRESULT result, const char* scope) {
+  device_removed_ = true;
+  REXGPU_ERROR("D3D12 fence synchronization failed: scope={} HRESULT={:08X}", scope,
+               uint32_t(result));
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  const HRESULT removed = device->GetDeviceRemovedReason();
+  if (FAILED(removed)) LogDeviceRemovalDiagnostics(device, removed);
+  if (graphics_system_) graphics_system_->OnHostGpuLossFromAnyThread(true);
+}
