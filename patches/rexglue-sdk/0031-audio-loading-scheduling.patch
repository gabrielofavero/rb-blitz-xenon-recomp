diff --git a/include/rex/audio/frame_queue.h b/include/rex/audio/frame_queue.h
new file mode 100644
--- /dev/null
+++ b/include/rex/audio/frame_queue.h
@@ -0,0 +1,35 @@
+// Fixed-capacity PCM handoff. No allocation or device calls while locked.
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+
+namespace rex::audio {
+template <size_t Capacity, size_t Samples>
+class AudioFrameQueue {
+ public:
+  bool Push(const float* samples, size_t* depth = nullptr) {
+    std::lock_guard lock(mutex_);
+    if (count_ == Capacity) return false;
+    std::memcpy(frames_[(head_ + count_) % Capacity].data(), samples, Samples * sizeof(float));
+    ++count_;
+    if (depth) *depth = count_;
+    return true;
+  }
+  bool Pop(float* samples) {
+    std::lock_guard lock(mutex_);
+    if (!count_) return false;
+    std::memcpy(samples, frames_[head_].data(), Samples * sizeof(float));
+    head_ = (head_ + 1) % Capacity;
+    --count_;
+    return true;
+  }
+  void Clear() { std::lock_guard lock(mutex_); head_ = count_ = 0; }
+ private:
+  static_assert(Capacity && Samples);
+  std::array<std::array<float, Samples>, Capacity> frames_;
+  size_t head_ = 0, count_ = 0;
+  std::mutex mutex_;
+};
+}
diff --git a/include/rex/graphics/preparation_budget.h b/include/rex/graphics/preparation_budget.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/preparation_budget.h
@@ -0,0 +1,10 @@
+// Background preparation leaves CPU time for audio and the guest/UI.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+namespace rex::graphics {
+inline size_t PreparationWorkerCount(size_t work, size_t processors) {
+  const size_t available = processors > 2 ? processors - 2 : 1;
+  return std::min(work, std::min(size_t(4), available));
+}
+}
