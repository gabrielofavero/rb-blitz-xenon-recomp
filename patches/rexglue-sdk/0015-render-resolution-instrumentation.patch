# Render-resolution instrumentation: swap-time totals (P2) and per-draw viewport/scissor (P4).
#
# P2 (docs/plans/in-game-settings-resolution-findings.md) added the swapdims/rtdims lines so
# a log shows what the guest presented and what the host allocated for it. P4 extends the
# same instrument with the per-draw host viewport and scissor, which is the evidence the
# plan asks P4 for: a 1920x1080 capture shows the extents the render path really used, not
# only the presented size.
#
# All of it is debug level and reports each *distinct* tuple exactly once per boot, so a
# normal boot stays silent and a --log_level=debug boot stays readable. No cvar, no
# behaviour change.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a53..c6284bbc 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -791,6 +791,34 @@ void D3D12CommandProcessor::SetViewport(const D3D12_VIEWPORT& viewport) {
     ff_viewport_ = viewport;
     deferred_command_list_.RSSetViewport(ff_viewport_);
     ff_viewport_update_needed_ = false;
+    // Exact-render-resolution investigation (P4): one line per *distinct* host viewport, at
+    // debug level only, so a capture shows the per-draw extents the render path really used
+    // rather than only the swap-time totals the swapdims line reports. A draw loop alternates
+    // between a handful of rectangles, so each tuple is reported exactly once per boot.
+    {
+      static float vp_seen[64][4];
+      static int vp_seen_count = 0;
+      const float vp_now[4] = {ff_viewport_.TopLeftX, ff_viewport_.TopLeftY, ff_viewport_.Width,
+                               ff_viewport_.Height};
+      bool vp_new = true;
+      for (int i = 0; i < vp_seen_count; ++i) {
+        if (vp_seen[i][0] == vp_now[0] && vp_seen[i][1] == vp_now[1] &&
+            vp_seen[i][2] == vp_now[2] && vp_seen[i][3] == vp_now[3]) {
+          vp_new = false;
+          break;
+        }
+      }
+      if (vp_new && vp_seen_count < 64) {
+        for (int k = 0; k < 4; ++k) {
+          vp_seen[vp_seen_count][k] = vp_now[k];
+        }
+        ++vp_seen_count;
+        REXLOG_DEBUG("viewport d3d12: x={} y={} w={} h={} draw_scale={}x{}", vp_now[0], vp_now[1],
+                     vp_now[2], vp_now[3],
+                     texture_cache_ != nullptr ? texture_cache_->draw_resolution_scale_x() : 0,
+                     texture_cache_ != nullptr ? texture_cache_->draw_resolution_scale_y() : 0);
+      }
+    }
   }
 }
 
@@ -803,6 +831,30 @@ void D3D12CommandProcessor::SetScissorRect(const D3D12_RECT& scissor_rect) {
     ff_scissor_ = scissor_rect;
     deferred_command_list_.RSSetScissorRect(ff_scissor_);
     ff_scissor_update_needed_ = false;
+    // Exact-render-resolution investigation (P4): the scissor the guest asked for, scaled by
+    // the same integer factor as the viewport. Each distinct rectangle once, debug level.
+    {
+      static int32_t sc_seen[64][4];
+      static int sc_seen_count = 0;
+      const int32_t sc_now[4] = {int32_t(ff_scissor_.left), int32_t(ff_scissor_.top),
+                                 int32_t(ff_scissor_.right), int32_t(ff_scissor_.bottom)};
+      bool sc_new = true;
+      for (int i = 0; i < sc_seen_count; ++i) {
+        if (sc_seen[i][0] == sc_now[0] && sc_seen[i][1] == sc_now[1] &&
+            sc_seen[i][2] == sc_now[2] && sc_seen[i][3] == sc_now[3]) {
+          sc_new = false;
+          break;
+        }
+      }
+      if (sc_new && sc_seen_count < 64) {
+        for (int k = 0; k < 4; ++k) {
+          sc_seen[sc_seen_count][k] = sc_now[k];
+        }
+        ++sc_seen_count;
+        REXLOG_DEBUG("scissor d3d12: l={} t={} r={} b={}", sc_now[0], sc_now[1], sc_now[2],
+                     sc_now[3]);
+      }
+    }
   }
 }
 
