+// from another thread and is consumed at the next texture request.
+void SetTextureOverrideProvider(TextureOverrideProvider* provider);
+void InvalidateTextureOverrides();
+TextureOverrideProvider* GetTextureOverrideProvider();
+uint64_t GetTextureOverrideGeneration();
 
