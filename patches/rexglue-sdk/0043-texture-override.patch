+// Optional host replacement for the base level of an unscaled 2D guest texture.
+// The provider sees the original guest bytes for identification, but returns
+// blocks in the host format's canonical (untiled, unswapped) order. A cache
+// accepts the result only when its backend uses the same block-compressed format.
+struct TextureOverrideRequest {
+  uint32_t width;
+  uint32_t height;
+  uint32_t mip_count;
+  xenos::TextureFormat format;
+  uint32_t guest_base_address;
+  uint32_t guest_base_size;
+  bool tiled;
+  xenos::Endian endianness;
+};
+
+class TextureOverrideProvider {
+ public:
+  virtual ~TextureOverrideProvider() = default;
+  // Called on the GPU thread once per frame. May call InvalidateTextureOverrides.
+  virtual void Poll() {}
+  // Set refresh_target when this texture may change on a generation bump,
+  // including when no replacement is currently active. Return a complete base
+  // mip chain (one BC3 block vector per level), or false to use the guest
+  // texture unchanged.
+  virtual bool GetOverride(const TextureOverrideRequest& request, const uint8_t* guest_data,
+                           std::vector<std::vector<uint8_t>>* host_levels,
+                           bool* refresh_target) = 0;
+};
+
+// The provider must outlive all texture caches using it. Calls to GetOverride
