@@ -0,0 +1,29 @@
+// Generic host texture override registration shared by the runtime and the
+// dynamically loaded GPU plugin. The provider is owned by the application.
+#include <atomic>
+
+#include <rex/graphics/pipeline/texture/cache.h>
+
+namespace rex::graphics {
+namespace {
+std::atomic<TextureOverrideProvider*> provider{nullptr};
+std::atomic<uint64_t> generation{1};
+}  // namespace
+
+void SetTextureOverrideProvider(TextureOverrideProvider* value) {
+  provider.store(value, std::memory_order_release);
+  InvalidateTextureOverrides();
+}
+
+TextureOverrideProvider* GetTextureOverrideProvider() {
+  return provider.load(std::memory_order_acquire);
+}
+
+void InvalidateTextureOverrides() {
+  generation.fetch_add(1, std::memory_order_acq_rel);
+}
+
+uint64_t GetTextureOverrideGeneration() {
+  return generation.load(std::memory_order_acquire);
+}
+}  // namespace rex::graphics
