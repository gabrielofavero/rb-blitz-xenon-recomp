+
+bool TextureCache::GetTextureOverride(Texture& texture,
+                                      std::vector<std::vector<uint8_t>>& host_levels) {
+  TextureOverrideProvider* provider = GetTextureOverrideProvider();
+  if (!provider) return false;
+  const TextureKey& key = texture.key();
+  if (key.scaled_resolve || key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.GetDepthOrArraySize() != 1 || key.format != xenos::TextureFormat::k_DXT4_5 ||
+      !key.base_page || !texture.GetGuestBaseSize()) {
+    return false;
+  }
+  const uint64_t address = uint64_t(key.base_page) << 12;
+  if (address + texture.GetGuestBaseSize() > SharedMemory::kBufferSize) return false;
+  const uint8_t* guest_data =
+      shared_memory().TranslatePhysicalForTextureOverride(uint32_t(address));
+  if (!guest_data) return false;
+  const TextureOverrideRequest request{key.GetWidth(), key.GetHeight(),
+                                       uint32_t(key.mip_max_level) + 1, key.format,
+                                       uint32_t(address), texture.GetGuestBaseSize(),
+                                       bool(key.tiled), key.endianness};
+  host_levels.clear();
+  bool refresh_target = false;
+  const bool replacement = provider->GetOverride(request, guest_data, &host_levels,
+                                                 &refresh_target);
+  if (replacement || refresh_target) texture.set_override_candidate();
+  if (!replacement) return false;
+  if (host_levels.size() != request.mip_count) {
+    REXGPU_WARN("Texture override returned {} levels for {}x{} BC3; expected {}",
+                host_levels.size(), request.width, request.height, request.mip_count);
+    host_levels.clear();
+    return false;
+  }
+  for (uint32_t level = 0; level < request.mip_count; ++level) {
+    const uint32_t width = std::max(1u, request.width >> level);
+    const uint32_t height = std::max(1u, request.height >> level);
+    const uint64_t expected_size =
+        uint64_t((width + 3) / 4) * ((height + 3) / 4) * 16;
+    if (host_levels[level].size() != expected_size) {
+      REXGPU_WARN("Texture override returned {} bytes for BC3 mip {} ({}x{}); expected {}",
+                  host_levels[level].size(), level, width, height, expected_size);
+      host_levels.clear();
+      return false;
+    }
+  }
+  return true;
 }
 
