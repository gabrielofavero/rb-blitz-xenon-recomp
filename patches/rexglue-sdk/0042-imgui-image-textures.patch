+ImTextureID ImGuiDrawer::CreateImageTexture(uint32_t width, uint32_t height,
+                                           const uint8_t* rgba) {
+  if (!immediate_drawer_ || !rgba || !width || !height || width > 512 || height > 512 ||
+      image_textures_.size() >= 8) return ImTextureID{};
+  auto texture = immediate_drawer_->CreateTexture(width, height,
+      ImmediateTextureFilter::kLinear, false, rgba);
+  if (!texture) return ImTextureID{};
+  auto id = reinterpret_cast<ImTextureID>(texture.get());
+  image_textures_.push_back(std::move(texture));
+  return id;
+}
+
+void ImGuiDrawer::ReleaseImageTexture(ImTextureID id, uint64_t generation) {
+  if (generation != image_texture_generation_) return;
+  std::erase_if(image_textures_, [id](const auto& texture) {
+    return reinterpret_cast<ImTextureID>(texture.get()) == id;
+  });
+}
