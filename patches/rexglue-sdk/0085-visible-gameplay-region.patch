new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/util/visible_region.h
@@ -0,0 +1,61 @@
+// Copyright 2026. Released under the BSD license - see LICENSE for details.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace rex::graphics::draw_util {
+// A title opts in for one identified main color/depth pair. Auxiliary targets,
+// resolves, memory exports and visibility queries must retain their full work.
+struct VisibleRegion {
+  bool enabled = false;
+  uint32_t source_width = 0, source_height = 0, visible_width = 0;
+  uint32_t guard_pixels = 32;
+  uint32_t color_info = UINT32_MAX, depth_info = UINT32_MAX;
+};
+struct VisibleRegionPass {
+  uint32_t color_info = 0, depth_info = 0, pitch = 0;
+  double width = 0, height = 0, left = 0, top = 0;
+  bool screen_space = false, side_effects = false;
+};
+struct VisibleRegionRect {
+  uint32_t x = 0, y = 0, width = 0, height = 0;
+};
+inline bool ClipToVisibleRegion(const VisibleRegion& region, const VisibleRegionPass& pass,
+                                VisibleRegionRect& rect) {
+  if (!region.enabled || !region.source_width || !region.source_height ||
+      !region.visible_width || region.visible_width >= region.source_width ||
+      region.source_width > 8192 || region.source_height > 8192 || pass.side_effects ||
+      pass.color_info != region.color_info || pass.depth_info != region.depth_info ||
+      rect.width < 64 || rect.height < 64) return false;
+  double origin = pass.left;
+  if (pass.screen_space) {
+    // Full-size screen-space composition only. Small clears, downsampling,
+    // shadow maps and scratch surfaces are not main-frame draws.
+    if (pass.pitch != region.source_width || rect.x != 0 || rect.y != 0 ||
+        rect.width != region.source_width || rect.height != region.source_height) return false;
+    origin = 0;
+  } else if (!std::isfinite(pass.width) || !std::isfinite(pass.height) ||
+             !std::isfinite(pass.left) || !std::isfinite(pass.top) ||
+             std::abs(pass.width - region.source_width) > .01 ||
+             std::abs(pass.height - region.source_height) > .01 ||
+             std::abs(pass.top) > .01 ||
+             origin > .01 || origin < -double(region.source_width) ||
+             !pass.pitch || pass.pitch > region.source_width) {
+    return false;
+  }
+  // Map the same full-frame crop into each tile's local coordinates. Round
+  // outward and preserve a source-pixel apron for filtering across the edge.
+  const double half_hidden = (region.source_width - region.visible_width) * .5;
+  const int64_t crop_left = int64_t(std::floor(origin + half_hidden - region.guard_pixels));
+  const int64_t crop_right = int64_t(std::ceil(origin + region.source_width - half_hidden +
+                                             region.guard_pixels));
+  const uint32_t old_x = rect.x, old_width = rect.width;
+  const int64_t left = std::max<int64_t>(rect.x, std::max<int64_t>(0, crop_left));
+  const int64_t right = std::min<int64_t>(uint64_t(rect.x) + rect.width,
+                                         std::max<int64_t>(0, crop_right));
+  rect.x = uint32_t(std::min<int64_t>(left, uint64_t(old_x) + old_width));
+  rect.width = uint32_t(std::max<int64_t>(0, right - rect.x));
+  return rect.x != old_x || rect.width != old_width;
+}
