diff --git a/src/graphics/pipeline/shader/spirv_builder.cpp b/src/graphics/pipeline/shader/spirv_builder.cpp
--- a/src/graphics/pipeline/shader/spirv_builder.cpp
+++ b/src/graphics/pipeline/shader/spirv_builder.cpp
@@ -13,6 +13,8 @@
 #include <utility>
 #include <vector>
 
+#include <SPIRV/GLSL.std.450.h>
+
 #include <rex/assert.h>
 #include <rex/graphics/pipeline/shader/spirv_builder.h>
 
@@ -48,6 +50,32 @@
 
 spv::Id SpirvBuilder::createNoContractionBinOp(spv::Op op_code, spv::Id type_id, spv::Id operand1,
                                                spv::Id operand2) {
+  if (no_contraction_fma_ext_inst_ != spv::NoResult &&
+      (op_code == spv::OpFAdd || op_code == spv::OpFSub || op_code == spv::OpFMul ||
+       op_code == spv::OpVectorTimesScalar)) {
+    auto splat = [this, type_id](spv::Id scalar) {
+      return isVectorType(type_id) ? smearScalar(spv::NoPrecision, scalar, type_id) : scalar;
+    };
+    spv::Id a, b, c;
+    if (op_code == spv::OpFAdd) {
+      a = splat(makeFloatConstant(1.0f));
+      b = operand1;
+      c = operand2;
+    } else if (op_code == spv::OpFSub) {
+      a = splat(makeFloatConstant(-1.0f));
+      b = operand2;
+      c = operand1;
+    } else {
+      a = operand1;
+      b = op_code == spv::OpVectorTimesScalar ? splat(operand2) : operand2;
+      // -0 preserves the sign of a zero product, including -0 * positive.
+      c = splat(makeFloatConstant(-0.0f));
+    }
+    spv::Id result =
+        createTriBuiltinCall(type_id, no_contraction_fma_ext_inst_, GLSLstd450Fma, a, b, c);
+    addDecoration(result, spv::DecorationNoContraction);
+    return result;
+  }
   spv::Id result = createBinOp(op_code, type_id, operand1, operand2);
   addDecoration(result, spv::DecorationNoContraction);
   return result;
