+    // still refused. Start empty, forget the file, and keep the layer usable -
+    // the portable recipes are unaffected.
+    REXGPU_WARN(
+        "vkCreatePipelineCache rejected the stored data ({}); starting from an empty cache",
+        int32_t(create_result));
+    native_store_.Forget(kNativeCacheEntryKey);
+    have_stored = false;
+    create_info = MakePipelineCacheCreateInfo(nullptr, 0);
+    create_result =
+        dfn.vkCreatePipelineCache(device, &create_info, nullptr, &device_pipeline_cache_);
+  }
+  if (create_result != VK_SUCCESS) {
+    REXGPU_WARN("vkCreatePipelineCache failed ({}); driver pipeline state will not be reused",
+                int32_t(create_result));
+    device_pipeline_cache_ = VK_NULL_HANDLE;
+    native_store_.Reset();
+    return;
+  }
+  native_loaded_data_ = have_stored ? stored : std::vector<uint8_t>();
