+  // Temp file in the same directory, then one rename: a reader sees the old file
+  // or the new one, never a prefix. The suffix carries a per-process value so
+  // two instances writing the same entry do not share a temp path.
+  static bool WriteFileAtomic(const std::filesystem::path& path,
+                              const std::vector<uint8_t>& data) {
+    static const uint64_t process_suffix = uint64_t(
+        std::chrono::steady_clock::now().time_since_epoch().count() & 0xFFFFFFFFu);
+    std::filesystem::path temp_path = path;
+    temp_path += ".tmp-" + std::to_string(process_suffix);
+    {
+      std::ofstream stream(temp_path, std::ios::binary | std::ios::trunc);
+      if (!stream) {
+        return false;
+      }
+      if (!data.empty()) {
+        stream.write(reinterpret_cast<const char*>(data.data()), std::streamsize(data.size()));
+      }
+      stream.flush();
+      if (!stream) {
+        stream.close();
+        std::error_code remove_error;
+        std::filesystem::remove(temp_path, remove_error);
+        return false;
+      }
+    }
+    std::error_code error;
+    std::filesystem::rename(temp_path, path, error);
+    if (error) {
+      std::error_code remove_error;
+      std::filesystem::remove(temp_path, remove_error);
+      return false;
+    }
+    return true;
+  }
+
+  mutable std::mutex mutex_;
+  bool enabled_ = false;
+  std::filesystem::path directory_;
+  NativePipelineCacheIdentity identity_;
+  uint64_t identity_hash_ = 0;
+  std::unordered_map<uint64_t, std::vector<uint8_t>> pending_;
+  Counters counters_;
+};
