+// The driver's own header inside a serialized cache. Checked before the data is
+// handed to vkCreatePipelineCache, because a driver may return an opaque failure
+// for foreign data and a clear refusal is more useful.
+bool ValidateVulkanCacheData(const std::vector<uint8_t>& data,
+                             const NativeAdapterIdentity& adapter) {
+  if (data.size() < sizeof(VkPipelineCacheHeaderVersionOne)) {
+    return false;
+  }
+  VkPipelineCacheHeaderVersionOne header;
+  std::memcpy(&header, data.data(), sizeof(header));
+  return header.headerVersion == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+         header.headerSize == sizeof(VkPipelineCacheHeaderVersionOne) &&
+         header.vendorID == adapter.vendor && header.deviceID == adapter.device &&
+         std::memcmp(header.pipelineCacheUUID, adapter.device_uuid, VK_UUID_SIZE) == 0;
+}
