+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/graphics_preparation.h>
+#include <rex/hash.h>
+
+// Native (driver-specific) pipeline results, persisted beside the portable
+// shader and pipeline recipe stores.
+//
+// The portable stores (.xsh guest shader microcode, .xpso pipeline recipes) are
+// shareable: they describe what the title asked for, not how a particular driver
+// turned it into a pipeline. A driver's own cached state - an ID3D12PipelineState
+// cached blob, or a serialized VkPipelineCache - is the opposite: it is only
+// meaningful for the exact adapter, driver and translator build that produced
+// it, and a driver is allowed to reject it outright.
+//
+// This header therefore keeps three separate things apart, because confusing any
+// two of them turns a cache into a correctness bug:
+//   * identity - adapter, driver, renderer path, translator and schema versions.
+//     A file written under a different identity is not reused, it is replaced.
+//   * entry key - the portable description hash. It names one pipeline, so the
+//     same key can be looked up in different identities without colliding.
+//   * payload - opaque driver bytes. Never interpreted, only length- and
+//     hash-checked, so a truncated or corrupted file is refused rather than fed
+//     to the driver.
+//
+// Writing is deliberately narrow: entries are staged in memory while pipelines
+// are created (which may happen during a song) and only reach the disk on an
+// explicit Flush - a bounded set of atomic per-entry replaces. The launch path
+// flushes when a preparation generation finishes and when the storage shuts
+// down, so no session writes native data while the guest is playing.
+
+namespace rex::graphics {
+
+// Bumped when the container below - or the meaning of an entry key - changes.
+// Old entry files then fail validation once and are replaced.
+inline constexpr uint32_t kNativePipelineCacheFormatVersion = 1;
+
+// 'RBNP' in the file, written and read little-endian (host order on all
+// supported targets, and the file never leaves the machine that wrote it).
+inline constexpr uint32_t kNativePipelineCacheEntryMagic = 0x504E4252u;
+
+// What a stored native result depends on outside the pipeline description
+// itself. Two adapters with the same vendor/device/driver can still produce
+// different driver state, so the driver build is part of the identity, not a
+// field of the entry.
+struct NativeAdapterIdentity {
+  uint32_t vendor = 0;
+  uint32_t device = 0;
+  uint32_t subsystem = 0;
+  uint32_t revision = 0;
+  // High half of the D3D12 UMD / driver version, or Vulkan's
+  // VkPhysicalDeviceProperties::driverVersion.
+  uint32_t driver_version = 0;
+  // D3D12 UMD low half (unused by Vulkan, left zero).
+  uint64_t driver_version_low = 0;
+  // Vulkan's pipelineCacheUUID - the driver's own word on which cached state is
+  // compatible. Zero for D3D12.
+  uint8_t device_uuid[16] = {};
+
+  bool operator==(const NativeAdapterIdentity& other) const {
+    return vendor == other.vendor && device == other.device && subsystem == other.subsystem &&
+           revision == other.revision && driver_version == other.driver_version &&
+           driver_version_low == other.driver_version_low &&
+           std::equal(std::begin(device_uuid), std::end(device_uuid),
+                      std::begin(other.device_uuid));
+  }
+  bool operator!=(const NativeAdapterIdentity& other) const { return !(*this == other); }
+};
+
+// Everything a native result is valid for. Stored in every entry file, so a
+// stale directory - a driver update, another rendering path, a new translator -
+// is refused entry by entry instead of being trusted by directory name.
+struct NativePipelineCacheIdentity {
+  GraphicsPreparationBackend backend = GraphicsPreparationBackend::kUnknown;
+  uint32_t title_id = 0;
+  // Backend-specific rendering path (D3D12 rtv/rov, Vulkan fbo/fsi). A pipeline
+  // created for one path's shaders is not valid for the other.
+  uint32_t render_path = 0;
+  uint32_t format_version = kNativePipelineCacheFormatVersion;
+  // PipelineDescription::kVersion of the backend.
+  uint32_t pipeline_schema_version = 0;
+  // DxbcShaderTranslator::Modification::kVersion / the SPIR-V translator's
+  // equivalent: the bytecode the driver cached came from that translator build.
+  uint32_t translator_version = 0;
+  NativeAdapterIdentity adapter;
+
+  uint64_t Hash() const {
+    struct Canonical {
+      uint32_t backend;
+      uint32_t title_id;
+      uint32_t render_path;
+      uint32_t format_version;
+      uint32_t pipeline_schema_version;
+      uint32_t translator_version;
+      NativeAdapterIdentity adapter;
+    } canonical{};
+    canonical.backend = uint32_t(backend);
+    canonical.title_id = title_id;
+    canonical.render_path = render_path;
+    canonical.format_version = format_version;
+    canonical.pipeline_schema_version = pipeline_schema_version;
+    canonical.translator_version = translator_version;
+    canonical.adapter = adapter;
+    return XXH3_64bits(&canonical, sizeof(canonical));
+  }
+
+  bool SameAs(const NativePipelineCacheIdentity& other) const {
+    return format_version == other.format_version && backend == other.backend &&
+           title_id == other.title_id && render_path == other.render_path &&
+           pipeline_schema_version == other.pipeline_schema_version &&
+           translator_version == other.translator_version && adapter == other.adapter;
+  }
+};
+
+// One entry file: this header followed by `payload_size` opaque bytes.
+struct NativePipelineCacheEntryHeader {
+  uint32_t magic = kNativePipelineCacheEntryMagic;
+  uint16_t format_version = uint16_t(kNativePipelineCacheFormatVersion);
+  uint16_t reserved = 0;
+  uint64_t identity_hash = 0;
+  uint64_t key = 0;
+  uint64_t payload_hash = 0;
+  uint32_t payload_size = 0;
+  uint32_t reserved2 = 0;
+};
+
+// A bounded, thread-safe store of native results for one identity.
+//
+// The store is configured once, before any creation thread uses it, and is then
+// read from any thread (`Load`). Staging may also happen from creation workers;
+// `Flush` is the owner's call and is the only writer of entry files.
+class NativePipelineCacheStore {
+ public:
+  // A single driver blob larger than this is not persisted: D3D12 cached blobs
+  // and a whole Vulkan pipeline cache are in the kilobytes-to-low-megabytes
+  // range, so this is a corruption guard rather than a policy.
+  static constexpr size_t kMaxEntryBytes = 64u * 1024u * 1024u;
+  // Upper bounds on what one session may stage between flushes, and on the
+  // directory the store will keep growing. Together they keep a cache from
+  // becoming an unbounded write or a disk filler.
+  static constexpr size_t kMaxPendingBytes = 128u * 1024u * 1024u;
+  static constexpr size_t kMaxPendingEntries = 8192;
+  static constexpr size_t kMaxDirectoryBytes = 1024u * 1024u * 1024u;
+  static constexpr size_t kMaxDirectoryEntries = 32768;
+
+  struct Counters {
+    uint64_t loaded = 0;
+    uint64_t missing = 0;
+    uint64_t rejected = 0;
+    uint64_t staged = 0;
+    uint64_t written = 0;
+    uint64_t forgotten = 0;
+    uint64_t refused = 0;
+    uint64_t write_failures = 0;
+    uint64_t bytes_read = 0;
+    uint64_t bytes_written = 0;
+    uint64_t pending_entries = 0;
+    uint64_t pending_bytes = 0;
+    uint64_t directory_entries = 0;
+    uint64_t directory_bytes = 0;
+  };
+
+  NativePipelineCacheStore() = default;
+  NativePipelineCacheStore(const NativePipelineCacheStore&) = delete;
+  NativePipelineCacheStore& operator=(const NativePipelineCacheStore&) = delete;
+
+  // Prepares `directory` for this identity and measures what is already there.
+  // Returns false when the directory cannot be created or the identity is not
+  // usable; the store then stays disabled and every operation is a no-op.
+  bool Configure(const std::filesystem::path& directory,
+                 const NativePipelineCacheIdentity& identity) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (directory.empty()) {
+      enabled_ = false;
+      return false;
+    }
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    if (!std::filesystem::is_directory(directory, error)) {
+      enabled_ = false;
+      return false;
+    }
+    directory_ = directory;
+    identity_ = identity;
+    identity_hash_ = identity.Hash();
+    enabled_ = true;
+    pending_.clear();
+    counters_ = Counters();
+    // A one-shot walk, bounded, so a directory left behind by another machine's
+    // driver cannot make the store start over its size limit.
+    size_t inspected = 0;
+    std::error_code iterate_error;
+    for (std::filesystem::directory_iterator it(directory, iterate_error), end;
+         !iterate_error && it != end; it.increment(iterate_error)) {
+      if (inspected++ >= kMaxDirectoryEntries * 2) {
+        break;
+      }
+      std::error_code entry_error;
+      if (!it->is_regular_file(entry_error) || entry_error) {
+        continue;
+      }
+      std::error_code size_error;
+      const std::uintmax_t size = it->file_size(size_error);
+      if (size_error) {
+        continue;
+      }
+      ++counters_.directory_entries;
+      counters_.directory_bytes += uint64_t(size);
+    }
+    return true;
+  }
+
+  void Reset() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    enabled_ = false;
+    directory_.clear();
+    identity_ = NativePipelineCacheIdentity();
+    identity_hash_ = 0;
+    pending_.clear();
+    counters_ = Counters();
+  }
+
+  bool enabled() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return enabled_;
+  }
+
+  NativePipelineCacheIdentity identity() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return identity_;
+  }
+
+  std::filesystem::path directory() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return directory_;
+  }
+
+  // Reads `key`'s entry. Returns false when there is no usable entry - missing,
+  // corrupted, of another identity, or oversized. A rejected file is left in
+  // place for Forget(); it is never handed to a driver.
+  bool Load(uint64_t key, std::vector<uint8_t>& data_out) {
+    std::filesystem::path path;
+    uint64_t identity_hash;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!enabled_) {
+        return false;
+      }
+      path = EntryPath(key);
+      identity_hash = identity_hash_;
+    }
+    // The read happens outside the lock: a creation worker reading an entry must
+    // not block the owner thread's staging or another worker's read. Entry files
+    // are only ever replaced atomically, so a concurrent replace yields either
+    // the old or the new complete file.
+    std::vector<uint8_t> file_data;
+    if (!ReadWholeFile(path, kMaxEntryBytes + sizeof(NativePipelineCacheEntryHeader),
+                       file_data)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (enabled_) {
+        ++counters_.missing;
+      }
+      return false;
+    }
+    std::vector<uint8_t> payload;
+    if (!DecodeEntry(file_data, identity_hash, key, payload)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (enabled_) {
+        ++counters_.rejected;
+      }
+      return false;
+    }
+    data_out = std::move(payload);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (enabled_) {
+        ++counters_.loaded;
+        counters_.bytes_read += data_out.size();
+      }
+    }
+    return true;
+  }
+
+  // Remembers the bytes for `key` to be written by the next Flush(). Bounded by
+  // kMaxPendingBytes/kMaxPendingEntries; a refusal is counted, never silently
+  // dropped in a way that could grow without limit.
+  bool Stage(uint64_t key, const void* data, size_t size) {
+    if (!data || !size || size > kMaxEntryBytes) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (enabled_) {
+        ++counters_.refused;
+      }
+      return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!enabled_) {
+      return false;
+    }
+    auto existing = pending_.find(key);
+    const size_t existing_size = existing != pending_.end() ? existing->second.size() : 0;
+    if (counters_.pending_entries - (existing != pending_.end() ? 1 : 0) >= kMaxPendingEntries ||
+        counters_.pending_bytes - existing_size + size > kMaxPendingBytes) {
+      ++counters_.refused;
+      return false;
+    }
+    std::vector<uint8_t> bytes(static_cast<const uint8_t*>(data),
+                               static_cast<const uint8_t*>(data) + size);
+    if (existing == pending_.end()) {
+      pending_.emplace(key, std::move(bytes));
+      ++counters_.pending_entries;
+    } else {
+      existing->second = std::move(bytes);
+    }
+    counters_.pending_bytes = counters_.pending_bytes - existing_size + size;
+    ++counters_.staged;
+    return true;
+  }
+
+  // Writes every staged entry, atomically replacing its file. Returns how many
+  // were written. Staging during the flush is not lost: it stays pending.
+  size_t Flush() {
+    std::unordered_map<uint64_t, std::vector<uint8_t>> pending;
+    uint64_t identity_hash;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!enabled_ || pending_.empty()) {
+        return 0;
+      }
+      pending.swap(pending_);
+      identity_hash = identity_hash_;
+      counters_.pending_entries = 0;
+      counters_.pending_bytes = 0;
+    }
+    size_t written = 0;
+    for (auto& entry : pending) {
+      NativePipelineCacheEntryHeader header;
+      header.identity_hash = identity_hash;
+      header.key = entry.first;
+      header.payload_size = uint32_t(entry.second.size());
+      header.payload_hash = XXH3_64bits(entry.second.data(), entry.second.size());
+      std::vector<uint8_t> file_data(sizeof(header) + entry.second.size());
+      std::memcpy(file_data.data(), &header, sizeof(header));
+      if (!entry.second.empty()) {
+        std::memcpy(file_data.data() + sizeof(header), entry.second.data(), entry.second.size());
+      }
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!enabled_) {
+        continue;
+      }
+      const std::filesystem::path path = EntryPath(entry.first);
+      std::error_code size_error;
+      const std::uintmax_t previous_size = std::filesystem::file_size(path, size_error);
+      const bool replacing = !size_error;
+      if (counters_.directory_bytes + file_data.size() > kMaxDirectoryBytes ||
+          (!replacing && counters_.directory_entries + 1 > kMaxDirectoryEntries)) {
+        ++counters_.refused;
+        continue;
+      }
+      if (WriteFileAtomic(path, file_data)) {
+        ++counters_.written;
+        counters_.bytes_written += file_data.size();
+        if (replacing) {
+          counters_.directory_bytes =
+              counters_.directory_bytes > uint64_t(previous_size)
+                  ? counters_.directory_bytes - uint64_t(previous_size) + file_data.size()
+                  : file_data.size();
+        } else {
+          ++counters_.directory_entries;
+          counters_.directory_bytes += file_data.size();
+        }
+        ++written;
+      } else {
+        ++counters_.write_failures;
+      }
+    }
+    return written;
+  }
+
+  // Deletes the stored entry. Called when a driver rejects the blob, so the next
+  // creation does not feed the same bytes back to it.
+  bool Forget(uint64_t key) {
+    std::filesystem::path path;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!enabled_) {
+        return false;
+      }
+      path = EntryPath(key);
+    }
+    std::error_code size_error;
+    const std::uintmax_t removed_size = std::filesystem::file_size(path, size_error);
+    std::error_code error;
+    const bool removed = std::filesystem::remove(path, error);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (enabled_ && removed) {
+        ++counters_.forgotten;
+        if (!size_error) {
+          if (counters_.directory_entries) {
+            --counters_.directory_entries;
+          }
+          counters_.directory_bytes =
+              counters_.directory_bytes > uint64_t(removed_size)
+                  ? counters_.directory_bytes - uint64_t(removed_size)
+                  : 0;
+        }
+      }
+    }
+    return removed;
+  }
+
+  // True when an entry file exists for `key`, whether or not it is valid.
+  bool Has(uint64_t key) const {
+    std::filesystem::path path;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!enabled_) {
+        return false;
+      }
+      path = EntryPath(key);
+    }
+    std::error_code error;
+    return std::filesystem::is_regular_file(path, error);
+  }
+
+  Counters counters() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return counters_;
+  }
+
+  // One line for a boot log: what was reused, what was written, and where.
+  std::string Summary() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!enabled_) {
+      return "native pipeline cache disabled";
+    }
+    return std::string(GraphicsPreparationBackendName(identity_.backend)) + " native pipeline " +
+           "cache: " + std::to_string(counters_.loaded) + " reused, " +
+           std::to_string(counters_.missing) + " absent, " +
+           std::to_string(counters_.rejected) + " rejected, " +
+           std::to_string(counters_.written) + " written, " +
+           std::to_string(counters_.refused) + " refused, " +
+           std::to_string(counters_.write_failures) + " write failure(s), " +
+           std::to_string(counters_.bytes_written) + " byte(s) written, " +
+           std::to_string(counters_.directory_entries) + " entry file(s) / " +
+           std::to_string(counters_.directory_bytes) + " byte(s) on disk";
+  }
+
+  // Validates one entry file. Exposed for tests: a driver blob is opaque, so the
+  // only thing that can be checked is that this is a complete entry for the
+  // identity and key it claims.
+  static bool DecodeEntry(const std::vector<uint8_t>& file_data, uint64_t identity_hash,
+                          uint64_t key, std::vector<uint8_t>& payload_out) {
+    if (file_data.size() < sizeof(NativePipelineCacheEntryHeader)) {
+      return false;
+    }
+    NativePipelineCacheEntryHeader header;
+    std::memcpy(&header, file_data.data(), sizeof(header));
+    if (header.magic != kNativePipelineCacheEntryMagic ||
+        header.format_version != uint16_t(kNativePipelineCacheFormatVersion) ||
+        header.identity_hash != identity_hash || header.key != key ||
+        header.payload_size > kMaxEntryBytes ||
+        uint64_t(header.payload_size) + sizeof(header) != uint64_t(file_data.size())) {
+      return false;
+    }
+    const uint8_t* payload = file_data.data() + sizeof(header);
+    if (header.payload_size &&
+        XXH3_64bits(payload, header.payload_size) != header.payload_hash) {
+      return false;
+    }
+    payload_out.assign(payload, payload + header.payload_size);
+    return true;
+  }
+
+  // The format a caller has to produce to be reused. Exposed for tests.
+  static std::vector<uint8_t> EncodeEntry(uint64_t identity_hash, uint64_t key, const void* data,
+                                          size_t size) {
+    NativePipelineCacheEntryHeader header;
+    header.identity_hash = identity_hash;
+    header.key = key;
+    header.payload_size = uint32_t(size);
+    header.payload_hash = size ? XXH3_64bits(data, size) : 0;
+    std::vector<uint8_t> file_data(sizeof(header) + size);
+    std::memcpy(file_data.data(), &header, sizeof(header));
+    if (size) {
+      std::memcpy(file_data.data() + sizeof(header), data, size);
+    }
+    return file_data;
+  }
+
+ private:
+  std::filesystem::path EntryPath(uint64_t key) const {
+    return directory_ / (FormatKey(key) + ".pso");
+  }
+
+  static std::string FormatKey(uint64_t key) {
+    static const char kHex[] = "0123456789ABCDEF";
+    std::string text(16, '0');
+    for (size_t i = 0; i < 16; ++i) {
+      text[15 - i] = kHex[(key >> (i * 4)) & 0xF];
+    }
+    return text;
+  }
+
+  static bool ReadWholeFile(const std::filesystem::path& path, size_t max_size,
+                            std::vector<uint8_t>& data_out) {
+    std::error_code error;
+    const std::uintmax_t size = std::filesystem::file_size(path, error);
+    if (error || size == 0 || size > max_size) {
+      return false;
+    }
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+      return false;
+    }
+    data_out.resize(size_t(size));
+    stream.read(reinterpret_cast<char*>(data_out.data()), std::streamsize(size));
+    if (!stream) {
+      data_out.clear();
+      return false;
+    }
+    return true;
+  }
