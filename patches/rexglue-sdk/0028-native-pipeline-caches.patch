+void VulkanPipelineCache::SaveNativeCache(const char* reason) {
+  if (!native_store_.enabled() || device_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  // Pipeline creation with the cache may run on any thread, but serializing it
+  // must not overlap a creation. New gameplay creation is enqueued only by this
+  // thread, so "nothing queued and no worker busy" is the safe window: no
+  // creation can start until this function returns.
+  if (IsCreatingPipelines()) {
+    REXGPU_INFO(
+        "Native pipeline cache: serialization deferred {}, pipelines are still being created",
+        reason);
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  if (!vulkan_device) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const NativePipelineCacheIdentity identity = native_store_.identity();
+
+  // Concurrent-instance policy: a second instance may have written newer data
+  // since this one loaded. Merge it instead of overwriting it, so the last
+  // writer does not discard the other run's pipelines.
+  {
+    std::vector<uint8_t> on_disk;
+    if (native_store_.Load(kNativeCacheEntryKey, on_disk) && on_disk != native_loaded_data_ &&
+        ValidateVulkanCacheData(on_disk, identity.adapter)) {
+      VkPipelineCacheCreateInfo merge_create_info =
+          MakePipelineCacheCreateInfo(on_disk.data(), on_disk.size());
+      VkPipelineCache merge_source = VK_NULL_HANDLE;
+      if (dfn.vkCreatePipelineCache(device, &merge_create_info, nullptr, &merge_source) ==
+          VK_SUCCESS) {
+        if (dfn.vkMergePipelineCaches(device, device_pipeline_cache_, 1, &merge_source) ==
+            VK_SUCCESS) {
+          native_loaded_data_ = on_disk;
+        }
+        dfn.vkDestroyPipelineCache(device, merge_source, nullptr);
+      }
+    }
+  }
+
+  size_t data_size = 0;
+  VkResult result = dfn.vkGetPipelineCacheData(device, device_pipeline_cache_, &data_size, nullptr);
+  if (result == VK_SUCCESS && data_size) {
+    std::vector<uint8_t> data(data_size);
+    result = dfn.vkGetPipelineCacheData(device, device_pipeline_cache_, &data_size, data.data());
+    if (result == VK_INCOMPLETE || (result == VK_SUCCESS && data_size > data.size())) {
+      // The cache grew between the size query and the read; ask once more with
+      // the size the call wrote back.
+      data.resize(data_size);
+      result = dfn.vkGetPipelineCacheData(device, device_pipeline_cache_, &data_size, data.data());
+    }
+    if (result == VK_SUCCESS) {
+      data.resize(data_size);
+      if (ValidateVulkanCacheData(data, identity.adapter) &&
+          native_store_.Stage(kNativeCacheEntryKey, data.data(), data.size())) {
+        native_loaded_data_ = data;
+      } else {
+        REXGPU_WARN("Native pipeline cache: refusing to store unusable serialized data");
+      }
+    } else {
+      REXGPU_WARN("vkGetPipelineCacheData failed ({})", int32_t(result));
+    }
+  }
+  const size_t written = native_store_.Flush();
+  if (written) {
+    REXGPU_INFO("Native pipeline cache: serialized {} byte(s) {} ({})", native_loaded_data_.size(),
+                reason, native_store_.Summary());
+  }
+}
