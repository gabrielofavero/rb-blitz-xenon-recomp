+void VulkanPipelineCache::CloseNativeCache() {
+  if (device_pipeline_cache_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+    if (vulkan_device) {
+      // Stop handing the handle to new creations first: a creation that starts
+      // after this point falls back to VK_NULL_HANDLE, which is always valid.
+      if (vulkan_device->shared_pipeline_cache() == device_pipeline_cache_) {
+        vulkan_device->set_shared_pipeline_cache(VK_NULL_HANDLE);
+      }
+      if (IsCreatingPipelines()) {
+        // A creation in flight is still using the cache - destroying it would be
+        // a use after free. That only happens when the storage is re-initialized
+        // while the guest is drawing; abandoning the handle is the safe answer.
+        REXGPU_WARN(
+            "Native pipeline cache: not destroyed, pipelines are still being created; this "
+            "boot's serialized data is abandoned");
+      } else {
+        vulkan_device->functions().vkDestroyPipelineCache(vulkan_device->device(),
+                                                          device_pipeline_cache_, nullptr);
+      }
+    }
+    device_pipeline_cache_ = VK_NULL_HANDLE;
+  }
+  native_loaded_data_.clear();
+  native_store_.Reset();
+}
