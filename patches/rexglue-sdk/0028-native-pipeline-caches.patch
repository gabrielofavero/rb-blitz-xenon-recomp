+void VulkanPipelineCache::OpenNativeCache(const std::filesystem::path& shader_local_root,
+                                          uint32_t title_id,
+                                          bool edram_fragment_shader_interlock) {
+  CloseNativeCache();
+  if (!REXCVAR_GET(native_pipeline_cache)) {
+    // Explicitly a diagnostic configuration: the shareable recipes still load,
+    // only the driver's own state is neither read nor written.
+    REXGPU_INFO("Native pipeline cache is off (native_pipeline_cache=false)");
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  if (!vulkan_device) {
+    return;
+  }
+  NativePipelineCacheIdentity identity;
+  identity.backend = GraphicsPreparationBackend::kVulkan;
+  identity.title_id = title_id;
+  identity.render_path = edram_fragment_shader_interlock ? 1u : 0u;
+  identity.pipeline_schema_version = PipelineDescription::kVersion;
+  identity.translator_version = SpirvShaderTranslator::Modification::kVersion;
+  FillNativeAdapterIdentity(vulkan_device, identity.adapter);
+  // One directory per rendering path: the fragment shader interlock path links
+  // different SPIR-V, so its cached state is not a substitute for the other's.
+  const std::filesystem::path directory =
+      shader_local_root /
+      fmt::format("{:08X}.{}.vk", title_id, edram_fragment_shader_interlock ? "fsi" : "fbo");
+  if (!native_store_.Configure(directory, identity)) {
+    REXGPU_WARN(
+        "Could not prepare the native pipeline cache directory {}, driver pipeline state will "
+        "not be reused",
+        rex::path_to_utf8(directory));
+    return;
+  }
+
+  std::vector<uint8_t> stored;
+  bool have_stored = native_store_.Load(kNativeCacheEntryKey, stored) &&
+                     ValidateVulkanCacheData(stored, identity.adapter);
+  if (!have_stored && native_store_.Has(kNativeCacheEntryKey)) {
+    // Present but not usable here: another adapter, another driver build, a
+    // damaged file. Drop it so this boot replaces it instead of failing on it
+    // again next time.
+    native_store_.Forget(kNativeCacheEntryKey);
+  }
+
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkPipelineCacheCreateInfo create_info = MakePipelineCacheCreateInfo(
+      have_stored ? stored.data() : nullptr, have_stored ? stored.size() : 0);
+  VkResult create_result =
