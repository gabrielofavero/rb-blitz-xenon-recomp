+  // pipelines created after this point are covered as well as guest ones.
+  vulkan_device->set_shared_pipeline_cache(device_pipeline_cache_);
+  const NativeAdapterIdentity& adapter = identity.adapter;
+  REXGPU_INFO("Native pipeline cache: adapter {:04X}:{:04X} driver 0x{:08X}, {} byte(s) {}",
+              adapter.vendor, adapter.device, adapter.driver_version,
+              have_stored ? native_loaded_data_.size() : size_t(0),
+              have_stored ? "restored" : "not restored (nothing usable on disk yet)");
+}
