+/// The same file reached through a different spelling - relative or absolute, '\'
+/// or '/', with or without '.' segments - must produce the same sort key, or the
+/// fingerprint depends on how the caller happened to spell the path.
+std::filesystem::path InputSortKey(const std::filesystem::path& path) {
+  std::error_code ec;
+  auto canonical = std::filesystem::weakly_canonical(path, ec);
+  if (!ec && !canonical.empty())
+    return canonical;
+  ec.clear();
+  auto absolute = std::filesystem::absolute(path, ec);
+  if (!ec && !absolute.empty())
+    return absolute;
+  return path.lexically_normal();
+}
