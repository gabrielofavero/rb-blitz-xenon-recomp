+// True when the instruction before `addr` never falls through - a return, an
+// indirect branch, or an unconditional branch - so `addr` cannot be the continuation
+// of the block in front of it and is a real entry, not the middle of one.
+bool followsTerminator(const BinaryView& binary, uint32_t addr) {
+  if (addr < 4)
+    return false;
+
+  const uint8_t* data = binary.translate(addr - 4);
+  if (!data)
+    return false;
+
+  uint32_t raw = load_and_swap<uint32_t>(data);
+  auto decoded = decode_instruction(addr - 4, raw);
+
+  if (decoded.is_return() || (decoded.is_indirect_branch() && !decoded.is_conditional()))
+    return true;
+
+  // An unconditional branch: opcode 18 without the link bit. `bl` sets LR and falls
+  // through, so a call in front of `addr` is not what makes it an entry.
+  return decoded.opcode == Opcode::b && (raw & 1) == 0;
