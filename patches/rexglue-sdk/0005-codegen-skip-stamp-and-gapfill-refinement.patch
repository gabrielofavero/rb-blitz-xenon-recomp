+size_t FunctionNode::rewindEdgesTo(const FunctionNode* target, uint32_t targetBase) {
+  size_t rewound = 0;
+  const auto rewind = [&](std::vector<CallEdge>& edges, bool isCall) {
+    std::erase_if(edges, [&](const CallEdge& edge) {
+      if (edge.target.asFunction() != target) {
+        return false;
+      }
+      addUnresolvedJump(edge.site, targetBase, isCall, /*conditional=*/false);
+      ++rewound;
+      return true;
+    });
+  };
+  rewind(calls_, true);
+  rewind(tailCalls_, false);
+  return rewound;
+}
