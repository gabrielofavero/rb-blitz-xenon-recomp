+// A merged view of the address ranges the graph already claims - one span per function,
+// over its extent - used to find the words inside a code region that belong to no
+// function at all.
+class CoveredSpans {
+ public:
+  void add(uint32_t start, uint32_t end) {
+    if (end > start)
+      spans_.emplace_back(start, end);
+  }
+
+  void seal() {
+    std::sort(spans_.begin(), spans_.end());
+    size_t kept = 0;
+    for (const auto& span : spans_) {
+      if (kept > 0 && span.first <= spans_[kept - 1].second) {
+        spans_[kept - 1].second = std::max(spans_[kept - 1].second, span.second);
+      } else {
+        spans_[kept++] = span;
+      }
+    }
+    spans_.resize(kept);
+  }
+
+  // A walk may revisit an address (an overlap between a segment and a block it
+  // contains), so the lookup is a plain binary search rather than a moving cursor.
+  bool contains(uint32_t addr) const {
+    auto it =
+        std::upper_bound(spans_.begin(), spans_.end(), addr,
+                         [](uint32_t value, const std::pair<uint32_t, uint32_t>& span) {
+                           return value < span.first;
+                         });
+    if (it == spans_.begin())
+      return false;
+    --it;
+    return addr < it->second;
+  }
+
+ private:
+  std::vector<std::pair<uint32_t, uint32_t>> spans_;
+};
