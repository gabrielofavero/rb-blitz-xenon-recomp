+u32 XamAlloc_entry(u32 flags, u32 size, mapped_u32 out_ptr) {
+  // The first parameter is a XAM heap-flag word, not an unknown. Xenia Canary
+  // spells it `flags` in its XamAllocImpl, identifies bit 0x00100000
+  // ("HEAP_ZERO_memory used unless this flag") as the only bit it knows about,
+  // and reports the top four bits as selecting one of several heaps; its
+  // implementation allocates from the system heap and does nothing about the
+  // flags either. This one does the same, so there is nothing to enforce and
+  // nothing to reject: on Rock Band Blitz the call that aborted a Debug build
+  // carried `flags=0x10000000` (top nibble 1, zero bit clear) while a Release
+  // build - where the assert is compiled out - ran the same route unchecked.
   // Allocate from the heap. Not sure why XAM does this specially, perhaps
   // it keeps stuff in a separate heap?
   uint32_t ptr = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
