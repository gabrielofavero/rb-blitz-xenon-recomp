+void ReXApp::HandleApplicationActivation(bool active) {
+  auto* graphics = runtime_ ? runtime_->graphics_system() : config_.graphics.get();
+  auto* audio = runtime_ ? runtime_->audio_system() : nullptr;
+  if (!active) {
+    // Audio callbacks execute guest code. Let them quiesce while the guest and
+    // GPU can still make progress, before either can wait on the lifecycle gate.
+    if (audio) audio->Pause();
+    OnApplicationActiveChanged(false);
+    chrono::Clock::SetGuestPaused(true);
+    if (graphics) graphics->SetApplicationActive(false);
+    REXLOG_INFO("ios_lifecycle: application suspended; guest clock and audio paused");
+  } else {
+    chrono::Clock::SetGuestPaused(false);
+    if (graphics) graphics->SetApplicationActive(true);
+    if (audio) audio->Resume();
+    OnApplicationActiveChanged(true);
+    if (window_) window_->RequestPaint();
+    REXLOG_INFO("ios_lifecycle: application active; GPU, audio and guest clock resumed");
+  }
+}
+
 bool ReXApp::OnInitialize() {
+#if REX_PLATFORM_IOS
+  static_cast<ui::SDLWindowedAppContext&>(app_context()).SetApplicationActiveCallback(
+      [this](bool active) { HandleApplicationActivation(active); });
+#endif
   if (!SetupEnvironment())
     return false;
   if (!SetupPresentation())
@@ -597,6 +628,10 @@
 }
 
