new file mode 100644
--- /dev/null
+++ b/include/rex/ui/vulkan/queue_lifecycle.h
@@ -0,0 +1,64 @@
+#pragma once
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <utility>
+
+namespace rex::ui::vulkan {
+// Stop new queue operations, then drain operations that already own a permit.
+// GPU completion is awaited only after host queue calls have returned, so
+// asynchronous Metal submission cannot escape into the background transition.
+class QueueLifecycle {
+ public:
+  using Pump = bool (*)();
+  class Permit {
+   public:
+    explicit Permit(QueueLifecycle* owner) : owner_(owner) {
+      if (!owner_) return;
+      std::unique_lock lock(owner_->mutex_);
+      while (!owner_->active_) {
+        // A synchronous startup upload can be interrupted by UIKit. The UI
+        // thread must keep servicing foreground notifications while waiting.
+        lock.unlock();
+        const bool pumped = owner_->pump_ && owner_->pump_();
+        lock.lock();
+        if (!owner_->active_) {
+          if (pumped) owner_->changed_.wait_for(lock, std::chrono::milliseconds(2));
+          else owner_->changed_.wait(lock, [&] { return owner_->active_; });
+        }
+      }
+      ++owner_->users_;
+    }
+    Permit(const Permit&) = delete;
+    Permit& operator=(const Permit&) = delete;
+    Permit(Permit&& other) noexcept : owner_(std::exchange(other.owner_, nullptr)) {}
+    ~Permit() {
+      if (!owner_) return;
+      std::lock_guard lock(owner_->mutex_);
+      if (--owner_->users_ == 0) owner_->changed_.notify_all();
+    }
+   private:
+    QueueLifecycle* owner_;
+  };
+  explicit QueueLifecycle(Pump pump = nullptr) : pump_(pump) {}
+  void SetActive(bool active, const std::function<void()>& drain) {
+    std::unique_lock lock(mutex_);
+    if (active_ == active) return;
+    active_ = active;
+    if (active) {
+      lock.unlock();
+      changed_.notify_all();
+    } else {
+      changed_.wait(lock, [&] { return users_ == 0; });
+      drain();
+    }
+  }
+ private:
+  std::mutex mutex_;
+  std::condition_variable changed_;
+  bool active_ = true;
+  unsigned users_ = 0;
+  Pump pump_;
+};
+}  // namespace rex::ui::vulkan
