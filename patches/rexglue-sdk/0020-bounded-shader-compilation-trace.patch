new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/compile_trace.h
@@ -0,0 +1,78 @@
+// Diagnostic counters shared by rexruntime, the GPU plugin and the title.
+// No rendering policy or synchronization decisions depend on this instrument.
+#pragma once
+#include <cstdint>
+#include <utility>
+
+namespace rex::graphics::compile_trace {
+enum class Phase : uint32_t {
+  kBoot,
+  kPreA,
+  kPostALoading,
+  kMenu,
+  kSongLoading,
+  kActiveSong,
+  kPaused,
+  kUnknown,
+  kCount
+};
+enum class Event : uint32_t {
+  kTranslation,
+  kGuestPipeline,
+  kPlaceholder,
+  kHelperGraphics,
+  kHelperCompute,
+  kCompileDrain,
+  kCompileWait,
+  kGuestFrame,
+  kGpuFrame,
+  kCount
+};
+bool Enabled();
+uint64_t Now();
+Phase CurrentPhase();
+void SetPhase(Phase phase, const char* reason);
+void Record(Event event, Phase phase, const char* site, uint64_t key, uint64_t begin_us,
+            uint64_t end_us, bool success, uint64_t variant = 0);
+void Frame(Event event);
+void Snapshot(const char* reason);
+struct CounterSnapshot {
+  uint64_t count, failed, total_us, max_us, ge50, ge100, ge250, suppressed;
+};
+CounterSnapshot ReadCounter(Phase phase, Event event);
+
+class Scope {
+ public:
+  Scope(Event event, const char* site, uint64_t key = 0, uint64_t variant = 0)
+      : enabled_(Enabled()), event_(event), site_(site), key_(key), variant_(variant) {
+    if (enabled_) {
+      phase_ = CurrentPhase();
+      begin_ = Now();
+    }
+  }
+  ~Scope() {
+    if (enabled_)
+      Record(event_, phase_, site_, key_, begin_, Now(), success_, variant_);
+  }
+  void Success(bool success = true) { success_ = success; }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  bool enabled_, success_ = false;
+  Event event_;
+  const char* site_;
+  uint64_t key_, variant_, begin_ = 0;
+  Phase phase_ = Phase::kUnknown;
+};
+
+// D3D12 S_OK and Vulkan VK_SUCCESS are both zero. Positive Vulkan results such
+// as PIPELINE_COMPILE_REQUIRED are deliberately not counted as success.
+template <typename F>
+auto Call(Event event, const char* site, uint64_t key, F&& f) {
+  Scope scope(event, site, key);
+  auto result = std::forward<F>(f)();
+  scope.Success(result == 0);
+  return result;
+}
+}  // namespace rex::graphics::compile_trace
diff --git a/src/system/compile_trace.cpp b/src/system/compile_trace.cpp
new file mode 100644
--- /dev/null
+++ b/src/system/compile_trace.cpp
@@ -0,0 +1,154 @@
+// Opt-in, bounded shader-cache P0 measurements. One owner in rexruntime so
+// runtime helper creation and GPU-plugin work share a clock, phase and budget.
+#include <rex/graphics/compile_trace.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+
+REXCVAR_DEFINE_BOOL(shader_compile_trace, false, "Diagnostics",
+                    "Bounded compilation, wait and frame-gap measurements; restart required.")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::compile_trace {
+namespace {
+constexpr size_t kPhases = size_t(Phase::kCount), kEvents = size_t(Event::kCount);
+constexpr const char* kPhaseNames[] = {"boot",         "pre_a",       "post_a_loading", "menu",
+                                       "song_loading", "active_song", "paused",         "unknown"};
+constexpr const char* kEventNames[] = {"translation",     "guest_pipeline", "placeholder",
+                                       "helper_graphics", "helper_compute", "compile_drain",
+                                       "compile_wait",    "guest_frame",    "gpu_frame"};
+struct Counter {
+  uint64_t count = 0, failed = 0, total = 0, worst = 0;
+  uint64_t over50 = 0, over100 = 0, over250 = 0, suppressed = 0;
+};
+std::mutex mutex;
+std::array<std::array<Counter, kEvents>, kPhases> counters{};
+std::array<uint64_t, kEvents> details{};
+std::atomic<Phase> phase{Phase::kBoot};
+uint32_t snapshots = 0, transitions = 0;
+// Each producer has its own last-frame timestamp (all guarded by mutex).
+uint64_t last_guest = 0, last_gpu = 0;
+Phase last_guest_phase = Phase::kBoot, last_gpu_phase = Phase::kBoot;
+uint64_t last_snapshot = 0;
+
+void SnapshotLocked(const char* reason) {
+  if (snapshots >= 256)
+    return;
+  ++snapshots;
+  for (size_t p = 0; p < kPhases; ++p) {
+    for (size_t e = 0; e < kEvents; ++e) {
+      const auto& c = counters[p][e];
+      if (!c.count)
+        continue;
+      REXLOG_INFO(
+          "shader_trace: summary snapshot={} reason={} phase={} event={} count={} "
+          "failed={} total_us={} max_us={} ge50={} ge100={} ge250={} suppressed={}",
+          snapshots, reason, kPhaseNames[p], kEventNames[e], c.count, c.failed, c.total, c.worst,
+          c.over50, c.over100, c.over250, c.suppressed);
+    }
+  }
+}
+void RecordLocked(Event event, Phase start_phase, const char* site, uint64_t key, uint64_t begin,
+                  uint64_t end, bool success, uint64_t variant = 0) {
+  auto e = size_t(event), p = size_t(start_phase);
+  if (e >= kEvents || p >= kPhases || end < begin)
+    return;
+  auto& c = counters[p][e];
+  const uint64_t us = end - begin;
+  ++c.count;
+  c.failed += !success;
+  c.total += us;
+  c.worst = std::max(c.worst, us);
+  c.over50 += us >= 50000;
+  c.over100 += us >= 100000;
+  c.over250 += us >= 250000;
+  const bool frame = event == Event::kGuestFrame || event == Event::kGpuFrame;
+  const bool drain = event == Event::kCompileDrain;
+  if ((frame && us < 50000) || (drain && us < 1000))
+    return;
+  // Keep collecting all counters after the detail budget is spent. Never log
+  // every draw or every normal frame. Cross-phase operations retain both ends.
+  if (details[e]++ < 2048) {
+    REXLOG_INFO(
+        "shader_trace: event={} phase={} end_phase={} site={} key={:016X} variant={:016X} "
+        "begin_us={} end_us={} duration_us={} success={}",
+        kEventNames[e], kPhaseNames[p], kPhaseNames[size_t(phase.load())], site, key, variant,
+        begin, end, us, success);
+  } else {
+    ++c.suppressed;
+  }
+}
+}  // namespace
+bool Enabled() {
+  // First use follows argument/config parsing; immutable for this process.
+  static const bool enabled = REXCVAR_GET(shader_compile_trace);
+  return enabled;
+}
+uint64_t Now() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+Phase CurrentPhase() {
+  return phase.load(std::memory_order_relaxed);
+}
+void SetPhase(Phase value, const char* reason) {
+  if (!Enabled() || size_t(value) >= kPhases)
+    return;
+  if (CurrentPhase() == value)
+    return;
+  std::lock_guard lock(mutex);
+  auto before = phase.exchange(value);
+  if (before == value)
+    return;
+  if (transitions++ < 512) {
+    REXLOG_INFO("shader_trace: phase={} previous={} t_us={} reason={}", kPhaseNames[size_t(value)],
+                kPhaseNames[size_t(before)], Now(), reason);
+  }
+  SnapshotLocked("phase_change");
+}
+void Record(Event event, Phase start_phase, const char* site, uint64_t key, uint64_t begin,
+            uint64_t end, bool success, uint64_t variant) {
+  if (!Enabled())
+    return;
+  std::lock_guard lock(mutex);
+  RecordLocked(event, start_phase, site, key, begin, end, success, variant);
+}
+void Frame(Event event) {
+  if (!Enabled() || (event != Event::kGuestFrame && event != Event::kGpuFrame))
+    return;
+  const uint64_t now = Now();
+  std::lock_guard lock(mutex);
+  auto& last = event == Event::kGuestFrame ? last_guest : last_gpu;
+  auto& previous = event == Event::kGuestFrame ? last_guest_phase : last_gpu_phase;
+  const auto current = CurrentPhase();
+  // A gap spanning a phase boundary is explicitly unknown rather than charged
+  // wholly to gameplay. The endpoints still correlate with compilation details.
+  if (last)
+    RecordLocked(event, previous == current ? current : Phase::kUnknown, "swap", 0, last, now,
+                 true);
+  last = now;
+  previous = current;
+  if (now - last_snapshot >= 10000000) {
+    last_snapshot = now;
+    SnapshotLocked("periodic");
+  }
+}
+void Snapshot(const char* reason) {
+  if (!Enabled())
+    return;
+  std::lock_guard lock(mutex);
+  SnapshotLocked(reason);
+}
+CounterSnapshot ReadCounter(Phase value, Event event) {
+  std::lock_guard lock(mutex);
+  if (size_t(value) >= kPhases || size_t(event) >= kEvents)
+    return {};
+  const auto& c = counters[size_t(value)][size_t(event)];
+  return {c.count, c.failed, c.total, c.worst, c.over50, c.over100, c.over250, c.suppressed};
+}
+}  // namespace rex::graphics::compile_trace
