diff --git a/src/ui/surface_mac_metal.mm b/src/ui/surface_mac_metal.mm
new file mode 100644
--- /dev/null
+++ b/src/ui/surface_mac_metal.mm
@@ -0,0 +1,20 @@
+// Released under the BSD license - see LICENSE in the root.
+#include <rex/ui/surface_mac.h>
+#include <rex/logging.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+namespace rex::ui {
+bool CAMetalLayerSurface::RestoreDrawableSize(uint32_t width, uint32_t height) const {
+  if (!layer_ || !width || !height) return false;
+  CAMetalLayer* metal_layer = (__bridge CAMetalLayer*)layer_;
+  const CGSize before = metal_layer.drawableSize;
+  if (before.width == width && before.height == height) return false;
+  // MoltenVK 1.4.1 can flush pending presentations by setting this to 1x1
+  // after initializing a replacement swapchain. Restore the committed extent
+  // only after the old swapchain has finished retiring.
+  metal_layer.drawableSize = CGSizeMake(width, height);
+  REXLOG_INFO("Metal surface: restored drawable {}x{} -> {}x{} after swapchain replacement",
+              double(before.width), double(before.height), width, height);
+  return true;
+}
+}  // namespace rex::ui
