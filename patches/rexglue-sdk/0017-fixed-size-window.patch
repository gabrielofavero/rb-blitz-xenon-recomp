diff --git a/src/ui/window.cpp b/src/ui/window.cpp
index a405dfc..11ee906 100644
--- a/src/ui/window.cpp
+++ b/src/ui/window.cpp
@@ -49,6 +49,16 @@ REXCVAR_DEFINE_INT32(monitor, 0, "UI/Window",
     .range(0, 16)
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
+// ReXGlue addition (2026-10-14): whether the *user* may resize the window. A title that renders at
+// exactly one size wants that size, and a drag must not be able to leave a shape its render path
+// cannot fill. The window is still the platform's to decorate and the application's to size; this
+// only takes the resize handle away, and only when the application asks for it. Default true is
+// SDL's own default and the SDK's behaviour: a build that never touches it is unchanged. Applied in
+// window_sdl.cpp, which is where the SDL window and its flags live.
+REXCVAR_DEFINE_BOOL(window_resizable, true, "UI/Window",
+                    "Allow the user to resize the window")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 REXCVAR_DEFINE_STRING(video_driver, "", "UI/Window",
                       "SDL video driver to use, such as \"wayland\" or \"x11\". Empty picks "
                       "SDL's default for the session")
diff --git a/src/ui/window_sdl.cpp b/src/ui/window_sdl.cpp
index 234d256..5c219df 100644
--- a/src/ui/window_sdl.cpp
+++ b/src/ui/window_sdl.cpp
@@ -216,6 +216,16 @@ bool WindowSDL::OpenImpl() {
   // desired state so a reopened window comes back with the state it had.
   ApplyTextInputActiveNow();
   ApplyCursorVisibilityNow();
+  // ReXGlue addition (2026-10-14): the user's resize handle is the application's to decline. SDL
+  // exposes it independently of the size the window was created at and separately from the
+  // fullscreen state (SDL_SetWindowResizable), so it is applied here, with the other desired state.
+  // A title whose render size is fixed before the window exists (rb_blitz decides its guest frame,
+  // the draw scale and the presenter's output region from one resolution row) can therefore refuse a
+  // drag that would leave a shape its picture cannot fill, while the separate Controller Settings
+  // utility - which builds its own SDL window - keeps SDL's default.
+  if (!REXCVAR_GET(window_resizable)) {
+    SDL_SetWindowResizable(sdl_window_, false);
+  }
   SDL_ShowWindow(sdl_window_);
 
   // Actualize state for the common Window code. Listener dispatch is handled
