diff --git a/include/rex/ui/keyboard_input_controller.h b/include/rex/ui/keyboard_input_controller.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/keyboard_input_controller.h
@@ -0,0 +1,95 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace rex::ui {
+
+// Physical controls only: keyboard-to-pad emulation must never feed this modal.
+struct KeyboardControllerSample {
+  enum Button : uint16_t {
+    Select = 1, Cancel = 2, Up = 4, Down = 8, Left = 16, Right = 32
+  };
+  bool connected = false;
+  bool focused = false;
+  uint16_t buttons = 0;
+};
+
+struct KeyboardControllerAction {
+  bool focus_text = false;
+  bool focus_changed = false;
+  bool cancel = false;
+};
+
+// Device/ImGui-independent navigation for the XAM keyboard modal. Controller
+// input cannot submit: A focuses text, B cancels, directions move focus. Enter
+// and mouse clicks are handled by the dialog, regardless of text editing state.
+class KeyboardInputController {
+ public:
+  enum class Focus { Text, Done, Cancel };
+
+  KeyboardControllerAction Update(KeyboardControllerSample sample, float delta_seconds) {
+    using Button = KeyboardControllerSample;
+    KeyboardControllerAction action;
+    const uint16_t pressed = sample.buttons & ~previous_buttons_;
+    previous_buttons_ = sample.buttons;
+    if (!sample.connected || !sample.focused) {
+      armed_ = false;
+      repeat_button_ = 0;
+      return action;
+    }
+    if (!armed_) {
+      if (sample.buttons == 0) {
+        armed_ = true;
+      }
+      return action;
+    }
+    if (pressed & Button::Cancel) {
+      action.cancel = true;
+      return action;
+    }
+    const uint16_t direction = sample.buttons & (Button::Up | Button::Down |
+                                                Button::Left | Button::Right);
+    bool move = direction != 0 && direction != repeat_button_;
+    if (direction != repeat_button_) {
+      repeat_button_ = direction;
+      repeat_delay_ = 0.35f;
+    } else if (direction != 0) {
+      repeat_delay_ -= std::clamp(delta_seconds, 0.0f, 0.1f);
+      if (repeat_delay_ <= 0.0f) {
+        move = true;
+        repeat_delay_ = 0.12f;
+      }
+    }
+    if (move) {
+      const int current = static_cast<int>(focus_);
+      if (direction == Button::Up) {
+        focus_ = static_cast<Focus>((current + 2) % 3);
+      } else if (direction == Button::Down) {
+        focus_ = static_cast<Focus>((current + 1) % 3);
+      } else if (direction == Button::Left || direction == Button::Right) {
+        focus_ = focus_ == Focus::Done ? Focus::Cancel : Focus::Done;
+      }
+      action.focus_changed = focus_ != static_cast<Focus>(current);
+      return action;
+    }
+    if (pressed & Button::Select) {
+      focus_ = Focus::Text;
+      action.focus_text = true;
+      action.focus_changed = true;
+    }
+    return action;
+  }
+
+  Focus focus() const { return focus_; }
+
+ private:
+  Focus focus_ = Focus::Text;
+  bool armed_ = false;
+  uint16_t previous_buttons_ = 0;
+  uint16_t repeat_button_ = 0;
+  float repeat_delay_ = 0.0f;
+};
+
+}  // namespace rex::ui
