diff --git a/include/rex/ui/keyboard_input_controller.h b/include/rex/ui/keyboard_input_controller.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/keyboard_input_controller.h
@@ -0,0 +1,43 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <cstdint>
+
+namespace rex::ui {
+
+// Physical controls only: keyboard-to-pad emulation must never feed this modal.
+struct KeyboardControllerSample {
+  enum Button : uint16_t { ShowKeyboard = 1, Cancel = 2 };
+  bool connected = false;
+  bool focused = false;
+  uint16_t buttons = 0;
+};
+
+struct KeyboardControllerAction {
+  bool cancel = false;
+  bool show_keyboard = false;
+};
+
+// B cancels; A requests the OS keyboard, never submission. Ignore buttons
+// already held on open/focus regain. Directions and typing do not participate.
+class KeyboardInputController {
+ public:
+  KeyboardControllerAction Update(KeyboardControllerSample sample) {
+    if (!sample.connected || !sample.focused) {
+      initialized_ = false;
+      return {};
+    }
+    const auto pressed = initialized_ ? sample.buttons & ~previous_buttons_ : 0;
+    const bool cancel = (pressed & KeyboardControllerSample::Cancel) != 0;
+    const bool show = !cancel && (pressed & KeyboardControllerSample::ShowKeyboard) != 0;
+    previous_buttons_ = sample.buttons;
+    initialized_ = true;
+    return {cancel, show};
+  }
+
+ private:
+  bool initialized_ = false;
+  uint16_t previous_buttons_ = 0;
+};
+
+}  // namespace rex::ui
