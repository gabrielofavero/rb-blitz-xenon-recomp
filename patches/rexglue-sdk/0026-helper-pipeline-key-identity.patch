-  Scope scope(event, site, key);
+auto Call(Event event, const char* site, uint64_t key, F&& f, uint64_t variant = 0) {
+  Scope scope(event, site, key, variant);
   auto result = std::forward<F>(f)();
   scope.Success(result == 0);
   return result;
