 CounterSnapshot ReadCounter(Phase phase, Event event);
 
+// Several helpers are created by one shared function (for example every compute
+// pipeline in the D3D12 and Vulkan UI utilities), so the trace site alone cannot
+// name the recipe. The upper byte of the key names the creator and the remaining
+// bits are the creator's own packed key, so the identity is stable across runs and
+// readable in a log (it never hashes pointers or data that can move).
+enum class HelperKind : uint64_t {
+  kResolveCopy = 1,
+  kHostDepthStore = 2,
+  kRovClear = 3,
+  kDump = 4,
+  kTransfer = 5,
+  kTransferStencilBit = 6,
+  kClearRtv = 7,
+  kPresenter = 8,
+  kSwapChain = 9,
+  kComputeUtil = 10,
+  kTextureConversion = 11,
+  kTextureLoad = 12,
+};
+inline uint64_t HelperKey(HelperKind kind, uint64_t detail) {
+  return (uint64_t(kind) << 56) | (detail & 0x00FFFFFFFFFFFFFFull);
+}
+
 class Scope {
  public:
   Scope(Event event, const char* site, uint64_t key = 0, uint64_t variant = 0)
@@ -69,8 +92,8 @@
 // D3D12 S_OK and Vulkan VK_SUCCESS are both zero. Positive Vulkan results such
 // as PIPELINE_COMPILE_REQUIRED are deliberately not counted as success.
