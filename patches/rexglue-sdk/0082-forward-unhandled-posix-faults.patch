+
+// A rejected native fault must reach the previous handler (or the OS). Returning
+// to the unchanged instruction otherwise faults forever, hiding the crash and
+// leaving other threads blocked on work the faulting thread can never finish.
+static void ForwardUnhandledSignal(int number, siginfo_t* info, void* context) {
+  const struct sigaction* previous = &original_sigill_handler_;
+  if (number == SIGSEGV) previous = &original_sigsegv_handler_;
+#if REX_PLATFORM_MAC
+  if (number == SIGBUS) previous = &original_sigbus_handler_;
+#endif
+  if (previous->sa_handler != SIG_DFL && previous->sa_handler != SIG_IGN) {
+    if (previous->sa_flags & SA_RESETHAND) {
+      struct sigaction action{};
+      action.sa_handler = SIG_DFL;
+      sigemptyset(&action.sa_mask);
+      sigaction(number, &action, nullptr);
+    }
+    if (previous->sa_flags & SA_SIGINFO) previous->sa_sigaction(number, info, context);
+    else previous->sa_handler(number);
+    return;
+  }
+  // Ignoring a synchronous memory/instruction fault cannot make it recoverable.
+  struct sigaction action{};
+  action.sa_handler = SIG_DFL;
+  sigemptyset(&action.sa_mask);
+  sigaction(number, &action, nullptr);
+  if (raise(number) != 0) _exit(128 + number);
+}
 
