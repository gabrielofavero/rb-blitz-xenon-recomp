diff --git a/include/rex/graphics/vulkan/texture_conversion_shader.h b/include/rex/graphics/vulkan/texture_conversion_shader.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/texture_conversion_shader.h
@@ -0,0 +1,43 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+namespace rex::graphics::vulkan {
+
+// Preserve tiling, mip packing and endianness for the existing texture-load shaders.
+// Read current GPU memory, including resolves, without a CPU mirror or round trip.
+inline constexpr char kTextureConversionShader[] = R"glsl(#version 450
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0, std430) writeonly buffer Destination { uint dest[]; };
+layout(set = 1, binding = 0, std430) readonly buffer Source { uint src[]; };
+layout(push_constant) uniform Constants {
+  uint word_count;
+  uint endianness;
+  uint is_signed;
+  uint is_integer;
+  uint groups_per_row;
+} c;
+
+uint swap_guest(uint value) {
+  if (c.endianness == 1u || c.endianness == 2u) {
+    value = ((value & 0x00ff00ffu) << 8u) | ((value >> 8u) & 0x00ff00ffu);
+  }
+  if (c.endianness == 2u || c.endianness == 3u) {
+    value = (value << 16u) | (value >> 16u);
+  }
+  return value;
+}
+
+void main() {
+  uint i = (gl_WorkGroupID.y * c.groups_per_row + gl_WorkGroupID.x) * 64u
+      + gl_LocalInvocationID.x;
+  if (i >= c.word_count) return;
+  uint value = swap_guest(src[i]);
+  float converted = c.is_signed != 0u ? float(int(value)) : float(value);
+  if (c.is_integer == 0u) {
+    converted *= c.is_signed != 0u ? (1.0 / 2147483647.0) : (1.0 / 4294967295.0);
+  }
+  dest[i] = swap_guest(floatBitsToUint(converted));
+}
+)glsl";
+
+}  // namespace rex::graphics::vulkan
