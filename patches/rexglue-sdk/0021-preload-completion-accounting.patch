index 0000000..ef7b322
--- /dev/null
+++ b/include/rex/graphics/pipeline_preload.h
@@ -0,0 +1,221 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+// Accounting and the completion barrier for a shader-storage preload, shared by
+// the Direct3D 12 and the Vulkan pipeline caches.
+//
+// A preload is done only when every required pipeline reached a terminal
+// success. An empty creation queue, a stopped worker, a cleared placeholder flag
+// and a retained fallback pipeline are all states that can be observed while the
+// required work is not done - none of them is readiness. Both backends therefore
+// move every stored description through the explicit states below, and the
+// blocking barrier waits on those states instead of on temporary-worker
+// bookkeeping (the Direct3D 12 preload used to wait only inside the branch that
+// grew the worker pool, so the no-growth case could return with workers busy).
+
+namespace rex::graphics {
+
+// Identity of one required pipeline. Opaque to the tracker; the caller must
+// supply a value that is unique per required entry (a stored-description index
+// or a creation-queue index works). This value means "not a preload entry" and
+// is used for the per-pipeline marker read by the creation workers.
+inline constexpr uint64_t kNoPreloadIdentity = UINT64_MAX;
+
+// Explicit counts of one storage preload. `succeeded` counts only entries whose
+// real pipeline exists (created now or present before the preload); `failed`
+// counts attempts that finished without a pipeline, `missing` counts entries
+// that never could be attempted (no shader data, no creation arguments).
+struct PipelinePreloadResult {
+  uint64_t required = 0;
+  uint64_t queued = 0;
+  uint64_t running = 0;
+  uint64_t succeeded = 0;
+  uint64_t failed = 0;
+  uint64_t missing = 0;
+  // Repeated registration of one identity - refused, and not required twice.
+  uint64_t duplicates = 0;
+  // Entries satisfied by a pipeline that already existed before the preload.
+  uint64_t already_present = 0;
+  // The caller asked for blocking mode and the barrier was reached.
+  bool awaited = false;
+
+  bool HasWork() const { return required != 0; }
+  // No entry is queued or running any more. Failures may still be counted.
+  bool Finished() const { return queued == 0 && running == 0; }
+  // Every required entry produced a real pipeline. An empty preload (nothing
+  // stored) is not complete coverage - it is simply empty.
+  bool Complete() const { return HasWork() && Finished() && failed == 0 && missing == 0; }
+};
+
+class PipelinePreloadTracker {
+ public:
+  // Registers one required entry in the queued state. Returns false when the
+  // identity is already registered; that request is counted as a duplicate and
+  // does not create a second required entry.
+  bool Register(uint64_t identity) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto result = entries_.emplace(identity, EntryState::kQueued);
+    if (!result.second) {
+      ++duplicates_;
+      return false;
+    }
+    return true;
+  }
+
+  // queued -> running. Called by the worker that took the entry.
+  void BeginWork(uint64_t identity) { Transition(identity, EntryState::kRunning); }
+  // Terminal success: the real pipeline exists.
+  void Succeed(uint64_t identity) { Transition(identity, EntryState::kSucceeded); }
+  // Terminal failure: creation was attempted and produced no pipeline.
+  void Fail(uint64_t identity) { Transition(identity, EntryState::kFailed); }
+  // Terminal failure: the entry could not be attempted at all.
+  void Miss(uint64_t identity) { Transition(identity, EntryState::kMissing); }
+
+  // Number of entries still queued or running.
+  size_t UnfinishedCount() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return UnfinishedLocked();
+  }
+
+  // Blocks until every registered entry is terminal, then returns the counts.
+  // Returns immediately when nothing is unfinished (including an empty tracker).
+  // A Reset on another thread releases the wait: the counts it returns then
+  // belong to the new generation, and the caller must not treat them as the
+  // result of the preload it was waiting for.
+  PipelinePreloadResult WaitUntilFinished() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    const uint64_t generation = generation_;
+    finished_cond_.wait(lock, [this, generation] {
+      return generation_ != generation || UnfinishedLocked() == 0;
+    });
+    return SummarizeLocked();
+  }
+
+  PipelinePreloadResult Read() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return SummarizeLocked();
+  }
+
+  // Abandons the current generation (a new storage load or shutdown). Wakes
+  // waiters so a barrier can never be left blocking on work nobody will finish.
+  void Reset() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++generation_;
+      entries_.clear();
+      duplicates_ = 0;
+    }
+    finished_cond_.notify_all();
+  }
+
+ private:
+  enum class EntryState : uint8_t {
+    kQueued,
+    kRunning,
+    kSucceeded,
+    kFailed,
+    kMissing,
+  };
+
+  static bool IsTerminal(EntryState state) {
+    return state == EntryState::kSucceeded || state == EntryState::kFailed ||
+           state == EntryState::kMissing;
+  }
+
+  void Transition(uint64_t identity, EntryState target) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      auto it = entries_.find(identity);
+      if (it == entries_.end()) {
+        // Not a preload entry (or a generation that has been reset).
+        return;
+      }
+      if (IsTerminal(it->second)) {
+        // Terminal states are final: a failure reported late cannot turn into a
+        // success, and a success cannot be counted twice.
+        return;
+      }
+      it->second = target;
+    }
+    if (IsTerminal(target)) {
+      finished_cond_.notify_all();
+    }
+  }
+
+  size_t UnfinishedLocked() const {
+    size_t unfinished = 0;
+    for (const auto& entry : entries_) {
+      if (entry.second == EntryState::kQueued || entry.second == EntryState::kRunning) {
+        ++unfinished;
+      }
+    }
+    return unfinished;
+  }
+
+  PipelinePreloadResult SummarizeLocked() const {
+    PipelinePreloadResult result;
+    result.duplicates = duplicates_;
+    for (const auto& entry : entries_) {
+      ++result.required;
+      switch (entry.second) {
+        case EntryState::kQueued:
+          ++result.queued;
+          break;
+        case EntryState::kRunning:
+          ++result.running;
+          break;
+        case EntryState::kSucceeded:
+          ++result.succeeded;
+          break;
+        case EntryState::kFailed:
+          ++result.failed;
+          break;
+        case EntryState::kMissing:
+          ++result.missing;
+          break;
+      }
+    }
+    return result;
+  }
+
+  mutable std::mutex mutex_;
+  std::condition_variable finished_cond_;
+  std::unordered_map<uint64_t, EntryState> entries_;
+  uint64_t duplicates_ = 0;
+  uint64_t generation_ = 0;
+};
+
+// Number of pipeline creation threads to have while a storage preload runs.
+// The thread issuing the preload creates pipelines as well, so one worker fewer
+// than the processors put to the work. Never shrinks below the workers that
+// already exist, and never asks for a worker when there is only one entry (or
+// no entries at all) - the case the previous inline loop could not express,
+// which left the blocking completion barrier skipped.
+inline size_t PreloadCreationThreadCount(size_t entry_count, size_t logical_processor_count,
+                                         size_t existing_thread_count) {
+  if (entry_count == 0) {
+    return existing_thread_count;
+  }
+  const size_t parallel_entries =
+      std::min(entry_count, std::max(logical_processor_count, size_t(1)));
+  return std::max(parallel_entries - size_t(1), existing_thread_count);
+}
+
+}  // namespace rex::graphics
