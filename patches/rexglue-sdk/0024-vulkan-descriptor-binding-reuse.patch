diff --git a/include/rex/graphics/vulkan/descriptor_binding_state.h b/include/rex/graphics/vulkan/descriptor_binding_state.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/descriptor_binding_state.h
@@ -0,0 +1,29 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <span>
+#include <vulkan/vulkan.h>
+
+namespace rex::graphics::vulkan {
+
+// Pipeline layouts are compatible for set N only when sets 0 through N match.
+inline constexpr uint32_t DescriptorSetPrefixMask(uint32_t count) {
+  return count >= 32 ? UINT32_MAX : (UINT32_C(1) << count) - 1;
+}
+
+// A descriptor that was already bound remains bound when its immutable set
+// handle is unchanged. Never resurrect a binding invalidated by a new command
+// buffer, external renderer or incompatible pipeline layout.
+inline uint32_t RetainDescriptorSetBindings(uint32_t bound, uint32_t valid,
+    std::span<const VkDescriptorSet> previous, std::span<const VkDescriptorSet> current) {
+  const uint32_t count = uint32_t(std::min({previous.size(), current.size(), size_t(32)}));
+  bound &= valid & DescriptorSetPrefixMask(count);
+  for (uint32_t i = 0; i < count; ++i) {
+    if (previous[i] != current[i]) bound &= ~(UINT32_C(1) << i);
+  }
+  return bound;
+}
+
+}  // namespace rex::graphics::vulkan
