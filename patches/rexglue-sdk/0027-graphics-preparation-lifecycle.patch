+bool CommandProcessor::BeginShaderStoragePreparation(const std::filesystem::path& cache_root,
+                                                     uint32_t title_id, uint64_t configuration) {
+  if (cache_root.empty() || title_id == 0) {
+    return false;
+  }
+  GraphicsPreparationKey key;
+  key.title_id = title_id;
+  key.configuration = configuration;
+  key.cache_root = uint64_t(std::hash<std::filesystem::path>{}(cache_root));
+  if (!preparation_.Begin(key)) {
+    return false;
+  }
+  preparation_active_.store(true, std::memory_order_release);
+  // Even the import is scheduled on the command processor thread: the pipeline
+  // and shader maps, and the storage streams, belong to that thread. The caller
+  // gets its generation token back immediately and reads progress from the
+  // controller.
+  CallInThread([this, cache_root, title_id]() {
+    BeginShaderStoragePreparationOnProcessorThread(cache_root, title_id);
+  });
+  return true;
+}
+
+void CommandProcessor::RequestCancelShaderStoragePreparation() { preparation_.RequestCancel(); }
+
+GraphicsPreparationProgress CommandProcessor::QueryShaderStoragePreparation() const {
+  return preparation_.Snapshot();
+}
+
+GraphicsPreparationProgress CommandProcessor::WaitForShaderStoragePreparation() {
+  return preparation_.WaitForTerminal();
+}
+
+void CommandProcessor::ServiceShaderStoragePreparation() {
+  if (!preparation_active_.load(std::memory_order_acquire)) {
+    return;
+  }
+  ServiceShaderStoragePreparationOnProcessorThread();
+  if (!preparation_.Active()) {
+    preparation_active_.store(false, std::memory_order_release);
+  }
+}
