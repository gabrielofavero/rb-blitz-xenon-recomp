+bool PipelineCache::PreparationTranslationsFinished() const {
+  std::lock_guard<std::mutex> lock(preparation_translation_lock_);
+  return preparation_translation_busy_ == 0 && preparation_shaders_to_translate_.empty();
+}
+
+void PipelineCache::JoinPreparationTranslationWorkers() {
+  {
+    std::lock_guard<std::mutex> lock(preparation_translation_lock_);
+    preparation_translation_shutdown_ = true;
+  }
+  preparation_translation_cond_.notify_all();
+  for (auto& shader_translation_thread : preparation_translation_threads_) {
+    rex::thread::Wait(shader_translation_thread.get(), false);
+  }
+  preparation_translation_threads_.clear();
+  std::vector<D3D12Shader::D3D12Translation*> failed_translations;
+  {
+    std::lock_guard<std::mutex> lock(preparation_failed_translations_lock_);
+    failed_translations.swap(preparation_failed_translations_);
+  }
+  for (D3D12Shader::D3D12Translation* translation : failed_translations) {
+    D3D12Shader* shader = static_cast<D3D12Shader*>(&translation->shader());
+    shader->DestroyTranslation(translation->modification());
+    if (shader->translations().empty()) {
+      shaders_.erase(shader->ucode_data_hash());
+      delete shader;
+    }
+  }
+}
