+  // submission's EndSubmission() must never wait for preparation work, and
+  // preparation must not consume a pipeline a draw needs first.
+  size_t creation_thread_count = 1;
+  uint32_t logical_processor_count = rex::thread::logical_processor_count();
+  if (!logical_processor_count) {
+    logical_processor_count = 6;
+  }
+  if (REXCVAR_GET(vulkan_pipeline_creation_threads) == 0) {
+    creation_thread_count = 1;
+  } else if (REXCVAR_GET(vulkan_pipeline_creation_threads) < 0) {
+    creation_thread_count =
+        std::max(size_t(logical_processor_count * 3 / 4), size_t(1));
+  } else {
+    creation_thread_count =
+        std::min(size_t(REXCVAR_GET(vulkan_pipeline_creation_threads)),
+                 size_t(logical_processor_count));
+  }
+  creation_thread_count = std::max(creation_thread_count, size_t(1));
+  creation_thread_count = std::min(creation_thread_count, preparation_descriptions_.size());
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+  preparation_creation_threads_.clear();
+  preparation_creation_threads_.reserve(creation_thread_count);
+  for (size_t thread_index = 0; thread_index < creation_thread_count; ++thread_index) {
+    std::unique_ptr<rex::thread::Thread> creation_thread = rex::thread::Thread::Create(
+        {}, [this, thread_index]() { PreparationCreationThread(thread_index); });
+    assert_not_null(creation_thread);
