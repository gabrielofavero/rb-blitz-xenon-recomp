diff --git a/include/rex/graphics/graphics_preparation.h b/include/rex/graphics/graphics_preparation.h
new file mode 100644
index 0000000..6079d46
--- /dev/null
+++ b/include/rex/graphics/graphics_preparation.h
@@ -0,0 +1,382 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ *
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ *
+ ******************************************************************************
+ */
+
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+#include <rex/graphics/pipeline_preload.h>
+
+// A graphics-preparation generation: the lifecycle that turns persistent shader
+// and pipeline storage into ready GPU pipelines without holding the command
+// processor or the guest.
+//
+// The problem this models, in one sentence: opening the storage, translating
+// shader variants and creating driver pipelines is one long job, and running it
+// as one blocking call - before the first frame, or on the command processor
+// thread - stops the loading UI from animating and stops submissions. The
+// lifecycle below is deliberately independent of the graphics backend: a
+// backend starts a generation, advances it in bounded slices from its owner
+// thread, and finishes it; the caller only ever sees phases and explicit counts.
+//
+// Rules the state encodes, so a caller cannot accidentally weaken them:
+//   * Only the owner thread advances the phase or finishes a generation.
+//   * A phase never moves backwards within a generation.
+//   * "Zero entries" is not coverage: a generation whose storage declared no
+//     required pipelines finishes as kIncomplete, never kSucceeded.
+//   * Cancellation moves not-yet-started entries to a terminal cancelled state,
+//     stops further enqueues, and still lets work already in flight report its
+//     own result - nothing is abandoned in a half-published state.
+//   * Every waiter is released, including by Reset() during shutdown.
+
+namespace rex::graphics {
+
+enum class GraphicsPreparationPhase : uint8_t {
+  // No generation has started, or the previous one was reset.
+  kIdle = 0,
+  // Opening the storage and importing descriptions and guest shaders.
+  kImporting,
+  // Translating the shader variants the stored pipelines reference.
+  kTranslating,
+  // Creating the pipelines themselves.
+  kCreating,
+  // Committing results (releasing temporary workers, flushing storage).
+  kFinalizing,
+  // Terminal: every required entry produced a real pipeline.
+  kSucceeded,
+  // Terminal: the work finished, but entries failed, were missing, or the
+  // storage declared no required pipelines at all.
+  kIncomplete,
+  // Terminal: the generation was cancelled by its owner.
+  kCancelled,
+  // Terminal: the storage could not be opened or imported.
+  kFailed,
+};
+
+inline bool GraphicsPreparationIsTerminal(GraphicsPreparationPhase phase) {
+  return phase >= GraphicsPreparationPhase::kSucceeded;
+}
+
+inline const char* GraphicsPreparationPhaseName(GraphicsPreparationPhase phase) {
+  switch (phase) {
+    case GraphicsPreparationPhase::kIdle:
+      return "idle";
+    case GraphicsPreparationPhase::kImporting:
+      return "importing";
+    case GraphicsPreparationPhase::kTranslating:
+      return "translating";
+    case GraphicsPreparationPhase::kCreating:
+      return "creating";
+    case GraphicsPreparationPhase::kFinalizing:
+      return "finalizing";
+    case GraphicsPreparationPhase::kSucceeded:
+      return "succeeded";
+    case GraphicsPreparationPhase::kIncomplete:
+      return "incomplete";
+    case GraphicsPreparationPhase::kCancelled:
+      return "cancelled";
+    case GraphicsPreparationPhase::kFailed:
+      return "failed";
+  }
+  return "unknown";
+}
+
+// Which backend produced the generation. Informational - one process boots one
+// backend - but a progress reader should not have to guess it.
+enum class GraphicsPreparationBackend : uint32_t {
+  kUnknown = 0,
+  kD3D12 = 1,
+  kVulkan = 2,
+};
+
+inline const char* GraphicsPreparationBackendName(GraphicsPreparationBackend backend) {
+  switch (backend) {
+    case GraphicsPreparationBackend::kD3D12:
+      return "d3d12";
+    case GraphicsPreparationBackend::kVulkan:
+      return "vulkan";
+    case GraphicsPreparationBackend::kUnknown:
+      break;
+  }
+  return "unknown";
+}
+
+// Identity of everything a prepared result depends on that can change between
+// generations. A caller starts a new generation when any of these change; a
+// result from a different key may never be reported as ready.
+struct GraphicsPreparationKey {
+  uint32_t title_id = 0;
+  // Caller-supplied epoch for settings, content and rendering choices. The
+  // graphics backend does not interpret it, only compares it.
+  uint64_t configuration = 0;
+  // Hash of the resolved storage root, so two generations reading different
+  // caches are distinguishable in a log.
+  uint64_t cache_root = 0;
+
+  bool operator==(const GraphicsPreparationKey& other) const {
+    return title_id == other.title_id && configuration == other.configuration &&
+           cache_root == other.cache_root;
+  }
+  bool operator!=(const GraphicsPreparationKey& other) const { return !(*this == other); }
+};
+
+// One immutable reading of a generation. `entries` carries the explicit counts
+// (required / queued / running / succeeded / failed / missing / cancelled).
+struct GraphicsPreparationProgress {
+  uint64_t generation = 0;
+  GraphicsPreparationKey key;
+  GraphicsPreparationPhase phase = GraphicsPreparationPhase::kIdle;
+  PipelinePreloadResult entries;
+  GraphicsPreparationBackend backend = GraphicsPreparationBackend::kUnknown;
+  // Backend-specific rendering path (D3D12 rtv/rov, Vulkan fbo/fsi).
+  uint32_t render_path = 0;
+  // Whether the storage declared any required pipelines. A generation with no
+  // catalogue cannot be "ready" - there was nothing to verify.
+  bool has_catalogue = false;
+  bool cancel_requested = false;
+  bool active = false;
+  bool finished = false;
+  bool complete = false;
+  uint64_t elapsed_milliseconds = 0;
+  // Bounded slices the owner thread ran. A slice count that stops moving while
+  // `active` stays true is the signature of a stalled owner thread.
+  uint64_t service_slices = 0;
+
+  // The one readiness question a caller may ask: this generation finished,
+  // succeeded, and every required entry produced a real pipeline.
+  bool ready() const {
+    return finished && phase == GraphicsPreparationPhase::kSucceeded && complete;
+  }
+  uint64_t completed_entries() const { return entries.succeeded; }
+  uint64_t required_entries() const { return entries.required; }
+};
+
+// The lifecycle state machine. The owning command processor creates one, starts
+// a generation when the application asks for preparation, and advances it from
+// its own thread; every other thread may only take snapshots or wait.
+class GraphicsPreparationController {
+ public:
+  using Clock = std::chrono::steady_clock;
+
+  // Starts a generation. Returns false when one is already active - the caller
+  // must cancel it first, so two preparations can never write the same caches
+  // concurrently. The generation token strictly increases across Begin() and
+  // Reset(), so a stale snapshot can never be mistaken for a new generation.
+  bool Begin(const GraphicsPreparationKey& key) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (active_) {
+      return false;
+    }
+    tracker_.Reset();
+    ++generation_;
+    key_ = key;
+    phase_ = GraphicsPreparationPhase::kImporting;
+    cancel_requested_ = false;
+    has_catalogue_ = false;
+    backend_ = GraphicsPreparationBackend::kUnknown;
+    render_path_ = 0;
+    service_slices_ = 0;
+    started_at_ = Clock::now();
+    finished_at_ = Clock::time_point();
+    active_ = true;
+    finished_ = false;
+    complete_ = false;
+    return true;
+  }
+
+  // Records which backend and rendering path the generation prepares for.
+  void SetRenderer(GraphicsPreparationBackend backend, uint32_t render_path) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    backend_ = backend;
+    render_path_ = render_path;
+  }
+
+  // Declares whether the storage contained any required pipelines. Called once
+  // the import is complete; `false` makes the generation finish kIncomplete.
+  void NoteCatalogue(bool has_catalogue) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    has_catalogue_ = has_catalogue;
+  }
+
+  // Moves the phase forwards. Refuses to move backwards, into a terminal phase
+  // (Finish does that) or while no generation is active.
+  bool AdvancePhase(GraphicsPreparationPhase phase) {
+    if (phase == GraphicsPreparationPhase::kIdle || GraphicsPreparationIsTerminal(phase)) {
+      return false;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!active_ || GraphicsPreparationIsTerminal(phase_) || phase <= phase_) {
+      return false;
+    }
+    phase_ = phase;
+    return true;
+  }
+
+  // Entry accounting, forwarded so cancellation and progress share one lock
+  // ordering with the lifecycle.
+  bool RegisterEntry(uint64_t identity) { return tracker_.Register(identity); }
+  void BeginEntry(uint64_t identity) { tracker_.BeginWork(identity); }
+  void SucceedEntry(uint64_t identity) { tracker_.Succeed(identity); }
+  void FailEntry(uint64_t identity) { tracker_.Fail(identity); }
+  void MissEntry(uint64_t identity) { tracker_.Miss(identity); }
+  size_t CancelPendingEntries() { return tracker_.CancelPending(); }
+
+  // Asks for cancellation. The owner thread observes this at its next slice,
+  // stops enqueueing, cancels not-yet-started entries and finishes the
+  // generation as kCancelled after in-flight work reports.
+  void RequestCancel() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    cancel_requested_ = true;
+  }
+
+  bool CancelRequested() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return cancel_requested_;
+  }
+
+  bool Active() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return active_;
+  }
+
+  uint64_t generation() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return generation_;
+  }
+
+  GraphicsPreparationPhase phase() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return phase_;
+  }
+
+  // Numbers of entries still queued or running. The owner thread uses it to
+  // decide whether the generation can be finalized.
+  size_t unfinished_entries() const { return tracker_.UnfinishedCount(); }
+
+  // Live entry counts. Taken without the lifecycle lock, so a backend can read
+  // them from inside its own slice.
+  PipelinePreloadResult entries() const { return tracker_.Read(); }
+
+  void NoteServiceSlice() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++service_slices_;
+  }
+
+  // Publishes the terminal phase and wakes every waiter. Only an active
+  // generation can finish; the first terminal wins.
+  bool Finish(GraphicsPreparationPhase terminal_phase) {
+    if (!GraphicsPreparationIsTerminal(terminal_phase)) {
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!active_) {
+        return false;
+      }
+      const PipelinePreloadResult entries = tracker_.Read();
+      phase_ = terminal_phase;
+      finished_ = true;
+      active_ = false;
+      complete_ = terminal_phase == GraphicsPreparationPhase::kSucceeded && has_catalogue_ &&
+                  entries.Complete();
+      finished_at_ = Clock::now();
+    }
+    terminal_condition_.notify_all();
+    return true;
+  }
+
+  GraphicsPreparationProgress Snapshot() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return SnapshotLocked();
+  }
+
+  // Blocks until the active generation reaches a terminal phase, or until
+  // Reset()/Begin() replaces it. An idle controller returns immediately.
+  GraphicsPreparationProgress WaitForTerminal() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    const uint64_t generation = generation_;
+    terminal_condition_.wait(lock,
+                             [this, generation] { return generation_ != generation || !active_; });
+    return SnapshotLocked();
+  }
+
+  // Shutdown and re-initialization. Releases every waiter (a waiting barrier can
+  // never be left blocking on work nobody will finish) and abandons the current
+  // generation as cancelled. Counts of the new generation start empty.
+  void Reset() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++generation_;
+      if (active_) {
+        phase_ = GraphicsPreparationPhase::kCancelled;
+        finished_ = true;
+        active_ = false;
+        complete_ = false;
+        finished_at_ = Clock::now();
+      }
+      tracker_.Reset();
+      cancel_requested_ = false;
+      has_catalogue_ = false;
+      service_slices_ = 0;
+    }
+    terminal_condition_.notify_all();
+  }
+
+ private:
+  GraphicsPreparationProgress SnapshotLocked() const {
+    GraphicsPreparationProgress progress;
+    progress.generation = generation_;
+    progress.key = key_;
+    progress.phase = phase_;
+    progress.entries = tracker_.Read();
+    progress.backend = backend_;
+    progress.render_path = render_path_;
+    progress.has_catalogue = has_catalogue_;
+    progress.cancel_requested = cancel_requested_;
+    progress.active = active_;
+    progress.finished = finished_;
+    progress.complete = complete_;
+    progress.service_slices = service_slices_;
+    if (generation_ != 0) {
+      const Clock::time_point end = active_ || !finished_ ? Clock::now() : finished_at_;
+      if (end > started_at_) {
+        progress.elapsed_milliseconds =
+            uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(end - started_at_)
+                         .count());
+      }
+    }
+    return progress;
+  }
+
+  mutable std::mutex mutex_;
+  std::condition_variable terminal_condition_;
+  PipelinePreloadTracker tracker_;
+  GraphicsPreparationKey key_;
+  GraphicsPreparationBackend backend_ = GraphicsPreparationBackend::kUnknown;
+  uint32_t render_path_ = 0;
+  uint64_t generation_ = 0;
+  GraphicsPreparationPhase phase_ = GraphicsPreparationPhase::kIdle;
+  bool active_ = false;
+  bool finished_ = false;
+  bool complete_ = false;
+  bool has_catalogue_ = false;
+  bool cancel_requested_ = false;
+  uint64_t service_slices_ = 0;
+  Clock::time_point started_at_;
+  Clock::time_point finished_at_;
+};
