+void PipelineCache::CancelShaderStoragePreparation() {
+  auto& preparation = command_processor_.preparation();
+  if (!preparation_running_ || preparation_cancelled_) {
+    return;
+  }
+  preparation_cancelled_ = true;
+  // Entries whose creation has not started are abandoned; describing the
+  // remaining stored pipelines as never enqueued covers them in the same step.
+  preparation.CancelPendingEntries();
+  preparation_next_description_ = preparation_descriptions_.size();
+  preparation.AdvancePhase(GraphicsPreparationPhase::kFinalizing);
+}
+
+void PipelineCache::StartPreparationWorkers(size_t logical_processor_count) {
+  // The translation pool was grown while the storage was read; only the creation
+  // pool is created here, sized once to the whole batch.
+  size_t creation_thread_count =
+      PreloadCreationThreadCount(preparation_descriptions_.size(), logical_processor_count, 0);
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+  preparation_creation_threads_.clear();
+  preparation_creation_threads_.reserve(creation_thread_count);
+  for (size_t thread_index = 0; thread_index < creation_thread_count; ++thread_index) {
+    std::unique_ptr<rex::thread::Thread> creation_thread = rex::thread::Thread::Create(
+        {}, [this, thread_index]() { PreparationCreationThread(thread_index); });
+    assert_not_null(creation_thread);
+    creation_thread->set_name("D3D12 Prep Pipelines");
+    preparation_creation_threads_.push_back(std::move(creation_thread));
+  }
+}
