diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..e0b9057 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -945,6 +945,23 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
 #endif
   rex::perf::Profiler::Flip();
 
+  // Presentation-side pacing instrumentation (patches/rexglue-sdk/0004): the
+  // GPU thread's own view of the frame cadence, which is available even in
+  // Release builds where the perf counters above are compiled out.
+  {
+    static uint64_t present_index = 0;
+    static uint64_t last_present_tick = 0;
+    uint64_t now_tick = rex::chrono::Clock::QueryHostTickCount();
+    uint64_t dt_us = 0;
+    if (last_present_tick) {
+      dt_us =
+          (now_tick - last_present_tick) * 1000000 / rex::chrono::Clock::QueryHostTickFrequency();
+    }
+    last_present_tick = now_tick;
+    REXKRNL_IMPORT_TRACE("XE_SWAP", "n={} dt_us={} guest_tick={}", ++present_index, dt_us,
+                         rex::chrono::Clock::QueryGuestTickCount());
+  }
+
   // Xenia-specific VdSwap hook.
   // VdSwap will post this to tell us we need to swap the screen/fire an
   // interrupt.
diff --git a/src/kernel/xam/xam_input.cpp b/src/kernel/xam/xam_input.cpp
index 80c3634..fa46fec 100644
--- a/src/kernel/xam/xam_input.cpp
+++ b/src/kernel/xam/xam_input.cpp
@@ -9,6 +9,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <rex/chrono/clock.h>
 #include <rex/input/input.h>
 #include <rex/input/input_system.h>
 #include <rex/kernel/xam/private.h>
@@ -112,7 +113,22 @@ u32 XamInputGetState_entry(u32 user_index, u32 flags, ppc_ptr_t<X_INPUT_STATE> i
   }
 
   auto* is = input_system();
-  return is->GetState(actual_user_index, input_state);
+  X_RESULT result = is->GetState(actual_user_index, input_state);
+  if (input_state) {
+    // Input polling instrumentation (patches/rexglue-sdk/0004): every poll with
+    // the pad state the guest actually received, so the poll cadence and the
+    // visibility of injected keystrokes can be measured. The first five calls
+    // above keep the plain boot-time trace.
+    const rex::input::X_INPUT_GAMEPAD& pad = input_state->gamepad;
+    REXKRNL_IMPORT_TRACE("XamInputGetState",
+                         "user={} flags={:#x} st={:#x} buttons={:#06x} lt={} rt={} lx={} ly={} "
+                         "rx={} ry={} guest_tick={}",
+                         actual_user_index, (uint32_t)flags, (uint32_t)result, (uint32_t)pad.buttons,
+                         (uint32_t)pad.left_trigger, (uint32_t)pad.right_trigger,
+                         (int32_t)pad.thumb_lx, (int32_t)pad.thumb_ly, (int32_t)pad.thumb_rx,
+                         (int32_t)pad.thumb_ry, rex::chrono::Clock::QueryGuestTickCount());
+  }
+  return result;
 }
 
