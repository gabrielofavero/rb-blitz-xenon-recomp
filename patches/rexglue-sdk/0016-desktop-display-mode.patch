+
+bool WindowSDL::ApplyDisplayModeNow() {
+  SDL_Rect old_rect{};
+  SDL_GetWindowPosition(sdl_window_, &old_rect.x, &old_rect.y);
+  SDL_GetWindowSize(sdl_window_, &old_rect.w, &old_rect.h);
+  const SDL_WindowFlags old_flags = SDL_GetWindowFlags(sdl_window_);
+  const SDL_DisplayID display = SDL_GetDisplayForWindow(sdl_window_);
+  const auto restore = [&] {
+    SDL_SetWindowFullscreen(sdl_window_, (old_flags & SDL_WINDOW_FULLSCREEN) != 0);
+    SDL_SetWindowBordered(sdl_window_, (old_flags & SDL_WINDOW_BORDERLESS) == 0);
+    if (!(old_flags & SDL_WINDOW_FULLSCREEN)) {
+      SDL_SetWindowSize(sdl_window_, old_rect.w, old_rect.h);
+      SDL_SetWindowPosition(sdl_window_, old_rect.x, old_rect.y);
+    }
+    if (!(old_flags & SDL_WINDOW_HIDDEN)) {
+      SDL_SyncWindow(sdl_window_);
+    }
+    REXLOG_ERROR("Window display-mode transition failed: {}", SDL_GetError());
+    return false;
+  };
+  const bool desktop_mode = IsFullscreen() || IsBorderless();
+  if (!desktop_mode_applied_) {
+    windowed_bounds_ = old_rect;
+  }
+  SDL_Rect target_windowed = windowed_bounds_;
+  if (!desktop_mode && desktop_mode_applied_) {
+    SDL_Rect usable{};
+    if (display && SDL_GetDisplayUsableBounds(display, &usable)) {
+      int top = 0, left = 0, bottom = 0, right = 0;
+      SDL_GetWindowBordersSize(sdl_window_, &top, &left, &bottom, &right);
+      const int limit_w = std::max(1, usable.w - left - right);
+      const int limit_h = std::max(1, usable.h - top - bottom);
+      if (target_windowed.w > limit_w || target_windowed.h > limit_h) {
+        const double scale = std::min(double(limit_w) / std::max(1, target_windowed.w),
+                                      double(limit_h) / std::max(1, target_windowed.h));
+        target_windowed.w = std::max(1, int(std::floor(target_windowed.w * scale)));
+        target_windowed.h = std::max(1, int(std::floor(target_windowed.h * scale)));
+      }
+      target_windowed.x = std::clamp(target_windowed.x, usable.x + left,
+                                     usable.x + usable.w - right - target_windowed.w);
+      target_windowed.y = std::clamp(target_windowed.y, usable.y + top,
+                                     usable.y + usable.h - bottom - target_windowed.h);
+    }
+  }
+  if (IsFullscreen()) {
+    // Desktop fullscreen, without requesting an exclusive display mode.
+    if (!SDL_SetWindowFullscreen(sdl_window_, true)) {
+      return restore();
+    }
+  } else {
+    if ((SDL_GetWindowFlags(sdl_window_) & SDL_WINDOW_FULLSCREEN) &&
+        !SDL_SetWindowFullscreen(sdl_window_, false)) {
+      return restore();
+    }
+    if (IsBorderless()) {
+      SDL_Rect bounds{};
+      if (!display || !SDL_GetDisplayBounds(display, &bounds)) {
+        return restore();
+      }
+      if (!SDL_SetWindowBordered(sdl_window_, false) ||
+          !SDL_SetWindowPosition(sdl_window_, bounds.x, bounds.y) ||
+          !SDL_SetWindowSize(sdl_window_, bounds.w, bounds.h)) {
+        return restore();
+      }
+    } else if (desktop_mode_applied_) {
+      if (!SDL_SetWindowBordered(sdl_window_, true) ||
+          !SDL_SetWindowSize(sdl_window_, target_windowed.w, target_windowed.h) ||
+          !SDL_SetWindowPosition(sdl_window_, target_windowed.x, target_windowed.y)) {
+        return restore();
+      }
+    }
+  }
+  if (!(old_flags & SDL_WINDOW_HIDDEN) && !SDL_SyncWindow(sdl_window_)) {
+    return restore();
+  }
+  const SDL_WindowFlags actual = SDL_GetWindowFlags(sdl_window_);
+  if (((actual & SDL_WINDOW_FULLSCREEN) != 0) != IsFullscreen() ||
+      (!IsFullscreen() && (((actual & SDL_WINDOW_BORDERLESS) != 0) != IsBorderless()))) {
+    return restore();
+  }
+  desktop_mode_applied_ = desktop_mode;
+  if (!desktop_mode) {
+    windowed_bounds_ = target_windowed;
+  }
+  LogDisplayMode();
+  return true;
+}
