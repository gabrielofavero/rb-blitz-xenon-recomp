+
+void WindowSDL::ApplyDisplayModeNow() {
+  const bool desktop_mode = IsFullscreen() || IsBorderless();
+  if (!desktop_mode_applied_) {
+    SDL_GetWindowPosition(sdl_window_, &windowed_bounds_.x, &windowed_bounds_.y);
+    SDL_GetWindowSize(sdl_window_, &windowed_bounds_.w, &windowed_bounds_.h);
+  }
+  if (IsFullscreen()) {
+    // Desktop fullscreen, without requesting an exclusive display mode.
+    if (!SDL_SetWindowFullscreen(sdl_window_, true)) {
+      REXLOG_ERROR("SDL_SetWindowFullscreen failed: {}", SDL_GetError());
+    }
+  } else {
+    if ((SDL_GetWindowFlags(sdl_window_) & SDL_WINDOW_FULLSCREEN) &&
+        !SDL_SetWindowFullscreen(sdl_window_, false)) {
+      REXLOG_ERROR("Leaving SDL fullscreen failed: {}", SDL_GetError());
+      return;
+    }
+    if (IsBorderless()) {
+      SDL_Rect bounds{};
+      const SDL_DisplayID display = SDL_GetDisplayForWindow(sdl_window_);
+      if (!display || !SDL_GetDisplayBounds(display, &bounds)) {
+        REXLOG_ERROR("Getting borderless display bounds failed: {}", SDL_GetError());
+        return;
+      }
+      SDL_SetWindowBordered(sdl_window_, false);
+      SDL_SetWindowPosition(sdl_window_, bounds.x, bounds.y);
+      SDL_SetWindowSize(sdl_window_, bounds.w, bounds.h);
+    } else if (desktop_mode_applied_) {
+      SDL_SetWindowBordered(sdl_window_, true);
+      SDL_SetWindowSize(sdl_window_, windowed_bounds_.w, windowed_bounds_.h);
+      SDL_SetWindowPosition(sdl_window_, windowed_bounds_.x, windowed_bounds_.y);
+    }
+  }
+  desktop_mode_applied_ = desktop_mode;
+  LogDisplayMode();
+}
+
+void WindowSDL::LogDisplayMode() const {
+  int width = 0, height = 0;
+  SDL_GetWindowSizeInPixels(sdl_window_, &width, &height);
+  const SDL_WindowFlags flags = SDL_GetWindowFlags(sdl_window_);
+  REXLOG_INFO("Window mode: requested={} SDL fullscreen={} bordered={} pixels={}x{}",
+              IsFullscreen() ? "fullscreen" : IsBorderless() ? "borderless" : "windowed",
+              (flags & SDL_WINDOW_FULLSCREEN) != 0, (flags & SDL_WINDOW_BORDERLESS) == 0,
+              width, height);
 }
 
