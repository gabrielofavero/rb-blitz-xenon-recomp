   }
 }
 
+// Local patch (patches/rexglue-sdk/0010-input-system-state-filter.patch): the seam the
+// remap of the guest's pad lives behind.
+void InputSystem::SetStateFilter(StateFilter filter) {
+  state_filter_ = std::move(filter);
+}
+
 void InputSystem::RefreshDevices() {
   std::vector<DeviceInfo> seen;
   std::vector<InputDriver*> owners;
@@ -246,6 +252,9 @@ X_RESULT InputSystem::GetState(uint32_t user_index, X_INPUT_STATE* out_state) {
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
   if (out_state) {
+    if (state_filter_) {
+      state_filter_(user_index, merged);
+    }
     *out_state = merged;
   }
   return X_ERROR_SUCCESS;
