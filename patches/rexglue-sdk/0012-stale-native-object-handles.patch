+// True when an object resolved for a native pointer may be used as a T. The
+// dispatch header's own type is what GetNativeObject validates; this is the
+// caller's expectation on top of it, because the caller reaches the object
+// through a typed pointer (an event entry point that is handed a semaphore's
+// object would read the wrong member). XObject itself accepts any object.
+template <typename T>
+bool NativeObjectIsTypeOf(const XObject* object) {
+  if constexpr (requires { T::kObjectType; }) {
+    return object->type() == T::kObjectType;
+  } else {
+    (void)object;
+    return true;
+  }
+}
