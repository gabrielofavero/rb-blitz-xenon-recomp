+void XObject::ReportNativeObjectAnomaly(const char* what, const void* native_ptr, int32_t as_type,
+                                        const XObject* object) {
+  static std::atomic<int> reported{0};
+  static constexpr int kReportLimit = 16;
+  const int n = reported.fetch_add(1);
+  if (n >= kReportLimit) {
+    if (n == kReportLimit) {
+      REXLOG_WARN("object: further native-object anomalies this run are not logged ({} reported)",
+                  n);
+    }
+    return;
+  }
+  if (object) {
+    REXLOG_WARN(
+        "object: {} at {:08X}: the dispatch header names a {} (type byte {}), and the object the "
+        "stashed handle names is a {} (handle {:08X})",
+        what, reinterpret_cast<uintptr_t>(native_ptr), DispatchObjectType(as_type), as_type,
+        object->type(), object->handle());
+  } else {
+    REXLOG_WARN(
+        "object: {} at {:08X}: the dispatch header names a {} (type byte {}) (thread {:08X})", what,
+        reinterpret_cast<uintptr_t>(native_ptr), DispatchObjectType(as_type), as_type,
+        rex::thread::current_thread_id());
   }
