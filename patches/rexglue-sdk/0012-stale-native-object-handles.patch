+  auto object = GetNativeObject(kernel_state, native_ptr, as_type);
+  if (object && !NativeObjectIsTypeOf<T>(object.get())) {
+    ReportNativeObjectAnomaly("caller and dispatch header disagree", native_ptr, as_type,
+                              object.get());
+    object.reset();
+  }
+  return object_ref<T>(reinterpret_cast<T*>(object.release()));
 }
 
