+object_ref<XObject> XObject::LookupNativeObject(KernelState* kernel_state, void* native_ptr,
+                                               int32_t as_type) {
+  assert_not_null(native_ptr);
+
+  auto header = reinterpret_cast<X_DISPATCH_HEADER*>(native_ptr);
+  if (header->wait_list_flink != kXObjSignature) {
+    // Never initialised through this SDK, so there is no object to find: the
+    // structure is the guest's own, as it is before the first Ke* call on it.
+    return nullptr;
+  }
+  if (as_type == -1) {
+    as_type = header->type;
+  }
+  Type want = DispatchObjectType(as_type);
+  if (want == Type::Undefined) {
+    return nullptr;
+  }
+
+  // One lock over the handle read and the lookup, so the object found is the one
+  // the header named when it was read.
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  auto object = kernel_state->object_table()->LookupObject<XObject>(header->wait_list_blink);
+  if (!object) {
+    ReportNativeObjectAnomaly("stashed handle names no object", native_ptr, as_type, nullptr);
+    return nullptr;
+  }
+  if (object->type() != want) {
+    ReportNativeObjectAnomaly("stashed handle names another type", native_ptr, as_type,
+                              object.get());
+    return nullptr;
+  }
+  return object;
+}
