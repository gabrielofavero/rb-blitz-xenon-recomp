+namespace {
+// The object type an X_DISPATCH_HEADER's type field names, or Undefined when
+// this SDK hands out no object for it. These are the types this SDK can have
+// stashed a handle into: XEvent and XThread create their guest structure
+// (CreateNative), and events, mutants and semaphores that the guest initialises
+// itself get one stashed on first use (GetNativeObject). A thread's structure is
+// included because ObLookupThreadByThreadId hands the guest a thread pointer it
+// expects to be able to dereference again.
+XObject::Type DispatchObjectType(int32_t dispatch_type) {
+  switch (dispatch_type) {
+    case 0x00:  // EventNotificationObject (manual reset)
+    case 0x01:  // EventSynchronizationObject (auto reset)
+      return XObject::Type::Event;
+    case 0x02:  // MutantObject
+      return XObject::Type::Mutant;
+    case 0x05:  // SemaphoreObject
+      return XObject::Type::Semaphore;
+    case 0x06:  // ThreadObject
+      return XObject::Type::Thread;
+    default:
+      return XObject::Type::Undefined;
+  }
+}
+}  // namespace
