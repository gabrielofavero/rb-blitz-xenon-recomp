diff --git a/include/rex/graphics/vulkan/texture_descriptor_cache.h b/include/rex/graphics/vulkan/texture_descriptor_cache.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/texture_descriptor_cache.h
@@ -0,0 +1,94 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <span>
+#include <unordered_map>
+#include <vector>
+#include <vulkan/vulkan.h>
+
+namespace rex::graphics::vulkan {
+
+// Immutable descriptor sets borrowed from the existing transient allocator.
+// Clear before a new submission/frame or pool reset. Resource retirement and
+// set recycling remain the allocator's responsibility. Lookups allocate nothing.
+class TextureDescriptorCache {
+ public:
+  struct View {
+    VkDescriptorSetLayout layout;
+    std::span<const VkDescriptorImageInfo> textures;
+    std::span<const VkDescriptorImageInfo> samplers;
+  };
+
+  explicit TextureDescriptorCache(size_t capacity = 1024) : capacity_(capacity) {}
+
+  VkDescriptorSet Find(View view) const {
+    auto it = sets_.find(view);
+    return it == sets_.end() ? VK_NULL_HANDLE : it->second;
+  }
+
+  void Insert(View view, VkDescriptorSet set) {
+    if (set == VK_NULL_HANDLE || sets_.size() >= capacity_) return;
+    sets_.try_emplace(Key{view.layout,
+        {view.textures.begin(), view.textures.end()},
+        {view.samplers.begin(), view.samplers.end()}}, set);
+  }
+
+  void Clear() { sets_.clear(); }
+  size_t size() const { return sets_.size(); }
+
+ private:
+  struct Key {
+    VkDescriptorSetLayout layout;
+    std::vector<VkDescriptorImageInfo> textures;
+    std::vector<VkDescriptorImageInfo> samplers;
+    View view() const { return {layout, textures, samplers}; }
+  };
+
+  struct Hasher {
+    using is_transparent = void;
+    size_t operator()(const Key& key) const { return (*this)(key.view()); }
+    size_t operator()(View view) const {
+      size_t hash = std::hash<VkDescriptorSetLayout>{}(view.layout);
+      auto add = [&](size_t value) {
+        hash ^= value + size_t(0x9e3779b9) + (hash << 6) + (hash >> 2);
+      };
+      add(view.textures.size());
+      add(view.samplers.size());
+      // Ignore fields unused by each descriptor type and all struct padding.
+      for (const auto& texture : view.textures) {
+        add(std::hash<VkImageView>{}(texture.imageView));
+        add(size_t(texture.imageLayout));
+      }
+      for (const auto& sampler : view.samplers) {
+        add(std::hash<VkSampler>{}(sampler.sampler));
+      }
+      return hash;
+    }
+  };
+
+  struct Equal {
+    using is_transparent = void;
+    bool operator()(const Key& a, const Key& b) const { return (*this)(a.view(), b.view()); }
+    bool operator()(const Key& a, View b) const { return (*this)(a.view(), b); }
+    bool operator()(View a, const Key& b) const { return (*this)(a, b.view()); }
+    bool operator()(View a, View b) const {
+      if (a.layout != b.layout || a.textures.size() != b.textures.size() ||
+          a.samplers.size() != b.samplers.size()) return false;
+      for (size_t i = 0; i < a.textures.size(); ++i) {
+        if (a.textures[i].imageView != b.textures[i].imageView ||
+            a.textures[i].imageLayout != b.textures[i].imageLayout) return false;
+      }
+      for (size_t i = 0; i < a.samplers.size(); ++i) {
+        if (a.samplers[i].sampler != b.samplers[i].sampler) return false;
+      }
+      return true;
+    }
+  };
+
+  size_t capacity_;
+  std::unordered_map<Key, VkDescriptorSet, Hasher, Equal> sets_;
+};
+
+}  // namespace rex::graphics::vulkan
