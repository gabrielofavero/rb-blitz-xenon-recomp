@@ -0,0 +1,29 @@
+// Worker-to-command-processor handoff. Driver calls run before Push, outside
+// the mutex. Taking a batch never waits for unfinished compilation.
+#pragma once
+
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics {
+template <typename T>
+class PipelineCompletionQueue {
+ public:
+  void Push(T completion) {
+    std::lock_guard lock(mutex_);
+    completions_.push_back(std::move(completion));
+  }
+
+  std::vector<T> Take() {
+    std::vector<T> completions;
+    std::lock_guard lock(mutex_);
+    completions.swap(completions_);
+    return completions;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::vector<T> completions_;
+};
+}  // namespace rex::graphics
