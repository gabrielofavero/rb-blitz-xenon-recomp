+// Whether the guest format stores 32-bit-per-component data that isn't
+// floating-point, which thus needs to be converted for a host texture (see the
+// k_32 comment in host_formats_).
+bool IsFixedPointConvertedFormat(xenos::TextureFormat format) {
+  return format == xenos::TextureFormat::k_32 || format == xenos::TextureFormat::k_32_32 ||
+         format == xenos::TextureFormat::k_32_32_32_32;
+}
+
+// Converts the 32-bit components of a big-endian guest texture region to the
+// floating-point values with the same meaning (used for the guest formats that
+// aren't floating-point, such as 0.32 fixed-point ones), using the same math as
+// the vertex fetch for such formats. The conversion is done in-place for each
+// component without any assumptions about the layout (tiling, mip packing and
+// so on), as it doesn't change it - so the load shaders can still be used to
+// load the converted data.
+void ConvertFixedPointGuestRange(const uint8_t* source, uint8_t* destination, uint32_t size_bytes,
+                                 xenos::Endian endianness, bool is_signed) {
+  std::memcpy(destination, source, size_bytes);
+  uint32_t component_count = size_bytes >> 2;
+  uint32_t* destination_components = reinterpret_cast<uint32_t*>(destination);
+  for (uint32_t i = 0; i < component_count; ++i) {
+    // Store the floating-point bits in the byte order of the guest data, since
+    // the load shaders apply the endianness conversion from the load constant
+    // to what they read.
+    uint32_t guest_value = xenos::GpuSwap(destination_components[i], endianness);
+    float converted_value;
+    if (is_signed) {
+      // Signed repeating fraction (the only mode supported for textures,
+      // kZeroClampMinusOne) - 1 / (2^31 - 1), with the most negative value
+      // rounded to -1 as float32, so no clamping is needed.
+      converted_value = float(int32_t(guest_value)) * (1.0f / 2147483647.0f);
+    } else {
+      // Unsigned repeating fraction - 1 / (2^32 - 1).
+      converted_value = float(guest_value) * (1.0f / 4294967295.0f);
+    }
+    uint32_t converted_value_bits;
+    std::memcpy(&converted_value_bits, &converted_value, sizeof(converted_value_bits));
+    destination_components[i] = xenos::GpuSwap(converted_value_bits, endianness);
+  }
+}
