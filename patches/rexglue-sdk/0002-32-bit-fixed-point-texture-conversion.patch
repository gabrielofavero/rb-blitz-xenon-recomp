+    staging = &conversion_buffers_.back();
+  }
+  staging->submission = command_processor_.GetCurrentSubmission();
+  auto& gpu_memory = static_cast<VulkanSharedMemory&>(shared_memory());
+  const auto* vulkan_device = command_processor_.GetVulkanDevice();
+  VkDescriptorSet sets[2];
+  VkDescriptorBufferInfo buffers[2] = {
+      {staging->buffer, 0, range}, {gpu_memory.buffer(), guest_address, range}};
+  VkWriteDescriptorSet writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    sets[i] = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+    if (sets[i] == VK_NULL_HANDLE) return false;
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = sets[i];
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    writes[i].pBufferInfo = &buffers[i];
