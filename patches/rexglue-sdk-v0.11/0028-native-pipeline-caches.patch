+file(GLOB_RECURSE _native_cache_inputs CONFIGURE_DEPENDS
+     "${REXGLUE_ROOT}/src/gpu/*.cpp" "${REXGLUE_ROOT}/src/gpu/*.h"
+     "${REXGLUE_ROOT}/include/rex/gpu/*.h" "${REXGLUE_ROOT}/include/rex/xenos/*.h"
+     "${REXGLUE_ROOT}/src/gpu/CMakeLists.txt")
