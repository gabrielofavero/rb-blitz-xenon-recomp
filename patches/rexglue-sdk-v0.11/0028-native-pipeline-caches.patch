+  const std::vector<rex::u8> first{1,2,3}, second{4,5,6,7};
+  REQUIRE(store.Stage(1, first.data(), first.size())); REQUIRE(store.Flush() == 1);
+  REQUIRE(store.Stage(1, second.data(), second.size())); REQUIRE(store.Flush() == 1);
+  std::vector<rex::u8> loaded; REQUIRE(store.Load(1, loaded)); CHECK(loaded == second);
+  identity.source_build = "patched-sdk-b";
+  REQUIRE(store.Configure(folder.path, identity)); CHECK_FALSE(store.Load(1, loaded));
+  REQUIRE(store.Stage(2, first.data(), first.size()));
+  store.Reset(); CHECK(store.Flush() == 0); CHECK_FALSE(store.Has(2));
+  identity.source_build.clear(); CHECK_FALSE(store.Configure(folder.path, identity));
+}
