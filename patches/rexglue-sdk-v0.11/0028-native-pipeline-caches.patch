+#pragma once
+#include <mutex>
+#include <shared_mutex>
+#include <utility>
+#include "gpu/xenos/host/vulkan/api.h"
+
+namespace rex::gpu::vulkan {
+/** Keeps cache creation users alive until serialization or destruction acquires exclusive access. */
+class NativePipelineCacheAccess {
+ public:
+  template <typename Callback> decltype(auto) Use(Callback&& callback) const {
+    std::shared_lock lock(mutex_);
+    return std::forward<Callback>(callback)(cache_);
+  }
+  template <typename Callback> decltype(auto) Exclusive(Callback&& callback) const {
+    std::unique_lock lock(mutex_);
+    return std::forward<Callback>(callback)(cache_);
+  }
+ private:
+  mutable std::shared_mutex mutex_;
+  mutable VkPipelineCache cache_ = VK_NULL_HANDLE;
+};
+}  // namespace rex::gpu::vulkan
