+// The adapter and driver build a cached PSO blob belongs to. A Direct3D 12
+// cached blob is only meaningful for the driver that produced it, so this is
+// part of the cache identity rather than a property of one entry - and the
+// desc-based vendor lookup alone is not enough, because two driver builds on the
+// same adapter produce incompatible blobs.
+void FillNativeAdapterIdentity(const gpu::d3d12::D3D12Provider& provider,
+                               NativeAdapterIdentity& adapter_out) {
+  adapter_out = NativeAdapterIdentity();
+  adapter_out.vendor = uint32_t(provider.GetAdapterVendorID());
+  ID3D12Device* device = provider.GetDevice();
+  IDXGIFactory2* factory = provider.GetDXGIFactory();
+  if (!device || !factory) {
+    return;
+  }
+  Microsoft::WRL::ComPtr<IDXGIFactory4> factory_4;
+  if (FAILED(factory->QueryInterface(IID_PPV_ARGS(&factory_4))) || !factory_4) {
+    return;
+  }
+  Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+  if (FAILED(factory_4->EnumAdapterByLuid(device->GetAdapterLuid(), IID_PPV_ARGS(&adapter))) ||
+      !adapter) {
+    return;
+  }
+  DXGI_ADAPTER_DESC1 adapter_description;
+  std::memset(&adapter_description, 0, sizeof(adapter_description));
+  if (SUCCEEDED(adapter->GetDesc1(&adapter_description))) {
+    adapter_out.vendor = adapter_description.VendorId;
+    adapter_out.device = adapter_description.DeviceId;
+    adapter_out.subsystem = adapter_description.SubSysId;
+    adapter_out.revision = adapter_description.Revision;
+  }
+  // The UMD version is what makes a cached blob incompatible after a driver
+  // update; the WDDM version CheckInterfaceSupport also accepts is irrelevant
+  // here. Not every driver implements it, so zero means "unknown" and the blob
+  // is still guarded by the driver's own validation and the retry in
+  // CreateD3D12Pipeline.
+  LARGE_INTEGER umd_version;
+  umd_version.QuadPart = 0;
+  if (SUCCEEDED(adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &umd_version))) {
+    adapter_out.driver_version = uint32_t(uint64_t(umd_version.QuadPart) >> 32);
+    adapter_out.driver_version_low = uint64_t(uint32_t(umd_version.QuadPart));
+  }
+}
