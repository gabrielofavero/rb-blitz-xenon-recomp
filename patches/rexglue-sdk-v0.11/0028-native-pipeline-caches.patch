+#include "gpu/xenos/shaders/bytecode/d3d12_5_1/fullscreen_cw_vs.h"
+}
+
+REX_TEST_CASE("Native D3D12 cached PSO round trip and rejection preserve ordinary creation", "[gpu][native_pipeline_cache][native_d3d12]") {
+  const auto enabled = rex::platform::GetEnvironmentValue("REX_RUN_NATIVE_GPU_TESTS");
+  if (!enabled || *enabled != "1") SKIP("Set REX_RUN_NATIVE_GPU_TESTS=1 on a D3D12 host");
+  using Microsoft::WRL::ComPtr;
+  ComPtr<ID3D12Device> device;
+  if (FAILED(D3D12CreateDevice(nullptr, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device))))
+    SKIP("No D3D12 device available");
+  D3D12_ROOT_SIGNATURE_DESC root_desc = {};
+  ComPtr<ID3DBlob> serialized, errors;
+  REQUIRE(SUCCEEDED(D3D12SerializeRootSignature(&root_desc, D3D_ROOT_SIGNATURE_VERSION_1,
+                                               &serialized, &errors)));
+  ComPtr<ID3D12RootSignature> root;
+  REQUIRE(SUCCEEDED(device->CreateRootSignature(0, serialized->GetBufferPointer(),
+                                               serialized->GetBufferSize(), IID_PPV_ARGS(&root))));
+  D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = {};
+  desc.pRootSignature = root.Get();
+  desc.VS = {kFullscreenCWVS, sizeof(kFullscreenCWVS)};
+  desc.SampleMask = UINT_MAX;
+  desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+  desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+  desc.RasterizerState.DepthClipEnable = TRUE;
+  auto& blend = desc.BlendState.RenderTarget[0];
+  blend.SrcBlend = blend.SrcBlendAlpha = D3D12_BLEND_ONE;
+  blend.DestBlend = blend.DestBlendAlpha = D3D12_BLEND_ZERO;
+  blend.BlendOp = blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+  blend.LogicOp = D3D12_LOGIC_OP_NOOP;
+  desc.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+  for (auto* face : {&desc.DepthStencilState.FrontFace, &desc.DepthStencilState.BackFace}) {
+    face->StencilFailOp = face->StencilDepthFailOp = face->StencilPassOp = D3D12_STENCIL_OP_KEEP;
+    face->StencilFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+  }
+  desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+  desc.SampleDesc.Count = 1;
+  ComPtr<ID3D12PipelineState> first;
+  REQUIRE(SUCCEEDED(device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&first))));
+  ComPtr<ID3DBlob> native;
+  REQUIRE(SUCCEEDED(first->GetCachedBlob(&native)));
+  REQUIRE(native->GetBufferSize() > 0);
+  desc.CachedPSO = {native->GetBufferPointer(), native->GetBufferSize()};
+  bool loaded = true;
+  unsigned attempts = 0, rejected = 0;
+  ComPtr<ID3D12PipelineState> warm;
+  auto create = [&] { ++attempts; return device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&warm)); };
+  REQUIRE(SUCCEEDED(rex::gpu::d3d12::CreateWithCachedPSOFallback(desc.CachedPSO, loaded,
+      create, [&](HRESULT) { ++rejected; })));
+  CHECK(loaded); CHECK(attempts == 1); CHECK(rejected == 0);
+  warm.Reset();
+  std::vector<unsigned char> invalid(64, 0xFF);
+  desc.CachedPSO = {invalid.data(), invalid.size()};
+  loaded = true; attempts = rejected = 0;
+  REQUIRE(SUCCEEDED(rex::gpu::d3d12::CreateWithCachedPSOFallback(desc.CachedPSO, loaded,
+      create, [&](HRESULT) { ++rejected; })));
+  CHECK_FALSE(loaded); CHECK(attempts == 2); CHECK(rejected == 1); CHECK(warm != nullptr);
+  CHECK(desc.CachedPSO.pCachedBlob == nullptr);
+}
+#endif
