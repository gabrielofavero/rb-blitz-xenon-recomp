+namespace rex::gpu::d3d12 {
+/** A rejected driver blob must not reject the portable pipeline recipe. */
+template <typename Create, typename Rejected>
+HRESULT CreateWithCachedPSOFallback(D3D12_CACHED_PIPELINE_STATE& cached, bool& loaded,
+                                    Create&& create, Rejected&& rejected) {
+  HRESULT result = create();
+  if (FAILED(result) && loaded) {
+    std::forward<Rejected>(rejected)(result);
+    cached = {};
+    loaded = false;
+    result = create();
+  }
+  return result;
+}
+}  // namespace rex::gpu::d3d12
