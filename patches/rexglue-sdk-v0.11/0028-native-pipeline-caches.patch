+  std::vector<rex::u8> decoded;
+  REQUIRE(NativePipelineCacheStore::DecodeEntry(bytes, 42, 7, decoded));
+  NativePipelineCacheEntryHeader header;
+  std::memcpy(&header, bytes.data(), sizeof(header));
+  header.reserved2 = 1; std::memcpy(bytes.data(), &header, sizeof(header));
+  CHECK_FALSE(NativePipelineCacheStore::DecodeEntry(bytes, 42, 7, decoded));
+  CHECK(NativePipelineCacheStore::EncodeEntry(42, 7, nullptr, 0).empty());
+}
