diff --git a/tests/unit/gpu/native_pipeline_cache_access_test.cpp b/tests/unit/gpu/native_pipeline_cache_access_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/native_pipeline_cache_access_test.cpp
@@ -0,0 +1,51 @@
+#include "rex_test.h"
+#include "gpu/xenos/host/vulkan/native_pipeline_cache_access.h"
+#include <atomic>
+#include <chrono>
+#include <future>
+#include <thread>
+
+using rex::gpu::vulkan::NativePipelineCacheAccess;
+using namespace std::chrono_literals;
+
+REX_TEST_CASE("Native pipeline cache destruction waits for all creation users", "[gpu][native_pipeline_cache]") {
+  NativePipelineCacheAccess access;
+  std::atomic<bool> null_cache{false};
+  std::promise<void> entered, release;
+  auto released = release.get_future().share();
+  auto creation = std::async(std::launch::async, [&] {
+    access.Use([&](VkPipelineCache cache) {
+      null_cache = cache == VK_NULL_HANDLE;
+      entered.set_value();
+      released.wait();
+    });
+  });
+  entered.get_future().wait();
+  std::promise<void> waiting;
+  std::atomic<bool> exclusive{false};
+  auto destroy = std::async(std::launch::async, [&] {
+    waiting.set_value();
+    access.Exclusive([&](VkPipelineCache& cache) { exclusive = true; cache = VK_NULL_HANDLE; });
+  });
+  waiting.get_future().wait();
+  const auto state = destroy.wait_for(20ms);
+  release.set_value();
+  creation.get(); destroy.get();
+  CHECK(null_cache.load());
+  CHECK(state == std::future_status::timeout);
+  CHECK(exclusive.load());
+}
+
+REX_TEST_CASE("Independent devices never share a native pipeline cache lock", "[gpu][native_pipeline_cache]") {
+  NativePipelineCacheAccess first, second;
+  std::promise<void> entered, release;
+  auto released = release.get_future().share();
+  auto creation = std::async(std::launch::async, [&] {
+    first.Use([&](VkPipelineCache) { entered.set_value(); released.wait(); });
+  });
+  entered.get_future().wait();
+  auto other = std::async(std::launch::async, [&] { second.Exclusive([](VkPipelineCache& cache) { cache = VK_NULL_HANDLE; }); });
+  const auto state = other.wait_for(5s);
+  release.set_value(); creation.get(); other.get();
+  CHECK(state == std::future_status::ready);
+}
