+namespace {
+NativeAdapterIdentity GetNativeAdapterIdentity(const gpu::vulkan::VulkanDevice& device) {
+  NativeAdapterIdentity identity;
+  const auto& properties = device.GetProperties();
+  identity.vendor = properties.vendorID;
+  identity.device = properties.deviceID;
+  identity.driver_version = properties.driverVersion;
+  std::memcpy(identity.device_uuid, properties.pipelineCacheUUID, VK_UUID_SIZE);
+  std::memcpy(identity.driver_uuid, properties.driverUUID, VK_UUID_SIZE);
+  return identity;
+}
+
+bool ValidateVulkanCacheData(const std::vector<u8>& data, const NativeAdapterIdentity& adapter) {
+  if (data.size() < sizeof(VkPipelineCacheHeaderVersionOne)) return false;
+  VkPipelineCacheHeaderVersionOne header;
+  std::memcpy(&header, data.data(), sizeof(header));
+  return header.headerVersion == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+         header.headerSize == sizeof(header) && header.vendorID == adapter.vendor &&
+         header.deviceID == adapter.device &&
+         std::memcmp(header.pipelineCacheUUID, adapter.device_uuid, VK_UUID_SIZE) == 0;
+}
+
+VkPipelineCacheCreateInfo NativeCacheCreateInfo(const std::vector<u8>& bytes) {
+  VkPipelineCacheCreateInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+  info.initialDataSize = bytes.size();
+  info.pInitialData = bytes.empty() ? nullptr : bytes.data();
+  return info;
+}
+}  // namespace
+
+void VulkanPipelineCache::OpenNativeCache(const std::filesystem::path& root, u32 title_id,
+                                          bool interlock) {
+  CloseNativeCache();
+  if (!command_processor_.GetXenosSettings().native_pipeline_cache.Get()) return;
+  const auto* device = command_processor_.GetVulkanDevice();
+  if (!device) return;
+  NativePipelineCacheIdentity identity;
+  identity.backend = GraphicsPreparationBackend::kVulkan;
+  identity.title_id = title_id;
+  identity.render_path = interlock ? 1u : 0u;
+  identity.pipeline_schema_version = PipelineDescription::kVersion;
+  identity.translator_version = SPIRVShaderTranslator::Modification::kVersion;
+  identity.source_build = REX_NATIVE_CACHE_SOURCE_BUILD ":" REXGLUE_BUILD_IDENTITY ":" REXGLUE_BUILD_CONFIG;
+  identity.adapter = GetNativeAdapterIdentity(*device);
+  if (!native_store_.Configure(root / std::format("{:08X}.{}.vk", title_id,
+                                                 interlock ? "fsi" : "fbo"), identity)) return;
+  std::vector<u8> stored;
+  bool loaded = native_store_.Load(kNativeCacheEntryKey, stored) &&
+                ValidateVulkanCacheData(stored, identity.adapter);
+  if (!loaded) {
+    native_store_.Forget(kNativeCacheEntryKey);
+    stored.clear();
+  }
+  const auto& dfn = device->GetFunctions();
+  const auto native_device = device->GetDevice();
+  const auto result = device->WithNativePipelineCacheExclusive([&](VkPipelineCache& cache) {
+    auto info = NativeCacheCreateInfo(stored);
+    VkResult created = dfn.vkCreatePipelineCache(native_device, &info, nullptr, &cache);
+    if (created != VK_SUCCESS && loaded) {
+      REXGPU_WARN("Vulkan rejected stored pipeline cache ({}); retrying an empty cache", i32(created));
+      loaded = false;
+      stored.clear();
+      info = NativeCacheCreateInfo(stored);
+      created = dfn.vkCreatePipelineCache(native_device, &info, nullptr, &cache);
+    }
+    if (created != VK_SUCCESS) cache = VK_NULL_HANDLE;
+    return created;
+  });
+  if (!loaded) native_store_.Forget(kNativeCacheEntryKey);
+  if (result != VK_SUCCESS) {
+    REXGPU_WARN("Vulkan pipeline cache unavailable ({}); creating pipelines normally", i32(result));
+    native_store_.Reset();
+    return;
+  }
+  native_loaded_data_ = std::move(stored);
+}
+
+void VulkanPipelineCache::SaveNativeCache(const char* reason, bool close) {
+  const auto* device = command_processor_.GetVulkanDevice();
+  if (!device) return;
+  const auto& dfn = device->GetFunctions();
+  const auto native_device = device->GetDevice();
+  const auto identity = native_store_.identity();
+  std::vector<u8> on_disk, data;
+  const bool merge = native_store_.Load(kNativeCacheEntryKey, on_disk) &&
+      on_disk != native_loaded_data_ && ValidateVulkanCacheData(on_disk, identity.adapter);
+  // Host I/O happens outside the exclusive section. Every helper/guest creation
+  // holds shared access through the complete driver call, including on UI threads.
+  device->WithNativePipelineCacheExclusive([&](VkPipelineCache& cache) {
+    if (!cache) return;
+    auto destroy = ScopeGuard([&] {
+      if (close) { dfn.vkDestroyPipelineCache(native_device, cache, nullptr); cache = VK_NULL_HANDLE; }
+    });
+    if (!native_store_.enabled()) return;
+    if (merge) {
+      const auto info = NativeCacheCreateInfo(on_disk);
+      VkPipelineCache source = VK_NULL_HANDLE;
+      if (dfn.vkCreatePipelineCache(native_device, &info, nullptr, &source) == VK_SUCCESS) {
+        dfn.vkMergePipelineCaches(native_device, cache, 1, &source);
+        dfn.vkDestroyPipelineCache(native_device, source, nullptr);
+      }
+    }
+    for (unsigned attempt = 0; attempt < 3; ++attempt) {
+      size_t size = 0;
+      auto result = dfn.vkGetPipelineCacheData(native_device, cache, &size, nullptr);
+      if (result != VK_SUCCESS || !size || size > NativePipelineCacheStore::kMaxEntryBytes) return;
+      data.resize(size);
+      result = dfn.vkGetPipelineCacheData(native_device, cache, &size, data.data());
+      if (result == VK_INCOMPLETE) continue;
+      if (result != VK_SUCCESS || size > data.size()) { data.clear(); return; }
+      data.resize(size);
+      return;
+    }
+    data.clear();
+  });
+  if (ValidateVulkanCacheData(data, identity.adapter) &&
+      native_store_.Stage(kNativeCacheEntryKey, data.data(), data.size())) {
+    native_loaded_data_ = std::move(data);
+  }
+  const auto written = native_store_.Flush();
+  if (written) REXGPU_INFO("Native pipeline cache {}: {}", reason, native_store_.Summary());
+}
+
+void VulkanPipelineCache::CloseNativeCache() {
+  SaveNativeCache("at shader storage shutdown", true);
+  native_loaded_data_.clear();
+  native_store_.Reset();
+}
