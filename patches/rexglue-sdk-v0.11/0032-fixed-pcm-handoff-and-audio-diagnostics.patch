 void SDL3AudioDriver::Pull(SDL_AudioStream* stream, int additional_amount) {
-  const u32 samples = static_cast<u32>(std::max(additional_amount, 0)) / sizeof(f32);
-  const u32 count = samples - samples % channels_;
-  if (count == 0 || !fill_) {
+  if (!stream || !fill_ || channels_ == 0 || additional_amount <= 0) {
     return;
   }
-  scratch_.resize(count);
-  fill_(std::span<f32>(scratch_.data(), count), channels_);
-  SDL_PutAudioStreamData(stream, scratch_.data(), static_cast<int>(count * sizeof(f32)));
+  const auto now = std::chrono::steady_clock::now();
+  if (last_callback_ != std::chrono::steady_clock::time_point{}) {
+    const auto gap = std::chrono::duration_cast<std::chrono::microseconds>(now - last_callback_);
+    max_callback_gap_us_ = std::max(max_callback_gap_us_, static_cast<u64>(gap.count()));
+  }
+  last_callback_ = now;
+  const u32 samples = static_cast<u32>(additional_amount) / sizeof(f32);
+  u32 remaining = samples - samples % channels_;
+  const u32 capacity = static_cast<u32>(scratch_.size()) - scratch_.size() % channels_;
+  while (remaining) {
+    const u32 count = std::min(remaining, capacity);
+    fill_(std::span<f32>(scratch_.data(), count), channels_);
+    if (!SDL_PutAudioStreamData(stream, scratch_.data(), static_cast<int>(count * sizeof(f32)))) {
+      break;
+    }
+    remaining -= count;
+  }
 }
 
