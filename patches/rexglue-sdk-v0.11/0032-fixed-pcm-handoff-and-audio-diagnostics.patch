+REX_TEST_CASE("PCM handoff preserves capacity and FIFO through wrap and partial pulls", "[apu]") {
+  const auto capacity = GENERATE(4u, 8u, 64u);
+  g_device.Reset();
+  g_device.manual = true;
+  AudioApp app({{"apu.driver", "fake"}, {"apu.max_queued_frames", std::to_string(capacity)}});
+  REQUIRE(app.Start());
+  auto& audio = app.GetAudio();
+  unsigned played = 0;
+  auto stream = audio.OpenStream([&] { ++played; });
+  REQUIRE(stream);
+  std::array<rex::f32, rex::apu::kAudioFrameSamples> output;
+  // Initial silence must not credit a frame; later submissions must remain audible.
+  g_device.manual_fill(output, 6);
+  CHECK(played == 0);
+  CHECK(std::ranges::all_of(output, [](auto value) { return value == 0; }));
+  const unsigned rounds = 65 / capacity + 2;
+  unsigned serial = 0;
+  for (unsigned round = 0; round < rounds; ++round) {
+    for (unsigned i = 0; i < capacity; ++i) {
+      REQUIRE(audio.Submit(*stream, Constant((serial + i + 1) * 0.0001f)));
+    }
+    CHECK(audio.GetStats().queued_frames == capacity);
+    CHECK_FALSE(audio.Submit(*stream, Constant(1.0f)));
+    for (unsigned i = 0; i < capacity; ++i) {
+      auto samples = std::span(output);
+      g_device.manual_fill(samples.first(17 * 6), 6);
+      CHECK(played == serial + 1);
+      CHECK(audio.GetStats().queued_frames == capacity - i - 1);
+      g_device.manual_fill(samples.subspan(17 * 6), 6);
+      const auto expected = (++serial) * 0.0001f;
+      for (auto sample : output) {
+        REQUIRE(Near(sample, expected, 1e-6f));
+      }
+    }
+  }
+  REQUIRE(audio.Submit(*stream, Constant(0.5f)));
+  audio.CloseStream(*stream);
+  CHECK_FALSE(audio.Submit(*stream, Constant(0.5f)));
+  g_device.manual_fill(output, 6);
+  CHECK(played == serial);
+  auto reopened = audio.OpenStream([&] { ++played; });
+  REQUIRE(reopened);
+  CHECK(audio.GetStats().queued_frames == 0);
+  REQUIRE(audio.Submit(*reopened, Constant(0.25f)));
+  g_device.manual_fill(output, 6);
+  CHECK(played == serial + 1);
+  CHECK(Near(output.back(), 0.25f, 1e-6f));
+  audio.CloseStream(*reopened);
+  app.Finish();
+}
