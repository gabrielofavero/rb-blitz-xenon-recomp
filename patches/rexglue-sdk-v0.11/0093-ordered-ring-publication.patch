+REX_TEST_CASE_METHOD(Fixture,"Queued ring publication survives initialization without blocking", "[gpu][packet_recovery][ring_reconfiguration]") {
+  auto& memory=rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{},title,title,title));
+  const auto block=memory.SystemHeapAlloc(0x2000,0x1000,rex::kernel::kSystemHeapPhysical);
+  const auto base=memory.GetPhysicalAddress(block),target=base+0x1100;
+  Put(memory,base,rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2));
+  Put(memory,base+4,target|2u);Put(memory,base+8,0xCAFEF00Du);
+  auto* processor=driver.GetCommandProcessor();
+  std::promise<void> entered,release;
+  auto started=entered.get_future();
+  auto released=release.get_future();
+  processor->CallInThread([&]{entered.set_value();released.wait();});
+  const bool blocked=started.wait_for(std::chrono::seconds(5))==std::future_status::ready;
+  if (!blocked) {
+    release.set_value();
+    driver.DetachTitle();driver.Shutdown();
+    FAIL("Processor did not reach the controlled queue barrier");
+  }
+  auto publish=std::async(std::launch::async,[&]{driver.InitializeRingBuffer(base,9);driver.WriteRegister(0x01C5,3);});
+  const auto early=publish.wait_for(std::chrono::milliseconds(100));
+  release.set_value();publish.get();
+  CHECK(early==std::future_status::ready);
+  CHECK(WaitFor([&]{return Get(memory,target)==0xCAFEF00Du;}));
+  driver.DetachTitle();driver.Shutdown();
+}
