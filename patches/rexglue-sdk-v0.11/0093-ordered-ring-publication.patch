 void CommandProcessor::InitializeRingBuffer(u32 ptr, u32 size_log2) {
   CallInThreadNoWait([this, ptr, size_log2]() {
+    // A new ring starts unpublished. Submit its write pointer through the same
+    // queue so a guest cannot publish new offsets before this reset is applied.
     read_ptr_index_ = 0;
+    write_ptr_index_.store(0);
+    incomplete_packet_retries_ = 0;
+    incomplete_packet_offset_ = ~u32{0};
+    incomplete_packet_write_index_ = ~u32{0};
     primary_buffer_ptr_ = ptr;
     primary_buffer_size_ = static_cast<u32>(1) << (size_log2 + 3);
   });
@@ -375,8 +381,9 @@
 }
 
 void CommandProcessor::UpdateWritePointer(u32 value) {
-  write_ptr_index_ = value;
-  write_ptr_index_event_->Set();
+  // Keep guest publication ordered after ring and writeback setup without
+  // waiting for a worker that may need the guest to complete a memory wait.
+  CallInThreadNoWait([this, value]() { write_ptr_index_ = value; });
 }
 
