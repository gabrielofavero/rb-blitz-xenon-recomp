+REX_TEST_CASE_METHOD(Fixture,"Ring reconfiguration retires the previous write pointer", "[gpu][packet_recovery][ring_reconfiguration]") {
+  auto& memory=rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{},title,title,title));
+  const auto block=memory.SystemHeapAlloc(0x4000,0x1000,rex::kernel::kSystemHeapPhysical);
+  const auto base=memory.GetPhysicalAddress(block);
+  const auto writeback=base+0x2000,target=base+0x2100,next=base+0x1000;
+  Put(memory,base,rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2));
+  Put(memory,base+4,target|2u);Put(memory,base+8,0x11111111u);
+  driver.InitializeRingBuffer(base,9);driver.EnableReadPointerWriteBack(writeback,6);
+  driver.WriteRegister(0x01C5,3);
+  CHECK(WaitFor([&]{return Get(memory,writeback)==3;}));
+  CHECK(Get(memory,target)==0x11111111u);
+  Put(memory,target,0);
+  Put(memory,next,rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2));
+  Put(memory,next+4,target|2u);Put(memory,next+8,0x22222222u);
+  driver.InitializeRingBuffer(next,9);
+  driver.GetCommandProcessor()->CallInThreadAndWait([]{});
+  std::this_thread::sleep_for(std::chrono::milliseconds(60));
+  CHECK(Get(memory,target)==0);
+  driver.WriteRegister(0x01C5,3);
+  CHECK(WaitFor([&]{return Get(memory,target)==0x22222222u;}));
+  driver.DetachTitle();driver.Shutdown();
+}
