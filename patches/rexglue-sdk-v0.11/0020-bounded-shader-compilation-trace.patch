new file mode 100644
--- /dev/null
+++ b/include/rex/diagnostics/compile_trace.h
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Diagnostic counters shared by SDK services, graphics drivers and the title.
+// No rendering policy or synchronization decisions depend on this instrument.
+#pragma once
+#include <cstdint>
+#include <rex/platform.h>
+#include <utility>
+
+namespace rex::diagnostics::compile_trace {
+enum class Phase : uint32_t {
+  kBoot,
+  kPreA,
+  kPostALoading,
+  kMenu,
+  kSongLoading,
+  kActiveSong,
+  kPaused,
+  kUnknown,
+  kCount
+};
+enum class Event : uint32_t {
+  kTranslation,
+  kGuestPipeline,
+  kPlaceholder,
+  kHelperGraphics,
+  kHelperCompute,
+  kCompileDrain,
+  kCompileWait,
+  kGuestFrame,
+  kGpuFrame,
+  // CPU spans in non-compilation GPU work. Only spans >= 50 ms are retained;
+  // short operations return before taking the shared trace lock.
+  kGpuOperation,
+  kGuestWork,
+  kFileRead,
+  kGpuIdle,
+  kPresent,
+  kCount
+};
+constexpr bool IsLongOperation(Event event) {
+  return event == Event::kGpuOperation || event == Event::kGuestWork ||
+         event == Event::kFileRead || event == Event::kGpuIdle || event == Event::kPresent;
+}
+REX_API bool Enabled();
+REX_API uint64_t Now();
+REX_API Phase CurrentPhase();
+REX_API void SetPhase(Phase phase, const char* reason);
+REX_API void Record(Event event, Phase phase, const char* site, uint64_t key, uint64_t begin_us,
+            uint64_t end_us, bool success, uint64_t variant = 0);
+REX_API void Frame(Event event);
+REX_API void Snapshot(const char* reason);
+struct CounterSnapshot {
+  uint64_t count, failed, total_us, max_us, ge50, ge100, ge250, suppressed;
+};
+REX_API CounterSnapshot ReadCounter(Phase phase, Event event);
+
+// Several helpers are created by one shared function (for example every compute
+// pipeline in the D3D12 and Vulkan UI utilities), so the trace site alone cannot
+// name the recipe. The upper byte of the key names the creator and the remaining
+// bits are the creator's own packed key, so the identity is stable across runs and
+// readable in a log (it never hashes pointers or data that can move).
+enum class HelperKind : uint64_t {
+  kResolveCopy = 1,
+  kHostDepthStore = 2,
+  kRovClear = 3,
+  kDump = 4,
+  kTransfer = 5,
+  kTransferStencilBit = 6,
+  kClearRtv = 7,
+  kPresenter = 8,
+  kSwapChain = 9,
+  kComputeUtil = 10,
+  kTextureConversion = 11,
+  kTextureLoad = 12,
+};
+inline uint64_t HelperKey(HelperKind kind, uint64_t detail) {
+  return (uint64_t(kind) << 56) | (detail & 0x00FFFFFFFFFFFFFFull);
+}
+
+class Scope {
+ public:
+  Scope(Event event, const char* site, uint64_t key = 0, uint64_t variant = 0)
+      : enabled_(Enabled()), event_(event), site_(site), key_(key), variant_(variant) {
+    if (enabled_) {
+      phase_ = CurrentPhase();
+      begin_ = Now();
+    }
+  }
+  ~Scope() {
+    if (enabled_)
+      Record(event_, phase_, site_, key_, begin_, Now(), success_, variant_);
+  }
+  void Success(bool success = true) { success_ = success; }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  bool enabled_, success_ = false;
+  Event event_;
+  const char* site_;
+  uint64_t key_, variant_, begin_ = 0;
+  Phase phase_ = Phase::kUnknown;
+};
+
+// D3D12 S_OK and Vulkan VK_SUCCESS are both zero. Positive Vulkan results such
+// as PIPELINE_COMPILE_REQUIRED are deliberately not counted as success.
+template <typename F>
+auto Call(Event event, const char* site, uint64_t key, F&& f, uint64_t variant = 0) {
+  Scope scope(event, site, key, variant);
+  auto result = std::forward<F>(f)();
+  scope.Success(result == 0);
+  return result;
+}
+}  // namespace rex::diagnostics::compile_trace
