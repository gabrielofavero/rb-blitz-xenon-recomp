diff --git a/tests/unit/base/compile_trace_test.cpp b/tests/unit/base/compile_trace_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/base/compile_trace_test.cpp
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include <rex/diagnostics/compile_trace.h>
+#include <rex/settings_registry.h>
+#include <thread>
+#include <vector>
+
+namespace t = rex::diagnostics::compile_trace;
+
+REX_TEST_CASE("Shared trace retains attribution thresholds and per-song budgets", "[diagnostics]") {
+  REQUIRE(t::Enabled());
+  auto setting = REX_SETTINGS().Find("diagnostics.shader_compile_trace");
+  REQUIRE(setting);
+  CHECK((*setting)->GetLayer() == rex::SettingLayer::kDefault);
+  t::SetPhase(t::Phase::kPostALoading, "test");
+  const auto before = t::ReadCounter(t::Phase::kPostALoading,t::Event::kTranslation).count;
+  {
+    t::Scope crossing(t::Event::kTranslation,"cross_phase",0x1234);
+    t::SetPhase(t::Phase::kMenu,"test");
+    crossing.Success();
+  }
+  CHECK(t::ReadCounter(t::Phase::kPostALoading,t::Event::kTranslation).count == before+1);
+  const auto failure_before = t::ReadCounter(t::Phase::kMenu,t::Event::kGuestPipeline).failed;
+  CHECK(t::Call(t::Event::kGuestPipeline,"failure",1,[]{return -1;}) == -1);
+  CHECK(t::ReadCounter(t::Phase::kMenu,t::Event::kGuestPipeline).failed == failure_before+1);
+  const auto concurrent_before = t::ReadCounter(t::Phase::kMenu,t::Event::kHelperCompute);
+  std::vector<std::thread> threads;
+  for (int i=0;i<4;++i) threads.emplace_back([]{
+    for(int n=0;n<600;++n) t::Call(t::Event::kHelperCompute,"concurrent",0,[]{return 0;});
+  });
+  for(auto& thread:threads) thread.join();
+  const auto concurrent = t::ReadCounter(t::Phase::kMenu,t::Event::kHelperCompute);
+  CHECK(concurrent.count == concurrent_before.count+2400);
+  CHECK(concurrent.suppressed >= concurrent_before.suppressed+352);
+  for(auto event:{t::Event::kGpuOperation,t::Event::kGuestWork,t::Event::kFileRead,
+                  t::Event::kGpuIdle,t::Event::kPresent}) {
+    const auto initial=t::ReadCounter(t::Phase::kActiveSong,event);
+    for(uint64_t duration:{49999u,50000u,100000u,250000u})
+      t::Record(event,t::Phase::kActiveSong,"resource",0,10,10+duration,duration!=100000);
+    t::Record(event,t::Phase::kActiveSong,"invalid",0,10,9,true);
+    const auto actual=t::ReadCounter(t::Phase::kActiveSong,event);
+    CHECK(actual.count == initial.count+3);
+    CHECK(actual.failed == initial.failed+1);
+    CHECK(actual.total_us == initial.total_us+400000);
+    CHECK(actual.ge50 == initial.ge50+3);
+    CHECK(actual.ge100 == initial.ge100+2);
+    CHECK(actual.ge250 == initial.ge250+1);
+  }
+  const auto initial=t::ReadCounter(t::Phase::kActiveSong,t::Event::kHelperCompute);
+  t::SetPhase(t::Phase::kActiveSong,"next song");
+  t::Call(t::Event::kHelperCompute,"new_budget",0,[]{return 0;});
+  const auto actual=t::ReadCounter(t::Phase::kActiveSong,t::Event::kHelperCompute);
+  CHECK(actual.count == initial.count+1);
+  CHECK(actual.suppressed == initial.suppressed);
+}
+
+REX_TEST_CASE("Disabled shared trace leaves counters and phase unchanged", "[diagnostics]") {
+  (void)t::Enabled();
+  REQUIRE(REX_SETTINGS().SetText("shader_compile_trace","false"));
+  REQUIRE_FALSE(t::Enabled());
+  const auto phase=t::CurrentPhase();
+  const auto initial=t::ReadCounter(t::Phase::kMenu,t::Event::kGuestWork);
+  t::SetPhase(t::Phase::kActiveSong,"disabled");
+  t::Record(t::Event::kGuestWork,t::Phase::kMenu,"disabled",0,10,50010,false);
+  t::Frame(t::Event::kGuestFrame);
+  CHECK(t::CurrentPhase() == phase);
+  CHECK(t::ReadCounter(t::Phase::kMenu,t::Event::kGuestWork).count == initial.count);
+  CHECK(REX_SETTINGS().Reset("diagnostics.shader_compile_trace"));
+}
