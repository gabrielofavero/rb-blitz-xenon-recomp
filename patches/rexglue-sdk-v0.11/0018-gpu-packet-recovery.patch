diff --git a/tests/unit/gpu/packet_recovery_test.cpp b/tests/unit/gpu/packet_recovery_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/packet_recovery_test.cpp
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include <catch2/generators/catch_generators.hpp>
+#include <chrono>
+#include <thread>
+#include <vector>
+#include <rex/xenos/packet.h>
+#include "fake_driver_context.h"
+#include "fake_title_context.h"
+#include "gpu/xenos/null/null_xenos_graphics_driver.h"
+#include "test_memory.h"
+
+namespace {
+struct Fixture {
+  Fixture() { rex::test::ReleaseTestMemory(); }
+  ~Fixture() { rex::test::ReleaseTestMemory(); }
+};
+void Put(rex::kernel::GuestAddressSpace& memory, rex::u32 physical, rex::u32 value) {
+  memory.TranslatePhysical<be_u32*>(physical)->Store(value,std::memory_order_release);
+}
+rex::u32 Get(rex::kernel::GuestAddressSpace& memory, rex::u32 physical) {
+  return memory.TranslatePhysical<const be_u32*>(physical)->Load(std::memory_order_acquire);
+}
+template<class Done> bool WaitFor(Done done) {
+  const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
+  while(!done() && std::chrono::steady_clock::now()<deadline)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  return done();
+}
+}
+
+REX_TEST_CASE_METHOD(Fixture,"Partial primary packets retry without dropping following work", "[gpu][packet_recovery]") {
+  const auto type=GENERATE(0,1,3);
+  auto& memory=rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{},title,title,title));
+  const auto block=memory.SystemHeapAlloc(0x2000,0x1000,rex::kernel::kSystemHeapPhysical);
+  const auto base=memory.GetPhysicalAddress(block);
+  const auto writeback=base+0x1000, target=base+0x1100;
+  std::vector<rex::u32> words;
+  if(type==0) words={rex::xenos::BuildPacketType0(0x100,1),0};
+  if(type==1) words={0x40000000u | 0x100u | (0x101u<<11),0,0};
+  if(type==3) words={rex::xenos::BuildPacketType3(rex::xenos::PM4_NOP,1),0};
+  words.insert(words.end(),{rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2),target|2u,0xCAFEF00Du});
+  Put(memory,base,words[0]);
+  Put(memory,writeback,0xFFFFFFFFu);
+  driver.InitializeRingBuffer(base,9);
+  driver.EnableReadPointerWriteBack(writeback,6);
+  driver.WriteRegister(0x01C5,1);
+  const bool retried=WaitFor([&]{return Get(memory,writeback)==0;});
+  CHECK(retried);
+  CHECK(Get(memory,target)==0);
+  for(rex::u32 i=1;i<words.size();++i) Put(memory,base+i*4,words[i]);
+  driver.WriteRegister(0x01C5,static_cast<rex::u32>(words.size()));
+  CHECK(WaitFor([&]{return Get(memory,writeback)==words.size();}));
+  CHECK(Get(memory,target)==0xCAFEF00Du);
+  driver.DetachTitle();
+  driver.Shutdown();
+}
+
+REX_TEST_CASE_METHOD(Fixture,"Indirect incomplete packets propagate retry to the primary ring", "[gpu][packet_recovery]") {
+  auto& memory=rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{},title,title,title));
+  const auto block=memory.SystemHeapAlloc(0x2000,0x1000,rex::kernel::kSystemHeapPhysical);
+  const auto base=memory.GetPhysicalAddress(block);
+  const auto writeback=base+0x1000, target=base+0x1100, indirect=base+0x1200;
+  const rex::u32 words[]={rex::xenos::BuildPacketType3(rex::xenos::PM4_INDIRECT_BUFFER,2),indirect,1,
+      rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2),(target+4)|2u,0x12345678u};
+  for(rex::u32 i=0;i<std::size(words);++i) Put(memory,base+i*4,words[i]);
+  Put(memory,indirect,rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2));
+  Put(memory,writeback,0xFFFFFFFFu);
+  driver.InitializeRingBuffer(base,9);
+  driver.EnableReadPointerWriteBack(writeback,6);
+  driver.WriteRegister(0x01C5,6);
+  CHECK(WaitFor([&]{return Get(memory,writeback)==0;}));
+  CHECK(Get(memory,target+4)==0);
+  Put(memory,indirect+4,target|2u);
+  Put(memory,indirect+8,0xCAFEF00Du);
+  Put(memory,base+8,3);
+  driver.WriteRegister(0x01C5,6);
+  CHECK(WaitFor([&]{return Get(memory,writeback)==6;}));
+  CHECK(Get(memory,target)==0xCAFEF00Du);
+  CHECK(Get(memory,target+4)==0x12345678u);
+  driver.DetachTitle();
+  driver.Shutdown();
+}
+
+REX_TEST_CASE_METHOD(Fixture,"Stalled indirect recovery preserves consumed arguments across ring wrap", "[gpu][packet_recovery]") {
+  auto& memory=rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{},title,title,title));
+  const auto block=memory.SystemHeapAlloc(0x2000,0x1000,rex::kernel::kSystemHeapPhysical);
+  const auto base=memory.GetPhysicalAddress(block);
+  const auto writeback=base+0x1000,target=base+0x1100,indirect=base+0x1200;
+  Put(memory,base,rex::xenos::BuildPacketType3(rex::xenos::PM4_NOP,1021));
+  driver.InitializeRingBuffer(base,9);
+  driver.EnableReadPointerWriteBack(writeback,6);
+  driver.WriteRegister(0x01C5,1022);
+  CHECK(WaitFor([&]{return Get(memory,writeback)==1022;}));
+  Put(memory,base+1022*4,rex::xenos::BuildPacketType3(rex::xenos::PM4_INDIRECT_BUFFER,2));
+  Put(memory,base+1023*4,indirect);
+  Put(memory,base,1);
+  Put(memory,indirect,rex::xenos::BuildPacketType3(rex::xenos::PM4_NOP,2));
+  Put(memory,base+4,rex::xenos::BuildPacketType3(rex::xenos::PM4_MEM_WRITE,2));
+  Put(memory,base+8,target|2u);
+  Put(memory,base+12,0xCAFEF00Du);
+  const auto started=std::chrono::steady_clock::now();
+  driver.WriteRegister(0x01C5,4);
+  CHECK(WaitFor([&]{return Get(memory,writeback)==4;}));
+  CHECK(std::chrono::steady_clock::now()-started>=std::chrono::seconds(1));
+  CHECK(Get(memory,target)==0xCAFEF00Du);
+  driver.DetachTitle();
+  driver.Shutdown();
+}
