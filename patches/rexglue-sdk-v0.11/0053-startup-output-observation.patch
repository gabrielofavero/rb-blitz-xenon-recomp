diff --git a/tests/unit/ui/startup_paint_test.cpp b/tests/unit/ui/startup_paint_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/ui/startup_paint_test.cpp
@@ -0,0 +1,65 @@
+#include "rex_test.h"
+#include "ui_harness.h"
+#include <rex/ui/startup_paint.h>
+#include <rex/ui/ui_system.h>
+#include <rex/overlay_renderer.h>
+#include <atomic>
+#include <chrono>
+#include <thread>
+#include <imgui.h>
+
+namespace {
+class StartupDialog final : public rex::ui::DialogBase {
+ public:
+  std::atomic<int> draws{0};
+  bool Draw(ImGuiIO&) override { ++draws; return true; }
+};
+class StartupRenderer final : public rex::IOverlayRenderer {
+ public:
+  std::atomic<int> frames{0};
+  void RenderOverlays(ImDrawData& data) override {
+    for(auto* texture : *data.Textures) {
+      if(texture->Status==ImTextureStatus_WantDestroy)texture->SetStatus(ImTextureStatus_Destroyed);
+      else if(texture->Status!=ImTextureStatus_OK) {
+        texture->SetTexID(static_cast<ImTextureID>(1));
+        texture->SetStatus(ImTextureStatus_OK);
+      }
+    }
+    ++frames;
+  }
+};
+}
+
+REX_TEST_CASE("Startup paint services overlay frames without dispatching application tasks",
+              "[ui][startup_paint]") {
+  rex::test_ui::UIApp app;
+  REQUIRE(app.Start());
+  auto& ui=app.GetUI();
+  auto* startup=REX_INTERFACE(rex::ui::IStartupPaint);
+  REQUIRE(startup);
+  StartupDialog dialog;
+  auto registered=ui.AddDialog(dialog);
+  StartupRenderer renderer;
+  std::atomic<bool> ordinary{false},synchronous{false},done{false};
+  ui.PostTask([&] { ordinary=true; });
+  std::thread ordinary_caller([&] { (void)ui.RunSynchronous([&] { synchronous=true; }); });
+  std::thread presenter([&] { ui.DrawOverlays(renderer);done=true; });
+  const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
+  while(!done && std::chrono::steady_clock::now()<deadline) {
+    CHECK(startup->PumpStartupPaint());
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+  CHECK(done.load());
+  CHECK(renderer.frames.load()==1);
+  CHECK(dialog.draws.load()==1);
+  CHECK_FALSE(ordinary.load());
+  CHECK_FALSE(synchronous.load());
+  app.Pump();
+  ordinary_caller.join();
+  presenter.join();
+  CHECK(ordinary.load());
+  CHECK(synchronous.load());
+  registered.Reset();
+  app.Shutdown();
+  CHECK(REX_INTERFACE(rex::ui::IStartupPaint)==nullptr);
+}
