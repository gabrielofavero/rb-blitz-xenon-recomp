+
+struct PresentationState {
+  u64 guest_output_refresh = 0; /**< Active images published to the output mailbox. */
+  u64 successful_ui_present = 0; /**< Images presented from the UI paint path. */
+};
+
+/** Optional output observation, available while the graphics module is connected.
+ * Calls never expose a backend object. Capture waits for GPU completion and may fail when
+ * output is absent, unavailable or lost; callers must not use it as a per-frame pacing signal.
+ */
+REX_DECLARE_INTERFACE(IGraphicsPresentation, 1)
+  [[nodiscard]] virtual PresentationState GetPresentationState() const = 0;
+  [[nodiscard]] virtual bool CaptureGuestOutput(CaptureImage& image) = 0;
+};
+}  // namespace rex::gpu
