diff --git a/src/gpu/xenos/host/metal_surface.h b/src/gpu/xenos/host/metal_surface.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/host/metal_surface.h
@@ -0,0 +1,7 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+#include <rex/types.h>
+namespace rex::gpu {
+/** Restore the committed extent after replacement swapchain retirement. Apple only. */
+bool RestoreMetalDrawableSize(void* layer, u32 width, u32 height);
+}
diff --git a/src/gpu/xenos/host/metal_surface.mm b/src/gpu/xenos/host/metal_surface.mm
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/host/metal_surface.mm
@@ -0,0 +1,16 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "gpu/xenos/host/metal_surface.h"
+#include <rex/logging/log_category.h>
+#import <QuartzCore/CAMetalLayer.h>
+namespace rex::gpu {
+bool RestoreMetalDrawableSize(void* layer, u32 width, u32 height) {
+  if (!layer || !width || !height) return false;
+  CAMetalLayer* metal_layer = (__bridge CAMetalLayer*)layer;
+  const CGSize before = metal_layer.drawableSize;
+  if (before.width == width && before.height == height) return false;
+  metal_layer.drawableSize = CGSizeMake(width, height);
+  REXUI_INFO("Metal surface: restored drawable {}x{} -> {}x{} after swapchain replacement",
+              double(before.width), double(before.height), width, height);
+  return true;
+}
+}
