diff --git a/src/gpu/xenos/present_resize.h b/src/gpu/xenos/present_resize.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/present_resize.h
@@ -0,0 +1,28 @@
+// Copyright (c) 2026 ReXGlue contributors.
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <cstdint>
+
+namespace rex::gpu {
+
+// Owned by one command processor and observed only on its worker thread.
+class PresentResizeTracker {
+ public:
+  bool Observe(uint32_t width, uint32_t height, bool cleanup_enabled) {
+    if (!width || !height) return false;
+    const bool changed = width_ && height_ && (width != width_ || height != height_);
+    width_ = width;
+    height_ = height;
+    return cleanup_enabled && changed;
+  }
+
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+
+ private:
+  uint32_t width_ = 0;
+  uint32_t height_ = 0;
+};
+
+}  // namespace rex::gpu
