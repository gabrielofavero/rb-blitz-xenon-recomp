@@ -272,6 +272,20 @@
 }
 
 void CommandProcessor::ClearCaches() {}
+
+void CommandProcessor::CheckPresentResize(u32 width, u32 height) {
+  const u32 previous_width = present_resize_tracker_.width();
+  const u32 previous_height = present_resize_tracker_.height();
+  if (!present_resize_tracker_.Observe(
+          width, height, GetXenosSettings().clear_caches_on_present_resize.Get())) {
+    return;
+  }
+  // Backend cleanup waits for GPU completion at frame end and preserves owned
+  // EDRAM targets and compiled pipelines.
+  ClearCaches();
+  REXGPU_INFO("Frontbuffer resized {}x{} -> {}x{}; GPU cache cleanup queued",
+              previous_width, previous_height, width, height);
+}
 
 void CommandProcessor::InvalidateGPUMemory() {}
 
