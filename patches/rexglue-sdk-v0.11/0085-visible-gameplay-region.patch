+
+VisibleRegion ReadVisibleRegion(const XenosSettings& settings) {
+  VisibleRegion region;
+  region.enabled = settings.draw_visible_region.Get();
+  if (!region.enabled) return region;
+  region.source_width = settings.draw_visible_source_width.Get();
+  region.source_height = settings.draw_visible_source_height.Get();
+  region.visible_width = settings.draw_visible_width.Get();
+  region.guard_pixels = settings.draw_visible_guard.Get();
+  region.color_info = settings.draw_visible_color_info.Get();
+  region.depth_info = settings.draw_visible_depth_info.Get();
+  region.probe = settings.draw_visible_region_probe.Get();
+  return region;
+}
+
+bool ApplyVisibleRegion(const xenos::RegisterFile& regs, const VisibleRegion& region,
+                         bool side_effects, Scissor& scissor) {
+  if (!region.enabled || side_effects) return false;
+  VisibleRegionPass pass;
+  pass.color_info = regs.Get<xenos::reg::RB_COLOR_INFO>().value;
+  pass.depth_info = regs.Get<xenos::reg::RB_DEPTH_INFO>().value;
+  pass.pitch = regs.Get<xenos::reg::RB_SURFACE_INFO>().surface_pitch;
+  const auto vte = regs.Get<xenos::reg::PA_CL_VTE_CNTL>();
+  pass.screen_space = !vte.vport_x_scale_ena || !vte.vport_y_scale_ena ||
+                      !vte.vport_x_offset_ena || !vte.vport_y_offset_ena;
+  if (!pass.screen_space) {
+    const double half_width = std::abs(double(regs.Get<float>(xenos::Register::PA_CL_VPORT_XSCALE)));
+    const double half_height = std::abs(double(regs.Get<float>(xenos::Register::PA_CL_VPORT_YSCALE)));
+    pass.width = half_width * 2;
+    pass.height = half_height * 2;
+    pass.left = double(regs.Get<float>(xenos::Register::PA_CL_VPORT_XOFFSET)) - half_width;
+    pass.top = double(regs.Get<float>(xenos::Register::PA_CL_VPORT_YOFFSET)) - half_height;
+    if (regs.Get<xenos::reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+      const auto window = regs.Get<xenos::reg::PA_SC_WINDOW_OFFSET>();
+      pass.left += window.window_x_offset;
+      pass.top += window.window_y_offset;
+    }
+  }
+  VisibleRegionRect rect{scissor.offset[0], scissor.offset[1], scissor.extent[0], scissor.extent[1]};
+  if (!ClipToVisibleRegion(region, pass, rect)) return false;
+  static thread_local uint64_t clipped_draws = 0, pixels_before = 0, pixels_after = 0;
+  const bool probe = region.probe;
+  if (probe) {
+    ++clipped_draws;
+    pixels_before += uint64_t(scissor.extent[0]) * scissor.extent[1];
+    pixels_after += uint64_t(rect.width) * rect.height;
+    if (clipped_draws <= 8 || !(clipped_draws % 16384)) {
+      REXGPU_INFO("visible_region: draws={} scissor_pixels_before={} after={} original={}x{}+{},{} clipped={}x{}+{},{} viewport={}x{}+{},{}",
+          clipped_draws, pixels_before, pixels_after, scissor.extent[0], scissor.extent[1],
+          scissor.offset[0], scissor.offset[1], rect.width, rect.height, rect.x, rect.y,
+          pass.width, pass.height, pass.left, pass.top);
+    }
+  }
+
+  scissor.offset[0] = rect.x;
+  scissor.extent[0] = rect.width;
+  return true;
 }
 
