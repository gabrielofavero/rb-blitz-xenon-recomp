diff --git a/tests/unit/gpu/frame_trace_test.cpp b/tests/unit/gpu/frame_trace_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/frame_trace_test.cpp
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include <chrono>
+#include <thread>
+#include <rex/diagnostics/compile_trace.h>
+#include <rex/settings_registry.h>
+#include <rex/xenos/packet.h>
+#include "fake_driver_context.h"
+#include "fake_title_context.h"
+#include "gpu/xenos/null/null_xenos_graphics_driver.h"
+#include "test_memory.h"
+
+REX_TEST_CASE("Command processor produces frame cadence and empty-ring attribution",
+              "[gpu][xenos][diagnostics]") {
+  namespace trace = rex::diagnostics::compile_trace;
+  rex::test::ReleaseTestMemory();
+  rex::ScopeGuard release([] { rex::test::ReleaseTestMemory(); });
+  REQUIRE(REX_SETTINGS().SetText("diagnostics.shader_compile_trace", "true"));
+  const auto previous_phase = trace::CurrentPhase();
+  rex::ScopeGuard restore([&] {
+    trace::SetPhase(previous_phase, "frame producer test complete");
+    (void)REX_SETTINGS().Reset("diagnostics.shader_compile_trace");
+  });
+  trace::SetPhase(trace::Phase::kPaused, "frame producer test");
+  auto& memory = rex::test::GetTestMemory();
+  rex::test::FakeTitleContext title(memory);
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  REQUIRE(driver.AttachTitle(rex::TitleInfo{}, title, title, title));
+  const auto initial_frames = trace::ReadCounter(trace::Phase::kPaused, trace::Event::kGpuFrame);
+  const auto initial_idle = trace::ReadCounter(trace::Phase::kPaused, trace::Event::kGpuIdle);
+  std::this_thread::sleep_for(std::chrono::milliseconds(80));
+  const u32 block = memory.SystemHeapAlloc(0x2000, 0x1000, rex::kernel::kSystemHeapPhysical);
+  REQUIRE(block);
+  const u32 ring = memory.GetPhysicalAddress(block), writeback = ring + 0x1000;
+  const u32 packets[] = {
+    rex::xenos::BuildPacketType3(rex::xenos::PM4_XE_SWAP, 4), rex::xenos::kSwapSignature, 0, 1280, 720,
+    rex::xenos::BuildPacketType3(rex::xenos::PM4_XE_SWAP, 4), rex::xenos::kSwapSignature, 0, 1280, 720,
+  };
+  for (u32 i = 0; i < std::size(packets); ++i)
+    *memory.TranslatePhysical<be_u32*>(ring + i * 4) = packets[i];
+  driver.InitializeRingBuffer(ring, 9);
+  driver.EnableReadPointerWriteBack(writeback, 6);
+  driver.WriteRegister(0x01C5, std::size(packets));
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  while (memory.TranslatePhysical<const be_u32*>(writeback)->Load(std::memory_order_acquire) !=
+             std::size(packets) && std::chrono::steady_clock::now() < deadline)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  CHECK(memory.TranslatePhysical<const be_u32*>(writeback)->Load(std::memory_order_acquire) ==
+        std::size(packets));
+  driver.DetachTitle();
+  driver.Shutdown();
+  CHECK(trace::ReadCounter(trace::Phase::kPaused, trace::Event::kGpuFrame).count >=
+        initial_frames.count + 1);
+  CHECK(trace::ReadCounter(trace::Phase::kPaused, trace::Event::kGpuIdle).count >=
+        initial_idle.count + 1);
+}
