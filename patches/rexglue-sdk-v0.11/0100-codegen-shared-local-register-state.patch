diff --git a/tests/unit/codegen/funclet_sync_test.cpp b/tests/unit/codegen/funclet_sync_test.cpp
--- a/tests/unit/codegen/funclet_sync_test.cpp
+++ b/tests/unit/codegen/funclet_sync_test.cpp
@@ -89,3 +89,44 @@
   CHECK(body.find("ctx.r31 = r31;") == std::string::npos);
   CHECK(body.find("r31 = ctx.r31;") == std::string::npos);
 }
+
+REX_TEST_CASE("A shared cleanup receives the caller's localized r12 frame pointer",
+              "[codegen][funclet]") {
+  // addi r12,r1,144; bl cleanup; blr. Cleanup reads its frame through r12.
+  const std::vector<u32> words = {0x39810090, BranchLink(1, 3), kBlr,
+                                  0x3BECFF70, 0x807F0054, kBlr};
+  const rex::test::PDataEntry pdata[] = {{Address(0), 3}};
+  rex::test::TempFolder folder;
+  const auto result = rex::test::GenerateFromImage(
+      folder, rex::test::BuildCodeImage(words, pdata),
+      std::format("non_argument_as_local = true\nnon_volatile_as_local = true\n"
+                  "[entrypoint.functions]\n0x{:08X} = {{ share_registers = true }}\n",
+                  Address(3)));
+  REQUIRE(result);
+  const auto tree = rex::test::ReadGeneratedTree(folder.path / "generated" / "entry");
+  const auto owner = Body(tree, "xstart");
+  const auto call = owner.find(std::format("sub_{:08X}(ctx, base);", Address(3)));
+  const auto to_ctx = owner.find("ctx.r12 = r12;");
+  const auto from_ctx = owner.find("r12 = ctx.r12;", call);
+  REQUIRE(call != std::string::npos);
+  REQUIRE(to_ctx != std::string::npos);
+  CHECK(to_ctx < call);
+  CHECK(from_ctx != std::string::npos);
+  const auto cleanup = Body(tree, std::format("sub_{:08X}", Address(3)));
+  CHECK(cleanup.find("ctx.r12.s64 + -144") != std::string::npos);
+  CHECK(cleanup.find("PPCRegister r12{}") == std::string::npos);
+}
+
+REX_TEST_CASE("A shared call synchronizes all enabled local register families",
+              "[codegen][funclet]") {
+  const auto body = GenerateOwner("non_argument_as_local = true\nnon_volatile_as_local = true\n"
+                                  "cr_as_local = true\n");
+  for (const std::string_view reg : {"r11", "r12", "r31", "f31", "v64", "cr5"}) {
+    const auto before = body.find(std::format("ctx.{0} = {0};", reg));
+    const auto after = body.find(std::format("{0} = ctx.{0};", reg));
+    INFO(reg);
+    CHECK(before != std::string::npos);
+    CHECK(after != std::string::npos);
+    CHECK(before < after);
+  }
+}
