diff --git a/src/gpu/xenos/preparation_budget.h b/src/gpu/xenos/preparation_budget.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/preparation_budget.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Background preparation leaves CPU time for audio and the guest/UI.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+namespace rex::gpu {
+inline size_t PreparationWorkerCount(size_t work, size_t processors) {
+  const size_t available = processors > 2 ? processors - 2 : 1;
+  return std::min(work, std::min(size_t(4), available));
+}
+}
diff --git a/tests/unit/gpu/preparation_budget_test.cpp b/tests/unit/gpu/preparation_budget_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/preparation_budget_test.cpp
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include "gpu/xenos/preparation_budget.h"
+
+REX_TEST_CASE("Preparation pools leave CPU headroom and respect small workloads", "[gpu][preparation]") {
+  using rex::gpu::PreparationWorkerCount;
+  CHECK(PreparationWorkerCount(0,64)==0);
+  CHECK(PreparationWorkerCount(1,64)==1);
+  CHECK(PreparationWorkerCount(100,1)==1);
+  CHECK(PreparationWorkerCount(100,2)==1);
+  CHECK(PreparationWorkerCount(100,3)==1);
+  CHECK(PreparationWorkerCount(100,4)==2);
+  CHECK(PreparationWorkerCount(100,6)==4);
+  CHECK(PreparationWorkerCount(100,64)==4);
+}
