+      {staging->buffer, 0, range}, {gpu_memory.GetBuffer(), guest_address, range}};
+  VkWriteDescriptorSet writes[2] = {};
+  for (u32 i = 0; i < 2; ++i) {
+    sets[i] = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+    if (sets[i] == VK_NULL_HANDLE) return false;
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = sets[i];
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
