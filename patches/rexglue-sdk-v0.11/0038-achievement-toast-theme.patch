+void UISystem::SetEnabled(bool enabled) {
+  State& s = *state_;
+  s.achievement_notifications_enabled.store(enabled);
+  (void)RunSynchronous([&s] {
+    if (s.achievement_notifications_enabled.load()) s.CreateToast();
+    else s.ReleaseToast();
+  });
+}
+
+bool UISystem::Preview(const Achievement& achievement) {
+  State& s = *state_;
+  bool queued = false;
+  const bool ran = RunSynchronous([&] {
+    if (!s.achievement_notifications_enabled.load() || !s.achievements || !s.imgui) return;
+    s.CreateToast();
+    std::lock_guard lock(s.toast_mutex);
+    if (s.toast && s.achievement_notifications_enabled.load()) {
+      s.toast->Push(achievement);
+      queued = true;
+    }
+  });
+  return ran && queued;
+}
