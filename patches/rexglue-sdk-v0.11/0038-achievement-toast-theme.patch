diff --git a/tests/unit/ui/achievement_notifications_test.cpp b/tests/unit/ui/achievement_notifications_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/ui/achievement_notifications_test.cpp
@@ -0,0 +1,68 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include "ui_harness.h"
+#include <rex/ui/achievement_notifications.h>
+#include <rex/ui/style.h>
+
+namespace {
+rex::Achievement ExampleAchievement() {
+  rex::Achievement value;
+  value.label = "Achievement preview";
+  return value;
+}
+class Achievements final : public rex::IAchievementRegistry {
+ public:
+  std::vector<rex::Achievement> GetAchievements() override { return {}; }
+  rex::Result<std::vector<std::byte>> GetAchievementIcon(rex::u32) override {
+    return rex::Err<std::vector<std::byte>>(rex::ErrorCategory::kNotFound, "no icon");
+  }
+  rex::ScopeGuard OnAchievementUnlocked(rex::MoveOnlyFunction<void(const rex::Achievement&)> fn) override {
+    listener = std::move(fn);
+    return rex::ScopeGuard([this] { listener = {}; });
+  }
+  void Unlock() { ++saved; if (listener) listener(ExampleAchievement()); }
+  int saved = 0;
+  rex::MoveOnlyFunction<void(const rex::Achievement&)> listener;
+};
+}
+
+REX_TEST_CASE("achievement notifications suppress only presentation and preview never unlocks", "[ui][achievements]") {
+  Achievements source;
+  rex::test_ui::UIApp app;
+  REQUIRE(app.Start());
+  auto* notifications = REX_INTERFACE(rex::ui::IAchievementNotifications);
+  REQUIRE(notifications);
+  CHECK_FALSE(notifications->Preview(ExampleAchievement()));
+  REQUIRE(app.GetUIControl()->AttachTitle({}, source));
+  CHECK(static_cast<bool>(source.listener));
+  CHECK(notifications->Preview(ExampleAchievement()));
+  CHECK(source.saved == 0);
+  notifications->SetEnabled(false);
+  CHECK_FALSE(source.listener);
+  CHECK_FALSE(notifications->Preview(ExampleAchievement()));
+  source.Unlock();
+  CHECK(source.saved == 1);
+  notifications->SetEnabled(true);
+  CHECK(static_cast<bool>(source.listener));
+  app.GetUIControl()->DetachTitle();
+  CHECK_FALSE(source.listener);
+  CHECK_FALSE(notifications->Preview(ExampleAchievement()));
+  app.Shutdown();
+}
+
+REX_TEST_CASE("existing achievements action can toggle the persistent application browser", "[ui][achievements]") {
+  rex::test_ui::UIApp app;
+  REQUIRE(app.Start());
+  auto& ui = app.GetUI();
+  CHECK_FALSE(ui.GetStyle().achievements.toggle_override);
+  int toggles = 0;
+  ui.GetStyle().achievements.toggle_override = [&] { ++toggles; };
+  ui.ToggleOverlay("achievements");
+  ui.ToggleOverlay("achievements");
+  CHECK(toggles == 2);
+  CHECK_FALSE(ui.IsAnyOverlayVisible());
+  ui.GetStyle().achievements.toggle_override = {};
+  ui.ToggleOverlay("achievements");
+  CHECK(ui.IsAnyOverlayVisible());
+  app.Shutdown();
+}
