+namespace rex::ui {
+
+/** Optional control of the existing achievement notification UI. These calls
+ * never change the achievement manager's unlock or persistence behavior.
+ */
+REX_DECLARE_INTERFACE(IAchievementNotifications, 1)
+  /** Enable or suppress notifications. Enabled by default. Any thread. */
+  virtual void SetEnabled(bool enabled) = 0;
+  /** Queue an existing achievement as a preview, without unlocking it. Returns
+   * false while disabled, headless, or without an attached title. Any thread.
+   */
+  virtual bool Preview(const Achievement& achievement) = 0;
+};
+
+}  // namespace rex::ui
