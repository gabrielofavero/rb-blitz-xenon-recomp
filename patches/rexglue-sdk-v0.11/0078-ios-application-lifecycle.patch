+namespace rex::ui {
+REX_DECLARE_INTERFACE(IApplicationActivity, 1)
+  /** Synchronous lifecycle transition on the UI thread. On suspend, guest audio
+   * callbacks finish before clock pause and GPU drain. Failed resume keeps the
+   * application inactive. Wrong-thread calls return an error without waiting.
+   */
+  [[nodiscard]] virtual Result<void> SetActive(bool active) = 0;
+  /** Release paused clock/audio and queue waiters before shutdown joins. UI thread. */
+  virtual void ResumeForShutdown() = 0;
+};
