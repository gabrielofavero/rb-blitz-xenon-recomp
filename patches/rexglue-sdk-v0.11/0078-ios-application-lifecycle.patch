diff --git a/include/rex/gpu/queue_lifecycle.h b/include/rex/gpu/queue_lifecycle.h
new file mode 100644
--- /dev/null
+++ b/include/rex/gpu/queue_lifecycle.h
@@ -0,0 +1,88 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <utility>
+
+namespace rex::gpu {
+/** Stops new host queue operations before draining GPU work. */
+class QueueLifecycle {
+ public:
+  using Pump = bool (*)();
+  class Permit {
+   public:
+    explicit Permit(QueueLifecycle* owner) : owner_(owner) {
+      if (!owner_) return;
+      std::unique_lock lock(owner_->mutex_);
+      while (!owner_->active_ && !owner_->stopping_) {
+        lock.unlock();
+        const bool pumped = owner_->pump_ && owner_->pump_();
+        lock.lock();
+        if (!owner_->active_ && !owner_->stopping_) {
+          if (pumped) owner_->changed_.wait_for(lock, std::chrono::milliseconds(2));
+          else owner_->changed_.wait(lock, [&] { return owner_->active_ || owner_->stopping_; });
+        }
+      }
+      ++owner_->users_;
+    }
+    Permit(const Permit&) = delete;
+    Permit& operator=(const Permit&) = delete;
+    Permit(Permit&& other) noexcept : owner_(std::exchange(other.owner_, nullptr)) {}
+    ~Permit() {
+      if (!owner_) return;
+      std::lock_guard lock(owner_->mutex_);
+      if (--owner_->users_ == 0) owner_->changed_.notify_all();
+    }
+   private:
+    QueueLifecycle* owner_;
+  };
+  explicit QueueLifecycle(Pump pump = nullptr) : pump_(pump) {}
+  bool SetActive(bool active, const std::function<bool()>& drain) {
+    std::unique_lock lock(mutex_);
+    changed_.wait(lock, [&] { return !draining_; });
+    if (stopping_) return false;
+    if (active_ == active) return !failed_;
+    if (active) {
+      if (failed_) return false;
+      active_ = true;
+      lock.unlock();
+      changed_.notify_all();
+      return true;
+    }
+    active_ = false;
+    draining_ = true;
+    changed_.wait(lock, [&] { return users_ == 0; });
+    // Vulkan completion may run host callbacks. Never hold the gate mutex here.
+    lock.unlock();
+    const bool drained = drain();
+    lock.lock();
+    failed_ = !drained;
+    draining_ = false;
+    lock.unlock();
+    changed_.notify_all();
+    return drained;
+  }
+  void ResumeForShutdown() {
+    {
+      std::lock_guard lock(mutex_);
+      stopping_ = true;
+    }
+    changed_.notify_all();
+  }
+  bool IsActive() const {
+    std::lock_guard lock(mutex_);
+    return active_ && !failed_ && !stopping_;
+  }
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable changed_;
+  bool active_ = true;
+  bool draining_ = false;
+  bool failed_ = false;
+  bool stopping_ = false;
+  unsigned users_ = 0;
+  Pump pump_;
+};
+}  // namespace rex::gpu
