--- /dev/null
+++ b/tests/unit/ui/application_activity_test.cpp
@@ -0,0 +1,97 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include "ui_harness.h"
+#include <rex/ui/application_activity.h>
+#include <rex/apu/audio_system.h>
+#include <rex/chrono.h>
+#include <rex/gpu/queue_lifecycle.h>
+#include <rex/math.h>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <future>
+#include <memory>
+#include <thread>
+using namespace std::chrono_literals;
+
+REX_TEST_CASE("application activity freezes guest time and audio callbacks until resume", "[ui][application_activity]") {
+  std::atomic<unsigned> played{0};
+  rex::test_ui::UIApp app;
+  REQUIRE(app.Start());
+  auto* activity = REX_INTERFACE(rex::ui::IApplicationActivity);
+  auto* audio = REX_INTERFACE(rex::apu::IAudioSystem);
+  REQUIRE(activity);
+  REQUIRE(audio);
+  REQUIRE(activity->SetActive(false));
+  const auto stream = audio->OpenStream([&] { ++played; });
+  REQUIRE(stream);
+  std::array<rex::f32, rex::apu::kAudioFrameSamples> frame{};
+  REQUIRE(audio->Submit(*stream, frame));
+  const auto frozen = rex::Clock::QueryGuestTickCount();
+  const auto host = rex::Clock::GetHostTickCount();
+  std::this_thread::sleep_for(30ms);
+  CHECK(rex::Clock::QueryGuestTickCount() == frozen);
+  CHECK(rex::Clock::GetHostTickCount() > host);
+  CHECK(played == 0);
+  CHECK(audio->GetStats().queued_frames == 1);
+  REQUIRE(activity->SetActive(false));
+  CHECK(rex::Clock::QueryGuestTickCount() == frozen);
+  std::atomic<bool> rejected{false};
+  std::thread other([&] { rejected = !activity->SetActive(true); });
+  other.join();
+  CHECK(rejected.load());
+  CHECK(rex::Clock::QueryGuestTickCount() == frozen);
+  const auto before_resume = rex::Clock::GetHostTickCount();
+  REQUIRE(activity->SetActive(true));
+  const auto resumed = rex::Clock::QueryGuestTickCount();
+  const auto after_resume = rex::Clock::GetHostTickCount();
+  CHECK(resumed >= frozen);
+  const auto allowed = rex::mul_div(after_resume - before_resume,
+      rex::Clock::GetGuestTickFrequency(), rex::Clock::GetHostTickFrequency()) +
+      rex::Clock::GetGuestTickFrequency() / 100;
+  CHECK(resumed - frozen <= allowed);
+  const auto deadline = std::chrono::steady_clock::now() + 3s;
+  while (played == 0 && std::chrono::steady_clock::now() < deadline)
+    std::this_thread::sleep_for(2ms);
+  CHECK(played == 1);
+  audio->CloseStream(*stream);
+  REQUIRE(activity->SetActive(false));
+  app.GetUIControl()->BeginStop();
+  CHECK_FALSE(activity->SetActive(false));
+  const auto shutdown_tick = rex::Clock::QueryGuestTickCount();
+  std::this_thread::sleep_for(2ms);
+  CHECK(rex::Clock::QueryGuestTickCount() > shutdown_tick);
+  app.Shutdown(); // Shutdown keeps the clock running while joining title workers.
+  CHECK(REX_INTERFACE(rex::ui::IApplicationActivity) == nullptr);
+}
+
+REX_TEST_CASE("queue suspension drains outside its lock and shutdown releases failed transitions", "[gpu][queue_lifecycle]") {
+  rex::gpu::QueueLifecycle gate;
+  auto operation = std::make_unique<rex::gpu::QueueLifecycle::Permit>(&gate);
+  std::atomic<unsigned> drains{0};
+  std::atomic<bool> drain_saw_inactive{false};
+  std::promise<void> started;
+  auto suspend = std::async(std::launch::async, [&] {
+    started.set_value();
+    return gate.SetActive(false, [&] { drain_saw_inactive = !gate.IsActive(); ++drains; return true; });
+  });
+  started.get_future().wait();
+  CHECK(suspend.wait_for(20ms) == std::future_status::timeout);
+  CHECK(drains == 0);
+  operation.reset();
+  CHECK(suspend.wait_for(1s) == std::future_status::ready);
+  CHECK(suspend.get());
+  CHECK(drain_saw_inactive.load());
+  CHECK(drains == 1);
+  CHECK(gate.SetActive(false, [&] { ++drains; return true; }));
+  CHECK(drains == 1);
+  CHECK(gate.SetActive(true, [] { return true; }));
+  CHECK_FALSE(gate.SetActive(false, [] { return false; }));
+  CHECK_FALSE(gate.SetActive(true, [] { return true; }));
+  auto blocked = std::async(std::launch::async, [&] { rex::gpu::QueueLifecycle::Permit permit(&gate); });
+  CHECK(blocked.wait_for(20ms) == std::future_status::timeout);
+  gate.ResumeForShutdown();
+  CHECK(blocked.wait_for(1s) == std::future_status::ready);
+  blocked.get();
+  CHECK_FALSE(gate.IsActive());
+}
