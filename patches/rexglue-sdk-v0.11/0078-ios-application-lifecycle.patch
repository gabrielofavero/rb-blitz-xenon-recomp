+void UISystem::SetActivityServices(apu::IAudioActivity* audio, gpu::IGraphicsActivity* graphics) {
+  state_->audio_activity = audio;
+  state_->graphics_activity = graphics;
+}
+
+Result<void> UISystem::SetActive(bool active) {
+  State& s = *state_;
+  if (!s.IsUIThread()) return Err(ErrorCategory::kRuntime, "application activity requires the UI thread");
+  if (s.stopping.load() || s.stopped.load())
+    return Err(ErrorCategory::kRuntime, "application activity is stopping");
+  if (s.application_active == active) return Ok();
+  if (!active) {
+    if (s.audio_activity) s.audio_activity->SetActive(false);
+    Clock::SetGuestPaused(true);
+    s.application_active = false;
+    if (s.graphics_activity) REX_TRY_VOID(s.graphics_activity->SetActive(false));
+  } else {
+    if (s.graphics_activity) REX_TRY_VOID(s.graphics_activity->SetActive(true));
+    Clock::SetGuestPaused(false);
+    if (s.audio_activity) s.audio_activity->SetActive(true);
+    s.application_active = true;
+    s.WakeLoop();
+  }
+  return Ok();
+}
+
+void UISystem::ResumeForShutdown() {
+  State& s = *state_;
+  if (s.graphics_activity) s.graphics_activity->ResumeForShutdown();
+  Clock::SetGuestPaused(false);
+  if (s.audio_activity) s.audio_activity->SetActive(true);
+  s.application_active = true;
+}
+
 void UISystem::SetEnabled(bool enabled) {
   State& s = *state_;
   s.achievement_notifications_enabled.store(enabled);
