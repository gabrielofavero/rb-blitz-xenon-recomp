--- /dev/null
+++ b/src/gpu/xenos/host/vulkan/memory_policy.h
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <cstdint>
+
+namespace rex::gpu::vulkan {
+// Zero lets VMA use its upstream block policy. MoltenVK shares allocation slack
+// with the CPU's memory budget, so use smaller blocks without limiting resources.
+inline constexpr std::uint64_t PreferredAllocatorBlockSize(bool moltenvk, bool ios) {
+  return moltenvk ? std::uint64_t(ios ? 16 : 32) << 20 : 0;
+}
+}  // namespace rex::gpu::vulkan
