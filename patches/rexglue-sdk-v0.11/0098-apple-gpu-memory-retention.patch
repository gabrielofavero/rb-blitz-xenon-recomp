+namespace rex::gpu::vulkan {
+class VulkanDevice;
+namespace objects {
+// Owns only the host pages. Destroy the Vulkan buffer and free its imported
+// VkDeviceMemory before Reset or destruction, including on initialization failure.
+class HostMemoryBacking : public rex::NonCopyable {
+ public:
+  ~HostMemoryBacking();
+  bool CreateBuffer(const VulkanDevice* device, VkDeviceSize size, VkBufferUsageFlags usage,
+                    VkBuffer& buffer_out, VkDeviceMemory& memory_out, std::uint32_t* type_out = nullptr);
+  void Reset();
+ private:
+  void* mapping_ = nullptr;
+  size_t mapping_size_ = 0;
+};
+}  // namespace objects
+}  // namespace rex::gpu::vulkan
