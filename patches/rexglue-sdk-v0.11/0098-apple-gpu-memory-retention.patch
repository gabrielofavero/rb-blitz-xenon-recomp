+HostMemoryBacking::~HostMemoryBacking() { Reset(); }
+
+void HostMemoryBacking::Reset() {
+#if REX_PLATFORM_MAC
+  if (mapping_) munmap(mapping_, mapping_size_);
+#endif
+  mapping_ = nullptr;
+  mapping_size_ = 0;
+}
+
+bool HostMemoryBacking::CreateBuffer(const VulkanDevice* device, VkDeviceSize size,
+                                    VkBufferUsageFlags usage, VkBuffer& buffer_out,
+                                    VkDeviceMemory& memory_out, u32* type_out) {
+#if REX_PLATFORM_MAC
+  if (mapping_ || device->GetProperties().driverID != VK_DRIVER_ID_MOLTENVK ||
+      !device->GetExtensions().ext_EXT_external_memory_host) return false;
+  const auto* instance = device->GetVulkanInstance();
+  const auto& ifn = instance->GetFunctions();
+  const auto& dfn = device->GetFunctions();
+  const auto get_host_properties = reinterpret_cast<PFN_vkGetMemoryHostPointerPropertiesEXT>(
+      ifn.vkGetDeviceProcAddr(device->GetDevice(), "vkGetMemoryHostPointerPropertiesEXT"));
+  const auto get_external_properties = reinterpret_cast<PFN_vkGetPhysicalDeviceExternalBufferProperties>(
+      ifn.vkGetInstanceProcAddr(instance->GetInstance(), "vkGetPhysicalDeviceExternalBufferProperties"));
+  if (!get_host_properties || !get_external_properties || !ifn.vkGetPhysicalDeviceProperties2) return false;
+  auto external_info = BuildStructure<VkPhysicalDeviceExternalBufferInfo>(
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_BUFFER_INFO);
+  external_info.usage = usage;
+  external_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+  auto external_properties = BuildStructure<VkExternalBufferProperties>(
+      VK_STRUCTURE_TYPE_EXTERNAL_BUFFER_PROPERTIES);
+  get_external_properties(device->GetPhysicalDevice(), &external_info, &external_properties);
+  const auto external_features = external_properties.externalMemoryProperties.externalMemoryFeatures;
+  if (!(external_features & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT)) return false;
+  if ((external_features & VK_EXTERNAL_MEMORY_FEATURE_DEDICATED_ONLY_BIT) &&
+      !device->GetExtensions().ext_1_1_KHR_dedicated_allocation) return false;
+  auto host_properties = BuildStructure<VkPhysicalDeviceExternalMemoryHostPropertiesEXT>(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT);
+  auto properties = BuildStructure<VkPhysicalDeviceProperties2>(VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2);
+  properties.pNext = &host_properties;
+  ifn.vkGetPhysicalDeviceProperties2(device->GetPhysicalDevice(), &properties);
+  VkDeviceSize alignment = std::max(VkDeviceSize(getpagesize()),
+                                  host_properties.minImportedHostPointerAlignment);
+  if (!host_properties.minImportedHostPointerAlignment || (alignment & (alignment - 1))) return false;
+
+  auto external = BuildStructure<VkExternalMemoryBufferCreateInfo>(VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO);
+  external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+  auto info = BuildStructure<VkBufferCreateInfo>(VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO);
+  info.pNext = &external;
+  info.size = size;
+  info.usage = usage;
+  info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  VkBuffer buffer;
+  if (dfn.vkCreateBuffer(device->GetDevice(), &info, nullptr, &buffer) != VK_SUCCESS) return false;
+  VkMemoryRequirements requirements;
+  dfn.vkGetBufferMemoryRequirements(device->GetDevice(), buffer, &requirements);
+  const VkDeviceSize allocation_size = rex::RoundUpPow2(requirements.size, alignment);
+  // Reserve extra virtual pages so imports with alignment above the host page
+  // size can still be satisfied. Trim padding without touching the data pages.
+  if (!allocation_size || allocation_size > SIZE_MAX - alignment) {
+    dfn.vkDestroyBuffer(device->GetDevice(), buffer, nullptr);
+    return false;
+  }
+  const size_t reserve_size = size_t(allocation_size + alignment);
+  void* reserved = mmap(nullptr, reserve_size, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (reserved == MAP_FAILED) {
+    dfn.vkDestroyBuffer(device->GetDevice(), buffer, nullptr);
+    return false;
+  }
+  const uintptr_t base = reinterpret_cast<uintptr_t>(reserved);
+  const uintptr_t aligned = rex::RoundUpPow2(base, uintptr_t(alignment));
+  const size_t prefix = aligned - base;
+  const size_t suffix = reserve_size - prefix - size_t(allocation_size);
+  if (prefix) munmap(reserved, prefix);
+  if (suffix) munmap(reinterpret_cast<void*>(aligned + allocation_size), suffix);
+  mapping_ = reinterpret_cast<void*>(aligned);
+  mapping_size_ = size_t(allocation_size);
+
+  auto pointer_properties = BuildStructure<VkMemoryHostPointerPropertiesEXT>(VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT);
+  u32 memory_type = 0;
+  if (get_host_properties(device->GetDevice(), VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+                          mapping_, &pointer_properties) != VK_SUCCESS ||
+      !rex::bit_scan_forward(requirements.memoryTypeBits & pointer_properties.memoryTypeBits &
+                                device->GetMemoryTypes().host_coherent, &memory_type)) {
+    dfn.vkDestroyBuffer(device->GetDevice(), buffer, nullptr);
+    Reset();
+    return false;
+  }
+  auto import = BuildStructure<VkImportMemoryHostPointerInfoEXT>(VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT);
+  import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+  import.pHostPointer = mapping_;
+  auto dedicated = BuildStructure<VkMemoryDedicatedAllocateInfo>(
+      VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+  if (external_features & VK_EXTERNAL_MEMORY_FEATURE_DEDICATED_ONLY_BIT) {
+    dedicated.buffer = buffer;
+    import.pNext = &dedicated;
+  }
+  auto allocation = BuildStructure<VkMemoryAllocateInfo>(VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO);
+  allocation.pNext = &import;
+  allocation.allocationSize = allocation_size;
+  allocation.memoryTypeIndex = memory_type;
+  VkDeviceMemory memory;
+  if (dfn.vkAllocateMemory(device->GetDevice(), &allocation, nullptr, &memory) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device->GetDevice(), buffer, nullptr);
+    Reset();
+    return false;
+  }
+  if (dfn.vkBindBufferMemory(device->GetDevice(), buffer, memory, 0) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device->GetDevice(), buffer, nullptr);
+    dfn.vkFreeMemory(device->GetDevice(), memory, nullptr);
+    Reset();
+    return false;
+  }
+  buffer_out = buffer;
+  memory_out = memory;
+  if (type_out) *type_out = memory_type;
+  REXGPU_INFO("MoltenVK: demand-paged host backing for {} MiB buffer", allocation_size >> 20);
+  return true;
+#else
+  (void)device; (void)size; (void)usage; (void)buffer_out; (void)memory_out; (void)type_out;
+  return false;
+#endif
+}
 
