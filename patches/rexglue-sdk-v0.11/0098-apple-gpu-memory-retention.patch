diff --git a/src/gpu/xenos/host/graphics_upload_buffer_pool.cpp b/src/gpu/xenos/host/graphics_upload_buffer_pool.cpp
--- a/src/gpu/xenos/host/graphics_upload_buffer_pool.cpp
+++ b/src/gpu/xenos/host/graphics_upload_buffer_pool.cpp
@@ -27,6 +27,23 @@
 void GraphicsUploadBufferPool::Reclaim(u64 completed_submission_index) {
   ReclaimPages(submitted_first_, submitted_last_, writable_first_, writable_last_,
                completed_submission_index);
+  if (!idle_submission_count_ || !writable_first_) return;
+  // The first writable page may still contain data referenced by a pending
+  // submission. Only later pages have been fully retired by ReclaimPages.
+  Page* previous = writable_first_;
+  Page* page = previous->next;
+  while (page) {
+    Page* next = page->next;
+    if (page->last_submission_index <= completed_submission_index &&
+        completed_submission_index - page->last_submission_index >= idle_submission_count_) {
+      previous->next = next;
+      if (writable_last_ == page) writable_last_ = previous;
+      delete page;
+    } else {
+      previous = page;
+    }
+    page = next;
+  }
 }
 
