+REX_TEST_CASE_METHOD(Fixture, "SDL extras retain distinct identities and availability",
+                     "[hid][sdl3][title_input]") {
+  auto driver = Create();
+  REQUIRE(driver);
+  auto* extras = dynamic_cast<rex::hid::IExtraButtons*>(driver.get());
+  REQUIRE(extras);
+  TrackingContext context;
+  REQUIRE(driver->Initialize(context));
+  auto shutdown = rex::ScopeGuard([&] { driver->Shutdown(); context.RunPosted(); });
+  SDL_VirtualJoystickDesc desc;
+  SDL_INIT_INTERFACE(&desc);
+  desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+  desc.name = "Distinct extras fixture";
+  desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+  const std::array buttons = {
+      SDL_GAMEPAD_BUTTON_MISC1, SDL_GAMEPAD_BUTTON_MISC2, SDL_GAMEPAD_BUTTON_TOUCHPAD,
+      SDL_GAMEPAD_BUTTON_LEFT_PADDLE1, SDL_GAMEPAD_BUTTON_LEFT_PADDLE2,
+      SDL_GAMEPAD_BUTTON_RIGHT_PADDLE1, SDL_GAMEPAD_BUTTON_RIGHT_PADDLE2};
+  desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1;
+  const auto instance = SDL_AttachVirtualJoystick(&desc);
+  REQUIRE(instance != 0);
+  auto detach = rex::ScopeGuard([&] { SDL_DetachVirtualJoystick(instance); });
+  auto* joystick = SDL_OpenJoystick(instance);
+  REQUIRE(joystick);
+  auto close = rex::ScopeGuard([&] { SDL_CloseJoystick(joystick); });
+  SDL_UpdateJoysticks();
+  SDL_PumpEvents();
+  context.RunPosted();
+  std::vector<rex::hid::PadDevice> devices;
+  driver->EnumerateDevices(devices);
+  auto found = std::ranges::find(devices, "Distinct extras fixture", &rex::hid::PadDevice::name);
+  REQUIRE(found != devices.end());
+  const auto id = found->id;
+  REQUIRE(extras->GetExtraButtonState(id));
+  CHECK(extras->GetExtraButtonState(id)->available == 0x7F);
+  for (u8 i = 0; i < buttons.size(); ++i) {
+    REQUIRE(SDL_SetJoystickVirtualButton(joystick, buttons[i], true));
+    SDL_UpdateJoysticks();
+    SDL_PumpEvents();
+    const auto reading = extras->GetExtraButtonState(id);
+    REQUIRE(reading);
+    CHECK(reading->held == (1u << i));
+    REQUIRE(driver->GetDeviceState(id));
+    CHECK(driver->GetDeviceState(id)->buttons == 0);
+    REQUIRE(SDL_SetJoystickVirtualButton(joystick, buttons[i], false));
+    SDL_UpdateJoysticks();
+    SDL_PumpEvents();
+    CHECK(extras->GetExtraButtonState(id)->held == 0);
+  }
