+ExtraButtonState InputSystem::GetPhysicalExtraButtons(bool for_host_ui) {
+  State& state = *state_;
+  std::vector<ConnectionEvent> events;
+  ExtraButtonState result;
+  {
+    std::lock_guard lock(state.mutex);
+    if (state.started) {
+      state.RefreshDevicesLocked(events);
+      std::vector<PadDevice> devices;
+      for (u32 source = 0; source < state.keyboard_mouse_source; ++source) {
+        auto* extras = dynamic_cast<IExtraButtons*>(state.sources[source]);
+        if (!extras) continue;
+        devices.clear();
+        state.sources[source]->EnumerateDevices(devices);
+        for (const PadDevice& device : devices) {
+          auto reading = extras->GetExtraButtonState(device.id);
+          if (!reading) continue;
+          result.available |= reading->available;
+          result.held |= reading->held & reading->available;
+        }
+      }
+      if (!for_host_ui &&
+          (!state.focused.load(std::memory_order_relaxed) || state.ui_blocks.load() > 0)) {
+        result.held = 0;
       }
     }
   }
