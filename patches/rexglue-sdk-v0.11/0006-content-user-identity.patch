diff --git a/include/rex/xam/content_sources.h b/include/rex/xam/content_sources.h
new file mode 100644
--- /dev/null
+++ b/include/rex/xam/content_sources.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/types/content.h>
+#include <rex/module.h>
+#include <rex/result.h>
+
+namespace rex::xam {
+
+/** A package whose host location is independent of its guest identity. */
+struct ContentSourceItem {
+  std::filesystem::path host_path;
+  std::string file_name; /**< One guest component, 1 through 42 bytes. */
+  u32 title_id = 0;
+  kernel::XContentType content_type = kernel::XContentType::kMarketplaceContent;
+};
+
+/** Immutable input copied by the service. An empty snapshot removes external discovery. */
+struct ContentSources {
+  /** Shared read-only packages at root/title_id/content_type/name, without an XUID level. */
+  std::filesystem::path structured_root;
+  std::vector<ContentSourceItem> items;
+};
+
+/** Optional external content discovery. Sources belong to one attached title.
+ * Calls may replace sources while content is listed or opened. Already open packages retain
+ * their backing. Calls must be serialized with title attach/detach by the host.
+ */
+REX_DECLARE_INTERFACE(IContentSources, 1)
+  /** Atomically replaces the sources, or kNotFound without an attached title.
+   * Invalid or case-insensitively duplicate item identities reject the whole snapshot.
+   * Registration does not install, copy, rename or mutate any source.
+   */
+  [[nodiscard]] virtual Result<void> ReplaceContentSources(ContentSources sources) = 0;
+};
+
+}  // namespace rex::xam
