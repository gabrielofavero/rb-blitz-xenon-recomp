+
+namespace {
+constexpr rex::u32 kTitle = 0x52455831;
+constexpr auto kType = rex::kernel::XContentType::kMarketplaceContent;
+rex::kernel::XCONTENT_AGGREGATE_DATA Data(std::string_view name) {
+  rex::kernel::XCONTENT_AGGREGATE_DATA data{};
+  data.device_id=1; data.title_id=kTitle; data.content_type=kType; data.xuid=0;
+  data.SetFileName(name);
+  return data;
+}
+std::filesystem::path Package(const rex::test::KernelFixture& fixture, std::string_view name) {
+  auto path=fixture.GetRoot()/std::string(name);
+  std::filesystem::copy_file(rex::test::GetFixtureFolder()/"stfs_con.bin",path);
+  return path;
+}
+}
+
+REX_TEST_CASE("External content sources enumerate once and keep their open backing", "[xam][content_sources]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    auto* sources=REX_INTERFACE(rex::xam::IContentSources); REQUIRE(sources);
+    auto& manager=c.GetRuntime().GetContentManager();
+    auto& fs=c.GetRuntime().GetFileSystem();
+    const auto package=Package(fixture,"flat.bin");
+    const auto root=fixture.GetRoot()/"external";
+    const auto dir=root/"52455831"/"00000002"/"folder";
+    std::filesystem::create_directories(dir);
+    {std::ofstream file(dir/"marker"); file<<"original";}
+    std::filesystem::copy_file(package,root/"52455831"/"00000002"/"container");
+    rex::xam::ContentSources input{root,{{package,"loose",kTitle,kType}}};
+    REQUIRE(sources->ReplaceContentSources(input));
+    const auto listed=manager.ListContent(1,0,kType,kTitle);
+    CHECK(listed.size()==3);
+    auto* identity=REX_INTERFACE(rex::xam::IXAMUserIdentity); REQUIRE(identity);
+    REQUIRE(identity->GetUserXUID());
+    if(*identity->GetUserXUID()!=0) CHECK(manager.ListContent(1,*identity->GetUserXUID(),kType,kTitle).empty());
+    CHECK(manager.HasContent(0,Data("LOOSE")));
+    REQUIRE(manager.OpenContent("flat",0,Data("LOOSE")));
+    auto opened=fs.Open("flat:\\a.txt",{}); REQUIRE(opened);
+    REQUIRE(sources->ReplaceContentSources({}));
+    CHECK(manager.ListContent(1,0,kType,kTitle).empty());
+    CHECK_FALSE(manager.HasContent(0,Data("loose")));
+    std::array<rex::u8,1> byte{};
+    REQUIRE(opened->file->Read(byte,0));
+    opened->file.reset();
+    REQUIRE(manager.CloseContent("flat"));
+    REQUIRE(sources->ReplaceContentSources(input));
+    REQUIRE(manager.OpenContent("folder",0,Data("folder")));
+    auto write=fs.Open("folder:\\marker",{.access=rex::filesystem::Access::kWriteAccess}); REQUIRE(write);
+    CHECK_FALSE(write->file->Write(byte,0));
+    CHECK_FALSE(fs.Remove("folder:\\marker"));
+    write->file.reset(); REQUIRE(manager.CloseContent("folder"));
+    CHECK_FALSE(manager.DeleteContent(0,Data("folder")));
+    CHECK(std::filesystem::exists(dir/"marker"));
+    CHECK(std::filesystem::exists(package));
+    REQUIRE(manager.SetContentThumbnail(0,Data("folder"),{1,2,3}));
+    CHECK_FALSE(std::filesystem::exists(dir/"__thumbnail.png"));
+    CHECK(std::filesystem::exists(dir/"marker"));
+  });
+}
+
+REX_TEST_CASE("External content replacement rejects ambiguous or escaping identities atomically", "[xam][content_sources]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    auto* sources=REX_INTERFACE(rex::xam::IContentSources); REQUIRE(sources);
+    auto& manager=c.GetRuntime().GetContentManager();
+    const auto package=Package(fixture,"flat.bin");
+    rex::xam::ContentSources valid{{},{{package,"one",kTitle,kType}}};
+    REQUIRE(sources->ReplaceContentSources(valid));
+    for(const auto& name:{std::string(".."),std::string("../escape"),std::string("a:b"),std::string(43,'a'),std::string("a\0b",3)}) {
+      auto bad=valid; bad.items[0].file_name=name;
+      CHECK_FALSE(sources->ReplaceContentSources(std::move(bad)));
+      CHECK(manager.HasContent(0,Data("one")));
+    }
+    auto duplicate=valid; duplicate.items.push_back({package,"ONE",kTitle,kType});
+    CHECK_FALSE(sources->ReplaceContentSources(std::move(duplicate)));
+    CHECK(manager.ListContent(1,0,kType,kTitle).size()==1);
+    auto different=valid; different.items.push_back({package,"ONE",kTitle+1,kType});
+    REQUIRE(sources->ReplaceContentSources(std::move(different)));
+    CHECK(manager.ListContent(1,0,kType,kTitle).size()==1);
+  });
+}
+
+REX_TEST_CASE("External content uses package license then configured fallback including zero", "[xam][content_sources]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    auto* sources=REX_INTERFACE(rex::xam::IContentSources); REQUIRE(sources);
+    auto* settings=REX_INTERFACE(rex::ISettingsRegistry); REQUIRE(settings);
+    auto& manager=c.GetRuntime().GetContentManager();
+    const auto path=Package(fixture,"licenses.bin");
+    // The STFS license table is the 0x100 bytes immediately after the magic and signature.
+    {std::fstream file(path,std::ios::binary|std::ios::in|std::ios::out); file.seekp(0x22C); std::array<char,0x100> zero{}; file.write(zero.data(),zero.size());}
+    REQUIRE(sources->ReplaceContentSources({{},{{path,"unlicensed",kTitle,kType}}}));
+    auto found=settings->Find("kernel.license_mask"); REQUIRE(found);
+    auto* license=*found;
+    const auto previous=static_cast<rex::Setting<rex::u32>*>(license)->Get();
+    REQUIRE(settings->SetText("kernel.license_mask","7"));
+    auto full=manager.OpenContent("licensed",0,Data("unlicensed")); REQUIRE(full); CHECK(*full==7);
+    REQUIRE(manager.CloseContent("licensed"));
+    REQUIRE(settings->SetText("kernel.license_mask","0"));
+    auto trial=manager.OpenContent("trial",0,Data("unlicensed")); REQUIRE(trial); CHECK(*trial==0);
+    REQUIRE(manager.CloseContent("trial"));
+    REQUIRE(settings->SetText("kernel.license_mask",std::to_string(previous)));
+    CHECK(manager.ListInstalledPackages(kTitle).empty());
+  });
+}
