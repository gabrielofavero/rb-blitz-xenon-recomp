+  if (!sources->structured_root.empty()) {
+    auto structured = platform::ResolveEntryCase(
+        ResolveStructuredRoot(*sources, data.content_type, data.title_id), name);
+    if (std::filesystem::exists(structured, ec)) return {std::move(structured), true};
+  }
+  const u32 title_id = data.title_id == kernel::kRunningTitleID ? GetTitleID() : u32(data.title_id);
+  for (const auto& item : sources->items) {
+    if (item.title_id == title_id && item.content_type == data.content_type &&
+        string::utf8_equal_case(item.file_name, name)) return {item.host_path, true};
+  }
+  return {primary, false};
 }
 
