+      return Err(ErrorCategory::kValidation, "external content has duplicate guest identities");
+    }
+  }
+  auto snapshot = std::make_shared<const ContentSources>(std::move(sources));
+  {
+    std::lock_guard lock(sources_mutex_);
+    sources_ = std::move(snapshot);
+  }
+  return Ok();
