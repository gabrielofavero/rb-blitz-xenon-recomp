+
+REX_TEST_CASE("aggregate counts retain their exact snapshot through consumption and close",
+              "[xam][content_enumeration_info]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([](rex::test::Caller& c) {
+    auto* info = REX_INTERFACE(rex::xam::IContentEnumerationInfo);
+    REQUIRE(info);
+    CHECK(c.GetRuntime().GetTitleID() == 0);
+    const auto metadata = c.GetRuntime().GetTitleXDBF();
+    REQUIRE(metadata);
+    CHECK_FALSE(metadata->IsValid());
+    CHECK_FALSE(info->GetAggregateItemCount(0));
+    auto* identity = REX_INTERFACE(rex::xam::IXAMUserIdentity);
+    REQUIRE(identity);
+    const auto xuid = identity->GetUserXUID();
+    REQUIRE(xuid);
+    const auto out = c.Alloc(4);
+    constexpr auto type = rex::kernel::XContentType::kMarketplaceContent;
+    REQUIRE(c.XAM("XamContentAggregateCreateEnumerator", {*xuid, 0, u32(type), 0, out}) == 0);
+    auto handle = c.Load32(out);
+    REQUIRE(info->GetAggregateItemCount(handle));
+    CHECK(*info->GetAggregateItemCount(handle) == 0);
+    REQUIRE(c.Kernel("NtClose", {handle}) == 0);
+    CHECK_FALSE(info->GetAggregateItemCount(handle));
+
+    rex::kernel::XCONTENT_AGGREGATE_DATA data{};
+    data.device_id = 1;
+    data.title_id = c.GetRuntime().GetTitleID();
+    data.content_type = type;
+    data.xuid = 0;
+    data.SetFileName("snapshot");
+    auto& content = c.GetRuntime().GetContentManager();
+    REQUIRE(content.CreateContent("snapshot", 0, data));
+    REQUIRE(content.CloseContent("snapshot"));
+    REQUIRE(c.XAM("XamContentAggregateCreateEnumerator", {*xuid, 0, u32(type), 0, out}) == 0);
+    handle = c.Load32(out);
+    REQUIRE(info->GetAggregateItemCount(handle));
+    CHECK(*info->GetAggregateItemCount(handle) == 1);
+    const auto buffer = c.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    const auto count = c.Alloc(4);
+    REQUIRE(c.XAM("XamEnumerate", {handle, 0, buffer,
+        sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA), count, 0}) == 0);
+    CHECK(c.Load32(count) == 1);
+    CHECK(*info->GetAggregateItemCount(handle) == 1);
+    CHECK(c.XAM("XamEnumerate", {handle, 0, buffer,
+        sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA), count, 0}) ==
+        rex::kernel::X_ERROR_NO_MORE_FILES);
+    CHECK(*info->GetAggregateItemCount(handle) == 1);
+    REQUIRE(c.Kernel("NtClose", {handle}) == 0);
+    CHECK_FALSE(info->GetAggregateItemCount(handle));
+
+    const auto size = c.Alloc(4);
+    REQUIRE(c.XAM("XamContentCreateDeviceEnumerator", {0, 0, 2, size, out}) == 0);
+    handle = c.Load32(out);
+    CHECK_FALSE(info->GetAggregateItemCount(handle));
+    REQUIRE(c.Kernel("NtClose", {handle}) == 0);
+  });
+}
