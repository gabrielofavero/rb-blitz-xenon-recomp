diff --git a/cmake/rexglue_vulkan_dependencies.cmake b/cmake/rexglue_vulkan_dependencies.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/rexglue_vulkan_dependencies.cmake
@@ -0,0 +1,131 @@
+# Pinned source dependencies. Runtime implementations remain dynamically loaded.
+include_guard(GLOBAL)
+if (NOT REXGLUE_GPU_VULKAN)
+  return()
+endif()
+
+set(REXGLUE_VULKAN_SOURCE_ROOT "${CMAKE_BINARY_DIR}/_deps/rex-vulkan" CACHE PATH
+    "Exact Vulkan source checkouts used by the SDK")
+set(REXGLUE_VULKAN_MIRROR_ROOT "" CACHE PATH "Optional local mirrors of the Vulkan source repositories")
+set(REXGLUE_MOLTENVK_CANONICAL_PATCH "" CACHE FILEPATH
+    "Canonical MoltenVK patch to compare with the bundled source-build input")
+option(REXGLUE_FETCH_VULKAN_DEPS "Acquire missing pinned Vulkan source checkouts" ON)
+
+find_package(Python3 COMPONENTS Interpreter REQUIRED)
+set(_vulkan_dependencies vulkan-headers vulkan-memory-allocator)
+if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  list(APPEND _vulkan_dependencies vulkan-loader)
+endif()
+if (APPLE)
+  list(APPEND _vulkan_dependencies moltenvk)
+endif()
+set(_vulkan_prepare_args --source-root "${REXGLUE_VULKAN_SOURCE_ROOT}" --only ${_vulkan_dependencies})
+if (NOT REXGLUE_FETCH_VULKAN_DEPS)
+  list(APPEND _vulkan_prepare_args --check)
+endif()
+if (REXGLUE_VULKAN_MIRROR_ROOT)
+  list(APPEND _vulkan_prepare_args --mirror-root "${REXGLUE_VULKAN_MIRROR_ROOT}")
+endif()
+if (REXGLUE_MOLTENVK_CANONICAL_PATCH)
+  list(APPEND _vulkan_prepare_args --canonical-moltenvk-patch "${REXGLUE_MOLTENVK_CANONICAL_PATCH}")
+endif()
+execute_process(COMMAND "${Python3_EXECUTABLE}" "${REXGLUE_ROOT}/scripts/prepare_vulkan_stack.py"
+                ${_vulkan_prepare_args} RESULT_VARIABLE _vulkan_prepare_result
+                OUTPUT_VARIABLE _vulkan_prepare_output ERROR_VARIABLE _vulkan_prepare_error)
+if (NOT _vulkan_prepare_result EQUAL 0)
+  message(FATAL_ERROR "Pinned Vulkan dependencies are unavailable:\n${_vulkan_prepare_output}${_vulkan_prepare_error}")
+endif()
+message(STATUS "${_vulkan_prepare_output}")
+
+set(VULKAN_HEADERS_ENABLE_TESTS OFF)
+set(VULKAN_HEADERS_ENABLE_INSTALL ON)
+set(VULKAN_HEADERS_ENABLE_MODULE OFF)
+add_subdirectory("${REXGLUE_VULKAN_SOURCE_ROOT}/vulkan-headers" "${CMAKE_CURRENT_BINARY_DIR}/vulkan-headers")
+set(VMA_ENABLE_INSTALL ON)
+set(VMA_BUILD_DOCUMENTATION OFF)
+set(VMA_BUILD_SAMPLES OFF)
+add_subdirectory("${REXGLUE_VULKAN_SOURCE_ROOT}/vulkan-memory-allocator"
+                 "${CMAKE_CURRENT_BINARY_DIR}/vulkan-memory-allocator")
+set_property(TARGET VulkanMemoryAllocator PROPERTY SYSTEM TRUE)
+add_library(rex-vma INTERFACE)
+target_link_libraries(rex-vma INTERFACE GPUOpen::VulkanMemoryAllocator)
+
+if (NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  set(BUILD_TESTS OFF)
+  set(BUILD_WERROR OFF)
+  set(UPDATE_DEPS OFF)
+  set(LOADER_CODEGEN OFF)
+  set(VulkanHeaders_VERSION "1.4.357")
+  if (WIN32)
+    # GNU-style clang still targets the MSVC ABI. Its loader trampolines require
+    # Microsoft's assembler rather than the GNU assembly route.
+    set(USE_GAS OFF)
+    set(USE_MASM ON)
+    if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|ARM64|aarch64)$")
+      if (CMAKE_VERSION VERSION_LESS 3.26)
+        message(FATAL_ERROR "The Windows ARM64 Vulkan loader requires CMake 3.26 or newer")
+      endif()
+      enable_language(ASM_MARMASM)
+    else()
+      if (NOT CMAKE_ASM_MASM_COMPILER)
+        find_program(_vulkan_masm NAMES ml64)
+        if (NOT _vulkan_masm)
+          find_program(_vulkan_vswhere NAMES vswhere.exe
+                       HINTS "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer")
+          if (_vulkan_vswhere)
+            execute_process(COMMAND "${_vulkan_vswhere}" -latest -products *
+                            -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
+                            -property installationPath OUTPUT_VARIABLE _vulkan_vsroot
+                            OUTPUT_STRIP_TRAILING_WHITESPACE)
+            file(GLOB _vulkan_masm_candidates
+                 "${_vulkan_vsroot}/VC/Tools/MSVC/*/bin/Hostx64/x64/ml64.exe"
+                 "${_vulkan_vsroot}/VC/Tools/MSVC/*/bin/Hostarm64/x64/ml64.exe")
+            list(SORT _vulkan_masm_candidates COMPARE NATURAL ORDER DESCENDING)
+            if (_vulkan_masm_candidates)
+              list(GET _vulkan_masm_candidates 0 _vulkan_masm)
+            endif()
+          endif()
+        endif()
+        if (NOT _vulkan_masm)
+          message(FATAL_ERROR "The Windows Vulkan loader needs ml64; set CMAKE_ASM_MASM_COMPILER")
+        endif()
+        set(CMAKE_ASM_MASM_COMPILER "${_vulkan_masm}" CACHE FILEPATH "Vulkan loader assembler")
+      endif()
+      enable_language(ASM_MASM)
+    endif()
+  endif()
+  block()
+    # The source header target above defines this loader's complete SDK input.
+    set(CMAKE_DISABLE_FIND_PACKAGE_VulkanHeaders TRUE)
+    add_subdirectory("${REXGLUE_VULKAN_SOURCE_ROOT}/vulkan-loader" "${CMAKE_CURRENT_BINARY_DIR}/vulkan-loader")
+  endblock()
+  if (WIN32 AND NOT TARGET loader_asm_gen_files)
+    message(FATAL_ERROR "The pinned Windows Vulkan loader could not build its assembly trampolines")
+  endif()
+  if (NOT TARGET Vulkan::Vulkan)
+    add_library(Vulkan::Vulkan ALIAS vulkan)
+  endif()
+endif()
+
+if (APPLE)
+  set(REXGLUE_MOLTENVK_SOURCE_DIR "${REXGLUE_VULKAN_SOURCE_ROOT}/moltenvk"
+      CACHE INTERNAL "Prepared exact MoltenVK source checkout" FORCE)
+  if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    find_library(REXGLUE_UIKIT_LIBRARY UIKit REQUIRED)
+    set(APPKIT_LIBRARY "${REXGLUE_UIKIT_LIBRARY}")
+    set(IOKIT_LIBRARY "${REXGLUE_UIKIT_LIBRARY}")
+  endif()
+  set(MVK_BUILD_SHADER_CONVERTER_TOOL OFF)
+  set(MVK_EXCLUDE_SPIRV_TOOLS ON)
+  add_subdirectory("${REXGLUE_VULKAN_SOURCE_ROOT}/moltenvk" "${CMAKE_CURRENT_BINARY_DIR}/moltenvk")
+  if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    find_library(REXGLUE_COREGRAPHICS_LIBRARY CoreGraphics REQUIRED)
+    target_link_libraries(MoltenVK PRIVATE "${REXGLUE_COREGRAPHICS_LIBRARY}")
+  endif()
+  if (NOT TARGET Vulkan::MoltenVK)
+    add_library(Vulkan::MoltenVK ALIAS MoltenVK)
+  endif()
+  if (NOT TARGET Vulkan::Vulkan)
+    add_library(Vulkan::Vulkan ALIAS MoltenVK)
+  endif()
+endif()
diff --git a/cmake/patches/moltenvk/0001-retain-presentation-drawable.patch b/cmake/patches/moltenvk/0001-retain-presentation-drawable.patch
new file mode 100644
--- /dev/null
+++ b/cmake/patches/moltenvk/0001-retain-presentation-drawable.patch
@@ -0,0 +1,201 @@
+diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKImage.h b/MoltenVK/MoltenVK/GPUObjects/MVKImage.h
+--- a/MoltenVK/MoltenVK/GPUObjects/MVKImage.h
++++ b/MoltenVK/MoltenVK/GPUObjects/MVKImage.h
+@@ -22,6 +22,7 @@
+ #include "MVKCommandResourceFactory.h"
+ #include "MVKSync.h"
+ #include "MVKSmallVector.h"
++#include "MVKRetainedObject.h"
+ #include <MoltenVKShaderConverter/SPIRVToMSLConverter.h>
+ #include <unordered_map>
+ #include <mutex>
+@@ -498,7 +499,8 @@
+ protected:
+ 	friend MVKSwapchain;
+ 
+-	id<CAMetalDrawable> getCAMetalDrawable();
++	// Returns +1 ownership; the caller must release it.
++	id<CAMetalDrawable> getRetainedCAMetalDrawable();
+ 	void addPresentedHandler(id<CAMetalDrawable> mtlDrawable, MVKImagePresentInfo presentInfo, MVKSwapchainSignaler signaler);
+ 	void releaseMetalDrawable();
+ 	MVKSwapchainImageAvailability getAvailability();
+@@ -506,7 +508,7 @@
+ 	VkResult acquireAndSignalWhenAvailable(MVKSemaphore* semaphore, MVKFence* fence);
+ 	MVKSwapchainSignaler getPresentationSignaler();
+ 
+-	id<CAMetalDrawable> _mtlDrawable = nil;
++	MVKRetainedObject<id<CAMetalDrawable>> _mtlDrawable;
+ 	id<MTLTexture> _mtlTextureHeadless = nil;
+ 	MVKSwapchainImageAvailability _availability;
+ 	MVKSmallVector<MVKSwapchainSignaler, 1> _availabilitySignalers;
+diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKImage.mm b/MoltenVK/MoltenVK/GPUObjects/MVKImage.mm
+--- a/MoltenVK/MoltenVK/GPUObjects/MVKImage.mm
++++ b/MoltenVK/MoltenVK/GPUObjects/MVKImage.mm
+@@ -1577,47 +1577,60 @@
+ // Calling nextDrawable may result in a nil drawable, or a drawable with no pixel format.
+ // Attempt several times to retrieve a good drawable, and set an error to trigger the
+ // swapchain to be re-established if one cannot be retrieved.
+-id<CAMetalDrawable> MVKPresentableSwapchainImage::getCAMetalDrawable() {
+-
+-	if (_mtlTextureHeadless) { return nil; }	// If headless, there is no drawable.
+-
+-	if ( !_mtlDrawable ) {
++id<CAMetalDrawable> MVKPresentableSwapchainImage::getRetainedCAMetalDrawable() {
++	if (_mtlTextureHeadless) { return nil; }
++	if (id<CAMetalDrawable> drawable = _mtlDrawable.getRetained()) { return drawable; }
++
++	// nextDrawable can block until a completion callback releases another drawable.
++	// Never hold the ownership lock across this call.
++	id<CAMetalDrawable> candidate = nil;
++	bool hasInvalidFormat = false;
++	uint32_t attemptCnt = _swapchain->getImageCount();
++	for (uint32_t attemptIdx = 0; !candidate && attemptIdx < attemptCnt; attemptIdx++) {
+ 		@autoreleasepool {
+-			bool hasInvalidFormat = false;
+-			uint32_t attemptCnt = _swapchain->getImageCount();	// Attempt a resonable number of times
+-			for (uint32_t attemptIdx = 0; !_mtlDrawable && attemptIdx < attemptCnt; attemptIdx++) {
+-				uint64_t startTime = getPerformanceTimestamp();
+-				_mtlDrawable = [_swapchain->getCAMetalLayer().nextDrawable retain];	// retained
