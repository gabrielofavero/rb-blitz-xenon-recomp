+++ b/scripts/prepare_vulkan_stack.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Prepare exact Vulkan source revisions and audit their bounded local patch set."""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+SDK_ROOT = Path(__file__).resolve().parents[1]
+MANIFEST = SDK_ROOT / "cmake/rexglue_vulkan_stack.json"
+
+
+def git(root: Path, *args: str, check: bool = True) -> bytes:
+    result = subprocess.run(["git", "-C", str(root), *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if check and result.returncode:
+        raise RuntimeError(result.stderr.decode(errors="replace").strip())
+    return result.stdout
+
+
+def comparable(data: bytes | None) -> bytes | None:
+    return data.replace(b"\r\n", b"\n") if os.name == "nt" and data is not None else data
+
+
+def patched_files(source: Path, patch: Path) -> dict[str, bytes]:
+    paths = set()
+    for line in patch.read_text().splitlines():
+        if line.startswith("+++ b/") or line.startswith("--- a/"):
+            name = line[6:]
+            if Path(name).is_absolute() or Path(name).drive or ".." in Path(name).parts:
+                raise RuntimeError(f"Unsafe dependency patch path: {name}")
+            paths.add(name)
+    with tempfile.TemporaryDirectory(prefix="rex-vulkan-patch-") as temporary:
+        replay = Path(temporary)
+        git(replay, "init", "-q")
+        git(replay, "config", "core.autocrlf", "false")
+        for name in paths:
+            data = git(source, "show", "HEAD:" + name, check=False)
+            if data:
+                dest = replay / name
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_bytes(data)
+        git(replay, "apply", "--whitespace=nowarn", str(patch.resolve()))
+        return {name: (replay / name).read_bytes() for name in paths}
+
+
+def audit(source: Path, spec: dict, check_only: bool) -> int:
+    actual = git(source, "rev-parse", "HEAD").decode().strip()
+    if actual != spec["commit"]:
+        raise RuntimeError(f"{source} is at {actual}, expected {spec['commit']}; refusing to replace its checkout")
+    expected = {}
+    if "patch" in spec:
+        patch = SDK_ROOT / spec["patch"]
+        if hashlib.sha256(patch.read_bytes()).hexdigest() != spec["patch_sha256"]:
+            raise RuntimeError(f"Bundled dependency patch hash mismatch: {patch}")
+        expected = patched_files(source, patch)
+    changed = git(source, "diff", "HEAD", "--name-only", "-z").decode().split("\0")
+    untracked = git(source, "ls-files", "--others", "--exclude-standard", "-z").decode().split("\0")
+    unexpected = sorted(name for name in set(changed + untracked) if name and name not in expected)
+    if unexpected:
+        raise RuntimeError(f"{source} has unrelated local edits: {unexpected}")
+    writes = []
+    for name, final in expected.items():
+        dest = source / name
+        if dest.is_symlink() or (dest.exists() and not dest.is_file()):
+            raise RuntimeError(f"Refusing dependency patch replacement: {dest}")
+        current = dest.read_bytes() if dest.exists() else None
+        original = git(source, "show", "HEAD:" + name, check=False) or None
+        if comparable(current) not in (comparable(original), comparable(final)):
+            raise RuntimeError(f"Dependency has local edits outside its exact patch replay: {dest}")
+        if comparable(current) != comparable(final):
+            writes.append((dest, final))
+    if check_only and writes:
+        raise RuntimeError(f"{source} needs {len(writes)} dependency patch updates")
+    for dest, data in writes:
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(data)
+    return len(writes)
+
+
+def prepare(source: Path, spec: dict, mirror: Path | None, check_only: bool, offline: bool) -> None:
+    if not (source / ".git").exists():
+        if check_only:
+            raise RuntimeError(f"Pinned dependency is missing: {source}")
+        if source.exists():
+            raise RuntimeError(f"Dependency directory exists without Git metadata: {source}")
+        source.parent.mkdir(parents=True, exist_ok=True)
+        origin = str(mirror.resolve()) if mirror and (mirror / ".git").exists() else spec["repository"]
+        if offline and origin == spec["repository"]:
+            raise RuntimeError(f"Offline dependency preparation needs a local mirror: {source.name}")
+        # A failed acquisition must not leave a half-prepared dependency at its
+        # public path. Rename the verified checkout only after all inputs pass.
+        with tempfile.TemporaryDirectory(prefix=".rex-vulkan-", dir=source.parent) as temporary:
+            checkout = Path(temporary) / source.name
+            subprocess.run(["git", "-c", "core.autocrlf=false", "clone", "--no-hardlinks", "--no-checkout", origin, str(checkout)], check=True)
+            git(checkout, "config", "core.autocrlf", "false")
+            git(checkout, "remote", "set-url", "origin", spec["repository"])
+            found = subprocess.run(["git", "-C", str(checkout), "cat-file", "-e", spec["commit"] + "^{commit}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            if found.returncode:
+                if offline:
+                    raise RuntimeError(f"Local mirror lacks pinned commit for {source.name}: {spec['commit']}")
+                git(checkout, "fetch", "--depth=1", "origin", spec["commit"])
+            git(checkout, "checkout", "--detach", spec["commit"])
+            audit(checkout, spec, False)
+            checkout.rename(source)
+    changed = audit(source, spec, check_only)
+    print(f"{source.name}: {spec['commit']} verified, {changed} patch updates")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, required=True)
+    parser.add_argument("--only", nargs="+", choices=["vulkan-headers", "vulkan-loader", "vulkan-memory-allocator", "moltenvk"])
+    parser.add_argument("--mirror-root", type=Path)
+    parser.add_argument("--mirror", action="append", default=[], metavar="NAME=PATH")
+    parser.add_argument("--canonical-moltenvk-patch", type=Path)
+    parser.add_argument("--check", action="store_true")
+    parser.add_argument("--offline", action="store_true")
+    args = parser.parse_args()
+    manifest = json.loads(MANIFEST.read_text())
+    mirrors = {}
+    for entry in args.mirror:
+        name, separator, value = entry.partition("=")
+        if not separator or name not in manifest["dependencies"]:
+            parser.error("--mirror expects a known dependency NAME=PATH")
+        mirrors[name] = Path(value)
+    if args.canonical_moltenvk_patch:
+        canonical = args.canonical_moltenvk_patch.read_bytes()
+        spec = manifest["dependencies"]["moltenvk"]
+        if hashlib.sha256(canonical).hexdigest() != spec["patch_sha256"]:
+            raise RuntimeError("Canonical MoltenVK patch differs from its bundled source-build input")
+    for name in args.only or manifest["dependencies"]:
+        mirror = mirrors.get(name)
+        if mirror is None and args.mirror_root:
+            mirror = args.mirror_root / name
+        prepare(args.source_root.resolve() / name, manifest["dependencies"][name], mirror, args.check, args.offline)
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
+        raise SystemExit(str(error))
