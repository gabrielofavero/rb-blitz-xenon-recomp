@@ -0,0 +1,89 @@
+"""Offline regressions for dependency publication and exact patch auditing."""
+import contextlib
+import hashlib
+import importlib.util
+import io
+from pathlib import Path
+import tempfile
+import unittest
+
+SPEC = importlib.util.spec_from_file_location(
+    "prepare_vulkan_stack", Path(__file__).resolve().parents[2] / "scripts/prepare_vulkan_stack.py")
+ENGINE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(ENGINE)
+
+
+class PinnedDependencyTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="rex-vulkan-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.mirror = self.root / "mirror"
+        self.mirror.mkdir()
+        ENGINE.git(self.mirror, "init", "-q")
+        ENGINE.git(self.mirror, "config", "core.autocrlf", "false")
+        (self.mirror / "value.txt").write_text("original\n")
+        ENGINE.git(self.mirror, "add", ".")
+        ENGINE.git(self.mirror, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid",
+                   "commit", "-qm", "fixture")
+        self.pin = ENGINE.git(self.mirror, "rev-parse", "HEAD").decode().strip()
+        self.spec = {"commit": self.pin, "repository": "https://invalid.example/dependency.git"}
+        self.source = self.root / "sources/dependency"
+
+    def prepare(self):
+        with contextlib.redirect_stdout(io.StringIO()):
+            ENGINE.prepare(self.source, self.spec, self.mirror, False, True)
+
+    def test_checkout_is_exact_and_idempotent(self):
+        self.prepare()
+        self.assertEqual(ENGINE.git(self.source, "rev-parse", "HEAD").decode().strip(), self.pin)
+        self.assertEqual(ENGINE.audit(self.source, self.spec, True), 0)
+        self.prepare()
+        self.assertEqual((self.source / "value.txt").read_text(), "original\n")
+
+    def test_pin_drift_and_local_edits_are_preserved(self):
+        self.prepare()
+        (self.source / "value.txt").write_text("local\n")
+        with self.assertRaisesRegex(RuntimeError, "unrelated local edits"):
+            ENGINE.audit(self.source, self.spec, False)
+        self.assertEqual((self.source / "value.txt").read_text(), "local\n")
+        with self.assertRaisesRegex(RuntimeError, "refusing to replace"):
+            ENGINE.audit(self.source, dict(self.spec, commit="0" * 40), False)
+
+    def test_failed_acquisition_does_not_publish_partial_checkout(self):
+        self.spec["commit"] = "0" * 40
+        with self.assertRaisesRegex(RuntimeError, "lacks pinned commit"):
+            self.prepare()
+        self.assertFalse(self.source.exists())
+        self.assertEqual(list(self.source.parent.iterdir()), [])
+
+    def test_existing_nonrepository_is_preserved(self):
+        self.source.mkdir(parents=True)
+        (self.source / "local.txt").write_text("keep")
+        with self.assertRaisesRegex(RuntimeError, "without Git metadata"):
+            self.prepare()
+        self.assertEqual((self.source / "local.txt").read_text(), "keep")
+
+    def test_patch_replay_is_exact_and_rejects_unowned_edits(self):
+        patch = self.root / "exact.patch"
+        patch.write_text("diff --git a/value.txt b/value.txt\n--- a/value.txt\n+++ b/value.txt\n"
+                         "@@ -1 +1 @@\n-original\n+patched\n")
+        self.spec.update(patch=str(patch), patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest())
+        self.prepare()
+        self.assertEqual((self.source / "value.txt").read_text(), "patched\n")
+        self.assertEqual(ENGINE.audit(self.source, self.spec, True), 0)
+        (self.source / "value.txt").write_text("original\n")
+        with self.assertRaisesRegex(RuntimeError, "needs 1 dependency patch updates"):
+            ENGINE.audit(self.source, self.spec, True)
+        self.assertEqual(ENGINE.audit(self.source, self.spec, False), 1)
+        (self.source / "value.txt").write_text("local\n")
+        with self.assertRaisesRegex(RuntimeError, "outside its exact patch replay"):
+            ENGINE.audit(self.source, self.spec, False)
+        self.assertEqual((self.source / "value.txt").read_text(), "local\n")
+        patch.write_text(patch.read_text() + "\n")
+        with self.assertRaisesRegex(RuntimeError, "hash mismatch"):
+            ENGINE.audit(self.source, self.spec, False)
+
+
+if __name__ == "__main__":
+    unittest.main()
