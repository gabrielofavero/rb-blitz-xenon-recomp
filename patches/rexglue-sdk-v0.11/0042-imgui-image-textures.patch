diff --git a/tests/unit/ui/image_texture_test.cpp b/tests/unit/ui/image_texture_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/ui/image_texture_test.cpp
@@ -0,0 +1,71 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include <array>
+#include <imgui_internal.h>
+#include <rex/ui/image_texture.h>
+#include "ui/image_texture.h"
+
+namespace {
+struct ImageContext {
+  ImGuiContext* previous = ImGui::GetCurrentContext();
+  ImGuiContext* context = ImGui::CreateContext();
+  ~ImageContext() {
+    ImGui::SetCurrentContext(context);
+    rex::ui::detail::ReleaseImageTextures();
+    ImGui::DestroyContext(context);
+    ImGui::SetCurrentContext(previous);
+  }
+};
+}
+
+REX_TEST_CASE("UI image extents and RGBA length are validated before registration", "[ui][image_texture]") {
+  ImageContext context;
+  std::array<rex::u8, 16> pixels{};
+  CHECK_FALSE(rex::ui::ImageTexture::Create(0, 2, pixels));
+  CHECK_FALSE(rex::ui::ImageTexture::Create(513, 1, pixels));
+  CHECK_FALSE(rex::ui::ImageTexture::Create(2, 3, pixels));
+  CHECK(ImGui::GetCurrentContext()->UserTextures.empty());
+  auto image = rex::ui::ImageTexture::Create(2, 2, pixels);
+  REQUIRE(image);
+  CHECK(ImGui::GetCurrentContext()->UserTextures.Size == 1);
+  CHECK((*image)->GetTexture()._TexData->Width == 2);
+  image->reset();
+  rex::ui::detail::CollectImageTextures();
+  CHECK(ImGui::GetCurrentContext()->UserTextures.empty());
+}
+
+REX_TEST_CASE("UI image release retains its descriptor until renderer retirement", "[ui][image_texture]") {
+  ImageContext context;
+  std::array<rex::u8, 16> pixels{1,2,3,4};
+  auto image = rex::ui::ImageTexture::Create(2, 2, pixels);
+  REQUIRE(image);
+  auto* descriptor = (*image)->GetTexture()._TexData;
+  REQUIRE(descriptor);
+  CHECK(static_cast<const rex::u8*>(descriptor->GetPixels())[0] == 1);
+  descriptor->SetTexID(123);
+  descriptor->SetStatus(ImTextureStatus_OK);
+  image->reset();
+  rex::ui::detail::CollectImageTextures();
+  CHECK(descriptor->WantDestroyNextFrame);
+  CHECK(descriptor->Status == ImTextureStatus_WantDestroy);
+  CHECK(ImGui::GetCurrentContext()->UserTextures.Size == 1);
+  descriptor->SetTexID(ImTextureID_Invalid);
+  descriptor->SetStatus(ImTextureStatus_Destroyed);
+  rex::ui::detail::CollectImageTextures();
+  CHECK(ImGui::GetCurrentContext()->UserTextures.empty());
+}
+
+REX_TEST_CASE("closing the UI context invalidates images retained by a consumer", "[ui][image_texture]") {
+  std::unique_ptr<rex::ui::ImageTexture> retained;
+  {
+    ImageContext context;
+    std::array<rex::u8, 4> pixels{};
+    auto image = rex::ui::ImageTexture::Create(1, 1, pixels);
+    REQUIRE(image);
+    retained = std::move(*image);
+    REQUIRE(retained->GetTexture()._TexData);
+    rex::ui::detail::ReleaseImageTextures();
+    CHECK(retained->GetTexture()._TexData == nullptr);
+  }
+  retained.reset();
+}
