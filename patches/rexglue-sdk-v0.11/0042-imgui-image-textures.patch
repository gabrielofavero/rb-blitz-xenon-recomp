+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+#include <rex/platform.h>
+namespace rex::ui::detail {
+// Current context only. The ImGui host calls these before each frame and shutdown.
+REX_API void CollectImageTextures();
+REX_API void ReleaseImageTextures();
+}  // namespace rex::ui::detail
diff --git a/src/ui/image_texture.cpp b/src/ui/image_texture.cpp
new file mode 100644
--- /dev/null
+++ b/src/ui/image_texture.cpp
@@ -0,0 +1,87 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include <rex/ui/image_texture.h>
+#include "ui/image_texture.h"
+
+#include <cstring>
+#include <map>
+#include <utility>
+#include <vector>
+#include <imgui_internal.h>
+
+namespace rex::ui {
+namespace detail {
+struct ImageTextureState {
+  ImGuiContext* context = nullptr;
+  ImTextureData texture;
+};
+
+// Each UI thread owns its contexts. The store retains released CPU descriptors
+// until their WantDestroy request has passed through the renderer.
+thread_local std::map<ImGuiContext*, std::vector<std::shared_ptr<ImageTextureState>>> stores;
+
+void CollectImageTextures() {
+  const auto found = stores.find(ImGui::GetCurrentContext());
+  if (found == stores.end()) return;
+  auto& images = found->second;
+  for (auto it = images.begin(); it != images.end();) {
+    auto& image = *it;
+    if (image.use_count() != 1) { ++it; continue; }
+    auto& texture = image->texture;
+    if (texture.Status == ImTextureStatus_Destroyed ||
+        (texture.Status == ImTextureStatus_WantCreate &&
+         texture.TexID == ImTextureID_Invalid)) {
+      ImGui::UnregisterUserTexture(&texture);
+      image->context = nullptr;
+      it = images.erase(it);
+      continue;
+    }
+    texture.WantDestroyNextFrame = true;
+    texture.SetStatus(ImTextureStatus_WantDestroy);
+    ++it;
+  }
+}
+
+void ReleaseImageTextures() {
+  const auto found = stores.find(ImGui::GetCurrentContext());
+  if (found == stores.end()) return;
+  for (auto& image : found->second) {
+    ImGui::UnregisterUserTexture(&image->texture);
+    image->context = nullptr;
+  }
+  stores.erase(found);
+}
+}  // namespace detail
+
+ImageTexture::ImageTexture(std::shared_ptr<detail::ImageTextureState> state)
+    : state_(std::move(state)) {}
+ImageTexture::~ImageTexture() = default;
+
+Result<std::unique_ptr<ImageTexture>> ImageTexture::Create(
+    u32 width, u32 height, std::span<const u8> rgba) {
+  auto* context = ImGui::GetCurrentContext();
+  if (!context) return Err<std::unique_ptr<ImageTexture>>(ErrorCategory::kRuntime, "no UI context");
+  if (!width || !height || width > 512 || height > 512 ||
+      rgba.size() != static_cast<size_t>(width) * height * 4) {
+    return Err<std::unique_ptr<ImageTexture>>(ErrorCategory::kValidation, "invalid RGBA image extent");
+  }
+  detail::CollectImageTextures();
+  auto& images = detail::stores[context];
+  // Dynamic ImGui textures replace the old immediate drawer's eight slots.
+  // Keep a bounded per-context allocation budget, including pending retirement.
+  if (images.size() >= 64) {
+    return Err<std::unique_ptr<ImageTexture>>(ErrorCategory::kRuntime, "UI image budget exhausted");
+  }
+  auto state = std::make_shared<detail::ImageTextureState>();
+  state->context = context;
+  state->texture.Create(ImTextureFormat_RGBA32, static_cast<int>(width), static_cast<int>(height));
+  std::memcpy(state->texture.GetPixels(), rgba.data(), rgba.size());
+  state->texture.UseColors = true;
+  ImGui::RegisterUserTexture(&state->texture);
+  images.push_back(state);
+  return std::unique_ptr<ImageTexture>(new ImageTexture(std::move(state)));
+}
+
+ImTextureRef ImageTexture::GetTexture() const {
+  return state_ && state_->context ? state_->texture.GetTexRef() : ImTextureRef{};
+}
+}  // namespace rex::ui
