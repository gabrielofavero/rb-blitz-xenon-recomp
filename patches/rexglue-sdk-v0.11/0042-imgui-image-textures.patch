+namespace rex::ui {
+namespace detail { struct ImageTextureState; }
+
+/** An RGBA image owned by the current UI context. All calls belong on its UI thread.
+ * Releasing an image requests GPU retirement; its pixels remain alive until the
+ * renderer acknowledges destruction or the UI context closes.
+ */
+class REX_API ImageTexture final {
+ public:
+  /** Creates an image of at most 512 by 512 pixels, or returns a validation error. */
+  [[nodiscard]] static Result<std::unique_ptr<ImageTexture>> Create(
+      u32 width, u32 height, std::span<const u8> rgba);
+  ~ImageTexture();
+  ImageTexture(const ImageTexture&) = delete;
+  ImageTexture& operator=(const ImageTexture&) = delete;
+
+  /** Returns an empty reference after the owning UI context closes. */
+  [[nodiscard]] ImTextureRef GetTexture() const;
+
+ private:
+  explicit ImageTexture(std::shared_ptr<detail::ImageTextureState> state);
+  std::shared_ptr<detail::ImageTextureState> state_;
+};
+}  // namespace rex::ui
