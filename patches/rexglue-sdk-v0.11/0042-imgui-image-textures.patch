+
+REX_TEST_CASE("a replacement overlay renderer recreates a live UI texture", "[gpu][imgui]") {
+  FakeDrawer drawer;
+  ImTextureData texture;
+  texture.Create(ImTextureFormat_RGBA32, 8, 8);
+  texture.SetStatus(ImTextureStatus_WantCreate);
+  Frame frame;
+  frame.textures.push_back(&texture);
+  {
+    rex::gpu::ImGuiOverlay first(drawer);
+    first.UpdateTextures(frame.data);
+    CHECK(texture.Status == ImTextureStatus_OK);
+    CHECK(drawer.create_attempts == 1);
+  }
+  rex::gpu::ImGuiOverlay second(drawer);
+  second.UpdateTextures(frame.data);
+  CHECK(texture.Status == ImTextureStatus_OK);
+  CHECK(drawer.create_attempts == 2);
+  CHECK(second.GetTextureCount() == 1);
+}
