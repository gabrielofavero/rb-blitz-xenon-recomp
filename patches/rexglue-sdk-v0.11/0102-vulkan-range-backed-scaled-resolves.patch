+u64 VulkanTextureCache::CreateScaledResolveSegment(u64 size) {
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& properties = device->GetProperties();
+  const auto& dfn = device->GetFunctions();
+  ReclaimScaledResolveSegments();
+  if ((properties.maxMemoryAllocationSize && size > properties.maxMemoryAllocationSize) ||
+      size > properties.maxStorageBufferRange ||
