+VulkanTextureCache::ScaledResolveSegment* VulkanTextureCache::FindScaledResolveSegment(u64 handle) const {
+  for (const auto& segment : scaled_resolve_segment_buffers_)
+    if (segment->handle == handle) return segment.get();
+  return nullptr;
+}
+
+void VulkanTextureCache::ReclaimScaledResolveSegments(bool all) {
+  const auto* device = command_processor_.GetVulkanDevice();
+  const auto& dfn = device->GetFunctions();
+  const auto completed = command_processor_.GetCompletedSubmission();
+  std::erase_if(scaled_resolve_segment_buffers_, [&](const auto& segment) {
+    if (!all && (!segment->retired_submission || segment->retired_submission > completed)) return false;
+    dfn.vkDestroyBuffer(device->GetDevice(), segment->buffer, nullptr);
+    dfn.vkFreeMemory(device->GetDevice(), segment->memory, nullptr);
+    scaled_resolve_segment_bytes_ -= segment->size;
+    // Imported host pages are released by the record after Vulkan releases its memory.
+    return true;
+  });
+}
