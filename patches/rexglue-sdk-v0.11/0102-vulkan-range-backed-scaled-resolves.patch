diff --git a/src/gpu/xenos/host/vulkan/scaled_resolve_segments.h b/src/gpu/xenos/host/vulkan/scaled_resolve_segments.h
new file mode 100644
index 0000000..b561e9a
--- /dev/null
+++ b/src/gpu/xenos/host/vulkan/scaled_resolve_segments.h
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <new>
+#include <vector>
+
+namespace rex::gpu::vulkan {
+
+// Maps logical scaled-resolve addresses to compact buffers. Descriptors remain
+// relative to their requested logical start, so shader addressing is unchanged.
+// Allocation owns hardware/budget checks. Copy and retire must not throw; retired
+// handles must remain alive until all submissions using their descriptors finish.
+class ScaledResolveSegments {
+ public:
+  static constexpr std::uint64_t kAlignment = std::uint64_t(64) << 10;
+
+  struct Span {
+    std::uint64_t start = 0;
+    std::uint64_t size = 0;
+    std::uint64_t handle = 0;
+  };
+
+  struct Binding {
+    std::uint64_t handle = 0;
+    std::uint64_t offset = 0;
+    std::uint64_t length = 0;
+  };
+
+  explicit ScaledResolveSegments(std::uint64_t logical_size = 0)
+      : logical_size_(logical_size) {}
+
+  bool Configure(std::uint64_t logical_size) {
+    if (!spans_.empty()) return false;
+    logical_size_ = logical_size;
+    return true;
+  }
+
+  const std::vector<Span>& spans() const { return spans_; }
+
+  bool Find(std::uint64_t start, std::uint64_t length, Binding& binding) const {
+    if (!ValidRange(start, length)) return false;
+    if (!length) {
+      binding = {};
+      return true;
+    }
+    for (const auto& span : spans_) {
+      if (span.start > start) break;
+      if (start - span.start < span.size &&
+          length <= span.size - (start - span.start)) {
+        binding = {span.handle, start - span.start, length};
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Allocate(size) returns a new nonzero handle or zero on failure.
+  // Copy(source, destination, source_offset, destination_offset, size) records a
+  // GPU copy before later use of the returned binding. Retirement is deferred by
+  // the caller. Failure leaves existing mappings and the output binding intact.
+  template <typename Allocate, typename Copy, typename Retire>
+  bool Acquire(std::uint64_t start, std::uint64_t length, Allocate&& allocate,
+               Copy&& copy, Retire&& retire, Binding& binding) {
+    if (!ValidRange(start, length)) return false;
+    if (Find(start, length, binding)) return true;
+
+    std::uint64_t begin = start & ~(kAlignment - 1);
+    std::uint64_t end = start + length;
+    if (end & (kAlignment - 1)) {
+      end += std::min(kAlignment - (end & (kAlignment - 1)), logical_size_ - end);
+    }
+
+    std::size_t first = 0;
+    while (first < spans_.size() && spans_[first].start + spans_[first].size <= begin) {
+      ++first;
+    }
+    std::size_t last = first;
+    while (last < spans_.size() && spans_[last].start < end) {
+      begin = std::min(begin, spans_[last].start);
+      end = std::max(end, spans_[last].start + spans_[last].size);
+      ++last;
+    }
+
+    // Prepare all metadata before allocation or recording migration commands.
+    // Publishing the resulting map is then a nonthrowing swap.
+    std::vector<Span> replacement;
+    try {
+      replacement.reserve(spans_.size() - (last - first) + 1);
+      replacement.insert(replacement.end(), spans_.begin(), spans_.begin() + first);
+      replacement.push_back({begin, end - begin, 0});
+      replacement.insert(replacement.end(), spans_.begin() + last, spans_.end());
+    } catch (const std::bad_alloc&) {
+      return false;
+    }
+
+    std::uint64_t handle;
+    try {
+      handle = allocate(end - begin);
+    } catch (const std::bad_alloc&) {
+      return false;
+    }
+    if (!handle) return false;
+    replacement[first].handle = handle;
+    for (std::size_t index = first; index < last; ++index) {
+      const auto& old = spans_[index];
+      copy(old.handle, handle, 0, old.start - begin, old.size);
+    }
+    spans_.swap(replacement);
+    for (std::size_t index = first; index < last; ++index) {
+      retire(replacement[index].handle);
+    }
+    binding = {handle, start - begin, length};
+    return true;
+  }
+
+  template <typename Retire>
+  void Clear(Retire&& retire) {
+    for (const auto& span : spans_) retire(span.handle);
+    spans_.clear();
+  }
+
+ private:
+  bool ValidRange(std::uint64_t start, std::uint64_t length) const {
+    return start <= logical_size_ && length <= logical_size_ - start;
+  }
+
+  std::uint64_t logical_size_ = 0;
+  std::vector<Span> spans_;
+};
+
+}  // namespace rex::gpu::vulkan
