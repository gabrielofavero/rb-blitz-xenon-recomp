+void TitleApp::StopTitle() {
+  if (state_->stopping_title) return;
+  state_->stopping_title = true;
+  ScopeGuard finish([this] {
+    state_->runtime.Unload();
+    state_->stopping_title = false;
+  });
+  if (state_->runtime.IsLoaded()) OnTitleStopping(state_->runtime);
+}
