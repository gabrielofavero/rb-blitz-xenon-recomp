+namespace {
+class StopAwareApp final : public FooApp {
+ public:
+  StopAwareApp() : FooApp(false,rex::test::MakeTitleImage(rex::test::kDelayingEntry)) {}
+  int stops=0;
+  bool loaded_during_stop=true;
+  bool refuse_launch=false;
+  bool throw_launch=false;
+ protected:
+  rex::Result<void> OnTitleLaunch(rex::kernel::TitleRuntime&) override {
+    if(throw_launch) throw std::runtime_error("launch reader failed");
+    if(refuse_launch) return rex::Err(rex::ErrorCategory::kRuntime,"required loading payload unavailable");
+    return rex::Ok();
+  }
+  void OnTitleStopping(rex::kernel::TitleRuntime& title) override {
+    ++stops;
+    loaded_during_stop=loaded_during_stop && title.IsLoaded() && title.GetTitleID()!=0;
+  }
+};
+}
+
+REX_TEST_CASE("Title readers stop before unmapping on unload restart and shutdown", "[ui][title_app]") {
+  rex::test::TempFolder folder("rex_stopping_title_");
+  rex::test::WriteTitle(folder.path);
+  StopAwareApp app;
+  app.game_root=folder.path;
+  REQUIRE(Open(app));
+  REQUIRE(app.LaunchTitle());
+  app.UnloadTitle();
+  CHECK(app.stops==1);
+  CHECK(app.loaded_during_stop);
+  CHECK_FALSE(app.GetTitleRuntime().IsLoaded());
+  app.UnloadTitle();
+  CHECK(app.stops==1);
+  REQUIRE(app.LaunchTitle());
+  REQUIRE(app.Shutdown()==0);
+  CHECK(app.stops==2);
+  CHECK(app.loaded_during_stop);
+}
+
+REX_TEST_CASE("A refused title launch stops its readers before the required-payload failure", "[ui][title_app]") {
+  rex::test::g_entry.Reset();
+  rex::test::TempFolder folder("rex_refused_title_");
+  rex::test::WriteTitle(folder.path);
+  StopAwareApp app;
+  app.game_root=folder.path;
+  app.refuse_launch=true;
+  REQUIRE(Open(app));
+  REQUIRE_FALSE(app.LaunchTitle());
+  CHECK(app.stops==1);
+  CHECK(app.loaded_during_stop);
+  CHECK_FALSE(app.GetTitleRuntime().IsLoaded());
+  CHECK(rex::test::g_entry.entered==0);
+  CHECK(app.Shutdown()==1);
+  CHECK(app.stops==1);
+}
+
+REX_TEST_CASE("An exception in title launch stops readers and releases guest memory", "[ui][title_app]") {
+  rex::test::TempFolder folder("rex_throwing_title_");
+  rex::test::WriteTitle(folder.path);
+  StopAwareApp app;
+  app.game_root=folder.path;
+  app.throw_launch=true;
+  REQUIRE(Open(app));
+  CHECK_THROWS_AS(app.LaunchTitle(),std::runtime_error);
+  CHECK(app.stops==1);
+  CHECK(app.loaded_during_stop);
+  CHECK_FALSE(app.GetTitleRuntime().IsLoaded());
+  CHECK(app.Shutdown()==0);
+  CHECK(app.stops==1);
+}
