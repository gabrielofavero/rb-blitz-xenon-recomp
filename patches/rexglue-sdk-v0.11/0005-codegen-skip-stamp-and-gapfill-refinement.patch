diff --git a/tests/codegen_first_build.cmake b/tests/codegen_first_build.cmake
new file mode 100644
--- /dev/null
+++ b/tests/codegen_first_build.cmake
@@ -0,0 +1,113 @@
+# Native Ninja regression for codegen metadata production and CMake regeneration ordering.
+cmake_minimum_required(VERSION 3.25)
+foreach(required REXGLUE_HELPER TEST_ROOT CXX_COMPILER MAKE_PROGRAM)
+  if(NOT DEFINED ${required})
+    message(FATAL_ERROR "Missing ${required}")
+  endif()
+  file(TO_CMAKE_PATH "${${required}}" ${required})
+endforeach()
+string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef unique)
+set(source "${TEST_ROOT}/${unique}/source")
+set(build "${TEST_ROOT}/${unique}/build")
+file(MAKE_DIRECTORY "${source}")
+set(project_text [=[
+cmake_minimum_required(VERSION 3.25)
+project(codegen_first_build LANGUAGES CXX)
+include("@REXGLUE_HELPER@")
+set(output "${CMAKE_CURRENT_SOURCE_DIR}/generated")
+if(EXISTS "${output}/sources.cmake")
+  include("${output}/sources.cmake")
+  if(GENERATED_SOURCES)
+    add_library(guest OBJECT ${GENERATED_SOURCES})
+  endif()
+endif()
+rexglue_add_codegen(generate_guest
+  MANIFEST "${CMAKE_CURRENT_SOURCE_DIR}/input.toml"
+  OUTPUT_DIR "${output}"
+  WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+  TOOL "${CMAKE_COMMAND}" -P "${CMAKE_CURRENT_SOURCE_DIR}/producer.cmake"
+  SOURCES ${GENERATED_SOURCES})
+add_executable(example main.cpp)
+if(TARGET guest)
+  add_dependencies(guest generate_guest)
+  target_link_libraries(example PRIVATE guest)
+endif()
+add_dependencies(example generate_guest)
+]=])
+string(CONFIGURE "${project_text}" project_text @ONLY)
+file(WRITE "${source}/CMakeLists.txt" "${project_text}")
+file(WRITE "${source}/main.cpp" "#include <cstdio>\nint guest_value();\nint main() { std::printf(\"%d\\n\", guest_value()); return 0; }\n")
+# A small producer keeps this scheduling regression independent of target SDK installation.
+# It uses the same output/depfile contract; real PPC translation is tested separately.
+file(WRITE "${source}/producer.cmake" [=[
+cmake_minimum_required(VERSION 3.25)
+set(manifest "${CMAKE_ARGV4}")
+get_filename_component(root "${manifest}" DIRECTORY)
+set(output "${root}/generated")
+file(READ "${manifest}" input)
+string(REGEX MATCH "value=([0-9]+)" matched "${input}")
+if(NOT matched)
+  message(FATAL_ERROR "Invalid producer input")
+endif()
+set(value "${CMAKE_MATCH_1}")
+file(MAKE_DIRECTORY "${output}")
+file(WRITE "${output}/guest.cpp" "int guest_value() { return ${value}; }\n")
+file(WRITE "${output}/sources.cmake" "set(GENERATED_SOURCES \"${output}/guest.cpp\")\n")
+file(WRITE "${output}/codegen.build.stamp" "${input}")
+file(APPEND "${root}/invocations.txt" "run\n")
+foreach(variable manifest output)
+  string(REPLACE "$" "$$" ${variable} "${${variable}}")
+  string(REPLACE "#" "\\#" ${variable} "${${variable}}")
+  string(REPLACE " " "\\ " ${variable} "${${variable}}")
+endforeach()
+file(WRITE "${root}/generated/codegen.d" "${output}/codegen.build.stamp: ${manifest}\n")
+]=])
+file(WRITE "${source}/input.toml" "value=42\n")
+function(run name)
+  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output
+                  ERROR_VARIABLE error TIMEOUT 90)
+  file(WRITE "${TEST_ROOT}/${unique}/${name}.log" "${output}${error}")
+  if(NOT result EQUAL 0)
+    message(FATAL_ERROR "${name} failed (${result}) in ${build}:\n${output}${error}")
+  endif()
+  set(last_output "${output}${error}" PARENT_SCOPE)
+endfunction()
+function(check_run expected)
+  set(executable "${build}/example")
+  if(WIN32)
+    string(APPEND executable ".exe")
+  endif()
+  run("run-${expected}" "${executable}")
+  string(STRIP "${last_output}" actual)
+  if(NOT actual STREQUAL "${expected}")
+    message(FATAL_ERROR "Generated function returned ${actual}, expected ${expected}")
+  endif()
+endfunction()
+run(configure "${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G Ninja
+    "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
+run(first-build "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+if(NOT last_output MATCHES "Re-running CMake")
+  message(FATAL_ERROR "Initial producer did not regenerate the build files")
+endif()
+check_run(42)
+file(SHA256 "${source}/invocations.txt" initial_runs)
+run(second-build "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+file(SHA256 "${source}/invocations.txt" second_runs)
+if(NOT last_output MATCHES "no work to do" OR NOT initial_runs STREQUAL second_runs)
+  message(FATAL_ERROR "Unchanged second build was not a no-op")
+endif()
+file(WRITE "${source}/input.toml" "value=43\n")
+run(changed-input "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+check_run(43)
+file(REMOVE "${source}/generated/sources.cmake")
+run(deleted-list "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+check_run(43)
+file(REMOVE "${source}/generated/sources.cmake")
+run(reconfigure-missing-list "${CMAKE_COMMAND}" -S "${source}" -B "${build}")
+run(rebuild-missing-list "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+check_run(43)
+run(final-noop "${CMAKE_COMMAND}" --build "${build}" --parallel 1)
+if(NOT last_output MATCHES "no work to do")
+  message(FATAL_ERROR "Metadata repair caused a regeneration loop")
+endif()
+message(STATUS "Codegen first build, no-op, input invalidation and metadata repair passed: ${build}")
