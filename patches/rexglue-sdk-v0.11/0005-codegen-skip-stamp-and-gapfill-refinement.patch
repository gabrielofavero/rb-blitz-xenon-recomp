+size_t FunctionNode::RewindEdgesTo(const FunctionNode* target, u32 target_base) {
+  size_t rewound = 0;
+  const auto rewind = [&](std::vector<CallEdge>& edges, bool is_call) {
+    std::erase_if(edges, [&](const CallEdge& edge) {
+      if (edge.target.AsFunction() != target)
+        return false;
+      AddUnresolvedJump(edge.site, target_base, is_call, false);
+      ++rewound;
+      return true;
+    });
+  };
+  rewind(calls_, true);
+  rewind(tail_calls_, false);
+  return rewound;
+}
