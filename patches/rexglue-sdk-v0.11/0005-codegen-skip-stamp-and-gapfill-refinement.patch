+REX_TEST_CASE("Removed graph targets release and rebind incoming edges", "[codegen][migration]") {
+  using namespace rex::codegen;
+  FunctionGraph graph;
+  auto* caller = graph.AddFunction(0x1000, 16, FunctionAuthority::kConfig);
+  auto* target = graph.AddFunction(0x2000, 4, FunctionAuthority::kGapFill);
+  auto* unrelated = graph.AddFunction(0x3000, 4, FunctionAuthority::kConfig);
+  graph.AddCallToFunction(0x1000, 0x1000, CallTarget::MakeFunction(target));
+  graph.AddTailCallToFunction(0x1000, 0x1004, CallTarget::MakeFunction(target));
+  graph.AddCallToFunction(0x1000, 0x1008, CallTarget::MakeFunction(unrelated));
+  REQUIRE(graph.RemoveFunction(0x2000));
+  REQUIRE(caller->GetCalls().size() == 1);
+  CHECK(caller->GetCalls()[0].target.AsFunction() == unrelated);
+  CHECK(caller->GetTailCalls().empty());
+  REQUIRE(caller->GetUnresolvedJumps().size() == 2);
+  auto* replacement = graph.AddFunction(0x2000, 8, FunctionAuthority::kConfig);
+  CHECK(caller->GetUnresolvedJumps().empty());
+  REQUIRE(caller->GetCalls().size() == 2);
+  REQUIRE(caller->GetTailCalls().size() == 1);
+  CHECK(caller->GetCalls()[1].target.AsFunction() == replacement);
+  CHECK(caller->GetTailCalls()[0].target.AsFunction() == replacement);
+}
+
+REX_TEST_CASE("Late function registration preserves call and tail-call kinds", "[codegen][migration]") {
+  using namespace rex::codegen;
+  FunctionGraph graph;
+  auto* caller = graph.AddFunction(0x1000, 8, FunctionAuthority::kConfig);
+  graph.AddUnresolvedJumpToFunction(0x1000, 0x1000, 0x2000, true, false);
+  graph.AddUnresolvedJumpToFunction(0x1000, 0x1004, 0x2000, false, false);
+  graph.AddFunction(0x2000, 4, FunctionAuthority::kConfig);
+  CHECK(caller->GetUnresolvedJumps().empty());
+  REQUIRE(caller->GetCalls().size() == 1);
+  REQUIRE(caller->GetTailCalls().size() == 1);
+  CHECK(caller->GetCalls()[0].site == 0x1000);
+  CHECK(caller->GetTailCalls()[0].site == 0x1004);
+}
