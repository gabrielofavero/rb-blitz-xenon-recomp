new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/host/vulkan/pipeline_compilation_gate.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <condition_variable>
+#include <cstddef>
+#include <mutex>
+#include <utility>
+
+namespace rex::gpu::vulkan {
+// MoltenVK serializes shader-library conversion inside its pipeline cache.
+// Schedule that serial work before entering the driver so preparation workers
+// cannot queue ahead of pipelines needed by the current frame.
+class PipelineCompilationGate {
+ public:
+  template <typename Callback> decltype(auto) Run(bool background, Callback&& callback) {
+    {
+      std::unique_lock lock(mutex_);
+      if (!background) ++foreground_waiters_;
+      changed_.wait(lock, [&] { return !active_ && (!background || !foreground_waiters_); });
+      if (!background) --foreground_waiters_;
+      active_ = true;
+    }
+    struct Completion {
+      PipelineCompilationGate& gate;
+      ~Completion() {
+        {
+          std::lock_guard lock(gate.mutex_);
+          gate.active_ = false;
+        }
+        gate.changed_.notify_all();
+      }
+    } completion{*this};
+    return std::forward<Callback>(callback)();
+  }
+  std::size_t WaitingForeground() const {
+    std::lock_guard lock(mutex_);
+    return foreground_waiters_;
+  }
+ private:
+  mutable std::mutex mutex_;
+  std::condition_variable changed_;
+  std::size_t foreground_waiters_ = 0;
+  bool active_ = false;
+};
+}  // namespace rex::gpu::vulkan
