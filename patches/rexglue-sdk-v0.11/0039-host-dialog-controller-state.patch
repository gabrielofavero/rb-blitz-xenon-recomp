diff --git a/tests/unit/hid/title_input_test.cpp b/tests/unit/hid/title_input_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/hid/title_input_test.cpp
@@ -0,0 +1,110 @@
+#include "rex_test.h"
+#include "input_harness.h"
+#include "../ui/ui_harness.h"
+#include <rex/hid/title_input.h>
+
+using namespace rex::test_input;
+
+REX_TEST_CASE("title input filter owns final packets and respects UI blocks", "[hid][title_input]") {
+  Run("fake_a", [](rex::hid::IInputSystem& input) {
+    auto* title = dynamic_cast<rex::hid::ITitleInput*>(&input);
+    REQUIRE(title);
+    g_fake[0].devices = {MakePad(1, 0)};
+    g_fake[0].states[1] = Buttons(rex::hid::kPadA);
+    const auto before = input.GetState(0);
+    REQUIRE(before);
+    auto first = title->SetStateFilter([](u32, rex::hid::PadState& state) {
+      state.buttons = rex::hid::kPadB;
+    });
+    auto changed = input.GetState(0);
+    REQUIRE(changed);
+    CHECK(changed->state.buttons == rex::hid::kPadB);
+    CHECK(changed->packet != before->packet);
+    CHECK(input.GetState(0)->packet == changed->packet);
+    auto second = title->SetStateFilter([](u32, rex::hid::PadState& state) {
+      state.buttons = rex::hid::kPadX;
+    });
+    first = {};
+    CHECK(input.GetState(0)->state.buttons == rex::hid::kPadX);
+    input.AcquireUIBlock();
+    CHECK(input.GetState(0)->state.buttons == 0);
+    input.ReleaseUIBlock();
+    second = {};
+    g_fake[0].states[1] = Buttons(0);
+    CHECK(input.GetState(0)->state.buttons == 0);
+    g_fake[0].states[1] = Buttons(rex::hid::kPadA);
+    CHECK(input.GetState(0)->state.buttons == rex::hid::kPadA);
+  });
+}
+
+REX_TEST_CASE("title physical sampling bypasses synthesis remaps and modal capture only for UI",
+              "[hid][title_input]") {
+  Run("fake_a,fake_b", [](rex::hid::IInputSystem& input) {
+    auto* title = dynamic_cast<rex::hid::ITitleInput*>(&input);
+    REQUIRE(title);
+    CHECK_FALSE(title->GetPhysicalState());
+    CHECK(input.GetState(0));
+    g_fake[0].devices = {MakePad(1, 0)};
+    g_fake[0].states[1] = Buttons(rex::hid::kPadA);
+    ++g_fake[0].revision;
+    g_fake[1].devices = {MakePad(7, 0)};
+    g_fake[1].states[7] = Buttons(rex::hid::kPadB);
+    ++g_fake[1].revision;
+    auto filter = title->SetStateFilter([title](u32, rex::hid::PadState& state) {
+      auto physical = title->GetPhysicalState();
+      REQUIRE(physical);
+      CHECK(physical->buttons == rex::hid::kPadA);
+      state.buttons = rex::hid::kPadX;
+    });
+    CHECK(input.GetState(0)->state.buttons == rex::hid::kPadX);
+    filter = {};
+    input.AcquireUIBlock();
+    CHECK(title->GetPhysicalState()->buttons == 0);
+    CHECK(title->GetPhysicalState(true)->buttons == rex::hid::kPadA);
+    input.ReleaseUIBlock();
+    rex::InputEvent lost;
+    lost.type = rex::InputEvent::Type::kFocusLost;
+    input.OnInputEvent(lost);
+    CHECK(title->GetPhysicalState()->buttons == 0);
+    CHECK(title->GetPhysicalState(true)->buttons == rex::hid::kPadA);
+    CHECK_FALSE(title->IsUIBlocked());
+  });
+}
+
+namespace {
+class ConsumingPointer final : public rex::ui::IUIEventListener {
+ public:
+  bool consume = true;
+  void OnUIEvent(const rex::ui::UIEvent&) override {}
+  void OnInputEvent(rex::InputEvent& event) override { event.handled = consume; }
+};
+}
+
+REX_TEST_CASE("consumed host pointer input does not reach HID and releases still clear held input",
+              "[hid][title_input][ui]") {
+  rex::test_ui::UIApp app;
+  REQUIRE(app.Start());
+  auto& input = app.GetInput();
+  ConsumingPointer listener;
+  auto subscription = app.GetUI().AddEventListener(listener);
+  rex::test_ui::DeliverMouseButton(rex::InputEvent::Type::kButtonDown, rex::MouseButton::kLeft);
+  rex::test_ui::DeliverWheel(1);
+  rex::test_ui::Deliver([](rex::ui::IUIEventListener& sink) {
+    rex::InputEvent event{.type = rex::InputEvent::Type::kMotion, .x = 51, .y = 73};
+    sink.OnInputEvent(event);
+  });
+  app.Pump();
+  CHECK_FALSE(input.IsButtonDown(rex::MouseButton::kLeft));
+  CHECK(input.TakeWheel() == 0);
+  CHECK_FALSE(input.GetPointer().has_position);
+  listener.consume = false;
+  rex::test_ui::DeliverMouseButton(rex::InputEvent::Type::kButtonDown, rex::MouseButton::kLeft);
+  app.Pump();
+  CHECK(input.IsButtonDown(rex::MouseButton::kLeft));
+  listener.consume = true;
+  rex::test_ui::DeliverMouseButton(rex::InputEvent::Type::kButtonUp, rex::MouseButton::kLeft);
+  app.Pump();
+  CHECK_FALSE(input.IsButtonDown(rex::MouseButton::kLeft));
+  subscription.Reset();
+  app.Shutdown();
+}
