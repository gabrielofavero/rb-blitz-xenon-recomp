+
+Result<PadState> InputSystem::GetPhysicalState(bool for_host_ui) {
+  State& state = *state_;
+  std::vector<ConnectionEvent> events;
+  Result<PadState> result = std::unexpected(NotFound("no physical pad is connected"));
+  {
+    std::lock_guard lock(state.mutex);
+    if (state.started) {
+      state.RefreshDevicesLocked(events);
+      for (const detail::Device& device : state.devices) {
+        if (device.synthetic) continue;
+        auto raw = state.sources[device.key.source]->GetDeviceState(device.key.id);
+        if (!raw) continue;
+        if (result) detail::MergeInto(*result, *raw);
+        else result = *raw;
+      }
+      if (result && !for_host_ui &&
+          (!state.focused.load(std::memory_order_relaxed) || state.ui_blocks.load() > 0)) {
+        *result = {};
+      }
+    }
+  }
+  state.Fire(events);
+  return result;
+}
+
+bool InputSystem::IsUIBlocked() const {
+  return state_->ui_blocks.load() > 0;
 }
 
 void InputSystem::AcquireUIBlock() {
