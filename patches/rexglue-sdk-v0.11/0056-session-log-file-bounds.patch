+
+REX_TEST_CASE("Session log rotation appends metadata and bounds file bytes and backups", "[base][logger][session_logging]") {
+  ResetLogger();
+  rex::test::TempFolder folder("rex_log_rotation_");
+  const auto named=folder.path/"game.log";
+  {std::ofstream file(named);file<<"session metadata\n";}
+  HarnessApp app;
+  REQUIRE(app.Start({"--log.file_name="+named.string(),"--log.max_file_size_bytes=1024",
+                     "--log.max_files=1","--log.pattern=%v","--log.console=false","--log.debugger=false"}));
+  REX_LOGGER().Flush();
+  CHECK(ReadFile(named).find("session metadata")!=std::string::npos);
+  for(int line=0;line<80;++line) REXLOG_INFO("{} {}",line,std::string(180,'x'));
+  REXLOG_INFO("final session marker");
+  REX_LOGGER().Flush();
+  CHECK(ReadFile(named).find("final session marker")!=std::string::npos);
+  CHECK(std::filesystem::exists(folder.path/"game.1.log"));
+  CHECK_FALSE(std::filesystem::exists(folder.path/"game.2.log"));
+  CHECK(std::filesystem::file_size(named)<=1024);
+  CHECK(std::filesystem::file_size(folder.path/"game.1.log")<=1024);
+  app.Finish();
+}
+
+REX_TEST_CASE("A zero backup count bounds only the active log", "[base][logger][session_logging]") {
+  ResetLogger();
+  rex::test::TempFolder folder("rex_log_no_backups_");
+  const auto named=folder.path/"game.log";
+  HarnessApp app;
+  REQUIRE(app.Start({"--log.file_name="+named.string(),"--log.max_file_size_bytes=512",
+                     "--log.max_files=0","--log.pattern=%v","--log.console=false","--log.debugger=false"}));
+  for(int line=0;line<20;++line) REXLOG_INFO("{} {}",line,std::string(150,'x'));
+  REX_LOGGER().Flush();
+  CHECK(std::filesystem::file_size(named)<=512);
+  CHECK_FALSE(std::filesystem::exists(folder.path/"game.1.log"));
+  CHECK_FALSE(REX_SETTINGS().SetText("log.max_files","200001"));
+  app.Finish();
+}
+
+REX_TEST_CASE("A log folder budget prunes complete rotated run groups", "[base][logger][session_logging]") {
+  ResetLogger();
+  rex::test::TempFolder folder("rex_log_run_budget_");
+  {
+    HarnessApp first(folder.path);
+    REQUIRE(first.Start({"--log.max_file_size_bytes=512","--log.max_files=1",
+                         "--log.pattern=%v","--log.console=false","--log.debugger=false"}));
+    for(int line=0;line<20;++line) REXLOG_INFO("{} {}",line,std::string(150,'x'));
+    first.Finish();
+  }
+  CHECK(std::filesystem::exists(folder.path/"logs"/"harness_001.log"));
+  CHECK(std::filesystem::exists(folder.path/"logs"/"harness_001.1.log"));
+  {
+    HarnessApp second(folder.path);
+    REQUIRE(second.Start({"--log.folder_budget=1","--log.console=false","--log.debugger=false"}));
+    second.Finish();
+  }
+  CHECK_FALSE(std::filesystem::exists(folder.path/"logs"/"harness_001.log"));
+  CHECK_FALSE(std::filesystem::exists(folder.path/"logs"/"harness_001.1.log"));
+  CHECK(std::filesystem::exists(folder.path/"logs"/"harness_002.log"));
+}
+
+#if !defined(_WIN32)
+REX_TEST_CASE("Crash reports follow the active file after rotation", "[base][logger][session_logging][crash_report]") {
+  const auto result = rex::test::RunChild("log-rotation");
+  CHECK(result.status != 0);
+  REQUIRE(result.Has("rotation log folder: "));
+  const auto first = result.output.find("rotation log folder: ") + std::string_view("rotation log folder: ").size();
+  const auto last = result.output.find('\n', first);
+  REQUIRE(last != std::string::npos);
+  const std::filesystem::path folder(result.output.substr(first, last - first));
+  auto cleanup = rex::ScopeGuard([&] { std::error_code ec; std::filesystem::remove_all(folder, ec); });
+  CHECK(ReadFile(folder / "game.log").find("end of crash report") != std::string::npos);
+  CHECK(ReadFile(folder / "game.1.log").find("end of crash report") == std::string::npos);
+}
+#endif
