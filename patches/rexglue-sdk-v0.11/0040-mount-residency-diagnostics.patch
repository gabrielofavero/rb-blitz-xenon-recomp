   return Ok();
+}
+
+Result<u32> FileSystem::GetMountOpenCount(std::string_view path) const {
+  std::lock_guard lock(mutex_);
+  REX_TRY(Resolved resolved, ResolveMount(path, false));
+  std::lock_guard provider_lock(resolved.provider->GetMutex());
+  return resolved.provider->GetRoot().GetOpenCount();
 }
 
