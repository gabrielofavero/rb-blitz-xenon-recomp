+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <string_view>
+#include <rex/filesystem/file_system.h>
+#include <rex/module.h>
+#include <rex/result.h>
+
+namespace rex::filesystem {
+
+/** Optional residency accounting for SDK file systems. */
+REX_DECLARE_INTERFACE(IMountDiagnostics, 1)
+  /** Returns live file and directory-walk references on the mount covering path.
+   * An owner must prevent new opens before using zero to retire a mount.
+   * Returns kNoMount for an absent path, kUnsupported for another filesystem implementation.
+   */
+  [[nodiscard]] virtual Result<u32> GetOpenCount(IFileSystem& file_system, std::string_view path) const = 0;
+};
+
+}  // namespace rex::filesystem
