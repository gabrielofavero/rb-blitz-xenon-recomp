diff --git a/tests/unit/filesystem/mount_diagnostics_test.cpp b/tests/unit/filesystem/mount_diagnostics_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/filesystem/mount_diagnostics_test.cpp
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include "base/module_group.h"
+#include "fixture_dir.h"
+#include <rex/filesystem/file_system_factory.h>
+#include <rex/filesystem/mount_diagnostics.h>
+
+REX_TEST_CASE("Mount residency counts files relative opens and directory walks", "[filesystem][mount_diagnostics]") {
+  rex::ModuleGroup group; REQUIRE(group.Load("rexfilesystem")); REQUIRE(group.Connect());
+  auto* factory=group.Get<rex::filesystem::IFileSystemFactory>(); REQUIRE(factory);
+  auto* diagnostics=group.Get<rex::filesystem::IMountDiagnostics>(); REQUIRE(diagnostics);
+  auto fs=factory->Create(); REQUIRE(fs);
+  REQUIRE(fs->Mount({.path="\\Device\\Count",.type=rex::filesystem::ProviderType::kSTFS,.source=rex::test::GetFixtureFolder()/"stfs_con.bin",.null_paths={}}));
+  REQUIRE(fs->Link("count:","\\Device\\Count"));
+  REQUIRE(diagnostics->GetOpenCount(*fs,"count:")); CHECK(*diagnostics->GetOpenCount(*fs,"count:")==0);
+  auto root=fs->Open("count:",{}); REQUIRE(root);
+  CHECK(*diagnostics->GetOpenCount(*fs,"COUNT:")==1);
+  auto file=fs->OpenRelative(*root->file,"a.txt",{}); REQUIRE(file);
+  CHECK(*diagnostics->GetOpenCount(*fs,"count:\\a.txt")==2);
+  auto walk=root->file->List(""); REQUIRE(walk);
+  CHECK(*diagnostics->GetOpenCount(*fs,"count:")==3);
+  root->file.reset();CHECK(*diagnostics->GetOpenCount(*fs,"count:")==2);
+  file->file.reset();CHECK(*diagnostics->GetOpenCount(*fs,"count:")==1);
+  walk->reset();CHECK(*diagnostics->GetOpenCount(*fs,"count:")==0);
+  REQUIRE(fs->Unmount("\\Device\\Count"));
+  CHECK_FALSE(diagnostics->GetOpenCount(*fs,"count:"));
+}
