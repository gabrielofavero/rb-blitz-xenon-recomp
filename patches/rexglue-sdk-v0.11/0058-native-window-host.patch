+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <rex/platform.h>
+#include <rex/types.h>
+#include <rex/utility.h>
+
+namespace rex::ui {
+
+enum class NativeHostDisplayMode : u8 { kWindowed = 0, kBorderless = 1, kFullscreen = 2 };
+
+/** Optional embedding of a rendering child inside an application-owned native window.
+ * Hooks run on the UI thread. The Windows SDL provider captures the registered
+ * host before attaching and showing its rendering child. Other platforms retain their own
+ * window lifecycle.
+ */
+class INativeWindowHost {
+ public:
+  virtual ~INativeWindowHost() = default;
+  virtual bool Attach(void* native_child, std::function<void(bool)> focus_changed) = 0;
+  virtual bool SetDisplayMode(NativeHostDisplayMode mode) = 0;
+  virtual void SetTitle(std::string_view title) = 0;
+  /** The last mode acknowledged by the native window, empty when unavailable. */
+  virtual std::optional<NativeHostDisplayMode> GetDisplayMode() const { return std::nullopt; }
+};
+
+/** Register before the UI provider opens its window. Destroying the guard removes
+ * only this registration; an existing window retains shared ownership of its host.
+ */
+[[nodiscard]] REX_API ScopeGuard RegisterNativeWindowHost(std::shared_ptr<INativeWindowHost> host);
+[[nodiscard]] REX_API std::shared_ptr<INativeWindowHost> GetNativeWindowHost();
+
+}  // namespace rex::ui
