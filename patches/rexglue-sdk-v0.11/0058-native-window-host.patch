diff --git a/tests/unit/ui/native_window_host_test.cpp b/tests/unit/ui/native_window_host_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/ui/native_window_host_test.cpp
@@ -0,0 +1,38 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include <rex/ui/native_window_host.h>
+
+namespace {
+class NativeHost final : public rex::ui::INativeWindowHost {
+ public:
+  bool Attach(void*, std::function<void(bool)>) override { return true; }
+  bool SetDisplayMode(rex::ui::NativeHostDisplayMode) override { return true; }
+  void SetTitle(std::string_view) override {}
+};
+}
+
+REX_TEST_CASE("native window registration is optional and stale guards cannot clear a new host", "[ui][native_host]") {
+  CHECK_FALSE(rex::ui::GetNativeWindowHost());
+  auto first = std::make_shared<NativeHost>();
+  auto first_guard = rex::ui::RegisterNativeWindowHost(first);
+  CHECK(rex::ui::GetNativeWindowHost() == first);
+  auto second = std::make_shared<NativeHost>();
+  auto second_guard = rex::ui::RegisterNativeWindowHost(second);
+  first_guard = {};
+  CHECK(rex::ui::GetNativeWindowHost() == second);
+  second_guard = {};
+  CHECK_FALSE(rex::ui::GetNativeWindowHost());
+}
+
+REX_TEST_CASE("a rendering window may retain its native host after registration ends", "[ui][native_host]") {
+  auto host = std::make_shared<NativeHost>();
+  std::weak_ptr<NativeHost> weak = host;
+  auto guard = rex::ui::RegisterNativeWindowHost(host);
+  auto captured = rex::ui::GetNativeWindowHost();
+  host.reset();
+  guard = {};
+  CHECK_FALSE(rex::ui::GetNativeWindowHost());
+  CHECK_FALSE(weak.expired());
+  captured.reset();
+  CHECK(weak.expired());
+}
