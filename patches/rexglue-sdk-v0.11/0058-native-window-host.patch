--- /dev/null
+++ b/src/base/native_window_host.cpp
@@ -0,0 +1,42 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include <rex/ui/native_window_host.h>
+#include <mutex>
+#include <utility>
+
+namespace rex::ui {
+namespace {
+struct Registration {
+  std::mutex mutex;
+  std::shared_ptr<INativeWindowHost> host;
+  u64 token = 0;
+};
+Registration& State() { static Registration value; return value; }
+}
+
+ScopeGuard RegisterNativeWindowHost(std::shared_ptr<INativeWindowHost> host) {
+  auto& state = State();
+  u64 token;
+  std::shared_ptr<INativeWindowHost> retired;
+  {
+    std::lock_guard lock(state.mutex);
+    retired = std::move(state.host);
+    state.host = std::move(host);
+    token = ++state.token;
+  }
+  return ScopeGuard([token] {
+    auto& current = State();
+    std::shared_ptr<INativeWindowHost> retired_host;
+    {
+      std::lock_guard lock(current.mutex);
+      if (current.token != token) return;
+      retired_host = std::move(current.host);
+    }
+  });
+}
+
+std::shared_ptr<INativeWindowHost> GetNativeWindowHost() {
+  auto& state = State();
+  std::lock_guard lock(state.mutex);
+  return state.host;
+}
+}  // namespace rex::ui
