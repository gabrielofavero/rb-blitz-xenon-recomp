+ScopeGuard InputSystem::SetStateFilter(MoveOnlyFunction<void(u32, PadState&)> fn) {
+  State* state = state_.get();
+  std::lock_guard lock(state->mutex);
+  state->state_filter = std::move(fn);
+  const u64 serial = ++state->filter_serial;
+  return ScopeGuard([state, serial] {
+    std::lock_guard call(state->mutex);
+    if (state->filter_serial == serial) state->state_filter = {};
+  });
+}
