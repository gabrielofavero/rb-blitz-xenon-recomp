diff --git a/include/rex/hid/title_input.h b/include/rex/hid/title_input.h
new file mode 100644
--- /dev/null
+++ b/include/rex/hid/title_input.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <rex/hid/pad.h>
+#include <rex/module.h>
+#include <rex/utility.h>
+
+namespace rex::hid {
+
+/** Optional title input transformations, owned by the HID module. */
+REX_DECLARE_INTERFACE(ITitleInput, 1)
+  /**
+   * Replaces the merged pad transformation before packet accounting and UI suppression.
+   * Calls are serialized with input polling. The callback may read physical pads through
+   * this interface. Its guard removes it and waits for a poll in progress; the guard must
+   * not outlive the input system. Replacing a callback retires the earlier guard.
+   */
+  [[nodiscard]] virtual ScopeGuard SetStateFilter(MoveOnlyFunction<void(u32, PadState&)> fn) = 0;
+};
+
+}  // namespace rex::hid
