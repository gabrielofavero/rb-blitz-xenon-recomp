diff --git a/src/gpu/xenos/vulkan/async_pipeline_state.h b/src/gpu/xenos/vulkan/async_pipeline_state.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/vulkan/async_pipeline_state.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <atomic>
+
+namespace rex::gpu::vulkan::detail {
+
+enum class MissingPipelineAction { kPending, kQueue, kCreate };
+
+// A setting change cannot cancel a driver call or enqueue its target twice.
+constexpr MissingPipelineAction GetMissingPipelineAction(bool pending, bool async_enabled,
+                                                         bool null_placeholder) {
+  if (pending) return MissingPipelineAction::kPending;
+  return async_enabled && null_placeholder ? MissingPipelineAction::kQueue
+                                          : MissingPipelineAction::kCreate;
+}
+
+constexpr bool ShouldSkipPendingPipeline(bool pending, bool async_enabled, bool missing) {
+  return pending && (async_enabled || missing);
+}
+
+// Failure retires the pending marker after publishing the missing handle. The
+// demand path can then retry, while an existing placeholder remains usable.
+template <typename Pipeline>
+void FailAsyncPipelineCreation(Pipeline& target) {
+  target.real_pipeline_failed.store(true, std::memory_order_release);
+  const bool placeholder = target.is_placeholder.load(std::memory_order_acquire);
+  const auto handle = target.pipeline.load(std::memory_order_acquire);
+  if (!placeholder || handle == decltype(handle){})
+    target.pipeline.store(decltype(handle){}, std::memory_order_release);
+  target.is_placeholder.store(false, std::memory_order_release);
+}
+
+}  // namespace rex::gpu::vulkan::detail
diff --git a/tests/unit/gpu/async_pipeline_state_test.cpp b/tests/unit/gpu/async_pipeline_state_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/async_pipeline_state_test.cpp
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "gpu/xenos/vulkan/async_pipeline_state.h"
+#include "rex_test.h"
+
+#include <atomic>
+#include <cstdint>
+#include <future>
+#include <thread>
+
+namespace {
+using namespace rex::gpu::vulkan::detail;
+struct Pipeline {
+  std::atomic<uint64_t> pipeline{0};
+  std::atomic<bool> is_placeholder{true};
+  std::atomic<bool> real_pipeline_failed{false};
+};
+
+REX_TEST_CASE("null pending pipeline failure permits the next demand to retry",
+              "[gpu][async_pipeline_state]") {
+  Pipeline pipeline;
+  CHECK(GetMissingPipelineAction(true, true, true) == MissingPipelineAction::kPending);
+  FailAsyncPipelineCreation(pipeline);
+  CHECK(pipeline.pipeline.load() == 0);
+  CHECK_FALSE(pipeline.is_placeholder.load());
+  CHECK(pipeline.real_pipeline_failed.load());
+  CHECK(GetMissingPipelineAction(pipeline.is_placeholder.load(), true, true) ==
+        MissingPipelineAction::kQueue);
+  CHECK(GetMissingPipelineAction(pipeline.is_placeholder.load(), false, true) ==
+        MissingPipelineAction::kCreate);
+}
+
+REX_TEST_CASE("failed replacement preserves a usable placeholder but ends pending state",
+              "[gpu][async_pipeline_state]") {
+  Pipeline pipeline;
+  pipeline.pipeline = 42;
+  FailAsyncPipelineCreation(pipeline);
+  CHECK(pipeline.pipeline.load() == 42);
+  CHECK_FALSE(pipeline.is_placeholder.load());
+  CHECK(pipeline.real_pipeline_failed.load());
+}
+
+REX_TEST_CASE("disabling asynchronous compilation cannot duplicate an active driver call",
+              "[gpu][async_pipeline_state]") {
+  Pipeline pipeline;
+  std::promise<void> started, release;
+  auto gate = release.get_future();
+  std::thread worker([&] {
+    started.set_value();
+    gate.wait();
+    FailAsyncPipelineCreation(pipeline);
+  });
+  started.get_future().wait();
+  const auto pending = pipeline.is_placeholder.load(std::memory_order_acquire);
+  CHECK(GetMissingPipelineAction(pending, true, true) == MissingPipelineAction::kPending);
+  CHECK(GetMissingPipelineAction(pending, false, true) == MissingPipelineAction::kPending);
+  CHECK(ShouldSkipPendingPipeline(pending, false, true));
+  // An existing non-null placeholder keeps the established synchronous fallback.
+  CHECK_FALSE(ShouldSkipPendingPipeline(pending, false, false));
+  release.set_value();
+  worker.join();
+  CHECK_FALSE(pipeline.is_placeholder.load(std::memory_order_acquire));
+  CHECK_FALSE(ShouldSkipPendingPipeline(false, false, true));
+}
+
+REX_TEST_CASE("cancelled preload entries follow the current demand setting",
+              "[gpu][async_pipeline_state]") {
+  CHECK(GetMissingPipelineAction(false, true, true) == MissingPipelineAction::kQueue);
+  CHECK(GetMissingPipelineAction(false, false, true) == MissingPipelineAction::kCreate);
+  CHECK(GetMissingPipelineAction(false, true, false) == MissingPipelineAction::kCreate);
+}
+}  // namespace
