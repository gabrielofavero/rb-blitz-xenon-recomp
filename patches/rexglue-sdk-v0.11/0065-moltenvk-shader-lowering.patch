diff --git a/tests/unit/gpu/tessellation_glsl_test.cpp b/tests/unit/gpu/tessellation_glsl_test.cpp
--- a/tests/unit/gpu/tessellation_glsl_test.cpp
+++ b/tests/unit/gpu/tessellation_glsl_test.cpp
@@ -42,3 +42,52 @@
                                          rex::xenos::TessellationMode::kAdaptive, 3, 3)
             .find(block) != std::string::npos);
 }
+
+// Check the production builder's MoltenVK-only precise arithmetic route.
+#include <SPIRV/GLSL.std.450.h>
+
+REX_TEST_CASE("MoltenVK precise arithmetic uses explicit Fma and preserves the desktop route",
+              "[gpu][moltenvk_lowering]") {
+  for (bool workaround : {false, true}) {
+    rex::gpu::SPIRVBuilder builder(spv::Spv_1_0, 0, nullptr);
+    builder.addCapability(spv::CapabilityShader);
+    builder.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+    const auto glsl = builder.import("GLSL.std.450");
+    if (workaround) builder.SetNoContractionFma(glsl);
+    const auto scalar = builder.makeFloatType(32);
+    const auto vector = builder.makeVectorType(scalar, 2);
+    const auto one = builder.makeFloatConstant(1.0f);
+    const auto pair = builder.makeCompositeConstant(vector, {one, one});
+    spv::Block* entry = nullptr;
+    const auto function = builder.makeFunctionEntry(spv::NoPrecision, builder.makeVoidType(),
+                                                     "main", {}, {}, &entry);
+    builder.addEntryPoint(spv::ExecutionModelVertex, function, "main");
+    for (auto op : {spv::OpFAdd, spv::OpFSub, spv::OpFMul})
+      builder.CreateNoContractionBinOp(op, scalar, one, one);
+    builder.CreateNoContractionBinOp(spv::OpVectorTimesScalar, vector, pair, one);
+    builder.makeReturn(false);
+    builder.leaveFunction();
+    std::vector<unsigned int> words;
+    builder.dump(words);
+    unsigned fma = 0, arithmetic = 0, precise = 0;
+    bool negative_zero = false;
+    for (size_t i = 5; i < words.size();) {
+      const auto length = words[i] >> 16;
+      const auto op = static_cast<spv::Op>(words[i] & 0xffff);
+      REQUIRE(length > 0);
+      REQUIRE(i + length <= words.size());
+      if (op == spv::OpExtInst && length >= 5 && words[i+4] == GLSLstd450Fma) ++fma;
+      if (op == spv::OpFAdd || op == spv::OpFSub || op == spv::OpFMul ||
+          op == spv::OpVectorTimesScalar) ++arithmetic;
+      if (op == spv::OpDecorate && length >= 3 && words[i+2] == spv::DecorationNoContraction)
+        ++precise;
+      if (op == spv::OpConstant && length == 4 && words[i+3] == 0x80000000u)
+        negative_zero = true;
+      i += length;
+    }
+    CHECK(fma == (workaround ? 4u : 0u));
+    CHECK(arithmetic == (workaround ? 0u : 4u));
+    CHECK(precise == 4);
+    if (workaround) CHECK(negative_zero);
+  }
+}
