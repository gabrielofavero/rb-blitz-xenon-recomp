+                     vp_now[2], vp_now[3],
+                     texture_cache_ != nullptr ? texture_cache_->GetDrawResolutionScaleX() : 0,
+                     texture_cache_ != nullptr ? texture_cache_->GetDrawResolutionScaleY() : 0);
+      }
+    }
   }
 }
 
