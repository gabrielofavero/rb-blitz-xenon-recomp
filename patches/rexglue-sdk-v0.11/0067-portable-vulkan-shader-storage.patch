diff --git a/tests/unit/gpu/vulkan_preparation_test.cpp b/tests/unit/gpu/vulkan_preparation_test.cpp
--- a/tests/unit/gpu/vulkan_preparation_test.cpp
+++ b/tests/unit/gpu/vulkan_preparation_test.cpp
@@ -178,3 +178,79 @@
   driver->DetachTitle();
   CHECK(driver->AsXenos()->SetShaderStorageDeferred(false));
 }
+
+#include <array>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <xxhash.h>
+#include "gpu/xenos/vulkan/render_target_cache.h"
+
+REX_TEST_CASE_METHOD(Fixture, "Native Vulkan storage preserves unsupported records before a corrupt tail",
+                     "[gpu][portable_recipes_native]") {
+  const auto enabled = rex::platform::GetEnvironmentValue("REX_RUN_NATIVE_GPU_TESTS");
+  if (!enabled || *enabled != "1") SKIP("Requires native GPU opt-in");
+  const auto* backend = "vulkan";
+  rex::test::FakeDriverContext context;
+  AppInfo info;
+  info.needs.graphics_family=rex::GraphicsFamily::kXenos;
+  rex::ModuleGroup group;
+  group.Serve(static_cast<rex::IDriverContext&>(context),rex::IDriverContext::kInterface);
+  group.Serve(static_cast<rex::IAppInfo&>(info),rex::IAppInfo::kInterface);
+  REQUIRE(group.Load("rexgpu"));
+  REQUIRE(group.Load(std::string("rexgpu-xenos-")+backend));
+  REQUIRE(group.Connect());
+  const rex::DriverRegistration* registration=nullptr;
+  for(const auto* candidate:rex::test::GetRegistrations(group,rex::DriverType::kGraphics))
+    if(candidate->name==backend) registration=candidate;
+  REQUIRE(registration);
+  rex::test::FakeTitleContext title(rex::test::GetTestMemory());
+  rex::test::TempFolder folder("rex_vulkan_preparation_");
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle,
+                                  "gpu.vulkan.render_target_path", "fbo"));
+  const auto directory = folder.path / "shaders/shareable";
+  std::filesystem::create_directories(directory);
+  const auto path = directory / "5841122D.fbo.vk.xpso";
+  // Golden portable schema: 12-byte header, 8-byte hash and 60-byte description.
+  // Triangle fan is a valid recipe that this backend cannot currently compile.
+  std::vector<rex::u8> valid(80, 0);
+  valid[0] = 'X'; valid[1] = 'E'; valid[2] = 'P'; valid[3] = 'S';
+  valid[8] = 0x20; valid[9] = 0x26; valid[10] = 0x02; valid[11] = 0x28;
+  constexpr size_t flags = 32 + sizeof(rex::gpu::vulkan::VulkanRenderTargetCache::RenderPassKey);
+  static_assert(flags == 36);
+  valid[20 + flags] = 5u << 2;
+  const auto hash = XXH3_64bits(valid.data() + 20, 60);
+  std::memcpy(valid.data() + 12, &hash, sizeof(hash));
+  auto file = valid;
+  file.resize(file.size() + 68 + 3, 0);  // Invalid hash record and a partial trailing record.
+  {
+    std::ofstream stream(path, std::ios::binary);
+    stream.write(reinterpret_cast<const char*>(file.data()), file.size());
+    REQUIRE(stream.good());
+  }
+  auto owner = registration->create();
+  REQUIRE(owner);
+  auto* driver = static_cast<rex::gpu::IGraphicsDriver*>(owner.get());
+  rex::ScopeGuard cleanup([&] { driver->Shutdown(); group.Disconnect(); });
+  REQUIRE(driver->Initialize(context));
+  auto* xenos = driver->AsXenos();
+  REQUIRE(xenos);
+  REQUIRE(xenos->SetShaderStorageDeferred(true));
+  REQUIRE(REX_PATHS().cache_root.SetText(rex::SettingLayer::kTitle, folder.path.string()));
+  REQUIRE(driver->AttachTitle(rex::TitleInfo{}, title, title, title));
+  for (rex::u64 generation : {1u, 2u}) {
+    REQUIRE(xenos->BeginShaderStoragePreparation(folder.path, 0x5841122D, generation));
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    while (xenos->QueryShaderStoragePreparation().active && std::chrono::steady_clock::now() < deadline)
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    const auto progress = xenos->QueryShaderStoragePreparation();
+    REQUIRE_FALSE(progress.active);
+    CHECK(progress.entries.required == 0);
+    CHECK_FALSE(progress.ready());
+    CHECK(std::filesystem::file_size(path) == valid.size());
+    std::ifstream stream(path, std::ios::binary);
+    const std::vector<rex::u8> retained((std::istreambuf_iterator<char>(stream)), {});
+    CHECK(retained == valid);
+  }
+  driver->DetachTitle();
+}
