diff --git a/include/rex/gpu/shared_memory_upload_hazards.h b/include/rex/gpu/shared_memory_upload_hazards.h
new file mode 100644
--- /dev/null
+++ b/include/rex/gpu/shared_memory_upload_hazards.h
@@ -0,0 +1,98 @@
+// Copyright 2026. Released under the BSD license - see LICENSE in the root.
+#pragma once
+
+#include <bitset>
+#include <cstdint>
+#include <rex/types.h>
+
+namespace rex::gpu::vulkan {
+
+// Uploads may move before a recorded render pass only if earlier draws cannot
+// observe the new bytes. Track conservative 4 KiB pages within guest physical
+// memory, independent of the host's page size. Repeated writes stay ordered too.
+class SharedMemoryUploadHazards {
+ public:
+  static constexpr u32 kBufferSize = 512 * 1024 * 1024;
+  static constexpr u32 kPageSize = 4096;
+
+  void BeginPass() {
+    initialized_ = false;
+    has_draws_ = false;
+    tracked_draw_ = false;
+    read_only_ = false;
+  }
+
+  void PrepareDraw(bool read_only) {
+    if (!has_draws_ && read_only) {
+      if (!initialized_) {
+        reads_.reset();
+        writes_.reset();
+        initialized_ = true;
+      }
+      read_only_ = true;
+    } else if (!read_only) {
+      read_only_ = false;
+    }
+    tracked_draw_ = true;
+  }
+
+  void FinishDraw() {
+    if (!tracked_draw_)
+      read_only_ = false;
+    has_draws_ = true;
+    tracked_draw_ = false;
+  }
+
+  // An untracked helper command prevents later draws from enabling batching.
+  void Disable() {
+    read_only_ = false;
+    has_draws_ = true;
+  }
+
+  void Read(u32 start, u32 length) {
+    if (!length)
+      return;
+    if (!Valid(start, length)) {
+      Disable();
+      return;
+    }
+    Mark(reads_, start, length);
+  }
+
+  bool CanUpload(u32 start, u32 length) const {
+    if (!read_only_ || !Valid(start, length))
+      return false;
+    const u32 end = (start + length - 1) / kPageSize;
+    for (u32 page = start / kPageSize; page <= end; ++page) {
+      if (reads_[page] || writes_[page])
+        return false;
+    }
+    return true;
+  }
+
+  void Uploaded(u32 start, u32 length) {
+    if (!Valid(start, length)) {
+      Disable();
+      return;
+    }
+    Mark(writes_, start, length);
+  }
+
+ private:
+  using Pages = std::bitset<kBufferSize / kPageSize>;
+  static bool Valid(u32 start, u32 length) {
+    return length && u64(start) + length <= kBufferSize;
+  }
+  static void Mark(Pages& pages, u32 start, u32 length) {
+    const u32 end = (start + length - 1) / kPageSize;
+    for (u32 page = start / kPageSize; page <= end; ++page)
+      pages.set(page);
+  }
+  Pages reads_, writes_;
+  bool initialized_ = false;
+  bool has_draws_ = false;
+  bool tracked_draw_ = false;
+  bool read_only_ = false;
+};
+
+}  // namespace rex::gpu::vulkan
