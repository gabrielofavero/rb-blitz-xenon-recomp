diff --git a/tests/unit/kernel/deferred_latency_test.cpp b/tests/unit/kernel/deferred_latency_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/kernel/deferred_latency_test.cpp
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <chrono>
+#include <future>
+#include <thread>
+#include <vector>
+
+#include "rex_test.h"
+#include "kernel/kernel_fixture.h"
+#include "kernel/title_state.h"
+#include <rex/kernel/title_runtime.h>
+#include <rex/kernel/thread_registry.h>
+#include <rex/settings_registry.h>
+
+REX_TEST_CASE("Deferred latency is typed and completion keeps dispatch ordering at zero", "[kernel][overlapped][deferred_latency]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    auto* settings=REX_INTERFACE(rex::ISettingsRegistry);REQUIRE(settings);
+    auto found=settings->Find("kernel.deferred_overlapped_delay_ms");REQUIRE(found);
+    CHECK((*found)->GetDefaultText()=="100");
+    auto* value=static_cast<rex::Setting<rex::u32>*>(*found);
+    const auto original=value->Get();
+    CHECK_FALSE(settings->SetText("kernel.deferred_overlapped_delay_ms","-1"));
+    for(const auto* delay:{"0","1"}) {
+      REQUIRE(settings->SetText("kernel.deferred_overlapped_delay_ms",delay));
+      std::vector<int> order;
+      const auto caller=std::this_thread::get_id();
+      std::thread::id worker;
+      std::promise<void> finished;auto ready=finished.get_future();
+      const auto overlapped=c.Alloc(64);
+      rex::kernel::StateOf(c.GetRuntime()).GetOverlappedDispatcher().CompleteDeferred(
+          overlapped,[&]{order.push_back(2);},{.result=0},
+          [&]{worker=std::this_thread::get_id();order.push_back(1);},
+          [&]{order.push_back(3);finished.set_value();});
+      REQUIRE(ready.wait_for(std::chrono::seconds(5))==std::future_status::ready);
+      ready.get();CHECK(order==std::vector<int>{1,2,3});CHECK(worker!=caller);
+      CHECK(c.Load32(overlapped)==0);
+    }
+    REQUIRE(settings->SetText("kernel.deferred_overlapped_delay_ms",std::to_string(original)));
+  });
+}
