diff --git a/tests/unit/kernel/io_trace_test.cpp b/tests/unit/kernel/io_trace_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/kernel/io_trace_test.cpp
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include "kernel_fixture.h"
+#include <algorithm>
+#include <chrono>
+#include <fstream>
+#include <thread>
+#include <rex/diagnostics/compile_trace.h>
+#include <rex/filesystem/file.h>
+#include <rex/filesystem/file_system.h>
+#include <rex/filesystem/mount.h>
+#include <rex/kernel/object/file_object.h>
+#include <rex/kernel/object/object_table.h>
+#include <rex/settings_registry.h>
+#include "kernel/title_state.h"
+
+namespace {
+namespace fs = rex::filesystem;
+namespace trace = rex::diagnostics::compile_trace;
+using rex::test::Caller;
+
+struct ReadControl { bool slow = true, fail = false; u32 info_calls = 0; };
+
+class DelayedFile final : public fs::IFile {
+ public:
+  DelayedFile(std::unique_ptr<fs::IFile> inner, ReadControl& control)
+      : inner_(std::move(inner)), control_(control) {}
+  fs::FileStat GetInfo() const override { ++control_.info_calls; return inner_->GetInfo(); }
+  void Refresh() override { inner_->Refresh(); }
+  fs::Access GetAccess() const override { return inner_->GetAccess(); }
+  fs::VolumeStat GetVolume() const override { return inner_->GetVolume(); }
+  rex::Result<size_t> Read(std::span<u8> bytes, u64 offset) override {
+    if (control_.slow) std::this_thread::sleep_for(std::chrono::milliseconds(65));
+    if (control_.fail) return rex::Err<size_t>(rex::ErrorCategory::kIO, "injected read failure");
+    return inner_->Read(bytes, offset);
+  }
+  rex::Result<size_t> Write(std::span<const u8> bytes, u64 offset) override {
+    return inner_->Write(bytes, offset);
+  }
+  rex::Result<void> SetLength(u64 n) override { return inner_->SetLength(n); }
+  rex::Result<void> Flush() override { return inner_->Flush(); }
+  rex::Result<void> SetAttributes(fs::FileAttributes a) override { return inner_->SetAttributes(a); }
+  rex::Result<void> SetTimes(const fs::FileTimes& t) override { return inner_->SetTimes(t); }
+  void SetDeleteOnClose(bool value) override { inner_->SetDeleteOnClose(value); }
+  rex::Result<std::unique_ptr<fs::IDirectory>> List(std::string_view p) override {
+    return inner_->List(p);
+  }
+  rex::Result<std::span<const u8>> View() override { return inner_->View(); }
+ private:
+  std::unique_ptr<fs::IFile> inner_;
+  ReadControl& control_;
+};
+}
+
+REX_TEST_CASE("Kernel read producers retain slow success, failure and scatter attribution",
+              "[kernel][files][diagnostics]") {
+  for (const bool enabled : {false, true}) {
+    INFO("startup trace enabled: " << enabled);
+    rex::test::KernelFixture fixture([](const std::filesystem::path& root) {
+      std::filesystem::create_directories(root / "scratch");
+      std::ofstream(root / "scratch/sample.bin", std::ios::binary) << std::string(32, 'x');
+    }, {}, {}, {}, [enabled](rex::SettingsRegistry& settings) -> rex::Result<void> {
+      // Register the lazy public owner before applying this generation's startup value.
+      (void)trace::Enabled();
+      return settings.SetText(rex::SettingLayer::kTitle,
+                              "diagnostics.shader_compile_trace", enabled ? "true" : "false");
+    });
+    REQUIRE(trace::Enabled() == enabled);
+    auto* file_system = StateOf(fixture.GetRuntime()).GetFileSystem();
+    REQUIRE(file_system);
+    REQUIRE(file_system->Mount({"\\Device\\Scratch", fs::ProviderType::kHostDirectory,
+                                fixture.GetRoot() / "scratch", fs::MountFlags::kWritable, {}}));
+    REQUIRE(file_system->Link("scratch:", "\\Device\\Scratch"));
+    const auto previous_phase = trace::CurrentPhase();
+    rex::ScopeGuard restore([&] {
+      trace::SetPhase(previous_phase, "read test complete");
+    });
+    trace::SetPhase(trace::Phase::kPaused, "read producer test");
+    fixture.RunOnGuestThread([enabled](Caller& c) {
+      const auto handle_out = c.Alloc(4), iosb = c.Alloc(8), buffer = c.Alloc(4096);
+      REQUIRE(c.Kernel("NtCreateFile", {handle_out, 0xC0100000,
+          c.AllocAttributes("scratch:\\sample.bin"), iosb, 0, 0, 3, 1, 0x20}) == 0);
+      const u32 handle = c.Load32(handle_out);
+      auto file = c.GetRuntime().GetObjectTable().Get<rex::kernel::FileObject>(handle);
+      REQUIRE(file);
+      ReadControl control;
+      file->file = std::make_unique<DelayedFile>(std::move(file->file), control);
+      const u32 offset = c.AllocQuad(1);
+      const auto initial = trace::ReadCounter(trace::Phase::kPaused, trace::Event::kFileRead);
+      const auto info_before = control.info_calls;
+      CHECK(c.Kernel("NtReadFile", {handle, 0, 0, 0, iosb, buffer, 8, offset}) == 0);
+      CHECK(c.Load32(iosb + 4) == 8);
+      control.fail = true;
+      CHECK(c.Kernel("NtReadFile", {handle, 0, 0, 0, iosb, buffer, 8, offset}) != 0);
+      control.fail = false;
+      const u32 segments = c.Alloc(8);
+      c.Store32(segments, buffer);
+      CHECK(c.Kernel("NtReadFileScatter", {handle, 0, 0, 0, iosb, segments, 8, offset}) == 0);
+      const auto actual = trace::ReadCounter(trace::Phase::kPaused, trace::Event::kFileRead);
+      if (enabled) {
+        CHECK(actual.count == initial.count + 3);
+        CHECK(actual.failed == initial.failed + 1);
+        CHECK(actual.ge50 == initial.ge50 + 3);
+        CHECK(control.info_calls == info_before + 3);
+        REQUIRE(REX_SETTINGS().SetText("diagnostics.shader_compile_trace", "false"));
+        const auto setting = REX_SETTINGS().Find("diagnostics.shader_compile_trace");
+        REQUIRE(setting);
+        CHECK((*setting)->GetConstraints().life == rex::SettingLife::kRestart);
+        CHECK((*setting)->GetText() == "false");
+        CHECK((*setting)->IsRestartPending());
+        const auto pending = REX_SETTINGS().GetRestartPending();
+        CHECK(std::find(pending.begin(), pending.end(), "diagnostics.shader_compile_trace") !=
+              pending.end());
+        CHECK(trace::Enabled());
+        CHECK(c.Kernel("NtReadFile", {handle, 0, 0, 0, iosb, buffer, 8, offset}) == 0);
+        CHECK(control.info_calls == info_before + 4);
+        CHECK(trace::ReadCounter(trace::Phase::kPaused, trace::Event::kFileRead).count ==
+              actual.count + 1);
+      } else {
+        CHECK(control.info_calls == info_before);
+        CHECK(actual.count == initial.count);
+        CHECK(actual.failed == initial.failed);
+        CHECK(actual.ge50 == initial.ge50);
+      }
+      CHECK(c.Kernel("NtClose", {handle}) == 0);
+      file = {};
+    });
+  }
+}
