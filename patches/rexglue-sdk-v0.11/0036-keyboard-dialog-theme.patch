+bool PromptDialog::DrawThemed(ImGuiIO& io, bool first_draw) {
+    const auto& theme = style_->keyboard;
+    // DisplaySize is already in DPI-independent units. Portrait dialogs use
+    // the phone width, leaving room below for the platform keyboard.
+    const bool portrait = io.DisplaySize.x < io.DisplaySize.y;
+    const float scale = std::clamp(std::min(io.DisplaySize.y / 720.0f,
+                                          io.DisplaySize.x / (portrait ? 480.0f : 960.0f)), 0.5f, 1.75f);
+    const float width = portrait ? io.DisplaySize.x - 32.0f * scale :
+        std::min(480.0f * scale, io.DisplaySize.x - 32.0f * scale);
+    ImGui::PushFont(theme.font, 18.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(30.0f * scale, 28.0f * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(12.0f * scale, 10.0f * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(10.0f * scale, (portrait ? 13.0f : 6.0f) * scale));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 8.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 2.0f * scale);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, theme.layered_border ? 0.0f : 1.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameBorderSize, 1.0f);
+    ImGui::PushStyleColor(ImGuiCol_PopupBg, theme.background);
+    ImGui::PushStyleColor(ImGuiCol_Border, theme.border);
+    ImGui::PushStyleColor(ImGuiCol_Text, theme.text);
+    ImGui::PushStyleColor(ImGuiCol_FrameBg, theme.input);
+    ImGui::PushStyleColor(ImGuiCol_FrameBgHovered, theme.secondary);
+    ImGui::PushStyleColor(ImGuiCol_FrameBgActive, theme.input);
+    ImGui::PushStyleColor(ImGuiCol_Button, theme.accent);
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, theme.accent_hovered);
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive, theme.accent_active);
+    ImGui::PushStyleColor(ImGuiCol_TextSelectedBg, theme.accent_active);
+    ImGui::PushStyleColor(ImGuiCol_NavCursor, theme.accent_hovered);
+    ImGui::PushStyleColor(ImGuiCol_ModalWindowDimBg, theme.dim);
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * (portrait ? 0.38f : 0.5f)),
+                            ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(ImVec2(width, 0.0f));
+    const ImGuiWindowFlags flags = ImGuiWindowFlags_AlwaysAutoResize |
+                                   ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoMove |
+                                   ImGuiWindowFlags_NoSavedSettings;
+    if (ImGui::BeginPopupModal(label_.c_str(), nullptr, flags)) {
+      const ImVec2 pos = ImGui::GetWindowPos();
+      if (theme.layered_border) {
+        const ImVec2 size = ImGui::GetWindowSize();
+        auto* draw = ImGui::GetWindowDrawList();
+        // Borders extend into window padding, outside the default content clip.
+        // All three rails and their glow stay inside this existing modal.
+        draw->PushClipRect(pos, ImVec2(pos.x + size.x, pos.y + size.y));
+        for (int rail = 0; rail < 3; ++rail) {
+          const float inset = (6.0f + 6.0f * rail) * scale;
+          const ImVec2 lo(pos.x + inset, pos.y + inset);
+          const ImVec2 hi(pos.x + size.x - inset, pos.y + size.y - inset);
+          const float rounding = (7.0f - 2.0f * rail) * scale;
+          const auto stroke = [&](ImVec4 color, float alpha, float thickness) {
+            color.w *= alpha;
+            draw->AddRect(lo, hi, ImGui::GetColorU32(color), rounding, 0, thickness * scale);
+          };
+          stroke(theme.border, 0.12f, 12.0f);
+          stroke(theme.border, 0.22f, 7.0f);
+          stroke(theme.border, 0.70f, 3.5f);
+          stroke(theme.border_highlight, 1.0f, 1.0f);
+        }
+        draw->PopClipRect();
+      }
+      const auto center_text = [](const char* text) {
+        const float available = ImGui::GetContentRegionAvail().x;
+        const float text_width = ImGui::CalcTextSize(text).x;
+        if (text_width < available) {
+          ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (available - text_width) * 0.5f);
+        }
+      };
+      ImGui::PushFont(theme.heading_font ? theme.heading_font : theme.font, 26.0f * scale);
+      center_text(config_.title.c_str());
+      ImGui::PushTextWrapPos(0.0f);
+      ImGui::TextUnformatted(config_.title.c_str());
+      ImGui::PopTextWrapPos();
+      ImGui::PopFont();
+      if (!config_.body.empty()) {
+        ImGui::PushStyleColor(ImGuiCol_Text, theme.muted_text);
+        center_text(config_.body.c_str());
+        ImGui::TextWrapped("%s", config_.body.c_str());
+        ImGui::PopStyleColor();
+      }
+      if (first_draw) {
+        ImGui::SetKeyboardFocusHere();
+      }
+      ImGui::SetNextItemWidth(-1.0f);
+      bool confirmed = ImGui::InputText("##body", buffer_.data(), buffer_.size(),
+                                        ImGuiInputTextFlags_EnterReturnsTrue);
+      const bool escaped = ImGui::IsKeyPressed(ImGuiKey_Escape, false);
+      const float button_width = portrait ?
+          (ImGui::GetContentRegionAvail().x - 12.0f * scale) * 0.5f : 110.0f * scale;
+      const float buttons_width = button_width * 2.0f + 12.0f * scale;
+      ImGui::SetCursorPosX(ImGui::GetCursorPosX() +
+                          (ImGui::GetContentRegionAvail().x - buttons_width) * 0.5f);
+      confirmed |= ImGui::Button("Done", ImVec2(button_width, (portrait ? 44.0f : 32.0f) * scale));
+      ImGui::SameLine();
+      ImGui::PushStyleColor(ImGuiCol_Button, theme.secondary);
+      const bool cancelled = ImGui::Button("Cancel", ImVec2(button_width, (portrait ? 44.0f : 32.0f) * scale));
+      ImGui::PopStyleColor();
+      ImGui::PushFont(theme.font, 14.0f * scale);
+      ImGui::PushStyleColor(ImGuiCol_Text, theme.muted_text);
+      center_text("Enter to confirm    /    Esc to cancel");
+      ImGui::TextUnformatted("Enter to confirm    /    Esc to cancel");
+      ImGui::PopStyleColor();
+      ImGui::PopFont();
+      if (confirmed || cancelled || escaped) {
+        const bool canceled = cancelled || escaped;
+        if (canceled) Complete({});
+        else Choose(0, GetText());
+        ImGui::CloseCurrentPopup();
+        closing_ = true;
+      }
+      ImGui::EndPopup();
+    } else {
+      Complete({});
+      closing_ = true;
+    }
+    ImGui::PopStyleColor(12);
+    ImGui::PopStyleVar(7);
+    ImGui::PopFont();
+    return !closing_;
+  }
+
 }  // namespace rex::ui
