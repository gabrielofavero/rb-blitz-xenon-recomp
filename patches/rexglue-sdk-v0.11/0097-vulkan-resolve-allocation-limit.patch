diff --git a/src/gpu/xenos/vulkan/resolve_scale.h b/src/gpu/xenos/vulkan/resolve_scale.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/vulkan/resolve_scale.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <cstdint>
+
+namespace rex::gpu::vulkan {
+
+// Non-sparse scaled resolves dedicate one allocation for all guest physical
+// memory. Descriptor range limits do not describe the allocation's size limit.
+// Reduce both axes together before constructing either cache so they agree.
+inline bool ClampResolveScaleToAllocationLimit(std::uint64_t guest_memory_size,
+                                               std::uint64_t max_allocation_size,
+                                               bool sparse_residency,
+                                               std::uint32_t& x, std::uint32_t& y) {
+  if (sparse_residency || !max_allocation_size) return false;
+  bool changed = false;
+  while ((x > 1 || y > 1) &&
+         std::uint64_t(x) * y > max_allocation_size / guest_memory_size) {
+    if (x > 1) --x;
+    if (y > 1) --y;
+    changed = true;
+  }
+  return changed;
+}
+
+}  // namespace rex::gpu::vulkan
