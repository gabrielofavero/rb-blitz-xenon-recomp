diff --git a/src/gpu/xenos/vulkan/resolve_scale.h b/src/gpu/xenos/vulkan/resolve_scale.h
new file mode 100644
index 0000000..ed866b5
--- /dev/null
+++ b/src/gpu/xenos/vulkan/resolve_scale.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace rex::gpu::vulkan {
+
+// Non-sparse scaled resolves dedicate one allocation for all guest physical
+// memory. Descriptor range limits do not describe the allocation's size limit.
+// Reduce both axes together before constructing either cache so they agree.
+inline bool ClampResolveScaleToAllocationLimit(std::uint64_t guest_memory_size,
+                                               std::uint64_t max_allocation_size,
+                                               bool sparse_residency,
+                                               std::uint32_t& x, std::uint32_t& y) {
+  if (sparse_residency || !max_allocation_size) return false;
+  bool changed = false;
+  while ((x > 1 || y > 1) &&
+         std::uint64_t(x) * y > max_allocation_size / guest_memory_size) {
+    if (x > 1) --x;
+    if (y > 1) --y;
+    changed = true;
+  }
+  return changed;
+}
+
+// Admission reserves room for shared memory, render targets and transient work.
+// A reported live budget leaves half of the remaining heap free; without it,
+// admit at most one quarter of the physical device-local heap.
+inline std::uint64_t ConservativeDenseResolveBudget(std::uint64_t heap_size,
+                                                    std::uint64_t reported_budget,
+                                                    std::uint64_t heap_usage) {
+  if (!reported_budget) return heap_size / 4;
+  const auto ceiling = std::min(heap_size, reported_budget);
+  return heap_usage >= ceiling ? 0 : (ceiling - heap_usage) / 2;
+}
+
+inline bool DenseResolveFitsBudget(std::uint64_t guest_memory_size,
+                                  std::uint32_t x, std::uint32_t y,
+                                  std::uint64_t budget) {
+  // Unscaled rendering has no additional scaled resolve buffer.
+  if (x == 1 && y == 1) return true;
+  return guest_memory_size && std::uint64_t(x) * y <= budget / guest_memory_size;
+}
+
+}  // namespace rex::gpu::vulkan
