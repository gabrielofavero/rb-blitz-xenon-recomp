+namespace {
+
+// Rejects recursive acquisition on every host, rather than hanging on a mutex implementation
+// that does not diagnose it. The cache and shared-memory watch lists are the production classes.
+class StrictTextureWatch final : public IPhysicalWriteWatch {
+ public:
+  ScopeGuard AddWriteListener(IPhysicalWriteListener& value) override {
+    listener = &value;
+    return ScopeGuard([this] { listener = nullptr; });
+  }
+  void WatchPhysicalWrites(PhysicalRange) override {}
+  ScopeGuard LockWriteWatches() override {
+    if (held) throw std::system_error(std::make_error_code(std::errc::resource_deadlock_would_occur));
+    held = true;
+    ++acquisitions;
+    return ScopeGuard([this] { held = false; });
+  }
+  void Write(PhysicalRange range) {
+    auto lock = LockWriteWatches();
+    REQUIRE(listener);
+    listener->OnPhysicalWrite(range, true);
+  }
+  bool held = false;
+  unsigned acquisitions = 0;
+  IPhysicalWriteListener* listener = nullptr;
+};
+
+// No physical bytes are needed for watch registration or invalidation. Unexpected reads fail.
+class TextureWatchMemory final : public IPhysicalMemory {
+ public:
+  Result<void> CopyFromPhysical(u32, std::span<std::byte>) override { throw std::logic_error("unexpected physical read"); }
+  Result<void> CopyToPhysical(u32, std::span<const std::byte>) override { throw std::logic_error("unexpected physical write"); }
+  Result<std::span<const std::byte>> GetReadOnlyPhysicalSpan(PhysicalRange) override { throw std::logic_error("unexpected physical span"); }
+  Result<std::span<std::byte>> GetWritablePhysicalSpan(PhysicalRange) override { throw std::logic_error("unexpected physical span"); }
+  Result<void> StoreRelease32(u32, u32) override { throw std::logic_error("unexpected physical store"); }
+  Result<u32> LoadAcquire32(u32) override { throw std::logic_error("unexpected physical load"); }
+};
+
+class TextureWatchSharedMemory final : public SharedMemory {
+ public:
+  TextureWatchSharedMemory(IPhysicalMemory& memory, IPhysicalWriteWatch& watch)
+      : SharedMemory(memory, watch) { InitializeCommon(); }
+ protected:
+  bool UploadRanges(const std::vector<std::pair<u32, u32>>&) override { return true; }
+};
+
+class WatchTextureCache final : public TextureCache {
+ public:
+  WatchTextureCache(const xenos::RegisterFile& registers, const XenosSettings& settings,
+                    SharedMemory& shared, std::shared_ptr<ITextureOverrideSource> source)
+      : TextureCache(registers, settings, shared, 1, 1, std::move(source)) {}
+
+  Texture* AddTexture(bool candidate, bool mips) {
+    TextureKey key;
+    key.base_page = candidate ? 0x10 : 0x30;
+    key.mip_page = mips ? 0x20 : 0;
+    key.width_minus_1 = key.height_minus_1 = 31;
+    key.pitch = 1;
+    key.dimension = xenos::DataDimension::k2DOrStacked;
+    key.format = xenos::TextureFormat::k_DXT4_5;
+    key.mip_max_level = mips ? 2 : 0;
+    key.is_valid = 1;
+    auto* texture = FindOrCreateTexture(key);
+    if (texture && candidate) texture->SetOverrideCandidate();
+    return texture;
+  }
+
+ protected:
+  class WatchTexture final : public Texture {
+   public:
+    WatchTexture(TextureCache& cache, TextureKey key) : Texture(cache, key) {}
+  };
+  u32 GetHostFormatSwizzle(TextureKey) const override { return xenos::REXGPU_SWIZZLE_0000; }
+  u32 GetMaxHostTextureWidthHeight(xenos::DataDimension) const override { return 4096; }
+  u32 GetMaxHostTextureDepthOrArraySize(xenos::DataDimension) const override { return 4096; }
+  std::unique_ptr<Texture> CreateTexture(TextureKey key) override {
+    return std::make_unique<WatchTexture>(*this, key);
+  }
+  bool LoadHostTextureDataFromResidentMemory(Texture&, bool, bool) override { return true; }
+};
+
+}  // namespace
+
+REX_TEST_CASE("texture generation invalidation removes watches under the existing guard",
+              "[gpu][texture_override]") {
+  const bool mips = GENERATE(false, true);
+  TextureWatchMemory memory;
+  StrictTextureWatch watch;
+  TextureWatchSharedMemory shared(memory, watch);
+  xenos::RegisterFile registers;
+  struct Settings final : XenosSettings {} settings;
+  auto registry = std::make_shared<TextureOverrideRegistry>();
+  auto provider = std::make_shared<Provider>();
+  auto registration = registry->Register(provider);
+  REQUIRE(registration);
+  WatchTextureCache cache(registers, settings, shared, registry);
+  cache.RequestTextures(0);
+  auto* texture = cache.AddTexture(true, mips);
+  auto* ordinary = cache.AddTexture(false, false);
+  REQUIRE(texture);
+  REQUIRE(ordinary);
+  REQUIRE(texture->GetGuestBaseSize() > 0);
+  REQUIRE((texture->GetGuestMipsSize() > 0) == mips);
+  const u32 all_bits = 1u | (mips ? 2u : 0u);
+  {
+    auto lock = shared.AcquireLock();
+    texture->UpdateAndWatch(lock);
+    ordinary->UpdateAndWatch(lock);
+  }
+  REQUIRE(texture->GetOutdatedMask() == 0);
+  REQUIRE(ordinary->GetOutdatedMask() == 0);
+
+  // An unchanged provider leaves both watches armed and the cached texture usable.
+  const auto before_unchanged = watch.acquisitions;
+  cache.RequestTextures(0);
+  CHECK(watch.acquisitions == before_unchanged);
+  CHECK(texture->GetOutdatedMask() == 0);
+
+  // Polling and unregistering both publish new generations and take exactly one watch lock.
+  for (unsigned generation = 0; generation < 2; ++generation) {
+    if (generation == 0) { provider->changed = true; registry->Poll(); }
+    else { *registration = {}; }
+    const auto before_invalidation = watch.acquisitions;
+    REQUIRE_NOTHROW(cache.RequestTextures(0));
+    CHECK(watch.acquisitions == before_invalidation + 1);
+    CHECK_FALSE(watch.held);
+    CHECK(texture->GetOutdatedMask() == all_bits);
+    CHECK(ordinary->GetOutdatedMask() == 0);
+    {
+      auto lock = shared.AcquireLock();
+      CHECK(texture->IsBaseOutdated(lock));
+      CHECK(texture->IsMipsOutdated(lock) == mips);
+      texture->UpdateAndWatch(lock);
+    }
+    CHECK(texture->GetOutdatedMask() == 0);
+    watch.Write({0x10000, 4096});
+    CHECK(texture->GetOutdatedMask() == 1);
+    if (mips) {
+      watch.Write({0x20000, 4096});
+      CHECK(texture->GetOutdatedMask() == all_bits);
+    }
+    {
+      auto lock = shared.AcquireLock();
+      texture->UpdateAndWatch(lock);
+    }
+    CHECK(texture->GetOutdatedMask() == 0);
+  }
+
+  // A noncandidate watch survives the provider changes and still fires on guest writes.
+  watch.Write({0x30000, 4096});
+  CHECK(ordinary->GetOutdatedMask() == 1);
+  const auto before_destruction = watch.acquisitions;
+  cache.ClearCache();
+  CHECK(watch.acquisitions == before_destruction + (mips ? 2u : 1u));
+  // No dangling callbacks remain after the self-locking destructor removal path.
+  REQUIRE_NOTHROW(watch.Write({0x10000, 0x30000}));
+}
