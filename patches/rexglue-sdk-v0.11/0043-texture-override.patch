new file mode 100644
--- /dev/null
+++ b/src/gpu/texture_override.h
@@ -0,0 +1,85 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <mutex>
+#include <rex/gpu/texture_override.h>
+
+namespace rex::gpu {
+inline bool ValidateBC3Override(const TextureOverrideRequest& request,
+                                const std::vector<std::vector<u8>>& levels) {
+  if (!request.width || !request.height || request.width > 16384 || request.height > 16384 ||
+      request.format != xenos::TextureFormat::k_DXT4_5 || !request.mip_count ||
+      request.mip_count > static_cast<u32>(std::bit_width(std::max(request.width, request.height))) ||
+      levels.size() != request.mip_count) return false;
+  for (u32 level = 0; level < request.mip_count; ++level) {
+    const u64 width = std::max(1u, request.width >> level);
+    const u64 height = std::max(1u, request.height >> level);
+    if (levels[level].size() != ((width + 3) / 4) * ((height + 3) / 4) * 16) return false;
+  }
+  return true;
+}
+
+class TextureOverrideRegistry final : public ITextureOverrideSource,
+                                      public std::enable_shared_from_this<TextureOverrideRegistry> {
+ public:
+  Result<ScopeGuard> Register(std::shared_ptr<ITextureOverrideProvider> provider) {
+    if (!provider) return Err<ScopeGuard>(ErrorCategory::kValidation, "empty texture provider");
+    u64 token;
+    std::shared_ptr<ITextureOverrideProvider> retired;
+    {
+      std::lock_guard lock(mutex_);
+      retired = std::move(provider_);
+      provider_ = std::move(provider);
+      token = ++registration_;
+      Invalidate();
+    }
+    return ScopeGuard([weak = weak_from_this(), token] {
+      if (auto source = weak.lock()) source->Release(token);
+    });
+  }
+  void Invalidate() { generation_.fetch_add(1, std::memory_order_acq_rel); }
+  u64 GetGeneration() const override { return generation_.load(std::memory_order_acquire); }
+  void Poll() override {
+    const auto provider = Snapshot();
+    if (provider && provider->Poll()) {
+      std::lock_guard lock(mutex_);
+      if (provider == provider_) Invalidate();
+    }
+  }
+  bool GetOverride(const TextureOverrideRequest& request, std::span<const u8> guest_bytes,
+                   std::vector<std::vector<u8>>& levels, bool& refresh_target) override {
+    levels.clear();
+    refresh_target = false;
+    const auto provider = Snapshot();
+    if (!provider || guest_bytes.size() != request.guest_base_size) return false;
+    const bool replacement = provider->GetOverride(request, guest_bytes, levels, refresh_target);
+    refresh_target |= replacement;
+    if (!replacement || !ValidateBC3Override(request, levels)) {
+      levels.clear();
+      return false;
+    }
+    return true;
+  }
+ private:
+  std::shared_ptr<ITextureOverrideProvider> Snapshot() const {
+    std::lock_guard lock(mutex_);
+    return provider_;
+  }
+  void Release(u64 token) {
+    std::shared_ptr<ITextureOverrideProvider> retired;
+    {
+      std::lock_guard lock(mutex_);
+      if (token != registration_) return;
+      retired = std::move(provider_);
+      Invalidate();
+    }
+    // A provider may join a worker in its destructor. Do it outside the lock.
+  }
+  mutable std::mutex mutex_;
+  std::shared_ptr<ITextureOverrideProvider> provider_;
+  std::atomic<u64> generation_{1};
+  u64 registration_ = 0;
+};
+}  // namespace rex::gpu
