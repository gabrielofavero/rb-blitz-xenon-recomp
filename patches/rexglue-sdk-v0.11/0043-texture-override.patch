+#include "gpu/texture_override.h"
+
+namespace {
+using namespace rex;
+using namespace rex::gpu;
+TextureOverrideRequest Request() {
+  return {7, 5, 3, xenos::TextureFormat::k_DXT4_5, 4096, 64, true, xenos::Endian::kNone};
+}
+class Provider : public ITextureOverrideProvider {
+ public:
+  bool Poll() override { return changed.exchange(false); }
+  bool GetOverride(const TextureOverrideRequest&, std::span<const u8> bytes,
+                   std::vector<std::vector<u8>>& levels, bool& refresh) override {
+    ++calls;
+    seen_bytes = bytes.size();
+    refresh = true;
+    levels = {{std::vector<u8>(64, marker)}, {std::vector<u8>(16, marker)}, {std::vector<u8>(16, marker)}};
+    if (malformed) levels.back().pop_back();
+    return true;
+  }
+  u8 marker = 1;
+  bool malformed = false;
+  std::atomic<bool> changed{false};
+  size_t seen_bytes = 0;
+  int calls = 0;
+};
+}
+
+REX_TEST_CASE("BC3 override validation requires every block row and mip tail", "[gpu][texture_override]") {
+  auto request = Request();
+  std::vector<std::vector<u8>> levels{std::vector<u8>(64),std::vector<u8>(16),std::vector<u8>(16)};
+  CHECK(ValidateBC3Override(request, levels));
+  levels.back().pop_back();
+  CHECK_FALSE(ValidateBC3Override(request, levels));
+  levels.back().push_back(0);
+  levels.pop_back();
+  CHECK_FALSE(ValidateBC3Override(request, levels));
+  levels.emplace_back(16);
+  request.width = 0;
+  CHECK_FALSE(ValidateBC3Override(request, levels));
+  request = Request(); request.format = xenos::TextureFormat::k_8_8_8_8;
+  CHECK_FALSE(ValidateBC3Override(request, levels));
+  request = Request(); request.mip_count = 4; levels.emplace_back(16);
+  CHECK_FALSE(ValidateBC3Override(request, levels));
+}
+
+REX_TEST_CASE("texture provider guards cannot unregister a later replacement", "[gpu][texture_override]") {
+  auto registry = std::make_shared<TextureOverrideRegistry>();
+  std::vector<u8> bytes(64);
+  std::vector<std::vector<u8>> levels;
+  bool refresh = false;
+  auto first = std::make_shared<Provider>();
+  auto first_guard = registry->Register(first);
+  REQUIRE(first_guard);
+  const auto first_generation = registry->GetGeneration();
+  CHECK(registry->GetOverride(Request(), bytes, levels, refresh));
+  CHECK(first->seen_bytes == bytes.size());
+  CHECK(refresh);
+  auto second = std::make_shared<Provider>(); second->marker = 2;
+  auto second_guard = registry->Register(second);
+  REQUIRE(second_guard);
+  CHECK(registry->GetGeneration() > first_generation);
+  const auto replaced_generation = registry->GetGeneration();
+  *first_guard = {};
+  CHECK(registry->GetGeneration() == replaced_generation);
+  CHECK(registry->GetOverride(Request(), bytes, levels, refresh));
+  CHECK(levels[0][0] == 2);
+  second->changed = true;
+  registry->Poll();
+  CHECK(registry->GetGeneration() > replaced_generation);
+  second->malformed = true;
+  CHECK_FALSE(registry->GetOverride(Request(), bytes, levels, refresh));
+  CHECK(levels.empty());
+  CHECK(refresh);
+  *second_guard = {};
+  CHECK_FALSE(registry->GetOverride(Request(), bytes, levels, refresh));
+  CHECK_FALSE(refresh);
+  CHECK_FALSE(registry->Register(nullptr));
+}
+
+REX_TEST_CASE("unregistering a texture provider leaves an active callback alive", "[gpu][texture_override]") {
+  struct BlockingProvider final : Provider {
+    bool GetOverride(const TextureOverrideRequest& request, std::span<const u8> bytes,
+                     std::vector<std::vector<u8>>& levels, bool& refresh) override {
+      entered.set_value();
+      release.wait();
+      return Provider::GetOverride(request, bytes, levels, refresh);
+    }
+    std::promise<void> entered;
+    std::shared_future<void> release;
+  };
+  auto registry = std::make_shared<TextureOverrideRegistry>();
+  auto provider = std::make_shared<BlockingProvider>();
+  std::promise<void> release;
+  provider->release = release.get_future().share();
+  auto entered = provider->entered.get_future();
+  std::weak_ptr<BlockingProvider> weak = provider;
+  auto guard = registry->Register(provider);
+  REQUIRE(guard);
+  std::atomic<bool> replaced{false};
+  std::thread callback([&] {
+    std::vector<u8> bytes(64);
+    std::vector<std::vector<u8>> levels;
+    bool refresh = false;
+    replaced = registry->GetOverride(Request(), bytes, levels, refresh);
+  });
+  const auto status = entered.wait_for(std::chrono::seconds(5));
+  CHECK(status == std::future_status::ready);
+  *guard = {};
+  provider.reset();
+  CHECK_FALSE(weak.expired());
+  release.set_value();
+  callback.join();
+  CHECK(replaced);
+  CHECK(weak.expired());
+}
