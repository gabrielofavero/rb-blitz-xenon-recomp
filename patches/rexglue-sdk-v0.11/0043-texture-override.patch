+bool TextureCache::GetTextureOverride(Texture& texture, std::vector<std::vector<u8>>& levels) {
+  if (!texture_overrides_) return false;
+  const auto& key = texture.GetKey();
+  if (key.scaled_resolve || key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.GetDepthOrArraySize() != 1 || key.format != xenos::TextureFormat::k_DXT4_5 ||
+      !key.base_page || !texture.GetGuestBaseSize()) return false;
+  const u64 address = u64(key.base_page) << 12;
+  if (address + texture.GetGuestBaseSize() > SharedMemory::kBufferSize) return false;
+  auto bytes = GetSharedMemory().GetTextureOverrideBytes(u32(address), texture.GetGuestBaseSize());
+  if (!bytes) return false;
+  TextureOverrideRequest request{key.GetWidth(), key.GetHeight(), u32(key.mip_max_level) + 1,
+      key.format, u32(address), texture.GetGuestBaseSize(), bool(key.tiled), key.endianness};
+  bool refresh_target = false;
+  const bool replaced = texture_overrides_->GetOverride(request, *bytes, levels, refresh_target);
+  if (refresh_target || replaced) texture.SetOverrideCandidate();
+  return replaced;
+}
