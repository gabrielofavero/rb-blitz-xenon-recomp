+namespace rex::gpu {
+/** Original guest identity and layout of an unscaled two-dimensional texture. */
+struct TextureOverrideRequest {
+  u32 width = 0, height = 0, mip_count = 0;
+  xenos::TextureFormat format = xenos::TextureFormat::k_DXT4_5;
+  u32 guest_base_address = 0, guest_base_size = 0;
+  bool tiled = false;
+  xenos::Endian endianness = xenos::Endian::kNone;
+};
+
+/** Application-owned replacement pixels. Calls run serially on the guest GPU thread. */
+class ITextureOverrideProvider {
+ public:
+  virtual ~ITextureOverrideProvider() = default;
+  /** Called once per frame. Return true when previously identified textures need reloading. */
+  virtual bool Poll() { return false; }
+  /** Return a complete canonical BC3 mip chain, or false to keep the guest texture.
+   * Set refresh_target for recognized textures even when no replacement is selected.
+   * The original bytes remain valid only for the duration of this call.
+   */
+  virtual bool GetOverride(const TextureOverrideRequest& request,
+                           std::span<const u8> guest_bytes,
+                           std::vector<std::vector<u8>>& host_levels,
+                           bool& refresh_target) = 0;
+};
+
+/** Optional graphics-module service. Replacing a provider invalidates only known candidates. */
+REX_DECLARE_INTERFACE(ITextureOverrides, 1)
+  /** The guard unregisters only this registration. In-flight callbacks retain the provider. */
+  [[nodiscard]] virtual Result<ScopeGuard> RegisterProvider(
+      std::shared_ptr<ITextureOverrideProvider> provider) = 0;
+  virtual void Invalidate() = 0;
+};
+
+/** Driver extension supplied by the graphics module before title attachment. */
+class ITextureOverrideSource {
+ public:
+  virtual ~ITextureOverrideSource() = default;
+  virtual void Poll() = 0;
+  virtual u64 GetGeneration() const = 0;
+  virtual bool GetOverride(const TextureOverrideRequest& request,
+                           std::span<const u8> guest_bytes,
+                           std::vector<std::vector<u8>>& host_levels,
+                           bool& refresh_target) = 0;
+};
+}  // namespace rex::gpu
