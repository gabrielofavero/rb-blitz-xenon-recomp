+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include <atomic>
+#include <condition_variable>
+#include <future>
+#include <mutex>
+#include <thread>
+#include <stdexcept>
+#include <system_error>
