+REX_TEST_CASE("Preparation progress counts reused pipelines once and retains failures", "[gpu][preparation]") {
+  GraphicsPreparationController controller;
+  REQUIRE(controller.Begin(MakeKey()));
+  controller.NoteCatalogue(true);
+  for(uint64_t identity:{1u,2u,3u}) REQUIRE(controller.RegisterEntry(identity));
+  controller.SucceedEntry(1);
+  controller.SucceedExistingEntry(2);
+  controller.SucceedExistingEntry(2);
+  controller.SucceedExistingEntry(99);
+  controller.FailEntry(3);
+  controller.SucceedExistingEntry(3);
+  const auto first=controller.Snapshot();
+  CHECK(first.entries.required==3);
+  CHECK(first.entries.succeeded==2);
+  CHECK(first.entries.already_present==1);
+  CHECK(first.entries.failed==1);
+  controller.Reset();
+  CHECK(controller.Snapshot().entries.already_present==0);
+  REQUIRE(controller.Begin(MakeKey(0x5841122D,2)));
+  controller.NoteCatalogue(true);
+  REQUIRE(controller.RegisterEntry(4));
+  controller.SucceedExistingEntry(4);
+  REQUIRE(controller.Finish(GraphicsPreparationPhase::kSucceeded));
+  CHECK(controller.Snapshot().ready());
+  CHECK(controller.Snapshot().entries.already_present==1);
+}
diff --git a/tests/unit/gpu/native_graphics_properties.cmake b/tests/unit/gpu/native_graphics_properties.cmake
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/native_graphics_properties.cmake
@@ -0,0 +1,19 @@
+# Device-wide compilation and memory budgets are shared across native fixtures.
+foreach(native_test IN ITEMS
+    "unit.Native graphics preparation reopens empty storage without claiming coverage"
+    "unit.Native graphics preparation reopens a validated nonempty cache"
+    "unit.Native texture conversion reads GPU contents in every component mode")
+  if(native_test IN_LIST unit_tests_TESTS)
+    set_tests_properties("${native_test}" PROPERTIES
+      RESOURCE_LOCK rex_native_graphics TIMEOUT 180)
+  endif()
+endforeach()
+
+# The nonempty case runs two generations for each compiled backend. Keep each
+# generation's three-minute assertion budget, plus three minutes for all native
+# initialization, cache copying and driver shutdown outside those loops.
+set(_rex_nonempty_test "unit.Native graphics preparation reopens a validated nonempty cache")
+if(_rex_nonempty_test IN_LIST unit_tests_TESTS)
+  math(EXPR _rex_nonempty_timeout "@REX_NATIVE_PREPARATION_BACKEND_COUNT@ * 2 * 180 + 180")
+  set_tests_properties("${_rex_nonempty_test}" PROPERTIES TIMEOUT "${_rex_nonempty_timeout}")
+endif()
