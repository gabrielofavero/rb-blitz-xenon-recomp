+REX_TEST_CASE("Pipeline preload: creation thread count", "[gpu][preparation]") {
+  TestCreationThreadCount();
+}
+
+REX_TEST_CASE("Pipeline preload: empty and synchronous", "[gpu][preparation]") {
+  TestEmptyAndSynchronous();
+}
+
+REX_TEST_CASE("Pipeline preload: delayed worker", "[gpu][preparation]") {
+  TestDelayedWorker();
+}
+
+REX_TEST_CASE("Pipeline preload: multi worker", "[gpu][preparation]") {
+  TestMultiWorker();
+}
+
+REX_TEST_CASE("Pipeline preload: failures missing and duplicates", "[gpu][preparation]") {
+  TestFailuresMissingAndDuplicates();
+}
+
+REX_TEST_CASE("Pipeline preload: shutdown releases waiters", "[gpu][preparation]") {
+  TestShutdownReleasesWaiters();
+}
