+  group.Serve(static_cast<rex::IAppInfo&>(info),rex::IAppInfo::kInterface);
+  REQUIRE(group.Load("rexgpu"));
+  REQUIRE(group.Load("rexgpu-xenos-vulkan"));
+  REQUIRE(group.Connect());
+  const rex::DriverRegistration* registration=nullptr;
+  for(const auto* candidate:rex::test::GetRegistrations(group,rex::DriverType::kGraphics))
+    if(candidate->name=="vulkan") registration=candidate;
+  REQUIRE(registration);
+  rex::test::FakeTitleContext title(rex::test::GetTestMemory());
+  rex::test::TempFolder folder("rex_vulkan_preparation_");
+  auto owner=registration->create();
+  REQUIRE(owner);
+  auto* driver=static_cast<rex::gpu::IGraphicsDriver*>(owner.get());
+  rex::ScopeGuard cleanup([&]{ driver->Shutdown(); group.Disconnect(); });
+  REQUIRE(driver->Initialize(context));
+  auto* xenos=static_cast<rex::gpu::XenosGraphicsDriverBase*>(driver->AsXenos());
+  REQUIRE(xenos);
+  REQUIRE(xenos->store_shaders.Set(false));
+  namespace trace=rex::diagnostics::compile_trace;
+  const auto trace_phase=trace::CurrentPhase();
+  const auto compute_before=trace::ReadCounter(trace_phase,trace::Event::kHelperCompute).count;
+  REQUIRE(driver->AttachTitle(rex::TitleInfo{},title,title,title));
+  auto* processor=xenos->GetCommandProcessor();
+  REQUIRE(processor);
+  rex::u64 previous=0;
+  for(rex::u64 configuration:{1u,2u}) {
+    REQUIRE(processor->BeginShaderStoragePreparation(folder.path,0x5841122D,configuration));
+    const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(30);
+    while(processor->QueryShaderStoragePreparation().active && std::chrono::steady_clock::now()<deadline)
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    const auto progress=processor->QueryShaderStoragePreparation();
+    REQUIRE_FALSE(progress.active);
+    CHECK(progress.generation>previous);
+    CHECK(progress.key.configuration==configuration);
+    CHECK(progress.phase==rex::gpu::GraphicsPreparationPhase::kIncomplete);
+    CHECK(progress.entries.required==0);
+    CHECK_FALSE(progress.ready());
+    CHECK(processor->WaitForShaderStoragePreparation().generation==progress.generation);
+    previous=progress.generation;
+  }
+  if(trace::Enabled())
+    CHECK(trace::ReadCounter(trace_phase,trace::Event::kHelperCompute).count>compute_before);
+  driver->DetachTitle();
+}
