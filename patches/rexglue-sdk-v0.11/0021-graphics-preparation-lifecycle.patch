new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/preparation_shader_access.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <mutex>
+#include "gpu/xenos/pipeline/shader/shader.h"
+
+namespace rex::gpu {
+// A live draw skips busy preparation shaders instead of waiting on a translation.
+// Ordinary draws keep their existing path once the preparation workers have joined.
+class PreparationShaderAccess {
+ public:
+  PreparationShaderAccess()=default;
+  PreparationShaderAccess(bool active,Shader* vertex,Shader* pixel) {
+    if(!active) return;
+    if(vertex) {
+      vertex_=std::unique_lock<std::recursive_mutex>(vertex->GetPreparationMutex(),std::try_to_lock);
+      if(!vertex_.owns_lock()) { allowed_=false; return; }
+    }
+    if(pixel && pixel!=vertex) {
+      pixel_=std::unique_lock<std::recursive_mutex>(pixel->GetPreparationMutex(),std::try_to_lock);
+      if(!pixel_.owns_lock()) {
+        if(vertex_.owns_lock()) vertex_.unlock();
+        allowed_=false;
+      }
+    }
+  }
+  PreparationShaderAccess(PreparationShaderAccess&&)=default;
+  PreparationShaderAccess& operator=(PreparationShaderAccess&&)=default;
+  explicit operator bool() const { return allowed_; }
+ private:
+  bool allowed_=true;
+  std::unique_lock<std::recursive_mutex> vertex_,pixel_;
+};
+}
diff --git a/tests/unit/gpu/preparation_shader_access_test.cpp b/tests/unit/gpu/preparation_shader_access_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/gpu/preparation_shader_access_test.cpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "rex_test.h"
+#include <array>
+#include <future>
+#include <thread>
+#include "gpu/xenos/preparation_shader_access.h"
+
+REX_TEST_CASE("Draw access does not wait for a busy preparation shader", "[gpu][preparation]") {
+  constexpr std::array<rex::u32,2> ucode{0,0};
+  rex::gpu::Shader vertex(rex::xenos::ShaderType::kVertex,1,ucode.data(),ucode.size());
+  rex::gpu::Shader pixel(rex::xenos::ShaderType::kPixel,2,ucode.data(),ucode.size());
+  std::promise<void> started,release;
+  auto gate=release.get_future();
+  std::thread worker([&] {
+    std::unique_lock lock(pixel.GetPreparationMutex());
+    started.set_value();
+    gate.wait();
+  });
+  started.get_future().wait();
+  auto draw=std::async(std::launch::async,[&] {
+    return bool(rex::gpu::PreparationShaderAccess(true,&vertex,&pixel));
+  });
+  const bool returned=draw.wait_for(std::chrono::seconds(2))==std::future_status::ready;
+  bool allowed=true;
+  if(returned) allowed=draw.get();
+  release.set_value();
+  worker.join();
+  if(!returned) allowed=draw.get();
+  CHECK(returned);
+  CHECK_FALSE(allowed);
+  // A refused draw released its first shader and left the next draw usable.
+  CHECK(bool(rex::gpu::PreparationShaderAccess(true,&vertex,&pixel)));
+}
+
+REX_TEST_CASE("Preparation access permits nested use and the completed fast path", "[gpu][preparation]") {
+  constexpr std::array<rex::u32,2> ucode{0,0};
+  rex::gpu::Shader shader(rex::xenos::ShaderType::kVertex,1,ucode.data(),ucode.size());
+  std::unique_lock owner(shader.GetPreparationMutex());
+  CHECK(bool(rex::gpu::PreparationShaderAccess(true,&shader,&shader)));
+  CHECK(bool(rex::gpu::PreparationShaderAccess(false,&shader,nullptr)));
+}
