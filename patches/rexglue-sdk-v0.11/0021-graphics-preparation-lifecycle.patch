+size_t VulkanPipelineCache::EnqueuePreparationPipelines(size_t max_count) {
+  auto& preparation = command_processor_.GetPreparation();
+  size_t enqueued_count = 0;
+  while (enqueued_count < max_count &&
+         preparation_next_creation_ < preparation_descriptions_.size()) {
+    const size_t pipeline_stored_description_index = preparation_next_creation_++;
+    ++enqueued_count;
+    const PipelineStoredDescription& pipeline_stored_description =
+        preparation_descriptions_[pipeline_stored_description_index];
+    const u64 preload_identity = u64(pipeline_stored_description_index);
+    const PipelineDescription& pipeline_description = pipeline_stored_description.description;
+
+    auto find_it = pipelines_.find(pipeline_description);
+    if (find_it != pipelines_.end()) {
+      // A pipeline that already exists is ready only when it holds a real
+      // pipeline. A placeholder, a retained fallback after a failed real
+      // creation and a not-yet-created entry are not readiness.
+      const Pipeline& found_pipeline = find_it->second;
+      if (found_pipeline.pipeline.load(std::memory_order_acquire) != VK_NULL_HANDLE &&
+          !found_pipeline.is_placeholder.load(std::memory_order_acquire) &&
+          !found_pipeline.real_pipeline_failed.load(std::memory_order_acquire)) {
+        preparation.SucceedEntry(preload_identity);
+        ++pipelines_already_present_;
+      } else {
+        preparation.FailEntry(preload_identity);
+      }
+      continue;
+    }
+    auto& pipeline = *pipelines_.emplace(pipeline_description, Pipeline()).first;
+    PipelineCreationArguments creation_arguments;
+    if (!TryGetPipelineCreationArgumentsForDescription(pipeline_description, &pipeline,
+                                                       creation_arguments)) {
+      pipelines_.erase(pipeline_description);
+      preparation.MissEntry(preload_identity);
+      continue;
+    }
+    u32 bound_rts = 0;
+    for (u32 i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (pipeline_description.render_targets[i].color_write_mask) {
+        bound_rts |= u32(1) << i;
+      }
+    }
+    u32 shader_writes_color_targets =
+        creation_arguments.pixel_shader
+            ? creation_arguments.pixel_shader->GetShader().GetWritesColorTargets()
+            : 0;
+    bool shader_writes_depth = creation_arguments.pixel_shader
+                                   ? creation_arguments.pixel_shader->GetShader().IsDepthWritten()
+                                   : pipeline_description.depth_write_enable != 0;
+    creation_arguments.priority = pipeline_priority::CalculatePipelinePriority(
+        bound_rts, shader_writes_color_targets, shader_writes_depth);
+    creation_arguments.preload_identity = preload_identity;
+    // The arguments outlive this slice: the workers pop their own copy, and the
+    // vector keeps the descriptions alive for the generation.
+    preparation_creations_.push_back(creation_arguments);
+    if (preparation_creation_threads_.empty()) {
+      if (CreatePipeline(preparation_creations_.back())) {
+        preparation.SucceedEntry(preload_identity);
+      } else {
+        preparation.FailEntry(preload_identity);
+      }
+      continue;
+    }
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      preparation_creation_queue_.push(preparation_creations_.back());
+    }
+    preparation_creation_cond_.notify_one();
+  }
+  return enqueued_count;
+}
+
+bool VulkanPipelineCache::ServiceShaderStoragePreparation() {
+  auto& preparation = command_processor_.GetPreparation();
+  if (!preparation_running_) {
+    return false;
+  }
+  preparation.NoteServiceSlice();
+  if (!preparation.Active()) {
+    ShutdownPreparationWorkers();
+    preparation_running_ = false;
+    return false;
+  }
+
+  if (preparation.CancelRequested() && !preparation_cancelled_) {
+    // Cancellation finalizes the generation: nothing more is enqueued, entries
+    // whose creation has not started are cancelled, and work already in flight
+    // is joined.
+    CancelShaderStoragePreparation();
+    FinishShaderStoragePreparation(GraphicsPreparationPhase::kCancelled);
+    return false;
+  }
+
+  if (preparation.phase() == GraphicsPreparationPhase::kImporting) {
+    FinishShaderStoragePreparation(GraphicsPreparationPhase::kFailed);
+    return false;
+  }
+
+  if (preparation.phase() == GraphicsPreparationPhase::kTranslating) {
+    if (!preparation_cancelled_) {
+      TranslatePreparationShaders(kPreparationTranslationBatch);
+    }
+    if (preparation_next_translation_ < preparation_translations_.size()) {
+      return true;
+    }
+    preparation.AdvancePhase(GraphicsPreparationPhase::kCreating);
+  }
+
+  if (preparation.phase() == GraphicsPreparationPhase::kCreating) {
+    if (!preparation_cancelled_) {
+      EnqueuePreparationPipelines(kPreparationEnqueueBatch);
+    }
+    {
+      rex::diagnostics::compile_trace::Scope trace_drain(
+          rex::diagnostics::compile_trace::Event::kCompileDrain,
+          "src/graphics/vulkan/pipeline_cache.cpp");
+      if (preparation_blocking_ || preparation_creation_threads_.empty()) {
+        CreatePreparationPipelinesOnProcessorThread(kPreparationCreationBatch);
+      }
+      trace_drain.Success();
+    }
+    const bool all_enqueued = preparation_next_creation_ >= preparation_descriptions_.size();
+    if (all_enqueued && preparation.unfinished_entries() == 0) {
+      const GraphicsPreparationPhase terminal_phase =
+          preparation_cancelled_
+              ? GraphicsPreparationPhase::kCancelled
+              : (preparation.entries().Complete() ? GraphicsPreparationPhase::kSucceeded
+                                                  : GraphicsPreparationPhase::kIncomplete);
+      FinishShaderStoragePreparation(terminal_phase);
+      return false;
+    }
+    return true;
+  }
+
+  return preparation.Active();
+}
+
+void VulkanPipelineCache::CancelShaderStoragePreparation() {
+  auto& preparation = command_processor_.GetPreparation();
+  if (!preparation_running_ || preparation_cancelled_) {
+    return;
+  }
+  preparation_cancelled_ = true;
+  preparation.CancelPendingEntries();
+  preparation_next_translation_ = preparation_translations_.size();
+  preparation_next_creation_ = preparation_descriptions_.size();
+  preparation.AdvancePhase(GraphicsPreparationPhase::kFinalizing);
+}
+
+void VulkanPipelineCache::StartPreparationWorkers() {
+  // The creation pool is separate from the gameplay `creation_threads_`: a
+  // submission's EndSubmission() must never wait for preparation work, and
+  // preparation must not consume a pipeline a draw needs first.
+  size_t creation_thread_count = 1;
+  u32 logical_processor_count = rex::platform::GetLogicalProcessorCount();
+  if (!logical_processor_count) {
+    logical_processor_count = 6;
+  }
+  if (command_processor_.GetVulkanSettings().pipeline_creation_threads.Get() == 0) {
+    creation_thread_count = 1;
+  } else if (command_processor_.GetVulkanSettings().pipeline_creation_threads.Get() < 0) {
+    creation_thread_count =
+        std::max(size_t(logical_processor_count * 3 / 4), size_t(1));
+  } else {
+    creation_thread_count =
+        std::min(size_t(command_processor_.GetVulkanSettings().pipeline_creation_threads.Get()),
+                 size_t(logical_processor_count));
+  }
+  creation_thread_count = std::max(creation_thread_count, size_t(1));
+  creation_thread_count = std::min(creation_thread_count,
+      PreparationWorkerCount(preparation_descriptions_.size(), logical_processor_count));
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+  preparation_creation_threads_.clear();
+  preparation_creation_threads_.reserve(creation_thread_count);
+  for (size_t thread_index = 0; thread_index < creation_thread_count; ++thread_index) {
+    std::unique_ptr<rex::platform::Thread> creation_thread = rex::platform::Thread::Create(
+        {.initial_priority = rex::platform::ThreadPriority::kBelowNormal},
+        [this, thread_index]() { PreparationCreationThread(thread_index); });
+    REX_ASSERT(creation_thread != nullptr);
+    creation_thread->SetName("Vulkan Prep Pipelines");
+    preparation_creation_threads_.push_back(std::move(creation_thread));
+  }
+}
+
+size_t VulkanPipelineCache::CreatePreparationPipelinesOnProcessorThread(size_t max_count) {
+  auto& preparation = command_processor_.GetPreparation();
+  size_t created_count = 0;
+  while (created_count < max_count) {
+    PipelineCreationArguments creation_arguments;
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      if (preparation_creation_queue_.empty()) {
+        break;
+      }
+      creation_arguments = preparation_creation_queue_.top();
+      preparation_creation_queue_.pop();
+      ++preparation_creation_busy_;
+    }
+    if (creation_arguments.preload_identity != kNoPreloadIdentity) {
+      preparation.BeginEntry(creation_arguments.preload_identity);
+    }
+    if (CreatePipeline(creation_arguments)) {
+      preparation.SucceedEntry(creation_arguments.preload_identity);
+    } else {
+      preparation.FailEntry(creation_arguments.preload_identity);
+    }
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      --preparation_creation_busy_;
+    }
+    ++created_count;
+  }
+  return created_count;
+}
+
+void VulkanPipelineCache::PreparationCreationThread(size_t thread_index) {
+  (void)thread_index;
+#if REX_PLATFORM_WIN32
+  rex::platform::SetCurrentThreadPriority(rex::platform::ThreadPriority::kBelowNormal);
+#endif
+  auto& preparation = command_processor_.GetPreparation();
+  for (;;) {
+    PipelineCreationArguments creation_arguments;
+    {
+      std::unique_lock<std::mutex> lock(preparation_creation_lock_);
+      if (preparation_creation_shutdown_) {
+        return;
+      }
+      if (preparation_creation_queue_.empty()) {
+        preparation_creation_cond_.wait(lock);
+        continue;
+      }
+      creation_arguments = preparation_creation_queue_.top();
+      preparation_creation_queue_.pop();
+      ++preparation_creation_busy_;
+    }
+    if (creation_arguments.preload_identity != kNoPreloadIdentity) {
+      preparation.BeginEntry(creation_arguments.preload_identity);
+    }
+    if (CreatePipeline(creation_arguments, VK_NULL_HANDLE, true)) {
+      preparation.SucceedEntry(creation_arguments.preload_identity);
+    } else {
+      preparation.FailEntry(creation_arguments.preload_identity);
+    }
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      --preparation_creation_busy_;
+    }
+  }
+}
+
+void VulkanPipelineCache::ShutdownPreparationWorkers() {
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    preparation_creation_shutdown_ = true;
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+  }
+  preparation_creation_cond_.notify_all();
+  for (auto& creation_thread : preparation_creation_threads_) {
+    rex::platform::Wait(creation_thread.get(), false);
+  }
+  preparation_creation_threads_.clear();
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+}
