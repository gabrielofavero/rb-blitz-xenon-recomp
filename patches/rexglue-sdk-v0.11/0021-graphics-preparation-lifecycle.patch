+
+bool PipelineCache::ServiceShaderStoragePreparation() {
+  auto& preparation = command_processor_.GetPreparation();
+  if (!preparation_running_) {
+    return false;
+  }
+  preparation.NoteServiceSlice();
+  if (!preparation.Active()) {
+    // Reset from outside (shutdown). Retire the workers without reporting into a
+    // generation that no longer exists.
+    ShutdownPreparationWorkers();
+    preparation_running_ = false;
+    return false;
+  }
+
+  if (preparation.CancelRequested() && !preparation_cancelled_) {
+    // Cancellation finalizes the generation: nothing more is enqueued, entries
+    // whose creation has not started are cancelled, and work already in flight
+    // is joined - the pipelines it produced are real and stay resident.
+    CancelShaderStoragePreparation();
+    FinishShaderStoragePreparation(GraphicsPreparationPhase::kCancelled);
+    return false;
+  }
+
+  const GraphicsPreparationPhase phase = preparation.phase();
+  if (phase == GraphicsPreparationPhase::kImporting) {
+    // Reaching the service slice still importing means a generation was started
+    // without OpenShaderStorage - nothing can be prepared.
+    FinishShaderStoragePreparation(GraphicsPreparationPhase::kFailed);
+    return false;
+  }
+
+  if (phase == GraphicsPreparationPhase::kTranslating) {
+    if (!PreparationTranslationsFinished()) {
+      return true;
+    }
+    JoinPreparationTranslationWorkers();
+    // Failed translations remain owned while queued gameplay may reference them;
+    // invalid translations cannot count as prepared pipelines.
+    preparation.AdvancePhase(GraphicsPreparationPhase::kCreating);
+  }
+
+  if (preparation.phase() == GraphicsPreparationPhase::kCreating) {
+    if (!preparation_cancelled_) {
+      EnqueuePreparationPipelines(kPreparationEnqueueBatch);
+    }
+    {
+      // The processor thread participates in creation (it is the owner of the
+      // maps and the driver calls), but only for a bounded batch per slice.
+      rex::diagnostics::compile_trace::Scope trace_drain(
+          rex::diagnostics::compile_trace::Event::kCompileDrain,
+          "src/graphics/d3d12/pipeline_cache.cpp");
+      if (preparation_blocking_ || preparation_creation_threads_.empty()) {
+        CreatePreparationPipelinesOnProcessorThread(kPreparationCreationBatch);
+      }
+      trace_drain.Success();
+    }
+    const bool all_enqueued =
+        preparation_next_description_ >= preparation_descriptions_.size();
+    if (all_enqueued && preparation.unfinished_entries() == 0) {
+      const GraphicsPreparationPhase terminal_phase =
+          preparation_cancelled_
+              ? GraphicsPreparationPhase::kCancelled
+              : (preparation.entries().Complete() ? GraphicsPreparationPhase::kSucceeded
+                                                  : GraphicsPreparationPhase::kIncomplete);
+      FinishShaderStoragePreparation(terminal_phase);
+      return false;
+    }
+    return true;
+  }
+
+  return preparation.Active();
+}
+
+void PipelineCache::CancelShaderStoragePreparation() {
+  auto& preparation = command_processor_.GetPreparation();
+  if (!preparation_running_ || preparation_cancelled_) {
+    return;
+  }
+  preparation_cancelled_ = true;
+  // Entries whose creation has not started are abandoned; describing the
+  // remaining stored pipelines as never enqueued covers them in the same step.
+  preparation.CancelPendingEntries();
+  preparation_next_description_ = preparation_descriptions_.size();
+  preparation.AdvancePhase(GraphicsPreparationPhase::kFinalizing);
+}
+
+void PipelineCache::StartPreparationWorkers(size_t logical_processor_count) {
+  // The translation pool was grown while the storage was read; only the creation
+  // pool is created here, sized once to the whole batch.
+  size_t creation_thread_count =
+      PreparationWorkerCount(preparation_descriptions_.size(), logical_processor_count);
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+  preparation_creation_threads_.clear();
+  preparation_creation_threads_.reserve(creation_thread_count);
+  for (size_t thread_index = 0; thread_index < creation_thread_count; ++thread_index) {
+    std::unique_ptr<rex::platform::Thread> creation_thread = rex::platform::Thread::Create(
+        {.initial_priority = rex::platform::ThreadPriority::kBelowNormal},
+        [this, thread_index]() { PreparationCreationThread(thread_index); });
+    REX_ASSERT(creation_thread != nullptr);
+    creation_thread->SetName("D3D12 Prep Pipelines");
+    preparation_creation_threads_.push_back(std::move(creation_thread));
+  }
+}
+
+bool PipelineCache::PreparationTranslationsFinished() const {
+  std::lock_guard<std::mutex> lock(preparation_translation_lock_);
+  return preparation_translation_busy_ == 0 && preparation_shaders_to_translate_.empty();
+}
+
+void PipelineCache::JoinPreparationTranslationWorkers() {
+  {
+    std::lock_guard lock(preparation_translation_lock_);
+    preparation_translation_shutdown_=true;
+  }
+  preparation_translation_cond_.notify_all();
+  for(auto& worker:preparation_translation_threads_) rex::platform::Wait(worker.get(),false);
+  preparation_translation_threads_.clear();
+  {
+    std::lock_guard lock(preparation_failed_translations_lock_);
+    // Queued gameplay pipelines may still reference a failed translation. Keep it
+    // in its shader until cache teardown; readiness already checks its validity.
+    preparation_failed_translations_.clear();
+  }
+  preparation_translation_active_.store(false,std::memory_order_release);
+}
+
+size_t PipelineCache::CreatePreparationPipelinesOnProcessorThread(size_t max_count) {
+  auto& preparation = command_processor_.GetPreparation();
+  size_t created_count = 0;
+  while (created_count < max_count) {
+    Pipeline* pipeline_to_create;
+    u64 preload_identity = kNoPreloadIdentity;
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      if (preparation_creation_queue_.empty()) {
+        break;
+      }
+      pipeline_to_create = preparation_creation_queue_.top();
+      preparation_creation_queue_.pop();
+      preload_identity = pipeline_to_create->preload_identity;
+      ++preparation_creation_busy_;
+    }
+    if (preload_identity != kNoPreloadIdentity) {
+      preparation.BeginEntry(preload_identity);
+    }
+    PipelineRuntimeDescription runtime_description;
+    if (!PrepareRuntimeDescriptionForQueuedCreation(pipeline_to_create, runtime_description)) {
+      pipeline_to_create->state.store(nullptr, std::memory_order_release);
+      if (preload_identity != kNoPreloadIdentity) {
+        preparation.FailEntry(preload_identity);
+      }
+    } else {
+      pipeline_to_create->state.store(CreateD3D12Pipeline(runtime_description),
+                                      std::memory_order_release);
+      if (preload_identity != kNoPreloadIdentity) {
+        if (pipeline_to_create->state.load(std::memory_order_acquire)) {
+          preparation.SucceedEntry(preload_identity);
+        } else {
+          preparation.FailEntry(preload_identity);
+        }
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      --preparation_creation_busy_;
+    }
+    ++created_count;
+  }
+  return created_count;
+}
+
+void PipelineCache::PreparationCreationThread(size_t thread_index) {
+  (void)thread_index;
+#if REX_PLATFORM_WIN32
+  rex::platform::SetCurrentThreadPriority(rex::platform::ThreadPriority::kBelowNormal);
+#endif
+  auto& preparation = command_processor_.GetPreparation();
+  for (;;) {
+    Pipeline* pipeline_to_create;
+    u64 preload_identity = kNoPreloadIdentity;
+    {
+      std::unique_lock<std::mutex> lock(preparation_creation_lock_);
+      if (preparation_creation_shutdown_) {
+        return;
+      }
+      if (preparation_creation_queue_.empty()) {
+        preparation_creation_cond_.wait(lock);
+        continue;
+      }
+      pipeline_to_create = preparation_creation_queue_.top();
+      preparation_creation_queue_.pop();
+      preload_identity = pipeline_to_create->preload_identity;
+      ++preparation_creation_busy_;
+    }
+    if (preload_identity != kNoPreloadIdentity) {
+      preparation.BeginEntry(preload_identity);
+    }
+    PipelineRuntimeDescription runtime_description;
+    if (!PrepareRuntimeDescriptionForQueuedCreation(pipeline_to_create, runtime_description)) {
+      pipeline_to_create->state.store(nullptr, std::memory_order_release);
+      if (preload_identity != kNoPreloadIdentity) {
+        preparation.FailEntry(preload_identity);
+      }
+    } else {
+      pipeline_to_create->state.store(CreateD3D12Pipeline(runtime_description),
+                                      std::memory_order_release);
+      if (preload_identity != kNoPreloadIdentity) {
+        if (pipeline_to_create->state.load(std::memory_order_acquire)) {
+          preparation.SucceedEntry(preload_identity);
+        } else {
+          preparation.FailEntry(preload_identity);
+        }
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+      --preparation_creation_busy_;
+    }
+  }
+}
+
+void PipelineCache::ShutdownPreparationWorkers() {
+  JoinPreparationTranslationWorkers();
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    preparation_creation_shutdown_ = true;
+    while (!preparation_creation_queue_.empty()) {
+      preparation_creation_queue_.pop();
+    }
+  }
+  preparation_creation_cond_.notify_all();
+  for (auto& creation_thread : preparation_creation_threads_) {
+    rex::platform::Wait(creation_thread.get(), false);
+  }
+  preparation_creation_threads_.clear();
+  {
+    std::lock_guard<std::mutex> lock(preparation_creation_lock_);
+    preparation_creation_shutdown_ = false;
+    preparation_creation_busy_ = 0;
+  }
+}
