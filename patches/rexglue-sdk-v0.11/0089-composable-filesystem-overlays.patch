diff --git a/src/filesystem/overlay_provider.h b/src/filesystem/overlay_provider.h
new file mode 100644
--- /dev/null
+++ b/src/filesystem/overlay_provider.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "filesystem/provider.h"
+
+namespace rex::filesystem {
+
+/** Captures an existing provider and composes a read-only host tree over it.
+ * Provider references form an immutable DAG; calls only descend towards older providers.
+ */
+class OverlayProvider final : public Provider {
+ public:
+  static Result<std::unique_ptr<Provider>> Create(
+      const MountEntry& entry, std::shared_ptr<Provider> base, std::string base_path);
+  ~OverlayProvider() override;
+  VolumeStat GetVolume() const override;
+  Node* Resolve(std::string_view path) override;
+
+  void Observe(std::string_view path, bool open, Access access, FileSystemError error) const;
+  Node* Base(std::string_view path) const;
+  Node* Source(std::string_view path) const;
+  Node* Redirect(std::string_view path) const;
+  Node* Backing(std::string_view path) const;
+  bool IsRedirected(std::string_view path) const;
+  bool HasRedirects() const { return redirect_ && !options_.redirected_paths.empty(); }
+  std::vector<std::unique_lock<std::recursive_mutex>> LockBackings() const;
+  Node* WriteParent(std::string_view path, std::string_view child) const;
+
+ private:
+  OverlayProvider(MountEntry entry, std::shared_ptr<Provider> base, std::string base_path);
+  std::shared_ptr<Provider> base_;
+  std::shared_ptr<Provider> source_;
+  std::shared_ptr<Provider> redirect_;
+  std::string base_path_;
+  OverlayMountOptions options_;
+  Node* anchor_ = nullptr;
+};
+
+}  // namespace rex::filesystem
diff --git a/src/filesystem/overlay_provider.cpp b/src/filesystem/overlay_provider.cpp
new file mode 100644
--- /dev/null
+++ b/src/filesystem/overlay_provider.cpp
@@ -0,0 +1,326 @@
+#include "filesystem/overlay_provider.h"
+
+#include <algorithm>
+#include <map>
+#include <mutex>
+
+#include <rex/filesystem/file_system_error.h>
+#include <rex/string/path.h>
+#include <rex/string/text.h>
+
+#include "filesystem/host_provider.h"
+#include "filesystem/node_file.h"
+
+namespace rex::filesystem {
+namespace {
+
+std::string Normalize(std::string_view path) {
+  const auto canonical = string::utf8_canonicalize_guest_path(path);
+  const auto parts = string::utf8_split_path(canonical);
+  std::string result;
+  for (auto part : parts) result = string::utf8_join_guest_paths(result, part);
+  return result;
+}
+
+Error Denied() { return BuildError(FileSystemError::kAccessDenied, "overlay backing refuses changes"); }
+
+// NodeFile pins both the backing node and its provider until the last stream closes.
+class OverlayStream final : public NodeStream {
+ public:
+  explicit OverlayStream(std::unique_ptr<IFile> file) : file_(std::move(file)) {}
+  Result<size_t> Read(std::span<u8> b, u64 o) override { return file_->Read(b, o); }
+  Result<size_t> Write(std::span<const u8> b, u64 o) override { return file_->Write(b, o); }
+  Result<void> SetLength(u64 n) override { return file_->SetLength(n); }
+  Result<void> Flush() override { return file_->Flush(); }
+  Result<std::span<const u8>> View() override { return file_->View(); }
+ private:
+  std::unique_ptr<IFile> file_;
+};
+
+class OverlayNode final : public Node {
+ public:
+  OverlayNode(OverlayProvider& provider, Node* parent, std::string path)
+      : Node(provider, parent, std::move(path)), overlay_(provider) {
+    Refresh();
+  }
+
+  bool IsReadOnly() const override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    if (!GetParent() && overlay_.HasRedirects()) return false;
+    auto* backing = overlay_.Backing(GetPath());
+    return !backing || backing->IsReadOnly();
+  }
+
+  void Refresh() override {
+    std::lock_guard lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    if (auto* backing = overlay_.Backing(GetPath())) {
+      backing->Refresh();
+      auto next = backing->GetInfo();
+      next.path = info_.path;
+      next.absolute_path = info_.absolute_path;
+      next.name = info_.name;
+      info_ = std::move(next);
+    }
+  }
+
+  void Populate() {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    if (!IsDirectory()) return;
+    std::map<std::string, std::string> names;
+    auto collect = [&](Node* node) {
+      if (!node || !node->IsDirectory()) return;
+      std::lock_guard lock(node->GetProvider().GetMutex());
+      for (const auto& child : node->GetChildren()) {
+        names[string::utf8_lower_ascii(child->GetName())] = child->GetName();
+      }
+    };
+    collect(overlay_.Base(GetPath()));
+    collect(overlay_.Source(GetPath()));
+    if (GetPath().empty()) {
+      for (const auto& name : overlay_.GetEntry().overlay->redirected_paths) {
+        if (auto* redirected = overlay_.Redirect(name))
+          names[string::utf8_lower_ascii(redirected->GetName())] = redirected->GetName();
+      }
+    }
+    for (const auto& [folded, name] : names) {
+      const auto path = string::utf8_join_guest_paths(GetPath(), name);
+      if (!overlay_.Backing(path)) continue;
+      auto child = std::make_unique<OverlayNode>(overlay_, this, path);
+      child->Populate();
+      AddChild(std::move(child));
+    }
+  }
+
+  bool HasChildVanished(const Node& child) const override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    return !overlay_.Backing(child.GetPath());
+  }
+
+  Result<std::unique_ptr<NodeStream>> Open(Access access) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    auto* backing = overlay_.Backing(GetPath());
+    if (!backing) return Err<std::unique_ptr<NodeStream>>(
+        BuildError(FileSystemError::kNotFound, "overlay backing no longer exists"));
+    std::lock_guard lock(backing->GetProvider().GetMutex());
+    auto opened = backing->Open(access);
+    overlay_.Observe(GetPath(), true, access,
+                     opened ? FileSystemError::kNone : CodeOf(opened.error()));
+    if (!opened) return Err<std::unique_ptr<NodeStream>>(opened.error());
+    auto stream = std::move(*opened);
+    return std::unique_ptr<NodeStream>(std::make_unique<OverlayStream>(
+        std::make_unique<NodeFile>(*backing, access, std::move(stream))));
+  }
+
+  Result<void> Truncate() override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    auto* backing = overlay_.Backing(GetPath());
+    if (!backing || backing->IsReadOnly()) return Err(Denied());
+    return backing->Truncate();
+  }
+  Result<void> SetAttributes(FileAttributes attributes) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    auto* backing = overlay_.Backing(GetPath());
+    if (!backing || backing->IsReadOnly()) return Err(Denied());
+    REX_TRY_VOID(backing->SetAttributes(attributes));
+    Refresh();
+    return Ok();
+  }
+  Result<void> SetTimes(const FileTimes& times) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    auto* backing = overlay_.Backing(GetPath());
+    if (!backing || backing->IsReadOnly()) return Err(Denied());
+    REX_TRY_VOID(backing->SetTimes(times));
+    Refresh();
+    return Ok();
+  }
+
+ protected:
+  Result<std::unique_ptr<Node>> CreateChildBacking(
+      std::string_view name, FileAttributes attributes) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    auto* parent = overlay_.WriteParent(GetPath(), name);
+    if (!parent || parent->IsReadOnly()) return Err<std::unique_ptr<Node>>(Denied());
+    REX_TRY(Node* created, parent->CreateChild(name, attributes));
+    (void)created;
+    return std::unique_ptr<Node>(std::make_unique<OverlayNode>(
+        overlay_, this, string::utf8_join_guest_paths(GetPath(), name)));
+  }
+  Result<void> DeleteChildBacking(Node& child) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    // Deleting a base record never removes its read-only source copy.
+    auto* backing = overlay_.IsRedirected(child.GetPath()) ?
+        overlay_.Redirect(child.GetPath()) : overlay_.Base(child.GetPath());
+    if (!backing || backing->IsReadOnly()) return Err(Denied());
+    return backing->Delete();
+  }
+  Result<void> MoveBacking(Node& parent, std::string_view name, bool replace) override {
+    std::lock_guard tree_lock(overlay_.GetMutex());
+    auto backing_locks = overlay_.LockBackings();
+    // Root redirects cannot be renamed into an ordinary base record or conversely.
+    const auto destination = string::utf8_join_guest_paths(parent.GetPath(), name);
+    if (overlay_.IsRedirected(GetPath()) != overlay_.IsRedirected(destination)) return Err(Denied());
+    auto* backing = overlay_.IsRedirected(GetPath()) ?
+        overlay_.Redirect(GetPath()) : overlay_.Base(GetPath());
+    auto* target = overlay_.WriteParent(parent.GetPath(), name);
+    if (!backing || !target || backing->IsReadOnly() || target->IsReadOnly()) return Err(Denied());
+    return backing->MoveTo(*target, name, replace);
+  }
+
+ private:
+  OverlayProvider& overlay_;
+};
+
+}  // namespace
+
+OverlayProvider::OverlayProvider(MountEntry entry, std::shared_ptr<Provider> base, std::string base_path)
+    : Provider(std::move(entry)), base_(std::move(base)), base_path_(Normalize(base_path)),
+      options_(*GetEntry().overlay) {}
+
+OverlayProvider::~OverlayProvider() {
+  if (anchor_) anchor_->ReleaseOpen();
+}
+
+Result<std::unique_ptr<Provider>> OverlayProvider::Create(
+    const MountEntry& entry, std::shared_ptr<Provider> base, std::string base_path) {
+  if (!entry.overlay) return Err<std::unique_ptr<Provider>>(
+      BuildError(FileSystemError::kInvalidPath, "overlay requires a policy"));
+  // Do not retain a caller-mutable alias of the mount policy.
+  MountEntry owned = entry;
+  owned.overlay = std::make_shared<const OverlayMountOptions>(*entry.overlay);
+  auto overlay = std::unique_ptr<OverlayProvider>(
+      new OverlayProvider(std::move(owned), std::move(base), std::move(base_path)));
+  for (const auto& name : overlay->options_.redirected_paths) {
+    auto parts = string::utf8_split_path(name);
+    if (parts.size() != 1 || parts.front() == "." || parts.front() == ".." ||
+        name.find_first_of("\\/:") != std::string::npos) return Err<std::unique_ptr<Provider>>(
+        BuildError(FileSystemError::kInvalidPath, "overlay redirects must name root records"));
+  }
+  auto backing_locks = overlay->LockBackings();
+  for (const auto& excluded : overlay->options_.excluded_source_paths) {
+    const auto parts = string::utf8_split_path(excluded);
+    if (parts.empty() || excluded.find(':') != std::string::npos ||
+        std::ranges::any_of(parts, [](auto part) { return part == "." || part == ".."; }))
+      return Err<std::unique_ptr<Provider>>(
+          BuildError(FileSystemError::kInvalidPath, "invalid overlay source exclusion"));
+  }
+  overlay->anchor_ = overlay->Base("");
+  if (!overlay->anchor_ || !overlay->anchor_->IsDirectory()) {
+    overlay->anchor_ = nullptr;
+    return Err<std::unique_ptr<Provider>>(
+        BuildError(FileSystemError::kNotDirectory, "overlay base is not a directory"));
+  }
+  overlay->anchor_->AddOpen();
+  if (!entry.source.empty()) {
+    std::error_code ec;
+    if (!std::filesystem::is_directory(entry.source, ec)) return Err<std::unique_ptr<Provider>>(
+        BuildError(FileSystemError::kNotDirectory, "overlay source is not a directory"));
+    REX_TRY(std::unique_ptr<Provider> source, HostProvider::Create(
+        {entry.path, ProviderType::kHostDirectory, entry.source, MountFlags::kNone, {}}));
+    overlay->source_ = std::move(source);
+  }
+  if (!overlay->options_.redirected_paths.empty()) {
+    if (overlay->options_.redirect_root.empty()) return Err<std::unique_ptr<Provider>>(
+        BuildError(FileSystemError::kInvalidPath, "overlay redirect root is empty"));
+    REX_TRY(std::unique_ptr<Provider> redirect, HostProvider::Create(
+        {entry.path, ProviderType::kHostDirectory, overlay->options_.redirect_root,
+         MountFlags::kWritable, {}}));
+    if (!redirect->GetRoot().IsDirectory()) return Err<std::unique_ptr<Provider>>(BuildError(FileSystemError::kNotDirectory, "overlay redirect root is not a directory"));
+    overlay->redirect_ = std::move(redirect);
+  }
+  auto root = std::make_unique<OverlayNode>(*overlay, nullptr, "");
+  root->Populate();
+  overlay->root_ = std::move(root);
+  return std::unique_ptr<Provider>(std::move(overlay));
+}
+
+void OverlayProvider::Observe(std::string_view path, bool open, Access access, FileSystemError error) const {
+  if (options_.observe) options_.observe(path, open, access, error);
+}
+VolumeStat OverlayProvider::GetVolume() const { return base_->GetVolume(); }
+std::vector<std::unique_lock<std::recursive_mutex>> OverlayProvider::LockBackings() const {
+  std::vector<std::unique_lock<std::recursive_mutex>> locks;
+  locks.emplace_back(base_->GetMutex());
+  if (source_) locks.emplace_back(source_->GetMutex());
+  if (redirect_) locks.emplace_back(redirect_->GetMutex());
+  return locks;
+}
+Node* OverlayProvider::Base(std::string_view path) const {
+  std::lock_guard lock(base_->GetMutex());
+  return base_->Resolve(string::utf8_join_guest_paths(base_path_, path));
+}
+Node* OverlayProvider::Source(std::string_view path) const {
+  if (!source_) return nullptr;
+  const auto normalized = Normalize(path);
+  for (const auto& excluded : options_.excluded_source_paths) {
+    const auto prefix = Normalize(excluded);
+    if (string::utf8_equal_case(normalized, prefix) ||
+        (normalized.size() > prefix.size() && normalized[prefix.size()] == '\\' &&
+         string::utf8_starts_with_case(normalized, prefix))) return nullptr;
+  }
+  std::lock_guard lock(source_->GetMutex());
+  return source_->Resolve(normalized);
+}
+bool OverlayProvider::IsRedirected(std::string_view path) const {
+  const auto normalized = Normalize(path);
+  return std::ranges::any_of(options_.redirected_paths, [&](const auto& name) {
+    return string::utf8_equal_case(normalized, Normalize(name));
+  });
+}
+Node* OverlayProvider::Redirect(std::string_view path) const {
+  if (!redirect_ || !IsRedirected(path)) return nullptr;
+  std::lock_guard lock(redirect_->GetMutex());
+  return redirect_->Resolve(Normalize(path));
+}
+Node* OverlayProvider::Backing(std::string_view path) const {
+  if (IsRedirected(path)) return Redirect(path);
+  auto* base = Base(path);
+  auto* source = Source(path);
+  if (source && (!base || !source->IsDirectory() || !base->IsDirectory())) return source;
+  return base ? base : source;
+}
+Node* OverlayProvider::WriteParent(std::string_view path, std::string_view child) const {
+  if (path.empty() && IsRedirected(child)) return redirect_ ? &redirect_->GetRoot() : nullptr;
+  auto* base = Base(path);
+  return base && base->IsDirectory() ? base : nullptr;
+}
+Node* OverlayProvider::Resolve(std::string_view path) {
+  std::lock_guard lock(GetMutex());
+  // Report the final resolution once, including a failed walk, without exposing private nodes.
+  Node* resolved = nullptr;
+  ScopeGuard report([&] { Observe(path, false, Access::kNone,
+      resolved ? FileSystemError::kNone : FileSystemError::kNotFound); });
+  auto backing_locks = LockBackings();
+  Node* parent = root_.get();
+  for (auto part : string::utf8_split_path(path)) {
+    if (!parent->IsDirectory()) return nullptr;
+    const auto joined = string::utf8_join_guest_paths(parent->GetPath(), part);
+    auto* backing = Backing(joined);
+    auto* child = parent->GetChild(part);
+    if (!backing) {
+      if (child) parent->RemoveChild(*child);
+      return nullptr;
+    }
+    if (!child) {
+      auto next = std::make_unique<OverlayNode>(*this, parent, joined);
+      next->Populate();
+      child = parent->AddChild(std::move(next));
+    }
+    if (!parent->IsDirectory()) return nullptr;
+    child->Refresh();
+    parent = child;
+  }
+  resolved = parent;
+  return parent;
+}
+
+}  // namespace rex::filesystem
