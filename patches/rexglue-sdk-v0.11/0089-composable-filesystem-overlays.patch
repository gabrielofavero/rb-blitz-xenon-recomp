+REX_TEST_CASE_METHOD(Fixture, "Nested overlays pin their base across unmount replacement and clear",
+                     "[filesystem][overlay]") {
+  WriteHost(GetTemp()/"base/dir/base.bin", "old base");
+  WriteHost(GetTemp()/"source/dir/source.bin", "source");
+  WriteHost(GetTemp()/"generated/dir/generated.bin", "generated");
+  WriteHost(GetTemp()/"replacement/dir/base.bin", "replacement");
+  REQUIRE(GetFileSystem().Mount({"\\Base",ProviderType::kHostDirectory,GetTemp()/"base",MountFlags::kNone,{}}));
+  MountOverlay(*this,"\\First",GetTemp()/"source",Policy());
+  MountOverlay(*this,"\\Last",GetTemp()/"generated",Policy("\\First"));
+  auto root=Open("\\Last\\dir");
+  auto held=Open("\\Last\\dir\\base.bin");
+  auto listing=root.file->List("");
+  REQUIRE(listing);
+  REQUIRE(GetFileSystem().Unmount("\\First"));
+  REQUIRE(GetFileSystem().Unmount("\\Base"));
+  REQUIRE(GetFileSystem().Mount({"\\Base",ProviderType::kHostDirectory,GetTemp()/"replacement",MountFlags::kNone,{}}));
+  CHECK(ReadText(*Open("\\Base\\dir\\base.bin").file)=="replacement");
+  CHECK(ReadText(*held.file)=="old base");
+  CHECK(Names(GetFileSystem(),"\\Last\\dir")==
+      std::vector<std::string>{"base.bin","generated.bin","source.bin"});
+  GetFileSystem().Clear();
+  std::thread reader([&] { CHECK(ReadText(*held.file)=="old base"); });
+  reader.join();
+  auto source=GetFileSystem().OpenRelative(*root.file,"source.bin",{});
+  REQUIRE(source);
+  CHECK(ReadText(*source->file)=="source");
+  auto generated=GetFileSystem().OpenRelative(*root.file,"generated.bin",{});
+  REQUIRE(generated);
+  CHECK(ReadText(*generated->file)=="generated");
+  std::vector<std::string> names;
+  while(auto entry=(*listing)->Next())names.push_back(entry->name);
+  std::ranges::sort(names);
+  CHECK(names==std::vector<std::string>{"base.bin","generated.bin","source.bin"});
+}
