+
+#include "rex_test.h"
+#include "filesystem/fixture.h"
+
+namespace {
+using namespace rex::filesystem;
+using test::Fixture;
+using test::ReadText;
+using test::WriteHost;
+
+std::shared_ptr<OverlayMountOptions> Policy(std::string base = "\\Base") {
+  auto result = std::make_shared<OverlayMountOptions>();
+  result->base_path = std::move(base);
+  return result;
+}
+
+void MountOverlay(Fixture& fixture, std::string path, const std::filesystem::path& source,
+                  std::shared_ptr<OverlayMountOptions> options) {
+  REQUIRE(fixture.GetFileSystem().Mount({std::move(path), ProviderType::kOverlay, source,
+      MountFlags::kNone, {}, std::move(options)}));
+}
+
+std::vector<std::string> Names(IFileSystem& fs, std::string_view path) {
+  auto listing = fs.List(path, "");
+  REQUIRE(listing);
+  std::vector<std::string> result;
+  while (auto entry = (*listing)->Next()) result.push_back(entry->name);
+  std::ranges::sort(result);
+  return result;
+}
+}
