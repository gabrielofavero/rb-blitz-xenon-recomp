+// SPDX-License-Identifier: BSD-3-Clause
+#include <array>
+#include <filesystem>
+#include <fstream>
+
+#include "rex_test.h"
+#include "fixture_dir.h"
+#include "kernel/kernel_fixture.h"
+#include <rex/filesystem/file_system.h>
+#include <rex/kernel/title_runtime.h>
+#include <rex/xam/content_manager.h>
+#include <rex/xam/content_sources.h>
+#include <rex/xam/content_validation.h>
+
+REX_TEST_CASE("Content validation gates primary structured and flat packages before guest exposure", "[xam][content_validation]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    auto* sources=REX_INTERFACE(rex::xam::IContentSources); REQUIRE(sources);
+    auto* validation=REX_INTERFACE(rex::xam::IContentValidation); REQUIRE(validation);
+    auto& manager=c.GetRuntime().GetContentManager(); auto& fs=c.GetRuntime().GetFileSystem();
+    const auto path=fixture.GetRoot()/"content.bin";
+    std::filesystem::copy_file(rex::test::GetFixtureFolder()/"stfs_con.bin",path);
+    auto installed=manager.InstallContent(path,{.require_running_title=false}); REQUIRE(installed);
+    const auto root=fixture.GetRoot()/"external";
+    const auto structured=root/"52455831"/"00000002"/"structured";
+    std::filesystem::create_directories(structured);
+    {std::ofstream file(structured/"metadata");file<<"bad";}
+    constexpr auto type=rex::kernel::XContentType::kMarketplaceContent;
+    REQUIRE(sources->ReplaceContentSources({root,{{path,"flat",0x52455831,type}}}));
+    int calls=0;
+    REQUIRE(validation->SetContentValidator([&](const rex::filesystem::IMountValidationView& view)->rex::Result<void>{
+      ++calls;CHECK_FALSE(view.GetNodes().empty());
+      return rex::Err(rex::ErrorCategory::kValidation,"metadata is refused");
+    }));
+    const size_t before=fs.GetMounts().size();
+    auto data=*installed;
+    for(auto name:{data.GetFileName(),std::string("structured"),std::string("flat")}) {
+      data.SetFileName(name);data.content_type=name==installed->GetFileName()?static_cast<rex::kernel::XContentType>(installed->content_type):type;
+      CHECK_FALSE(manager.OpenContent("rejected",0,data));
+      CHECK_FALSE(fs.FindLink("rejected:"));
+      CHECK(fs.GetMounts().size()==before);
+    }
+    CHECK(calls==3);
+    REQUIRE(validation->SetContentValidator({}));
+    data.SetFileName("flat"); REQUIRE(manager.OpenContent("accepted",0,data));
+    REQUIRE(fs.Stat("accepted:\\a.txt"));
+    REQUIRE(manager.CloseContent("accepted"));
+  });
+}
