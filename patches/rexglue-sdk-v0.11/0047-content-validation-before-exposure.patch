diff --git a/include/rex/filesystem/mount_validation.h b/include/rex/filesystem/mount_validation.h
new file mode 100644
--- /dev/null
+++ b/include/rex/filesystem/mount_validation.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <functional>
+#include <span>
+#include <vector>
+
+#include <rex/filesystem/file_stat.h>
+#include <rex/result.h>
+#include <rex/types.h>
+
+namespace rex::filesystem {
+
+/** One exact provider node. Duplicate names retain distinct indices and byte sources. */
+struct MountValidationNode {
+  FileStat info;
+  size_t parent = 0; /**< Root is index 0 and its own parent. */
+  std::vector<size_t> children;
+};
+
+/** Callback-only read access to a provider before it enters the guest mount table.
+ * The view, nodes and their indices must not be retained after the callback returns.
+ * Read uses node identity and never resolves a duplicate by its path.
+ */
+class IMountValidationView {
+ public:
+  virtual ~IMountValidationView() = default;
+  [[nodiscard]] virtual std::span<const MountValidationNode> GetNodes() const = 0;
+  [[nodiscard]] virtual Result<size_t> Read(size_t node, u64 offset, std::span<u8> buffer) const = 0;
+};
+
+/** Synchronous, read-only validation. A refusal leaves no guest mount or link.
+ * Callbacks must not reenter the mount table or retain the view.
+ */
+using MountValidator = std::function<Result<void>(const IMountValidationView&)>;
+
+}  // namespace rex::filesystem
diff --git a/include/rex/xam/content_validation.h b/include/rex/xam/content_validation.h
new file mode 100644
--- /dev/null
+++ b/include/rex/xam/content_validation.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+
+#include <rex/filesystem/mount_validation.h>
+#include <rex/module.h>
+#include <rex/result.h>
+
+namespace rex::xam {
+
+/** Optional title-owned validation for primary and external content packages.
+ * A fresh title has no validator. Calls must be serialized with title attach/detach.
+ */
+REX_DECLARE_INTERFACE(IContentValidation, 1)
+  /** Replaces the callback for subsequent opens and creates; empty removes it.
+   * Validation reads the exact provider before any mount or guest link is published.
+   * An open in progress retains its callback snapshot. Returns kNotFound without a title.
+   */
+  [[nodiscard]] virtual Result<void> SetContentValidator(filesystem::MountValidator validator) = 0;
+};
+
+}  // namespace rex::xam
