+// SPDX-License-Identifier: BSD-3-Clause
+#include <array>
+#include <cstring>
+#include <fstream>
+#include <stdexcept>
+
+#include "rex_test.h"
+#include "fixture_dir.h"
+#include "filesystem/fixture.h"
+#include <rex/filesystem/mount_validation.h>
+#include <rex/string/text.h>
+
+using rex::filesystem::test::Fixture;
+using namespace rex::filesystem;
+
+REX_TEST_CASE_METHOD(Fixture,"Mount validation refuses before any provider is published","[filesystem][mount_validation]") {
+  test::WriteHost(GetTemp()/"folder"/"data.bin","abc");
+  int called=0;
+  auto validator=std::make_shared<const MountValidator>([&](const IMountValidationView& view)->rex::Result<void> {
+    ++called;
+    auto nodes=view.GetNodes(); REQUIRE(nodes.size()==3);
+    CHECK(nodes[0].parent==0);
+    CHECK(nodes[0].children.size()==1);
+    CHECK(nodes[1].parent==0);
+    CHECK(nodes[2].parent==1);
+    CHECK(nodes[2].info.name=="data.bin");
+    std::array<rex::u8,3> bytes{};
+    auto read=view.Read(2,0,bytes); REQUIRE(read); CHECK(*read==3);
+    CHECK(std::string(bytes.begin(),bytes.end())=="abc");
+    CHECK_FALSE(view.Read(nodes.size(),0,bytes));
+    CHECK_FALSE(view.Read(0,0,bytes));
+    return rex::Err(rex::ErrorCategory::kValidation,"refused contents");
+  });
+  MountEntry entry{"\\Device\\Validation",ProviderType::kHostDirectory,GetTemp(),MountFlags::kNone,{}};
+  entry.validator=validator;
+  auto denied=GetFileSystem().Mount(entry); REQUIRE_FALSE(denied);
+  CHECK(denied.error().category==rex::ErrorCategory::kValidation);
+  CHECK(called==1);
+  CHECK(GetFileSystem().GetMounts().empty());
+  CHECK_FALSE(GetFileSystem().Stat(entry.path));
+  entry.validator=std::make_shared<const MountValidator>([](const IMountValidationView&)->rex::Result<void>{return rex::Ok();});
+  REQUIRE(GetFileSystem().Mount(entry));
+  CHECK(GetFileSystem().GetMounts().size()==1);
+}
+
+REX_TEST_CASE_METHOD(Fixture,"Mount validation reads distinct duplicate container nodes by identity","[filesystem][mount_validation]") {
+  const auto source=GetTemp()/"duplicate.bin";
+  std::filesystem::copy_file(rex::test::GetFixtureFolder()/"stfs_con.bin",source);
+  std::string second;
+  SECTION("identical names") {second="songs.dta";}
+  SECTION("case variant names") {second="SONGS.DTA";}
+  {
+    std::fstream file(source,std::ios::binary|std::ios::in|std::ios::out); REQUIRE(file);
+    for(auto [offset,name]:{std::pair{std::streamoff{0xB040},std::string("songs.dta")},std::pair{std::streamoff{0xB080},second}}) {
+      std::array<char,40> record{}; std::memcpy(record.data(),name.data(),name.size());
+      file.seekp(offset);file.write(record.data(),record.size());
+      file.seekg(offset+40);char flags=0;file.read(&flags,1);
+      flags=char((static_cast<unsigned char>(flags)&0xC0)|name.size());
+      file.seekp(offset+40);file.write(&flags,1);
+    }
+  }
+  std::vector<std::string> content;
+  MountEntry entry{"\\Device\\Duplicate",ProviderType::kSTFS,source,MountFlags::kNone,{}};
+  entry.validator=std::make_shared<const MountValidator>([&](const IMountValidationView& view)->rex::Result<void>{
+    auto nodes=view.GetNodes();
+    for(size_t index=0;index<nodes.size();++index) {
+      if(!rex::string::utf8_equal_case(nodes[index].info.name,"songs.dta")) continue;
+      std::array<rex::u8,6> bytes{}; auto read=view.Read(index,0,bytes); REQUIRE(read); CHECK(*read==6);
+      content.emplace_back(bytes.begin(),bytes.end());
+    }
+    REQUIRE(content.size()==2);
+    CHECK(content[0]=="alpha\n");
+    CHECK(content[0]!=content[1]);
+    return rex::Err(rex::ErrorCategory::kValidation,"second duplicate is refused");
+  });
+  CHECK_FALSE(GetFileSystem().Mount(entry));
+  CHECK(GetFileSystem().GetMounts().empty());
+}
+
+REX_TEST_CASE_METHOD(Fixture,"Throwing mount validation leaves no mount or taken name","[filesystem][mount_validation]") {
+  MountEntry entry{"\\Device\\Throw",ProviderType::kHostDirectory,GetTemp(),MountFlags::kNone,{}};
+  entry.validator=std::make_shared<const MountValidator>([](const IMountValidationView&)->rex::Result<void>{throw std::runtime_error("invalid metadata");});
+  auto result=GetFileSystem().Mount(entry); REQUIRE_FALSE(result);
+  CHECK(result.error().category==rex::ErrorCategory::kValidation);
+  CHECK(GetFileSystem().GetMounts().empty());
+  entry.validator.reset(); REQUIRE(GetFileSystem().Mount(entry));
+}
