 namespace rex::filesystem {
 
 namespace {
+
+/** Owns no nodes: Mount keeps the provider alive throughout validation. */
+class MountValidationView final : public IMountValidationView {
+ public:
+  explicit MountValidationView(Provider& provider) : provider_(provider) {
+    Add(provider.GetRoot(), 0);
+    for (size_t index = 0; index < nodes_.size(); ++index) {
+      // Add may grow both vectors, so retain no reference to their elements.
+      for (const auto& child : nodes_[index]->GetChildren()) {
+        const size_t added = nodes_.size();
+        Add(*child, index);
+        records_[index].children.push_back(added);
+      }
+    }
+  }
+
+  std::span<const MountValidationNode> GetNodes() const override { return records_; }
+
+  Result<size_t> Read(size_t node, u64 offset, std::span<u8> buffer) const override {
+    if (node >= nodes_.size()) return Err<size_t>(BuildError(
+        FileSystemError::kInvalidPath, "validation node index is out of range"));
+    std::lock_guard lock(provider_.GetMutex());
+    if (nodes_[node]->IsDirectory()) return Err<size_t>(BuildError(
+        FileSystemError::kIsDirectory, "a validation directory cannot be read as bytes"));
+    REX_TRY(std::unique_ptr<NodeStream> stream, nodes_[node]->Open(Access::kReadAccess | Access::kReadData));
+    return stream->Read(buffer, offset);
+  }
+
+ private:
+  void Add(Node& node, size_t parent) {
+    nodes_.push_back(&node);
+    records_.push_back({node.GetInfo(), parent, {}});
+  }
+  Provider& provider_;
+  std::vector<Node*> nodes_;
+  std::vector<MountValidationNode> records_;
+};
 
