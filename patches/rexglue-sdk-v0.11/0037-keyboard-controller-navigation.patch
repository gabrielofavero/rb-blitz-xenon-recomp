diff --git a/include/rex/ui/keyboard_input_controller.h b/include/rex/ui/keyboard_input_controller.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/keyboard_input_controller.h
@@ -0,0 +1,43 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#pragma once
+
+#include <cstdint>
+
+namespace rex::ui {
+
+// Physical controls only: keyboard-to-pad emulation must never feed this modal.
+struct KeyboardControllerSample {
+  enum Button : uint16_t { ShowKeyboard = 1, Cancel = 2 };
+  bool connected = false;
+  bool focused = false;
+  uint16_t buttons = 0;
+};
+
+struct KeyboardControllerAction {
+  bool cancel = false;
+  bool show_keyboard = false;
+};
+
+// B cancels; A requests the OS keyboard, never submission. Ignore buttons
+// already held on open/focus regain. Directions and typing do not participate.
+class KeyboardInputController {
+ public:
+  KeyboardControllerAction Update(KeyboardControllerSample sample) {
+    if (!sample.connected || !sample.focused) {
+      initialized_ = false;
+      return {};
+    }
+    const auto pressed = initialized_ ? sample.buttons & ~previous_buttons_ : 0;
+    const bool cancel = (pressed & KeyboardControllerSample::Cancel) != 0;
+    const bool show = !cancel && (pressed & KeyboardControllerSample::ShowKeyboard) != 0;
+    previous_buttons_ = sample.buttons;
+    initialized_ = true;
+    return {cancel, show};
+  }
+
+ private:
+  bool initialized_ = false;
+  uint16_t previous_buttons_ = 0;
+};
+
+}  // namespace rex::ui
diff --git a/tests/unit/ui/keyboard_prompt_test.cpp b/tests/unit/ui/keyboard_prompt_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/ui/keyboard_prompt_test.cpp
@@ -0,0 +1,137 @@
+// Copyright 2026. Released under the BSD license - see LICENSE.
+#include "rex_test.h"
+#include <imgui.h>
+#include <imgui_internal.h>
+#include <rex/ui/style.h>
+#include "ui/prompt.h"
+
+namespace {
+struct PromptContext {
+  ImGuiContext* previous = ImGui::GetCurrentContext();
+  ImGuiContext* context = ImGui::CreateContext();
+  PromptContext() {
+    auto& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2(1280, 720);
+    io.BackendFlags |= ImGuiBackendFlags_RendererHasTextures;
+    io.Fonts->AddFontDefault();
+  }
+  ~PromptContext() { ImGui::DestroyContext(context); ImGui::SetCurrentContext(previous); }
+  bool Frame(rex::ui::PromptDialog& dialog, std::string* log = nullptr) {
+    auto& io = ImGui::GetIO();
+    io.DeltaTime = 1.0f / 60.0f;
+    ImGui::NewFrame();
+    if (log) {
+      ImGui::LogToBuffer();
+    }
+    const bool keep = dialog.Draw(io);
+    if (log) {
+      *log = ImGui::GetCurrentContext()->LogBuffer.c_str();
+      ImGui::LogFinish();
+    }
+    ImGui::Render();
+    for (auto* texture : *ImGui::GetDrawData()->Textures) {
+      texture->SetTexID(1);
+      texture->SetStatus(ImTextureStatus_OK);
+    }
+    return keep;
+  }
+};
+}
+
+REX_TEST_CASE("physical keyboard controls suppress held buttons and prioritize cancel", "[ui][keyboard]") {
+  using S = rex::ui::KeyboardControllerSample;
+  rex::ui::KeyboardInputController controller;
+  CHECK_FALSE(controller.Update({true, true, S::ShowKeyboard}).show_keyboard);
+  CHECK_FALSE(controller.Update({true, true, 0}).cancel);
+  CHECK(controller.Update({true, true, S::ShowKeyboard}).show_keyboard);
+  CHECK_FALSE(controller.Update({true, true, S::ShowKeyboard}).show_keyboard);
+  CHECK_FALSE(controller.Update({true, false, S::Cancel}).cancel);
+  CHECK_FALSE(controller.Update({true, true, S::Cancel}).cancel);
+  controller.Update({true, true, 0});
+  const auto both = controller.Update({true, true, S::Cancel | S::ShowKeyboard});
+  CHECK(both.cancel);
+  CHECK_FALSE(both.show_keyboard);
+  CHECK_FALSE(controller.Update({false, true, 0}).cancel);
+  CHECK_FALSE(controller.Update({true, true, S::Cancel}).cancel);
+}
+
+REX_TEST_CASE("a themed keyboard opens the host keyboard after focus and B cancels once", "[ui][keyboard]") {
+  PromptContext context;
+  rex::ui::Style style;
+  style.keyboard.enabled = true;
+  rex::ui::KeyboardControllerSample sample{true, true, 0};
+  style.keyboard.sample_controller = [&] { return sample; };
+  int opened = 0, dismissed = 0, completed = 0;
+  bool canceled = false;
+  style.keyboard.request_keyboard = [&] { ++opened; return true; };
+  style.keyboard.dismiss_keyboard = [&] { ++dismissed; };
+  {
+    rex::ui::PromptDialog dialog({.title="Search", .text_input=true, .default_text="abc"},
+        rex::ui::PromptDone([&](rex::ui::PromptResult answer) { ++completed; canceled=answer.canceled; }), &style);
+    CHECK(context.Frame(dialog));
+    CHECK(opened == 0);
+    CHECK(context.Frame(dialog));
+    CHECK(opened == 1);
+    CHECK(context.Frame(dialog));
+    CHECK(opened == 1);
+    sample.buttons = rex::ui::KeyboardControllerSample::ShowKeyboard;
+    CHECK(context.Frame(dialog));
+    CHECK(completed == 0);
+    sample.buttons = rex::ui::KeyboardControllerSample::Cancel;
+    CHECK_FALSE(context.Frame(dialog));
+    CHECK(opened == 1);
+    CHECK(completed == 1);
+    CHECK(canceled);
+  }
+  CHECK(dismissed == 1);
+  CHECK(completed == 1);
+}
+
+REX_TEST_CASE("portrait search fills the phone width and hides shortcuts for touch", "[ui][keyboard]") {
+  PromptContext context;
+  ImGui::GetIO().DisplaySize = ImVec2(402.0f, 874.0f);
+  rex::ui::Style style;
+  style.keyboard.enabled = true;
+  ImVec2 size{};
+  ImVec2 center{};
+  float button_height = 0.0f;
+  bool touch = true;
+  style.keyboard.hide_shortcut_hints = [&] {
+    size = ImGui::GetWindowSize();
+    const auto pos = ImGui::GetWindowPos();
+    center = ImVec2(pos.x + size.x * 0.5f, pos.y + size.y * 0.5f);
+    button_height = ImGui::GetItemRectSize().y;
+    return touch;
+  };
+  rex::ui::PromptDialog dialog({.title="Search", .text_input=true},
+      [](rex::ui::PromptResult) {}, &style);
+  CHECK(context.Frame(dialog));
+  CHECK(context.Frame(dialog));
+  std::string touch_log;
+  CHECK(context.Frame(dialog, &touch_log));
+  CHECK(size.x > 0.9f * 402.0f);
+  CHECK(center.y < 0.4f * 874.0f);
+  CHECK(button_height >= 44.0f);
+  CHECK(touch_log.find("Done") != std::string::npos);
+  CHECK(touch_log.find("Enter: Search") == std::string::npos);
+  CHECK(touch_log.find("Esc: Cancel") == std::string::npos);
+
+  touch = false;
+  std::string keyboard_log;
+  CHECK(context.Frame(dialog, &keyboard_log));
+  CHECK(keyboard_log.find("Enter: Search") != std::string::npos);
+  CHECK(keyboard_log.find("Esc: Cancel") != std::string::npos);
+}
+
+REX_TEST_CASE("keyboard theme callbacks do not affect an ordinary message box", "[ui][keyboard]") {
+  PromptContext context;
+  rex::ui::Style style;
+  style.keyboard.enabled = true;
+  int samples = 0;
+  style.keyboard.sample_controller = [&] { ++samples; return rex::ui::KeyboardControllerSample{}; };
+  rex::ui::PromptDialog dialog({.title="Message", .body="Body"}, [](rex::ui::PromptResult) {}, &style);
+  CHECK(context.Frame(dialog));
+  CHECK(context.Frame(dialog));
+  CHECK(samples == 0);
+}
