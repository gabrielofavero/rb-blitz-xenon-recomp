diff --git a/MoltenVK/MoltenVK/Utility/MVKRetainedObject.h b/MoltenVK/MoltenVK/Utility/MVKRetainedObject.h
new file mode 100644
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKRetainedObject.h
@@ -0,0 +1,42 @@
+/* Copyright 2026. Licensed under the Apache License, Version 2.0. */
+#pragma once
+
+#include <mutex>
+
+// An Objective-C object shared with asynchronous completion callbacks. Readers
+// acquire their own ownership before a concurrent clear can release the object.
+// Release outside the lock: destruction may itself run completion callbacks.
+template<class T> class MVKRetainedObject {
+public:
+    MVKRetainedObject() = default;
+    MVKRetainedObject(const MVKRetainedObject&) = delete;
+    MVKRetainedObject& operator=(const MVKRetainedObject&) = delete;
+    ~MVKRetainedObject() { clear(); }
+
+    T getRetained() {
+        std::lock_guard<std::mutex> lock(_lock);
+        return [_object retain];
+    }
+
+    // Candidate is borrowed. Its potentially blocking creation happens before
+    // entering this method, so a drawable wait cannot block retirement callbacks.
+    T publishIfEmptyAndGetRetained(T candidate) {
+        std::lock_guard<std::mutex> lock(_lock);
+        if (!_object) { _object = [candidate retain]; }
+        return [_object retain];
+    }
+
+    void clear() {
+        T previous;
+        {
+            std::lock_guard<std::mutex> lock(_lock);
+            previous = _object;
+            _object = nil;
+        }
+        [previous release];
+    }
+
+private:
+    std::mutex _lock;
+    T _object = nil;
+};
