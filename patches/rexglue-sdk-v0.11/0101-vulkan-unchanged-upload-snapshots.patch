diff --git a/src/gpu/xenos/host/vulkan/shared_memory_snapshot_cache.h b/src/gpu/xenos/host/vulkan/shared_memory_snapshot_cache.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/host/vulkan/shared_memory_snapshot_cache.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace rex::gpu::vulkan {
+// Exact CPU copies of data already recorded for upload. These never alias live
+// guest pages or GPU-owned memory. GPU writes must invalidate their page entries.
+class SharedMemorySnapshotCache {
+ public:
+  SharedMemorySnapshotCache(uint32_t address_space_size, uint32_t page_size, size_t budget)
+      : page_size_(page_size),
+        page_to_slot_(address_space_size / page_size, kMissing),
+        owners_(std::min(page_to_slot_.size(), budget / page_size), kMissing),
+        valid_(owners_.size(), 0),
+        bytes_(owners_.empty() ? nullptr :
+            std::make_unique_for_overwrite<uint8_t[]>(owners_.size() * page_size)) {}
+
+  bool Matches(uint32_t page, const void* source) const {
+    if (page >= page_to_slot_.size()) return false;
+    const uint32_t slot = page_to_slot_[page];
+    return slot != kMissing && valid_[slot] &&
+           std::memcmp(bytes_.get() + size_t(slot) * page_size_, source, page_size_) == 0;
+  }
+  // Call only for bytes in an upload staging buffer that will be recorded before
+  // the next lookup, including when an allocation fails after a partial upload.
+  const uint8_t* RememberUpload(uint32_t page, const void* snapshot) {
+    if (owners_.empty() || page >= page_to_slot_.size()) return static_cast<const uint8_t*>(snapshot);
+    uint32_t slot = page_to_slot_[page];
+    if (slot == kMissing) {
+      slot = next_slot_++ % static_cast<uint32_t>(owners_.size());
+      if (owners_[slot] != kMissing) page_to_slot_[owners_[slot]] = kMissing;
+      owners_[slot] = page;
+      page_to_slot_[page] = slot;
+    }
+    std::memcpy(bytes_.get() + size_t(slot) * page_size_, snapshot, page_size_);
+    valid_[slot] = 1;
+    return bytes_.get() + size_t(slot) * page_size_;
+  }
+  // Inclusive byte bounds, matching SharedMemory's global watch callback.
+  void Invalidate(uint32_t first, uint32_t last) {
+    if (first > last || size_t(first / page_size_) >= page_to_slot_.size()) return;
+    const uint32_t end = static_cast<uint32_t>(std::min(
+        size_t(last / page_size_), page_to_slot_.size() - 1));
+    for (uint32_t page = first / page_size_; page <= end; ++page) {
+      const uint32_t slot = page_to_slot_[page];
+      if (slot != kMissing) valid_[slot] = 0;
+    }
+  }
+  void Clear() { std::fill(valid_.begin(), valid_.end(), uint8_t(0)); }
+  size_t capacity_bytes() const { return owners_.size() * page_size_; }
+
+ private:
+  static constexpr uint32_t kMissing = UINT32_MAX;
+  uint32_t page_size_, next_slot_ = 0;
+  std::vector<uint32_t> page_to_slot_, owners_;
+  std::vector<uint8_t> valid_;
+  std::unique_ptr<uint8_t[]> bytes_;
+};
+}  // namespace rex::gpu::vulkan
