// rb_blitz - ReXGlue Recompiled Project
//
// Windows resources. Keep "assets\\blitz.ico" resolvable relative to this file:
// the RC compiler resolves the path against the directory holding this script.
//
// The icon is the first RT_GROUP_ICON in the executable, which is what the
// Explorer shows for rb_blitz.exe and what SDL_RegisterApp picks up as the
// window class icon, so the title bar, taskbar and Alt-Tab entries follow from
// this one resource.

#define IDI_RB_BLITZ 1

IDI_RB_BLITZ ICON DISCARDABLE "assets\\blitz.ico"
