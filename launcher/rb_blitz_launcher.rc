// rb_blitz launcher - Windows resources.
//
// Same mechanism as the game's rb_blitz.rc: the icon is the executable's first
// RT_GROUP_ICON, which is what Explorer shows for rb_blitz_launcher.exe and what SDL
// registers as the window class icon. The path is resolved against the directory
// holding this file.
//
// The launcher ships the black-and-white alt icon (assets/icon/blitz-mono.ico, made
// from the colour art by scripts/make_mono_icon.py) while the game keeps the colour
// one, so the two windows are told apart in the taskbar and the Alt-Tab list.

#define IDI_RB_BLITZ_LAUNCHER 1

IDI_RB_BLITZ_LAUNCHER ICON DISCARDABLE "..\\assets\\icon\\blitz-mono.ico"
